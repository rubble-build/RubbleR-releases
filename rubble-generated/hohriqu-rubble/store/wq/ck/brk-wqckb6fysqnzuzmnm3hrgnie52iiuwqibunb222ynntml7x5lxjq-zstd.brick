{ "id": "wqckb6fysqnzuzmnm3hrgnie52iiuwqibunb222ynntml7x5lxjq-zstd"
, "name": "zstd"
, "platform": "x86_64-linux"
, "build_platform": "x86_64-linux"
, "rubble_home": "/var/lib/rubble"
, "inputs": [
    { "brick": "hl6djaj44qkp6rily6m7uf6lsksicuvyiukbsphwqzo7zhddpzna-zstd-libs-1.5.6-r2.apk"
    , "alias": "zstd_libs_apk"
    , "transitive": "false"
    }
  , { "brick": "gn35dmjju7ixfllbazzkcjuoxfqy5sbsv6g6ghmtlkm5boylcb2a-zstd-1.5.6-r2.apk"
    , "alias": "zstd_apk"
    , "transitive": "false"
    }
  , { "brick": "4z45nx65xw3y3yxdn5rw2qf5jwclaclnqqfhofeig6xotqxb7ajq-patchelf"
    , "alias": "patchelf"
    , "transitive": "false"
    }
  , { "brick": "zkiff2cic77r6rxw3quhxg6gu4rznq4omwpz5tui7zwbvlqj6mbq-ld-musl.so"
    , "alias": "ld_musl"
    , "transitive": "true"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  , { "name": "bin" }
  , { "name": "lib" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "mkdir -p zstd-extract zstdlibs-extract\n"
        , "tar -xzf \"$zstd_apk\" -C zstd-extract\n"
        , "tar -xzf \"$zstd_libs_apk\" -C zstdlibs-extract\n"
        , "\n"
        , "mkdir -p \"$lib\"\n"
        , "find zstdlibs-extract -name \"libzstd.so*\" -exec cp -a {} \"$lib/\" \\;\n"
        , "\n"
        , "cp zstd-extract/usr/bin/zstd \"$out\"\n"
        , "chmod +x \"$out\"\n"
        , "\"$patchelf\" --set-interpreter \"$ld_musl\" --set-rpath \"$lib\" \"$out\"\n"
        , "\n"
        , "# bin directory with symlinks for PATH integration\n"
        , "mkdir -p \"$bin\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/zstd\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/zstdcat\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/unzstd\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/zstdmt\"\n"
        , "\n"
        , "# Verify\n"
        , "echo \"\"\n"
        , "echo \"=== Verifying zstd installation ===\"\n"
        , "assert_needed() {\n"
        , "  elf=$1\n"
        , "  shift\n"
        , "  actual=$(\"$patchelf\" --print-needed \"$elf\" | LC_ALL=C sort)\n"
        , "  expected=$(printf '%s\\n' \"$@\" | LC_ALL=C sort)\n"
        , "  test \"$actual\" = \"$expected\"\n"
        , "}\n"
        , "\n"
        , "musl_soname=$(\"$patchelf\" --print-soname \"$ld_musl\")\n"
        , "case \"$musl_soname\" in\n"
        , "  libc.musl-*.so.1) ;;\n"
        , "  *) false ;;\n"
        , "esac\n"
        , "\n"
        , "test \"$(\"$patchelf\" --print-interpreter \"$out\")\" = \"$ld_musl\"\n"
        , "test \"$(\"$patchelf\" --print-rpath \"$out\")\" = \"$lib\"\n"
        , "assert_needed \"$out\" libzstd.so.1 \"$musl_soname\"\n"
        , "\n"
        , "test -L \"$lib/libzstd.so.1\"\n"
        , "libzstd_target=$(readlink \"$lib/libzstd.so.1\")\n"
        , "case \"$libzstd_target\" in\n"
        , "  \"\"|/*|*/*) false ;;\n"
        , "esac\n"
        , "libzstd_real=\"$lib/$libzstd_target\"\n"
        , "test -f \"$libzstd_real\"\n"
        , "test ! -L \"$libzstd_real\"\n"
        , "test \"$(\"$patchelf\" --print-soname \"$libzstd_real\")\" = libzstd.so.1\n"
        , "assert_needed \"$libzstd_real\" \"$musl_soname\"\n"
        , "\n"
        , "\"$ld_musl\" --library-path \"$lib\" \"$out\" --version"
        ]
      , "format": "text"
      }
    }
  ]
, "inventory": {
    "hl6djaj44qkp6rily6m7uf6lsksicuvyiukbsphwqzo7zhddpzna-zstd-libs-1.5.6-r2.apk":
      { "id": "hl6djaj44qkp6rily6m7uf6lsksicuvyiukbsphwqzo7zhddpzna-zstd-libs-1.5.6-r2.apk"
      , "name": "zstd-libs-1.5.6-r2.apk"
      , "src": {
          "url": "https://dl-cdn.alpinelinux.org/alpine/v3.21/main/x86_64/zstd-libs-1.5.6-r2.apk"
        , "checksum": "sha256:45a06bfc107f44502b7e0503fcd5c8d2d2e6cff255134ed959275eb99caf9979"
        }
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "__rubble_skip_src_split__"
          , "value": "true"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "cp -ar \"$src\" \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "gn35dmjju7ixfllbazzkcjuoxfqy5sbsv6g6ghmtlkm5boylcb2a-zstd-1.5.6-r2.apk":
      { "id": "gn35dmjju7ixfllbazzkcjuoxfqy5sbsv6g6ghmtlkm5boylcb2a-zstd-1.5.6-r2.apk"
      , "name": "zstd-1.5.6-r2.apk"
