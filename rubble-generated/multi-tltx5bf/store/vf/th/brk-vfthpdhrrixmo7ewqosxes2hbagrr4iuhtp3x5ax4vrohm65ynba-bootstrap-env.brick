  , "catpfdrg7xd6pcsylgw2dzmolmqrqux6crkx64inuc42ioy4szfa-findutils":
      { "id": "catpfdrg7xd6pcsylgw2dzmolmqrqux6crkx64inuc42ioy4szfa-findutils"
      , "name": "findutils"
      , "platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "hdqxqr4vfc2rgc3rj5ywrpaykxqly77eix55tldf7wd7nqimpqfa-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "z3xhjdr5it75lq5iwals4toaklhutksbdphbucgwhtgqhxz32k6q-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "4gvhwzfvxu2ugj4sf2jr5aq4u6pjy5jrywhkzxyimdv437sk6eba-findutils-4.10.0-r0.apk"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "5egteflbtlhbpl5lxsf77tssx5r2xozci62fdy42ah5ennedwyeq-musl-install-tools"
          , "alias": "musl_tools"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "bin" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar -xzf \"$src\" 2>/dev/null || true\n"
              , "\n"
              , "mkdir -p \"$bin\"\n"
              , "\n"
              , "# Copy and patch find and xargs binaries\n"
              , "for cmd in find xargs; do\n"
              , "  if [ -f \"usr/bin/$cmd\" ]; then\n"
              , "    \"${musl_tools[install]}\" \"usr/bin/$cmd\" \"$bin/$cmd\" \"$patchelf\" \"$ld_musl\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "mkdir -p \"$TMP/find-probe\"\n"
              , "touch \"$TMP/find-probe/name with spaces\"\n"
              , "\"$bin/find\" -- \"$TMP/find-probe\" -type f -print0 > \"$TMP/found\"\n"
              , "actual=\"$(\"$bin/xargs\" -0 -r printf '%s\\n' < \"$TMP/found\")\"\n"
              , "test \"$actual\" = \"$TMP/find-probe/name with spaces\"\n"
              , "rm -rf \"$TMP/find-probe\" \"$TMP/found\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "klzkfeewgdals54pcgp3sytbcfc46yua4g3vq23ijqq4cou4almq-diffutils":
      { "id": "klzkfeewgdals54pcgp3sytbcfc46yua4g3vq23ijqq4cou4almq-diffutils"
      , "name": "diffutils"
      , "platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "hdqxqr4vfc2rgc3rj5ywrpaykxqly77eix55tldf7wd7nqimpqfa-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "z3xhjdr5it75lq5iwals4toaklhutksbdphbucgwhtgqhxz32k6q-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "pp5mdkq27cweyfk3tmnimt5y23i2qdjbjhlhx2bia6a67iyjm7ya-diffutils-3.10-r0.apk"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "5egteflbtlhbpl5lxsf77tssx5r2xozci62fdy42ah5ennedwyeq-musl-install-tools"
          , "alias": "musl_tools"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "bin" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar -xzf \"$src\" 2>/dev/null || true\n"
              , "\n"
              , "mkdir -p \"$bin\"\n"
              , "\n"
              , "# Copy and patch diffutils binaries\n"
              , "for cmd in diff cmp diff3 sdiff; do\n"
              , "  if [ -f \"usr/bin/$cmd\" ]; then\n"
              , "    \"${musl_tools[install]}\" \"usr/bin/$cmd\" \"$bin/$cmd\" \"$patchelf\" \"$ld_musl\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "printf 'before\\n' > \"$TMP/diff-before\"\n"
              , "printf 'after\\n' > \"$TMP/diff-after\"\n"
              , "status=0\n"
              , "\"$bin/diff\" --unified=0 --label before --label after \"$TMP/diff-before\" \"$TMP/diff-after\" > \"$TMP/diff-result\" || status=$?\n"
              , "test \"$status\" -eq 1\n"
              , "test \"$(cat \"$TMP/diff-result\")\" = $'--- before\\n+++ after\\n@@ -1 +1 @@\\n-before\\n+after'\n"
              , "rm -f \"$TMP/diff-before\" \"$TMP/diff-after\" \"$TMP/diff-result\""
              ]
            , "format": "text"
            }
          }
        ]
      }
