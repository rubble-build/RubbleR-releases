  , "jx55n3p7uiv65atde62sfdnrktfey2co5qtqasgnglrc4qytpgtq-gzip":
      { "id": "jx55n3p7uiv65atde62sfdnrktfey2co5qtqasgnglrc4qytpgtq-gzip"
      , "name": "gzip"
      , "platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "hdqxqr4vfc2rgc3rj5ywrpaykxqly77eix55tldf7wd7nqimpqfa-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "z3xhjdr5it75lq5iwals4toaklhutksbdphbucgwhtgqhxz32k6q-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "vta6yl5kfo7l43xvgauwa32n5mdi7kx7vjxjymz4odjpnhxy2gfa-gzip-1.13-r1.apk"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "n7qbevbly56oq5vdzjm2bzhl77wjewdp4k5gmoimlbiv62nbv7pa-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "5egteflbtlhbpl5lxsf77tssx5r2xozci62fdy42ah5ennedwyeq-musl-install-tools"
          , "alias": "musl_tools"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar -xzf \"$src\" 2>/dev/null || true\n"
              , "\"${musl_tools[install]}\" bin/gzip \"$out\" \"$patchelf\" \"$ld_musl\"\n"
              , "\"${musl_tools[link_commands]}\" \"$out\" \"$bin\" gzip\n"
              , "for command in gunzip zcat; do\n"
              , "  mode=--decompress\n"
              , "  if [ \"$command\" = zcat ]; then mode='--decompress --stdout'; fi\n"
              , "  printf '#!%s\\nexec \"%s\" %s \"$@\"\\n' \"${bash[bin]}/bash\" \"$out\" \"$mode\" > \"$bin/$command\"\n"
              , "  chmod +x \"$bin/$command\"\n"
              , "done\n"
              , "\n"
              , "printf '%s' 'rubble gzip probe' | \"$out\" -c > \"$TMP/probe.gz\"\n"
              , "actual=\"$(\"$bin/gunzip\" -c \"$TMP/probe.gz\")\"\n"
              , "test \"$actual\" = 'rubble gzip probe'\n"
              , "actual=\"$(\"$bin/zcat\" \"$TMP/probe.gz\")\"\n"
              , "test \"$actual\" = 'rubble gzip probe'\n"
              , "rm -f \"$TMP/probe.gz\""
              ]
            , "format": "text"
            }
          }
        ]
      }
