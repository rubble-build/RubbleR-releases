            }
          }
        , { "brick": "cmdaozrcvaymmdfw3jodg7rrc4qwmaqyx6q3jj6u6nsie32hvdxq-publish-output-directory"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$script\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "dhzowymraqoa262lv45rzgrpjrqdedusoctmkao7qctbpck3qiva-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "mvw4balnruevggsruaxcd7m3dye6dlbrsjshobcplnic3svvd4rq-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "ysrvjznwd73kp7ikl6ymcdrfrcuxlklubsx6wlnxzuqa7gwuxdxq-bison-3.8.2-r1.apk"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "7gaiswvomctprmbv5i6dhxav3urpsmceezmwy52qv42yok44lygq-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "62pd2iqc5djuyptrefmfnoyqs2h7sixqjxbe4j7def3if3gwm2aa-m4"
          , "alias": "m4"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        , { "name": "share" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar -xzf \"$src\" 2>/dev/null || true\n"
              , "\n"
              , "mkdir -p \"$out/bin\" \"$out/share\"\n"
              , "\n"
              , "# Copy bison binaries\n"
              , "cp usr/bin/bison \"$out/bin/bison\"\n"
              , "cp usr/bin/yacc \"$out/bin/yacc\"\n"
              , "chmod +x \"$out/bin/bison\" \"$out/bin/yacc\"\n"
              , "rubble_script_shebang_register \"${bash[bin]}/bash\" sh bash\n"
              , "rubble_script_shebang_rewrite_all --strict \"$out/bin/yacc\"\n"
              , "\n"
              , "# Copy bison data files (skeletons, m4sugar)\n"
              , "cp -a usr/share/bison \"$out/share/bison\"\n"
              , "\n"
              , "# Patch ELF binaries to use musl interpreter from runtime home\n"
              , "\"$patchelf\" --set-interpreter \"$ld_musl\" \"$out/bin/bison\"\n"
              , "\n"
              , "printf '%%%%\\ninput: ;\\n%%%%\\n' > \"$TMP/probe.y\"\n"
              , "BISON_PKGDATADIR=\"$out/share/bison\" M4=\"$m4\" \"$out/bin/bison\" --output=\"$TMP/probe.c\" \"$TMP/probe.y\"\n"
              , "rm -f \"$TMP/probe.y\" \"$TMP/probe.c\""
              ]
            , "format": "text"
            }
          }
        , { "shell": {
              "value": [
                "publish_output_directory \"$out/bin\" \"$bin\"\n"
              , "publish_output_directory \"$out/share\" \"$share\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "7gwdsqgvkrl5q7ztjhu2z65wbjt2eywqrtwg7xc7jewdoolhnmea-acl-libs-2.3.2-r1.apk":
      { "id": "7gwdsqgvkrl5q7ztjhu2z65wbjt2eywqrtwg7xc7jewdoolhnmea-acl-libs-2.3.2-r1.apk"
      , "name": "acl-libs-2.3.2-r1.apk"
      , "src": {
          "url": "https://dl-cdn.alpinelinux.org/alpine/v3.21/main/aarch64/acl-libs-2.3.2-r1.apk"
        , "checksum": "sha256:b0d03f1eed5d5c083a5a11b780a4f89ccdfc5619ebbd822c8c1f09df179b7802"
        }
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "__rubble_skip_src_split__"
          , "value": "true"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "cp -ar \"$src\" \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "u6gpy6gfub4xlqrvjvqq4dtfafufxauxuste7lkmoc6vvpkuzp2q-gnu-tar":
      { "id": "u6gpy6gfub4xlqrvjvqq4dtfafufxauxuste7lkmoc6vvpkuzp2q-gnu-tar"
      , "name": "gnu-tar"
      , "platform": "aarch64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "ptg4o4phfr2eutq2xrcoqi6zx2d2rk4nqoxdm73hvskgosibuh4a-tar-1.35-r2.apk"
          , "alias": "tar_apk"
          , "transitive": "false"
          }
        , { "brick": "dhzowymraqoa262lv45rzgrpjrqdedusoctmkao7qctbpck3qiva-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "zwdawolcw4fqjnlmmwfrxjwrxcplq7t3jb73x5seskofbtj353na-libattr-2.5.2-r2.apk"
          , "alias": "libattr_apk"
          , "transitive": "false"
          }
        , { "brick": "mvw4balnruevggsruaxcd7m3dye6dlbrsjshobcplnic3svvd4rq-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "tyqosp4fpdd7pjacveojot6m2g5ls3hqljfqp4qerplz2kuwcvua-musl-install-tools"
          , "alias": "musl_tools"
          , "transitive": "false"
          }
        , { "brick": "defmfedonkfkblaqtfzjs7kvoq2u5k53xo3zzl43it7q634ax7ja-collect-shared-libraries"
          , "alias": "collect_libraries"
          , "transitive": "false"
          }
        , { "brick": "7gwdsqgvkrl5q7ztjhu2z65wbjt2eywqrtwg7xc7jewdoolhnmea-acl-libs-2.3.2-r1.apk"
          , "alias": "acl_libs_apk"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        , { "name": "lib" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p tar-extract acl-extract attr-extract\n"
              , "tar -xzf \"$tar_apk\" -C tar-extract 2>/dev/null || true\n"
              , "tar -xzf \"$acl_libs_apk\" -C acl-extract 2>/dev/null || true\n"
              , "tar -xzf \"$libattr_apk\" -C attr-extract 2>/dev/null || true\n"
              , "\n"
              , "mkdir -p \"$lib\"\n"
              , "\n"
              , "# Copy shared libraries (libacl, libattr)\n"
              , "\"$collect_libraries\" \"$lib\" recursive ignore acl-extract attr-extract\n"
              , "\n"
              , "# out is the tar binary itself\n"
              , "\"${musl_tools[install]}\" tar-extract/bin/tar \"$out\" \"$patchelf\" \"$ld_musl\" \"$lib\"\n"
              , "\"${musl_tools[link_commands]}\" \"$out\" \"$bin\" tar gtar\n"
              , "\n"
              , "mkdir -p \"$TMP/tar-source\" \"$TMP/tar-dest\"\n"
              , "printf '%s' 'rubble tar probe' > \"$TMP/tar-source/-file with spaces\"\n"
              , "printf '%s\\0' '-file with spaces' > \"$TMP/tar-members\"\n"
              , "\"$out\" -c -f \"$TMP/probe.tar\" -C \"$TMP/tar-source\" --null --verbatim-files-from --files-from=\"$TMP/tar-members\"\n"
              , "\"$bin/gtar\" -x -f \"$TMP/probe.tar\" -C \"$TMP/tar-dest\" --null --verbatim-files-from --files-from=\"$TMP/tar-members\"\n"
              , "cmp \"$TMP/tar-source/-file with spaces\" \"$TMP/tar-dest/-file with spaces\"\n"
              , "rm -rf \"$TMP/tar-source\" \"$TMP/tar-dest\" \"$TMP/tar-members\" \"$TMP/probe.tar\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "r2agl7x5h3nujgwasxf2d2vcopngkncwb6ronredz5n7o6va5s3a-coreutils":
      { "id": "r2agl7x5h3nujgwasxf2d2vcopngkncwb6ronredz5n7o6va5s3a-coreutils"
      , "name": "coreutils"
      , "platform": "aarch64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "dxbm5xbf7vkb35noka43so2duja6uw3kitmmhxbybcer6op5bcla-utmps-libs-0.1.2.3-r2.apk"
          , "alias": "utmps_libs_apk"
          , "transitive": "false"
          }
        , { "brick": "ttxoxb3lfk7t3rzpgq4m42lsl7lmgzt2e5w5pdt6rxna3q6pulra-skalibs-libs-2.14.3.0-r0.apk"
          , "alias": "skalibs_libs_apk"
          , "transitive": "false"
          }
        , { "brick": "cmdaozrcvaymmdfw3jodg7rrc4qwmaqyx6q3jj6u6nsie32hvdxq-publish-output-directory"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$script\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "dhzowymraqoa262lv45rzgrpjrqdedusoctmkao7qctbpck3qiva-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "dvrllqig4vloxhgyjrmpzimbvdcatflu5xsgnfnhez77trxhzbaa-libcrypto3-3.3.7-r2.apk"
          , "alias": "libcrypto_apk"
          , "transitive": "false"
          }
        , { "brick": "zwdawolcw4fqjnlmmwfrxjwrxcplq7t3jb73x5seskofbtj353na-libattr-2.5.2-r2.apk"
          , "alias": "libattr_apk"
          , "transitive": "false"
          }
        , { "brick": "mvw4balnruevggsruaxcd7m3dye6dlbrsjshobcplnic3svvd4rq-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "5wsmysbedc7wbcb22csq254i5hrsdbwpdwuzyi5seacce7a4iaoa-coreutils-sha512sum-9.5-r2.apk"
          , "alias": "coreutils_sha512sum_apk"
          , "transitive": "false"
          }
        , { "brick": "k2sq3ksyc4xg4n3byfvtc2xp2by5lw3uus2pjw4ro7y4ad54uo4q-coreutils-fmt-9.5-r2.apk"
          , "alias": "coreutils_fmt_apk"
          , "transitive": "false"
          }
        , { "brick": "cnsuk57bulhj544m3skp3wwq4lsh5qegyneycg7bgfo2zzu5z7ua-coreutils-env-9.5-r2.apk"
          , "alias": "coreutils_env_apk"
          , "transitive": "false"
          }
        , { "brick": "esh7pawc46nsh5b2uuykm4qsjsoowbes5uu4nt2kcg6hocags6vq-coreutils-9.5-r2.apk"
          , "alias": "coreutils_apk"
          , "transitive": "false"
          }
        , { "brick": "defmfedonkfkblaqtfzjs7kvoq2u5k53xo3zzl43it7q634ax7ja-collect-shared-libraries"
          , "alias": "collect_libraries"
          , "transitive": "false"
          }
        , { "brick": "7gwdsqgvkrl5q7ztjhu2z65wbjt2eywqrtwg7xc7jewdoolhnmea-acl-libs-2.3.2-r1.apk"
          , "alias": "acl_libs_apk"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        , { "name": "lib" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p \"$out/bin\" \"$out/lib\" extract\n"
              , "\n"
              , "for apk in \"$coreutils_apk\" \"$coreutils_env_apk\" \"$coreutils_fmt_apk\" \\\n"
              , "           \"$coreutils_sha512sum_apk\" \"$acl_libs_apk\" \"$libattr_apk\" \\\n"
              , "           \"$utmps_libs_apk\" \"$skalibs_libs_apk\" \"$libcrypto_apk\"; do\n"
              , "  tar -xzf \"$apk\" -C extract 2>/dev/null || true\n"
              , "done\n"
              , "\n"
              , "# Copy shared libraries (acl, attr, utmps, skalibs, libcrypto)\n"
              , "\"$collect_libraries\" \"$out/lib\" recursive ignore extract\n"
              , "\n"
              , "# Copy the multicall binary\n"
              , "cp extract/usr/bin/coreutils \"$out/bin/coreutils\"\n"
              , "chmod +x \"$out/bin/coreutils\"\n"
              , "\n"
              , "# Copy sub-package binaries (env, fmt, sha512sum are separate ELF binaries)\n"
              , "for cmd in env fmt sha512sum; do\n"
              , "  if [ -f \"extract/usr/bin/$cmd\" ] && [ ! -L \"extract/usr/bin/$cmd\" ]; then\n"
              , "    cp \"extract/usr/bin/$cmd\" \"$out/bin/${cmd}\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# Patch ELF binaries to use musl interpreter from runtime home\n"
              , "for f in \"$out/bin/\"*; do\n"
              , "  if [ -f \"$f\" ] && [ ! -L \"$f\" ]; then\n"
              , "    if \"$patchelf\" --print-interpreter \"$f\" >/dev/null 2>&1; then\n"
              , "      \"$patchelf\" --set-interpreter \"$ld_musl\" --set-rpath \"$out/lib\" \"$f\"\n"
              , "    fi\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# Create symlinks for all coreutils commands pointing to the multicall binary\n"
              , "for cmd in \\\n"
              , "  base64 basename basenc b2sum base32 cat chcon chgrp chmod chown chroot \\\n"
              , "  cksum comm cp csplit cut date dd df dir dircolors dirname du echo \\\n"
              , "  expand expr factor false fold head hostid id install join kill link \\\n"
              , "  ln logname ls md5sum mkdir mkfifo mknod mktemp mv nice nl nohup \\\n"
              , "  nproc numfmt od paste pathchk pinky pr printenv printf ptx pwd \\\n"
              , "  readlink realpath rm rmdir runcon seq sha1sum sha224sum sha256sum \\\n"
              , "  sha384sum shred shuf sleep sort split stat stdbuf stty sum \\\n"
              , "  sync tac tail tee test timeout touch tr true truncate tsort tty \\\n"
              , "  uname unexpand uniq unlink uptime users vdir wc who whoami yes\n"
              , "do\n"
              , "  if [ ! -e \"$out/bin/$cmd\" ]; then\n"
              , "    ln -s coreutils \"$out/bin/$cmd\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "printf 'b\\0a\\0' | \"$out/bin/sort\" -z > \"$TMP/sorted\"\n"
              , "mapfile -d '' -t values < \"$TMP/sorted\"\n"
              , "test \"${#values[@]}\" -eq 2\n"
              , "test \"${values[0]}\" = a\n"
              , "test \"${values[1]}\" = b\n"
              , "rm -f \"$TMP/sorted\""
              ]
            , "format": "text"
            }
          }
        , { "shell": {
              "value": [
                "publish_output_directory \"$out/bin\" \"$bin\"\n"
              , "publish_output_directory \"$out/lib\" \"$lib\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "psmhk3rswggelskf3qvnkd7itd3bwmik75jdyyje4nh7jdmi3j4q-bootstrap-env":
      { "id": "psmhk3rswggelskf3qvnkd7itd3bwmik75jdyyje4nh7jdmi3j4q-bootstrap-env"
      , "name": "bootstrap-env"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "fdjot6csltdy7pfpendap6yybjo5niybzp6knbofokgq7mxbz6kq-curl"
          , "alias": "curl"
          , "transitive": "true"
          }
        , { "brick": "zji5om2su2ddkysxsg3xzzbvx7uvgespdsko7wze2bovygtgnuzq-ca-certificates.pem"
          , "alias": "ca_certs"
          , "transitive": "true"
          }
        , { "brick": "7gaiswvomctprmbv5i6dhxav3urpsmceezmwy52qv42yok44lygq-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "krtc32gkhzcn3spc36a3ksbyjoykekcsx7bvmzj2mrxcmaxral2q-write-exec-wrappers"
          , "alias": "write_wrappers"
          , "transitive": "false"
          }
        , { "brick": "vjxlzrn6lje7peb2wiyior57it6egawfge3hoos2ctnlggkofvra-zstd"
          , "alias": "zstd"
          , "transitive": "true"
          }
        , { "brick": "2nguimja3ijn67ppduw4iymx3l63awsvfm3aeolh4huxhrtlelzq-xz"
          , "alias": "xz"
          , "transitive": "true"
          }
        , { "brick": "47zokkngsfutphq4c75jyibgp4htgwdbxcrgh5ufuwkgilcj7gyq-unzip"
          , "alias": "unzip"
          , "transitive": "true"
          }
        , { "brick": "62pd2iqc5djuyptrefmfnoyqs2h7sixqjxbe4j7def3if3gwm2aa-m4"
          , "alias": "m4"
          , "transitive": "true"
          }
        , { "brick": "6v64oxmhrixfku2kgw6taolvksk3cur6mm3anu6lhbjirbgfggxa-gzip"
          , "alias": "gzip"
          , "transitive": "true"
          }
        , { "brick": "nfvskclt3cgimqtrw2eazstdf454q3p2r7hoevkjczb56ozzmtpq-gpatch"
          , "alias": "gpatch"
          , "transitive": "true"
          }
        , { "brick": "mg7bty4vjnnybn7lxd3p5q2g2hgzp6szy5r5j3r3u5n6irldveoa-gnu-sed"
          , "alias": "gnu_sed"
          , "transitive": "true"
          }
        , { "brick": "sz7scme2he4n477gpccq6kdizt6dbkntlfh3ddo67dypl7ksxtda-gnu-make"
          , "alias": "gnu_make"
          , "transitive": "true"
          }
        , { "brick": "d4oam742ndjdswucg5txv67tvctcjxom6yt2e26fii37al2wmzra-gawk"
          , "alias": "gawk"
          , "transitive": "true"
          }
        , { "brick": "xusxkpuh7w545vzs7pihbqmmndx52nymd5tqatmphbfm3l4zkziq-findutils"
          , "alias": "findutils"
          , "transitive": "true"
          }
        , { "brick": "ebznmwxxmhegjnbtc25szhhelhtux4cplgjscwjux4zxx7eekxea-diffutils"
          , "alias": "diffutils"
          , "transitive": "true"
          }
        , { "brick": "35lunc52cnmxhsxgrbztpvoejb6h2oewsxbihfsqsdo2bifm7kmq-perl"
          , "alias": "perl"
          , "transitive": "true"
          }
        , { "brick": "l4jt55j5qqsfscqsfwk2ckk7iyj2hrv2kjpqf66rjw3ilg2psx7q-grep"
          , "alias": "grep"
          , "transitive": "true"
          }
        , { "brick": "re6wlad2vnmfnf4nrcravillaiaut6pzebyaadwgkkgh5g7tuvka-git"
          , "alias": "git"
          , "transitive": "true"
          }
        , { "brick": "evcmryzqpefcunpqoyutqjscwvwtbvogsntb5n47lbpuaohw6m6q-gcc"
          , "alias": "gcc"
          , "transitive": "true"
          }
        , { "brick": "npt4pmjgvneqxtb3xvqge7ptntgjmjfz6vkendkmbfzspxpabvia-bzip2"
          , "alias": "bzip2"
          , "transitive": "true"
          }
        , { "brick": "i7omhhjzayh7bxlnhyvcs4274b2uaunsyh76pixjh7ixvnpcrp2a-bison"
          , "alias": "bison"
          , "transitive": "true"
          }
        , { "brick": "u6gpy6gfub4xlqrvjvqq4dtfafufxauxuste7lkmoc6vvpkuzp2q-gnu-tar"
          , "alias": "gnu_tar"
          , "transitive": "true"
          }
        , { "brick": "r2agl7x5h3nujgwasxf2d2vcopngkncwb6ronredz5n7o6va5s3a-coreutils"
          , "alias": "coreutils"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "bin" }
        , { "name": "env" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p \"$bin\"\n"
              , "\n"
              , "# === Bash ===\n"
              , "\"$write_wrappers\" aliases \"$bin\" \"${bash[bin]}/bash\" \"${bash[bin]}/bash\" bash sh\n"
              , "\n"
              , "# === Coreutils ===\n"
              , "# Create wrappers for all coreutils commands\n"
              , "\"$write_wrappers\" coreutils \"$bin\" \"${bash[bin]}/bash\" \"${coreutils[bin]}\"\n"
              , "\n"
              , "# === curl ===\n"
              , "# curl needs SSL_CERT_FILE to find CA certificates\n"
              , "curl_env=\"export SSL_CERT_FILE=\\\"$ca_certs\\\"\"\n"
              , "\"$write_wrappers\" single \"$bin/curl\" \"${bash[bin]}/bash\" \"$curl\" \"$curl_env\"\n"
              , "\n"
              , "# === Git ===\n"
              , "\"$write_wrappers\" single \"$bin/git\" \"${bash[bin]}/bash\" \"${git[bin]}/git\"\n"
              , "\n"
              , "# === GNU tar ===\n"
              , "\"$write_wrappers\" aliases \"$bin\" \"${bash[bin]}/bash\" \"$gnu_tar\" tar gtar\n"
              , "\n"
              , "# === gzip ===\n"
              , "\"$write_wrappers\" single \"$bin/gzip\" \"${bash[bin]}/bash\" \"${gzip[bin]}/gzip\"\n"
              , "\"$write_wrappers\" single \"$bin/gunzip\" \"${bash[bin]}/bash\" \"${gzip[bin]}/gunzip\"\n"
              , "\"$write_wrappers\" single \"$bin/zcat\" \"${bash[bin]}/bash\" \"${gzip[bin]}/zcat\"\n"
              , "\n"
              , "# === xz ===\n"
              , "\"$write_wrappers\" single \"$bin/xz\" \"${bash[bin]}/bash\" \"$xz\"\n"
              , "for cmd in xzcat unxz lzma lzmadec lzcat; do\n"
              , "  \"$write_wrappers\" single \"$bin/$cmd\" \"${bash[bin]}/bash\" \"${xz[bin]}/$cmd\"\n"
              , "done\n"
              , "\n"
              , "# === zstd ===\n"
              , "\"$write_wrappers\" single \"$bin/zstd\" \"${bash[bin]}/bash\" \"$zstd\"\n"
              , "for cmd in zstdcat unzstd zstdmt; do\n"
              , "  \"$write_wrappers\" single \"$bin/$cmd\" \"${bash[bin]}/bash\" \"${zstd[bin]}/$cmd\"\n"
              , "done\n"
              , "\n"
              , "# === GNU sed ===\n"
              , "\"$write_wrappers\" single \"$bin/sed\" \"${bash[bin]}/bash\" \"$gnu_sed\"\n"
              , "\n"
              , "# === grep ===\n"
              , "\"$write_wrappers\" single \"$bin/grep\" \"${bash[bin]}/bash\" \"${grep[bin]}/grep\"\n"
              , "\"$write_wrappers\" single \"$bin/egrep\" \"${bash[bin]}/bash\" \"${grep[bin]}/egrep\"\n"
              , "\"$write_wrappers\" single \"$bin/fgrep\" \"${bash[bin]}/bash\" \"${grep[bin]}/fgrep\"\n"
              , "\n"
              , "# === GNU make ===\n"
              , "\"$write_wrappers\" aliases \"$bin\" \"${bash[bin]}/bash\" \"$gnu_make\" make gmake\n"
              , "\n"
              , "# === gpatch ===\n"
              , "\"$write_wrappers\" aliases \"$bin\" \"${bash[bin]}/bash\" \"$gpatch\" patch gpatch\n"
              , "\n"
              , "# === findutils ===\n"
              , "for cmd in find xargs; do\n"
              , "  if [ -f \"${findutils[bin]}/$cmd\" ]; then\n"
              , "    \"$write_wrappers\" single \"$bin/$cmd\" \"${bash[bin]}/bash\" \"${findutils[bin]}/$cmd\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# === bzip2 ===\n"
              , "\"$write_wrappers\" single \"$bin/bzip2\" \"${bash[bin]}/bash\" \"${bzip2[bin]}/bzip2\"\n"
              , "\"$write_wrappers\" single \"$bin/bunzip2\" \"${bash[bin]}/bash\" \"${bzip2[bin]}/bunzip2\"\n"
              , "\"$write_wrappers\" single \"$bin/bzcat\" \"${bash[bin]}/bash\" \"${bzip2[bin]}/bzcat\"\n"
              , "\n"
              , "# === unzip ===\n"
              , "\"$write_wrappers\" single \"$bin/unzip\" \"${bash[bin]}/bash\" \"$unzip\"\n"
              , "\n"
              , "# === perl ===\n"
              , "perl_env=\"source \\\"${perl[env]}\\\"\"\n"
              , "\"$write_wrappers\" single \"$bin/perl\" \"${bash[bin]}/bash\" \"${perl[bin]}/perl\" \"$perl_env\"\n"
              , "\n"
              , "# === gawk ===\n"
              , "\"$write_wrappers\" aliases \"$bin\" \"${bash[bin]}/bash\" \"$gawk\" awk gawk\n"
              , "\n"
              , "# === diffutils ===\n"
              , "for cmd in diff cmp diff3 sdiff; do\n"
              , "  if [ -f \"${diffutils[bin]}/$cmd\" ]; then\n"
              , "    \"$write_wrappers\" single \"$bin/$cmd\" \"${bash[bin]}/bash\" \"${diffutils[bin]}/$cmd\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# === m4 ===\n"
              , "\"$write_wrappers\" single \"$bin/m4\" \"${bash[bin]}/bash\" \"$m4\"\n"
              , "\n"
              , "# === bison ===\n"
              , "bison_env=\"export BISON_PKGDATADIR=\\\"${bison[share]}/bison\\\"\n"
              , "export M4=\\\"$m4\\\"\"\n"
              , "\"$write_wrappers\" single \"$bin/bison\" \"${bash[bin]}/bash\" \"${bison[bin]}/bison\" \"$bison_env\"\n"
              , "\"$write_wrappers\" single \"$bin/yacc\" \"${bash[bin]}/bash\" \"${bison[bin]}/yacc\" \"$bison_env\"\n"
              , "\n"
              , "# === GCC toolchain ===\n"
              , "gcc_env=\"export LD_LIBRARY_PATH=\\\"${gcc[lib]}\\${LD_LIBRARY_PATH:+:}\\${LD_LIBRARY_PATH:-}\\\"\"\n"
              , "for cmd in gcc g++ cc cpp c89 c99; do\n"
              , "  if [ -f \"${gcc[bin]}/$cmd\" ]; then\n"
              , "    \"$write_wrappers\" single \"$bin/$cmd\" \"${bash[bin]}/bash\" \"${gcc[bin]}/$cmd\" \"$gcc_env\"\n"
              , "  fi\n"
              , "done\n"
              , "for cmd in as ld ar nm ranlib strip objdump objcopy readelf strings size; do\n"
              , "  if [ -f \"${gcc[bin]}/$cmd\" ]; then\n"
              , "    \"$write_wrappers\" single \"$bin/$cmd\" \"${bash[bin]}/bash\" \"${gcc[bin]}/$cmd\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# === Environment setup script ===\n"
              , "{\n"
              , "  echo \"# Bootstrap environment setup script for Linux\"\n"
              , "  echo \"# Source this file to set up environment variables for builds\"\n"
              , "  echo \"export PATH=\\\"$bin\\${PATH:+:}\\${PATH:-}\\\"\"\n"
              , "  echo \"export SSL_CERT_FILE=\\\"$ca_certs\\\"\"\n"
              , "  echo \"export CC=\\\"${gcc[bin]}/gcc\\\"\"\n"
              , "  echo \"export CXX=\\\"${gcc[bin]}/g++\\\"\"\n"
              , "  echo \"export AR=\\\"${gcc[bin]}/ar\\\"\"\n"
              , "  echo \"export RANLIB=\\\"${gcc[bin]}/ranlib\\\"\"\n"
              , "  echo \"source \\\"${perl[env]}\\\"\"\n"
              , "} > \"$env\"\n"
              , "\n"
              , "printf %s \"rubble wrapper probe\" | \"$bin/gzip\" -c > \"$TMP/wrapper-probe.gz\"\n"
              , "actual=\"$(\"$bin/gunzip\" -c \"$TMP/wrapper-probe.gz\")\"\n"
              , "test \"$actual\" = \"rubble wrapper probe\"\n"
              , "rm -f \"$TMP/wrapper-probe.gz\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  }
}
