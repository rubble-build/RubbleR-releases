          , "alias": "zlib_apk"
          , "transitive": "false"
          }
        , { "brick": "gpd75vrjncv57fv3fzdfuoagqwgyqjwuizvdth2pdg7hv2q4lv5a-rubble-script-shebang"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$script\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "cmdaozrcvaymmdfw3jodg7rrc4qwmaqyx6q3jj6u6nsie32hvdxq-publish-output-directory"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$script\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "dhzowymraqoa262lv45rzgrpjrqdedusoctmkao7qctbpck3qiva-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "kovec6hpuborsbsvc7t6mvkfvwylfdlf4evnpad24hnwoyiflz5q-musl-dev-1.2.5-r11.apk"
          , "alias": "musl_dev_apk"
          , "transitive": "false"
          }
        , { "brick": "jwhfx26nkv24vmnfckbvccnpwdkzwfvxcjty7dhntghaemjlpfxq-mpfr4-4.2.1-r0.apk"
          , "alias": "mpfr_apk"
          , "transitive": "false"
          }
        , { "brick": "fg32tsmkrioagedunckpr37qz35rn4b7obxt3wsbxx56ajpxviza-mpc1-1.3.1-r1.apk"
          , "alias": "mpc_apk"
          , "transitive": "false"
          }
        , { "brick": "3exo4yvcmu45p6oevi6u6v7fkppbt2fohg5gpkfvwhjykut7m3wa-linux-headers-6.6-r1.apk"
          , "alias": "linux_headers_apk"
          , "transitive": "false"
          }
        , { "brick": "fzsocvqoawb6atzh5tfjxgahm2yualfjxwxicd55hjyf4gfjo5da-libstdc__-dev-14.2.0-r4.apk"
          , "alias": "libstdcpp_dev_apk"
          , "transitive": "false"
          }
        , { "brick": "hwudtbqp6mtqd433zl777ixamegzf5s6pqjc3vbkw4yy7ca6rpzq-libstdc__-14.2.0-r4.apk"
          , "alias": "libstdcpp_apk"
          , "transitive": "false"
          }
        , { "brick": "naa2ad3mxbwsl6syyyeikeu6srwar3mxn4lv6faf72kx6hjpq72q-libgomp-14.2.0-r4.apk"
          , "alias": "libgomp_apk"
          , "transitive": "false"
          }
        , { "brick": "bsczck3itaibqqkhhwkkzdh3fv5i477527aika7gfcttdyn6chhq-libgcc-14.2.0-r4.apk"
          , "alias": "libgcc_apk"
          , "transitive": "false"
          }
        , { "brick": "vq3sirpitu5prsi2ig3ld3d7am7x6cxjxscc4qchsiecywgz3bfa-libatomic-14.2.0-r4.apk"
          , "alias": "libatomic_apk"
          , "transitive": "false"
          }
        , { "brick": "mvw4balnruevggsruaxcd7m3dye6dlbrsjshobcplnic3svvd4rq-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "ktbdwi3xid4ywlz6il2qlgx67aclu2t5gljy527g7vdnv6h7gaha-jansson-2.14-r4.apk"
          , "alias": "jansson_apk"
          , "transitive": "false"
          }
        , { "brick": "n6vtqu3bxkksa6hlrwirri6entermnuofp2sdqcfcrzxarqrr3hq-isl26-0.26-r1.apk"
          , "alias": "isl_apk"
          , "transitive": "false"
          }
        , { "brick": "ho552ymbr5wqlkbb7xckcvqfjs5fd4ytbrf5rjp3vaqnwocxhx5q-gmp-6.3.0-r2.apk"
          , "alias": "gmp_apk"
          , "transitive": "false"
          }
        , { "brick": "saxdsta5ltm7iomdgyx3f23uma6qmu7hz674djpkjgbgi76tsisa-gcc-14.2.0-r4.apk"
          , "alias": "gcc_apk"
          , "transitive": "false"
          }
        , { "brick": "fu4gjf2vujnnxzbws5i2w57yneqm7tmgiqzxodte6s6rf74vchrq-g__-14.2.0-r4.apk"
          , "alias": "gpp_apk"
          , "transitive": "false"
          }
        , { "brick": "sgdyuezwsbzpgusurjxb7bvquikinj455qz7q5c2emyrynor4f3q-binutils-2.43.1-r3.apk"
          , "alias": "binutils_apk"
          , "transitive": "false"
          }
        , { "brick": "7gaiswvomctprmbv5i6dhxav3urpsmceezmwy52qv42yok44lygq-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "defmfedonkfkblaqtfzjs7kvoq2u5k53xo3zzl43it7q634ax7ja-collect-shared-libraries"
          , "alias": "collect_libraries"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "gcc_triple"
          , "value": "aarch64-alpine-linux-musl"
          }
        , { "name": "gcc_version"
          , "value": "14.2.0"
          }
        , { "name": "musl_interpreter"
          , "value": "ld-musl-aarch64.so.1"
          }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        , { "name": "include" }
        , { "name": "lib" }
        , { "name": "libexec" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p \"$out/bin\" \"$out/lib\" \"$out/include\" \"$out/libexec\" extract\n"
              , "\n"
              , "for apk in \"$gcc_apk\" \"$gpp_apk\" \"$binutils_apk\" \"$musl_dev_apk\" \\\n"
              , "           \"$linux_headers_apk\" \"$libstdcpp_dev_apk\" \"$libgcc_apk\" \\\n"
              , "           \"$libstdcpp_apk\" \"$libgomp_apk\" \"$libatomic_apk\" \"$gmp_apk\" \\\n"
              , "           \"$mpfr_apk\" \"$mpc_apk\" \"$isl_apk\" \"$zlib_apk\" \"$jansson_apk\" \\\n"
              , "           \"$zstd_libs_apk\"; do\n"
              , "  tar -xzf \"$apk\" -C extract 2>/dev/null || true\n"
              , "done\n"
              , "\n"
              , "# Create musl libc symlink pointing to the runtime interpreter\n"
              , "ln -sf \"$ld_musl\" \"$out/lib/$musl_interpreter\"\n"
              , "ln -sf \"$musl_interpreter\" \"$out/lib/libc.${musl_interpreter#ld-}\"\n"
              , "\n"
              , "# Copy all shared libraries\n"
              , "\"$collect_libraries\" \"$out/lib\" recursive ignore extract\n"
              , "\n"
              , "# Copy static libraries and object files from musl-dev\n"
              , "find extract/usr/lib -name \"*.a\" -exec cp -a {} \"$out/lib/\" \\; 2>/dev/null || true\n"
              , "find extract/usr/lib -name \"*.o\" -exec cp -a {} \"$out/lib/\" \\; 2>/dev/null || true\n"
              , "\n"
              , "# Copy GCC-specific libraries (crt*.o files, static libs)\n"
              , "if [ -d \"extract/usr/lib/gcc\" ]; then\n"
              , "  cp -a extract/usr/lib/gcc \"$out/lib/gcc\"\n"
              , "fi\n"
              , "if [ -d \"extract/usr/lib/bfd-plugins\" ]; then\n"
              , "  cp -a extract/usr/lib/bfd-plugins \"$out/lib/\"\n"
              , "fi\n"
              , "\n"
              , "# Copy binaries\n"
              , "for f in extract/usr/bin/*; do\n"
              , "  if [ -f \"$f\" ] && [ ! -L \"$f\" ]; then\n"
              , "    cp \"$f\" \"$out/bin/\"\n"
              , "  elif [ -L \"$f\" ]; then\n"
              , "    cp -a \"$f\" \"$out/bin/\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# Copy GCC libexec (cc1, cc1plus, collect2, etc.)\n"
              , "if [ -d \"extract/usr/libexec/gcc\" ]; then\n"
              , "  cp -a extract/usr/libexec/gcc \"$out/libexec/gcc\"\n"
              , "fi\n"
              , "\n"
              , "# Copy headers\n"
              , "if [ -d \"extract/usr/include\" ]; then\n"
              , "  cp -a extract/usr/include/* \"$out/include/\" 2>/dev/null || true\n"
              , "fi\n"
              , "\n"
              , "# Patch binutils ELF binaries (PIE binaries — patchelf works reliably)\n"
              , "for f in \"$out/bin/as\" \"$out/bin/ld\" \"$out/bin/ld.bfd\" \"$out/bin/ar\" \\\n"
              , "         \"$out/bin/nm\" \"$out/bin/ranlib\" \"$out/bin/objcopy\" \"$out/bin/objdump\" \\\n"
              , "         \"$out/bin/readelf\" \"$out/bin/strip\" \"$out/bin/strings\" \"$out/bin/size\" \\\n"
              , "         \"$out/bin/addr2line\" \"$out/bin/c++filt\" \"$out/bin/dwp\" \"$out/bin/elfedit\" \\\n"
              , "         \"$out/bin/gprof\"; do\n"
              , "  if [ -f \"$f\" ] && [ ! -L \"$f\" ]; then\n"
              , "    \"$patchelf\" --set-interpreter \"$ld_musl\" --set-rpath \"$out/lib\" \"$f\" 2>/dev/null || true\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# GCC/G++/CPP and libexec internals (cc1, cc1plus, collect2, lto-wrapper, etc.)\n"
              , "# crash when patchelf'd on aarch64 (EXEC binaries with long interpreter paths).\n"
              , "# Use ld-musl wrappers that invoke the store-internal dynamic linker directly.\n"
              , "GCC_LIBEXEC=\"$out/libexec/gcc/${gcc_triple}/${gcc_version}\"\n"
              , "\n"
              , "# Rename real GCC/G++ binaries\n"
              , "for cmd in gcc g++ cpp; do\n"
              , "  if [ -f \"$out/bin/$cmd\" ] && [ ! -L \"$out/bin/$cmd\" ]; then\n"
              , "    mv \"$out/bin/$cmd\" \"$out/bin/${cmd}.real\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# Create wrapper scripts using ld-musl interpreter\n"
              , "for cmd in gcc g++ cpp cc c89 c99 c++; do\n"
              , "  real_cmd=\"$cmd\"\n"
              , "  case \"$cmd\" in\n"
              , "    cc|c89|c99) real_cmd=\"gcc\" ;;\n"
              , "    c++) real_cmd=\"g++\" ;;\n"
              , "  esac\n"
              , "  rm -f \"$out/bin/$cmd\"\n"
              , "  printf '%s\\n' \"#!${bash[bin]}/bash\" > \"$out/bin/$cmd\"\n"
              , "  printf '%s\\n' \"exec \\\"$ld_musl\\\" --library-path \\\"$out/lib\\\" \\\"$out/bin/${real_cmd}.real\\\" \\\"\\$@\\\"\" >> \"$out/bin/$cmd\"\n"
              , "  chmod +x \"$out/bin/$cmd\"\n"
              , "done\n"
              , "\n"
              , "# Wrap libexec binaries (cc1, cc1plus, collect2, lto-wrapper, etc.)\n"
              , "find \"$GCC_LIBEXEC\" -maxdepth 1 -type f | while read -r f; do\n"
              , "  case \"$(basename \"$f\")\" in\n"
              , "    *.so|*.so.*) continue ;;\n"
              , "  esac\n"
              , "  if \"$patchelf\" --print-interpreter \"$f\" >/dev/null 2>&1; then\n"
              , "    mv \"$f\" \"${f}.real\"\n"
              , "    printf '%s\\n' \"#!${bash[bin]}/bash\" > \"$f\"\n"
              , "    printf '%s\\n' \"exec \\\"$ld_musl\\\" --library-path \\\"$out/lib\\\" \\\"${f}.real\\\" \\\"\\$@\\\"\" >> \"$f\"\n"
              , "    chmod +x \"$f\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# Also wrap gcc-ar, gcc-nm, gcc-ranlib, gcov, gcov-dump, gcov-tool, lto-dump\n"
              , "for cmd in gcc-ar gcc-nm gcc-ranlib gcov gcov-dump gcov-tool lto-dump; do\n"
              , "  if [ -f \"$out/bin/$cmd\" ] && [ ! -L \"$out/bin/$cmd\" ]; then\n"
              , "    mv \"$out/bin/$cmd\" \"$out/bin/${cmd}.real\"\n"
              , "    printf '%s\\n' \"#!${bash[bin]}/bash\" > \"$out/bin/$cmd\"\n"
              , "    printf '%s\\n' \"exec \\\"$ld_musl\\\" --library-path \\\"$out/lib\\\" \\\"$out/bin/${cmd}.real\\\" \\\"\\$@\\\"\" >> \"$out/bin/$cmd\"\n"
              , "    chmod +x \"$out/bin/$cmd\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# Update cross-compiler symlinks to point to wrapper scripts\n"
              , "for f in \"$out/bin/${gcc_triple}-\"*; do\n"
              , "  if [ -L \"$f\" ]; then\n"
              , "    target=$(readlink \"$f\")\n"
              , "    case \"$target\" in\n"
              , "      gcc|g++|cpp)\n"
              , "        rm \"$f\"\n"
              , "        ln -s \"$target\" \"$f\"\n"
              , "        ;;\n"
              , "    esac\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# Patch shared libraries to fix RPATH (exclude dynamic linker symlink)\n"
              , "find \"$out\" -name \"*.so*\" -type f ! -name \"ld-musl-*\" ! -name \"libc.musl-*\" | while read -r f; do\n"
              , "  if \"$out/bin/readelf\" -h \"$f\" >/dev/null 2>&1; then\n"
              , "    chmod u+w \"$f\" 2>/dev/null || true\n"
              , "    \"$patchelf\" --set-rpath \"$out/lib\" \"$f\" 2>/dev/null || \\\n"
              , "      echo \"  WARN: patchelf rpath failed on $(basename \"$f\")\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "rubble_script_shebang_register \"${bash[bin]}/bash\" sh bash\n"
              , "if [ -d \"$GCC_LIBEXEC/install-tools\" ]; then\n"
              , "  rubble_script_shebang_rewrite_all --strict --all \"$GCC_LIBEXEC/install-tools\"\n"
              , "fi\n"
              , "\n"
              , "# Do not patch Alpine GCC compiler executables themselves: cc1 can crash\n"
              , "# after PT_INTERP growth. Wrap every kernel-invokable musl ELF instead and\n"
              , "# keep the real payload non-executable so it cannot fall back to /lib.\n"
              , "find \"$out/bin\" \"$GCC_LIBEXEC\" -type f | while read -r f; do\n"
              , "  case \"$(basename \"$f\")\" in\n"
              , "    *.so|*.so.*) continue ;;\n"
              , "  esac\n"
              , "  if ! \"$patchelf\" --print-interpreter \"$f\" >/dev/null 2>&1; then\n"
              , "    continue\n"
              , "  fi\n"
              , "  case \"$f\" in\n"
              , "    *.real)\n"
              , "      chmod a-x \"$f\"\n"
              , "      ;;\n"
              , "    *)\n"
              , "      real=\"${f}.real\"\n"
              , "      mv \"$f\" \"$real\"\n"
              , "      printf '%s\\n' \"#!${bash[bin]}/bash\" > \"$f\"\n"
              , "      printf '%s\\n' \"exec \\\"$ld_musl\\\" --library-path \\\"$out/lib\\\" \\\"$real\\\" \\\"\\$@\\\"\" >> \"$f\"\n"
              , "      chmod +x \"$f\"\n"
              , "      chmod a-x \"$real\"\n"
              , "      ;;\n"
              , "  esac\n"
              , "done"
              ]
            , "format": "text"
            }
          }
        , { "shell": {
              "value": [
                "publish_output_directory \"$out/bin\" \"$bin\"\n"
              , "publish_output_directory \"$out/lib\" \"$lib\"\n"
              , "publish_output_directory \"$out/include\" \"$include\"\n"
              , "publish_output_directory \"$out/libexec\" \"$libexec\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "npt4pmjgvneqxtb3xvqge7ptntgjmjfz6vkendkmbfzspxpabvia-bzip2":
      { "id": "npt4pmjgvneqxtb3xvqge7ptntgjmjfz6vkendkmbfzspxpabvia-bzip2"
      , "name": "bzip2"
      , "platform": "aarch64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "dhzowymraqoa262lv45rzgrpjrqdedusoctmkao7qctbpck3qiva-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "mvw4balnruevggsruaxcd7m3dye6dlbrsjshobcplnic3svvd4rq-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "eukfornac6zeehc5o4izhyj6vslke65etzbod6j3x2u3w2igbi6q-bzip2-1.0.8-r6.apk"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "tyqosp4fpdd7pjacveojot6m2g5ls3hqljfqp4qerplz2kuwcvua-musl-install-tools"
          , "alias": "musl_tools"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar -xzf \"$src\" 2>/dev/null || true\n"
              , "\"${musl_tools[install]}\" usr/bin/bzip2 \"$out\" \"$patchelf\" \"$ld_musl\"\n"
              , "\"${musl_tools[link_commands]}\" \"$out\" \"$bin\" bzip2 bunzip2 bzcat\n"
              , "\n"
              , "expected='rubble bzip2 probe'\n"
              , "printf '%s' \"$expected\" | \"$out\" -c > \"$TMP/bzip2-probe.bz2\"\n"
              , "actual=\"$(\"$bin/bunzip2\" -c \"$TMP/bzip2-probe.bz2\")\"\n"
              , "test \"$actual\" = \"$expected\"\n"
              , "rm -f \"$TMP/bzip2-probe.bz2\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "i7omhhjzayh7bxlnhyvcs4274b2uaunsyh76pixjh7ixvnpcrp2a-bison":
      { "id": "i7omhhjzayh7bxlnhyvcs4274b2uaunsyh76pixjh7ixvnpcrp2a-bison"
      , "name": "bison"
      , "platform": "aarch64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
