{ "id": "vjxlzrn6lje7peb2wiyior57it6egawfge3hoos2ctnlggkofvra-zstd"
, "name": "zstd"
, "platform": "aarch64-linux"
, "rubble_home": "/var/lib/rubble"
, "inputs": [
    { "brick": "5vexncx3cian4rymupdaft3bwnvswvrzp6pcxohuilbll3lii53a-zstd-libs-1.5.6-r2.apk"
    , "alias": "zstd_libs_apk"
    , "transitive": "false"
    }
  , { "brick": "p437dghiaad2yb57qr2yhpsmwaw3z3jwfkdlsqaf6pgahrueysja-zstd-1.5.6-r2.apk"
    , "alias": "zstd_apk"
    , "transitive": "false"
    }
  , { "brick": "dhzowymraqoa262lv45rzgrpjrqdedusoctmkao7qctbpck3qiva-patchelf"
    , "alias": "patchelf"
    , "transitive": "false"
    }
  , { "brick": "mvw4balnruevggsruaxcd7m3dye6dlbrsjshobcplnic3svvd4rq-ld-musl.so"
    , "alias": "ld_musl"
    , "transitive": "true"
    }
  , { "brick": "tyqosp4fpdd7pjacveojot6m2g5ls3hqljfqp4qerplz2kuwcvua-musl-install-tools"
    , "alias": "musl_tools"
    , "transitive": "false"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  , { "name": "bin" }
  , { "name": "lib" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "mkdir -p zstd-extract zstdlibs-extract\n"
        , "tar -xzf \"$zstd_apk\" -C zstd-extract\n"
        , "tar -xzf \"$zstd_libs_apk\" -C zstdlibs-extract\n"
        , "\n"
        , "mkdir -p \"$lib\"\n"
        , "find zstdlibs-extract -name \"libzstd.so*\" -exec cp -a {} \"$lib/\" \\;\n"
        , "\n"
        , "\"${musl_tools[install]}\" zstd-extract/usr/bin/zstd \"$out\" \"$patchelf\" \"$ld_musl\" \"$lib\"\n"
        , "\"${musl_tools[link_commands]}\" \"$out\" \"$bin\" zstd zstdcat unzstd zstdmt\n"
        , "\n"
        , "# Verify\n"
        , "assert_needed() {\n"
        , "  elf=$1\n"
        , "  shift\n"
        , "  actual=$(\"$patchelf\" --print-needed \"$elf\" | LC_ALL=C sort)\n"
        , "  expected=$(printf '%s\\n' \"$@\" | LC_ALL=C sort)\n"
        , "  test \"$actual\" = \"$expected\"\n"
        , "}\n"
        , "\n"
        , "musl_soname=$(\"$patchelf\" --print-soname \"$ld_musl\")\n"
        , "case \"$musl_soname\" in\n"
        , "  libc.musl-*.so.1) ;;\n"
        , "  *) false ;;\n"
        , "esac\n"
        , "\n"
        , "test \"$(\"$patchelf\" --print-interpreter \"$out\")\" = \"$ld_musl\"\n"
        , "test \"$(\"$patchelf\" --print-rpath \"$out\")\" = \"$lib\"\n"
        , "assert_needed \"$out\" libzstd.so.1 \"$musl_soname\"\n"
        , "\n"
        , "test -L \"$lib/libzstd.so.1\"\n"
        , "libzstd_target=$(readlink \"$lib/libzstd.so.1\")\n"
        , "case \"$libzstd_target\" in\n"
        , "  \"\"|/*|*/*) false ;;\n"
        , "esac\n"
        , "libzstd_real=\"$lib/$libzstd_target\"\n"
        , "test -f \"$libzstd_real\"\n"
        , "test ! -L \"$libzstd_real\"\n"
        , "test \"$(\"$patchelf\" --print-soname \"$libzstd_real\")\" = libzstd.so.1\n"
        , "assert_needed \"$libzstd_real\" \"$musl_soname\"\n"
        , "\n"
        , "printf '%s' 'rubble zstd probe' | \"$out\" --compress --stdout > \"$TMP/probe.zst\"\n"
        , "actual=\"$(\"$bin/unzstd\" --stdout \"$TMP/probe.zst\")\"\n"
        , "test \"$actual\" = 'rubble zstd probe'\n"
        , "rm -f \"$TMP/probe.zst\""
        ]
      , "format": "text"
      }
    }
  ]
