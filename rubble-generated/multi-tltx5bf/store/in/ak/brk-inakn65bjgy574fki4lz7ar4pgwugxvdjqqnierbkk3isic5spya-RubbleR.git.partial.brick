{ "id": "inakn65bjgy574fki4lz7ar4pgwugxvdjqqnierbkk3isic5spya-RubbleR.git.partial"
, "name": "RubbleR.git.partial"
, "src": {
    "repo": "https://github.com/chaifeng/RubbleR.git"
  , "commit": "5efd8695c06a4d672c51fd6b1f7027899c968797"
  , "paths": [
      "./rubble-web/ui/package-lock.json"
    , "./rubble-web/ui/package.json"
    ]
  }
, "inputs": [
    { "brick": "6vx2ce7jcj6wfra4xg2ykz6htsdkuvhh7uxbyr4gzlwvf2mlriua-rubble-src-checkout"
    , "alias": "rubble_src_checkout"
    , "transitive": "true"
    }
  , { "brick": "4x2uexqjoqs5unyb4fxpdus3ctebmhvqnuruhalsl5rdwt3k6naa-rubble-canonical-script"
    , "alias": "rubble_canonical_script"
    , "transitive": "false"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "RUBBLE_SRC_FETCH_MODE all_proxy http_proxy https_proxy no_proxy" }
  ]
, "var": [
    { "name": "__rubble_skip_src_split__"
    , "value": "true"
    }
  ]
, "outputs": [
    { "name": "dir" }
  , { "name": "archive__impure__" }
  , { "name": "script" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "mkdir \"$dir\"\n"
        , "echo \"${brick[src::commit]}\" > \"${dir}/.rubble-deferred\"\n"
        , "\n"
        , "mkdir \"$archive\"\n"
        , "echo \"${brick[src::commit]}\" > \"${archive}/.rubble-deferred\"\n"
        , "\n"
        , "source \"${rubble_canonical_script[script]}\"\n"
        , "\n"
        , "printf -v __rubble_source_repo '%q' \"${brick[src::remote]}\"\n"
        , "printf -v __rubble_source_commit '%q' \"${brick[src::commit]}\"\n"
        , "printf -v __rubble_source_paths '%q' \"${brick[src::paths]}\"\n"
        , "(\n"
        , "rubble_canonical_script << __EOF_SCRIPT_207__\n"
        , "repo=${__rubble_source_repo}\n"
        , "commit=${__rubble_source_commit}\n"
        , "paths=${__rubble_source_paths}\n"
        , "gitRepoCredential=\"\"\n"
        , "src_archive=\"$archive\"\n"
        , "inner_path=\"\"\n"
        , "deferred_marker=\".rubble-deferred\"\n"
        , "\n"
        , "if [[ -z \"\\${repo:-}\" || -z \"\\${commit:-}\" ]]; then\n"
        , "    echo \"Error: Missing repo or commit information\" >&2\n"
        , "    exit 1\n"
        , "fi\n"
        , "\n"
        , "source \"${rubble_src_checkout}\" \"\\${1:-\\${dir}}\" \"\\${@:2}\"\n"
        , "__EOF_SCRIPT_207__\n"
        , ") > \"$script\"\n"
        , "__log_info \"${brick[id]:0:7}-${brick[name]}: source script generated path=${script}\""
        ]
      , "format": "text"
      }
    }
  ]
