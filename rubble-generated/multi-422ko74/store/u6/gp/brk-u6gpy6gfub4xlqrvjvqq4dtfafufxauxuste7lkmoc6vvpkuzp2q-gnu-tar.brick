          { "shell": {
              "value": [
                "tar -xvf \"$src\"\n"
              , "mv bin/patchelf \"$out\"\n"
              , "mkdir -p \"$bin\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/patchelf\"\n"
              , "mv share \"$share\"\n"
              , "\"$out\" --version"
              ]
            , "format": "text"
