{ "id": "c5wbg5jn3pylcmup7sbxmniucuw6dzpkte46m6h7buk2xbxyxtsq-python3"
, "name": "python3"
, "platform": "aarch64-linux"
, "build_platform": "aarch64-linux"
, "rubble_home": "/var/lib/rubble"
, "inputs": [
    { "brick": "ayvlr7htt6lml5iosty2yuiuogndl4xwu27xkbizrjbocyts5nrq-zlib-1.3.2-r0.apk"
    , "alias": "zlib_apk"
    , "transitive": "false"
    }
  , { "brick": "rlqgbuxu4kleo257tmrhzkllhb6thfjrmbcsr6hkxf2cduly7vta-xz-libs-5.8.3-r0.apk"
