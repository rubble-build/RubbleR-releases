    }
  , { "brick": "qmdv4se7cy5zxuxhuq6la3h562eim3kyrj3eud44s2njzmqn3mlq-libpanelw-6.5_p20241006-r3.apk"
    , "alias": "libpanelw_apk"
    , "transitive": "false"
    }
  , { "brick": "ng2yhab3txqyfgtnrgwttzyliczkrx52jeu7skkoaxeu5d752ynq-libncursesw-6.5_p20241006-r3.apk"
    , "alias": "libncursesw_apk"
    , "transitive": "false"
    }
  , { "brick": "bsczck3itaibqqkhhwkkzdh3fv5i477527aika7gfcttdyn6chhq-libgcc-14.2.0-r4.apk"
    , "alias": "libgcc_apk"
    , "transitive": "false"
    }
  , { "brick": "emumr4qhmj3md4udqk36vvpcou3bcq2q6x47b2utro76mglanp6q-libffi-3.4.7-r0.apk"
    , "alias": "libffi_apk"
    , "transitive": "false"
    }
  , { "brick": "5hu5obb4yrhcphlmjq4eze7rbdrnkszt7o2obqnpvtuehzgqdqoa-libexpat-2.8.4-r0.apk"
    , "alias": "libexpat_apk"
    , "transitive": "false"
    }
  , { "brick": "zkj7262l7rctago4tw4edylztcehl6bcvsxrow4o4lpqurjcftdq-libcrypto3-3.3.7-r0.apk"
    , "alias": "libcrypto3_apk"
    , "transitive": "false"
    }
  , { "brick": "kqoaqdowlcmrluolokiygo33evr47gordg5y3gqjf4etscxnee2a-libbz2-1.0.8-r6.apk"
    , "alias": "libbz2_apk"
    , "transitive": "false"
    }
  , { "brick": "65xn763kfhf7ye2ax5rr3hjotrij3qjagkddvfhqarwrt2a7mnha-ld-musl.so"
    , "alias": "ld_musl"
    , "transitive": "true"
    }
  , { "brick": "e5bidgxbvr5crgxvo3tckxld466txu5dxi674pplgncc4fifmkva-gdbm-1.24-r0.apk"
    , "alias": "gdbm_apk"
    , "transitive": "false"
    }
  , { "brick": "yecbppbe2hram3gythftkgn6mwelxq6l42vejdrjy3czbotcwmoq-bash"
    , "alias": "bash"
    , "transitive": "true"
    }
  , { "brick": "qj7s4kfeu7lleafbwujkfsjkts575oc7v5agukewx2ic3y6b6mdq-coreutils"
    , "alias": "coreutils"
    , "transitive": "true"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "var": [
    { "name": "musl_interpreter"
    , "value": "ld-musl-aarch64.so.1"
    }
  , { "name": "python_version"
    , "value": "3.12"
    }
  ]
, "outputs": [
    { "name": "out" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "mkdir -p \"$out/bin\" \"$out/lib\" \"$out/share\" extract\n"
        , "\n"
        , "echo \"=== Extracting Alpine Python packages ===\"\n"
        , "for apk in \"$python3_apk\" \"$libbz2_apk\" \"$libcrypto3_apk\" \"$libssl3_apk\" \\\n"
        , "           \"$libexpat_apk\" \"$libffi_apk\" \"$gdbm_apk\" \"$xz_libs_apk\" \\\n"
        , "           \"$mpdecimal_apk\" \"$libncursesw_apk\" \"$libpanelw_apk\" \\\n"
        , "           \"$readline_apk\" \"$sqlite_libs_apk\" \"$zlib_apk\" \"$libgcc_apk\" \\\n"
        , "           \"$libstdcpp_apk\"; do\n"
        , "  echo \"  Extracting $(basename \"$apk\")...\"\n"
        , "  tar -xzf \"$apk\" -C extract\n"
        , "done\n"
        , "\n"
        , "echo \"=== Installing Python runtime files ===\"\n"
        , "ln -sf \"$ld_musl\" \"$out/lib/$musl_interpreter\"\n"
        , "ln -sf \"$musl_interpreter\" \"$out/lib/libc.${musl_interpreter#ld-}\"\n"
        , "\n"
        , "for libdir in extract/lib extract/usr/lib; do\n"
        , "  if [ -d \"$libdir\" ]; then\n"
        , "    find \"$libdir\" -maxdepth 1 -name \"*.so*\" -type f -exec cp -a {} \"$out/lib/\" \\;\n"
        , "    find \"$libdir\" -maxdepth 1 -name \"*.so*\" -type l -exec cp -a {} \"$out/lib/\" \\;\n"
        , "  fi\n"
        , "done\n"
        , "\n"
        , "cp -a \"extract/usr/lib/python${python_version}\" \"$out/lib/\"\n"
        , "cp -a extract/usr/share/* \"$out/share/\" 2>/dev/null || true\n"
        , "cp \"extract/usr/bin/python${python_version}\" \"$out/bin/python${python_version}.bin\"\n"
        , "chmod +x \"$out/bin/python${python_version}.bin\"\n"
        , "\n"
        , "echo \"=== Patching Python ELF files ===\"\n"
        , "\"$patchelf\" --set-interpreter \"$ld_musl\" --set-rpath \"$out/lib\" \"$out/bin/python${python_version}.bin\"\n"
        , "find \"$out/lib\" -type f \\( -name \"*.so\" -o -name \"*.so.*\" \\) | while read -r elf_file; do\n"
        , "  chmod u+w \"$elf_file\" 2>/dev/null || true\n"
        , "  if \"$patchelf\" --print-rpath \"$elf_file\" >/dev/null 2>&1; then\n"
        , "    \"$patchelf\" --set-rpath \"$out/lib\" \"$elf_file\"\n"
        , "  fi\n"
        , "done\n"
        , "\n"
        , "create_python_wrapper() {\n"
        , "  local wrapper_path=\"$1\"\n"
        , "  {\n"
        , "    printf '#!%s\\n' \"$bash/bin/bash\"\n"
        , "    printf 'PYTHON_HOME=\"%s\"\\n' \"$out\"\n"
        , "    printf 'export PYTHONHOME=\"$PYTHON_HOME\"\\n'\n"
        , "    printf 'export PYTHONPATH=\"$PYTHON_HOME/lib/python%s${PYTHONPATH:+:}${PYTHONPATH:-}\"\\n' \"$python_version\"\n"
        , "    printf 'export LD_LIBRARY_PATH=\"$PYTHON_HOME/lib${LD_LIBRARY_PATH:+:}${LD_LIBRARY_PATH:-}\"\\n'\n"
        , "    printf 'exec \"$PYTHON_HOME/bin/python%s.bin\" \"$@\"\\n' \"$python_version\"\n"
        , "  } > \"$wrapper_path\"\n"
        , "  chmod +x \"$wrapper_path\"\n"
        , "}\n"
        , "\n"
        , "create_python_wrapper \"$out/bin/python\"\n"
        , "create_python_wrapper \"$out/bin/python3\"\n"
        , "create_python_wrapper \"$out/bin/python${python_version}\"\n"
        , "\n"
        , "require_line_equals() {\n"
        , "  local file=\"$1\" expected=\"$2\" line\n"
        , "  while IFS= read -r line || [ -n \"$line\" ]; do\n"
        , "    if [ \"$line\" = \"$expected\" ]; then\n"
        , "      return 0\n"
        , "    fi\n"
        , "  done < \"$file\"\n"
        , "  echo \"Expected line not found in $file: $expected\" >&2\n"
        , "  exit 1\n"
        , "}\n"
        , "\n"
        , "require_file_contains() {\n"
        , "  local file=\"$1\" needle=\"$2\" line\n"
        , "  while IFS= read -r line || [ -n \"$line\" ]; do\n"
        , "    if [[ \"$line\" == *\"$needle\"* ]]; then\n"
        , "      return 0\n"
        , "    fi\n"
        , "  done < \"$file\"\n"
        , "  echo \"Expected text not found in $file: $needle\" >&2\n"
        , "  exit 1\n"
        , "}\n"
        , "\n"
        , "require_file_not_contains() {\n"
        , "  local file=\"$1\" needle=\"$2\" line\n"
        , "  while IFS= read -r line || [ -n \"$line\" ]; do\n"
        , "    if [[ \"$line\" == *\"$needle\"* ]]; then\n"
        , "      echo \"Unexpected text in $file: $needle\" >&2\n"
        , "      echo \"Offending line: $line\" >&2\n"
        , "      exit 1\n"
        , "    fi\n"
        , "  done < \"$file\"\n"
        , "}\n"
        , "\n"
        , "normalize_make_var() {\n"
        , "  local file=\"$1\" key=\"$2\" value=\"$3\" expected tab\n"
        , "  tab=\"$(printf '\\t')\"\n"
        , "  expected=\"${key}=${tab}${value}\"\n"
        , "  sed -i \"s|^${key}[[:space:]]*=.*|${expected}|\" \"$file\"\n"
        , "  require_line_equals \"$file\" \"$expected\"\n"
        , "}\n"
        , "\n"
        , "normalize_sysconfig_var() {\n"
        , "  local file=\"$1\" key=\"$2\" value=\"$3\" expected\n"
        , "  expected=\"    '${key}': '${value}',\"\n"
        , "  sed -i \"s|^[[:space:]]*'${key}': .*|${expected}|\" \"$file\"\n"
        , "  require_line_equals \"$file\" \"$expected\"\n"
        , "}\n"
        , "\n"
        , "check_public_python_config_file() {\n"
        , "  local file=\"$1\"\n"
        , "  require_file_not_contains \"$file\" \"bootstrap-build-tools\"\n"
        , "  require_file_not_contains \"$file\" \"/usr/bin/install\"\n"
        , "  require_file_not_contains \"$file\" \"/usr/bin/mkdir\"\n"
        , "  require_file_not_contains \"$file\" \"./install-sh -c -d\"\n"
        , "}\n"
        , "\n"
        , "echo \"=== Normalizing Python runtime build configuration ===\"\n"
        , "runtime_sh=\"$bash/bin/sh\"\n"
        , "runtime_install=\"$coreutils/bin/install\"\n"
        , "runtime_mkdir=\"$coreutils/bin/mkdir\"\n"
        , "test -x \"$runtime_sh\"\n"
        , "test -x \"$runtime_install\"\n"
        , "test -x \"$runtime_mkdir\"\n"
        , "python_config_dir=$(find \"$out/lib/python${python_version}\" -maxdepth 1 -type d -name \"config-${python_version}-*\" -print -quit)\n"
        , "if [ -z \"$python_config_dir\" ] || [ ! -f \"$python_config_dir/Makefile\" ]; then\n"
        , "  echo \"Expected installed Python Makefile under $out/lib/python${python_version}\" >&2\n"
        , "  exit 1\n"
        , "fi\n"
        , "python_sysconfig_data=$(find \"$out/lib/python${python_version}\" -maxdepth 1 -type f -name \"_sysconfigdata_*.py\" -print -quit)\n"
        , "if [ -z \"$python_sysconfig_data\" ] || [ ! -f \"$python_sysconfig_data\" ]; then\n"
        , "  echo \"Expected installed Python sysconfig data under $out/lib/python${python_version}\" >&2\n"
        , "  exit 1\n"
        , "fi\n"
        , "\n"
        , "normalize_make_var \"$python_config_dir/Makefile\" \"SHELL\" \"$runtime_sh -e\"\n"
        , "normalize_make_var \"$python_config_dir/Makefile\" \"INSTALL\" \"$runtime_install -c\"\n"
        , "normalize_make_var \"$python_config_dir/Makefile\" \"INSTALL_PROGRAM\" \"$runtime_install -c\"\n"
        , "normalize_make_var \"$python_config_dir/Makefile\" \"INSTALL_SCRIPT\" \"$runtime_install -c\"\n"
        , "normalize_make_var \"$python_config_dir/Makefile\" \"INSTALL_DATA\" \"$runtime_install -c -m 644\"\n"
        , "normalize_make_var \"$python_config_dir/Makefile\" \"INSTALL_SHARED\" \"$runtime_install -c -m 755\"\n"
        , "normalize_make_var \"$python_config_dir/Makefile\" \"MKDIR_P\" \"$runtime_mkdir -p\"\n"
        , "\n"
        , "normalize_sysconfig_var \"$python_sysconfig_data\" \"SHELL\" \"$runtime_sh -e\"\n"
        , "normalize_sysconfig_var \"$python_sysconfig_data\" \"INSTALL\" \"$runtime_install -c\"\n"
        , "normalize_sysconfig_var \"$python_sysconfig_data\" \"INSTALL_PROGRAM\" \"$runtime_install -c\"\n"
        , "normalize_sysconfig_var \"$python_sysconfig_data\" \"INSTALL_SCRIPT\" \"$runtime_install -c\"\n"
        , "normalize_sysconfig_var \"$python_sysconfig_data\" \"INSTALL_DATA\" \"$runtime_install -c -m 644\"\n"
        , "normalize_sysconfig_var \"$python_sysconfig_data\" \"INSTALL_SHARED\" \"$runtime_install -c -m 755\"\n"
        , "normalize_sysconfig_var \"$python_sysconfig_data\" \"MKDIR_P\" \"$runtime_mkdir -p\"\n"
        , "\n"
        , "check_public_python_config_file \"$python_config_dir/Makefile\"\n"
        , "check_public_python_config_file \"$python_sysconfig_data\"\n"
        , "\n"
        , "python_subprocess=\"$out/lib/python${python_version}/subprocess.py\"\n"
        , "if [ -f \"$python_subprocess\" ]; then\n"
        , "  sed -i \"s|else '/bin/sh')|else '$runtime_sh')|\" \"$python_subprocess\"\n"
        , "  require_file_contains \"$python_subprocess\" \"else '$runtime_sh')\"\n"
        , "  require_file_not_contains \"$python_subprocess\" \"else '/bin/sh')\"\n"
        , "else\n"
        , "  echo \"Expected Python subprocess module at $python_subprocess\" >&2\n"
        , "  exit 1\n"
        , "fi\n"
        , "\n"
        , "echo \"=== Normalizing executable Python shebangs ===\"\n"
        , "rubble_script_shebang_register \"$out/bin/python3\" python python3 \"python${python_version}\"\n"
        , "rubble_script_shebang_register \"$bash/bin/bash\" sh bash\n"
        , "rubble_script_shebang_rewrite_all --strict \"$out\"\n"
        , "\n"
        , "echo \"=== Verifying Python installation ===\"\n"
        , "\"$out/bin/python3\" --version\n"
        , "RUBBLE_EXPECTED_SHELL=\"$runtime_sh -e\" \\\n"
        , "RUBBLE_EXPECTED_INSTALL=\"$runtime_install -c\" \\\n"
        , "RUBBLE_EXPECTED_INSTALL_DATA=\"$runtime_install -c -m 644\" \\\n"
        , "RUBBLE_EXPECTED_INSTALL_SHARED=\"$runtime_install -c -m 755\" \\\n"
        , "RUBBLE_EXPECTED_MKDIR_P=\"$runtime_mkdir -p\" \\\n"
        , "\"$out/bin/python3\" - <<'PY'\n"
        , "import bz2\n"
        , "import ctypes\n"
        , "import curses\n"
        , "import dbm.ndbm\n"
        , "import decimal\n"
        , "import hashlib\n"
        , "import lzma\n"
        , "import os\n"
        , "import readline\n"
        , "import sqlite3\n"
        , "import ssl\n"
        , "import subprocess\n"
        , "import sys\n"
        , "import sysconfig\n"
        , "import zlib\n"
        , "\n"
        , "expected = {\n"
        , "    \"SHELL\": os.environ[\"RUBBLE_EXPECTED_SHELL\"],\n"
        , "    \"INSTALL\": os.environ[\"RUBBLE_EXPECTED_INSTALL\"],\n"
        , "    \"INSTALL_PROGRAM\": os.environ[\"RUBBLE_EXPECTED_INSTALL\"],\n"
        , "    \"INSTALL_SCRIPT\": os.environ[\"RUBBLE_EXPECTED_INSTALL\"],\n"
        , "    \"INSTALL_DATA\": os.environ[\"RUBBLE_EXPECTED_INSTALL_DATA\"],\n"
        , "    \"INSTALL_SHARED\": os.environ[\"RUBBLE_EXPECTED_INSTALL_SHARED\"],\n"
        , "    \"MKDIR_P\": os.environ[\"RUBBLE_EXPECTED_MKDIR_P\"],\n"
        , "}\n"
        , "for key, value in expected.items():\n"
        , "    actual = sysconfig.get_config_var(key)\n"
        , "    assert actual == value, f\"{key}: expected {value!r}, got {actual!r}\"\n"
        , "shell_result = subprocess.run(\"printf shell-runtime-ok\", shell=True, check=True, text=True, capture_output=True)\n"
        , "assert shell_result.stdout == \"shell-runtime-ok\"\n"
        , "print(sys.version.split()[0])\n"
        , "print(shell_result.stdout)\n"
        , "print(\"python runtime modules ok\")\n"
        , "PY"
        ]
      , "format": "text"
      }
    }
  ]
, "inventory": {
    "ayvlr7htt6lml5iosty2yuiuogndl4xwu27xkbizrjbocyts5nrq-zlib-1.3.2-r0.apk":
      { "id": "ayvlr7htt6lml5iosty2yuiuogndl4xwu27xkbizrjbocyts5nrq-zlib-1.3.2-r0.apk"
      , "name": "zlib-1.3.2-r0.apk"
      , "src": {
