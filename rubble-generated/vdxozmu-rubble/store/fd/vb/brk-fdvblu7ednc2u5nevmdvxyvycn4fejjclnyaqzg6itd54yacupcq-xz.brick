{ "id": "fdvblu7ednc2u5nevmdvxyvycn4fejjclnyaqzg6itd54yacupcq-xz"
, "name": "xz"
, "platform": "aarch64-linux"
, "build_platform": "aarch64-linux"
, "rubble_home": "/var/lib/rubble"
, "inputs": [
    { "brick": "rlqgbuxu4kleo257tmrhzkllhb6thfjrmbcsr6hkxf2cduly7vta-xz-libs-5.8.3-r0.apk"
    , "alias": "xz_libs_apk"
    , "transitive": "false"
    }
  , { "brick": "oncm47zwljpb5u4lekuyhgdpx5rv4mn6vxvbkmuxps6izjagxiva-xz-5.8.3-r0.apk"
    , "alias": "xz_apk"
    , "transitive": "false"
    }
  , { "brick": "cndex52rgwiybhxcbkpry2isc55dz3hrc5lblmzr3xyeilghixda-patchelf"
    , "alias": "patchelf"
    , "transitive": "false"
    }
  , { "brick": "65xn763kfhf7ye2ax5rr3hjotrij3qjagkddvfhqarwrt2a7mnha-ld-musl.so"
    , "alias": "ld_musl"
    , "transitive": "true"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  , { "name": "bin" }
  , { "name": "lib" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "echo \"Extracting packages...\"\n"
        , "mkdir -p xz-extract xzlibs-extract\n"
        , "tar -xzf \"$xz_apk\" -C xz-extract 2>/dev/null || true\n"
        , "tar -xzf \"$xz_libs_apk\" -C xzlibs-extract 2>/dev/null || true\n"
        , "\n"
        , "# Copy liblzma shared libraries\n"
        , "mkdir -p \"$lib\"\n"
        , "find xzlibs-extract -name \"liblzma.so*\" -exec cp -a {} \"$lib/\" \\;\n"
        , "\n"
        , "# out is the xz binary itself\n"
        , "cp xz-extract/usr/bin/xz \"$out\"\n"
        , "chmod +x \"$out\"\n"
        , "\n"
        , "# Patch ELF binary\n"
        , "\"$patchelf\" --set-interpreter \"$ld_musl\" --set-rpath \"$lib\" \"$out\"\n"
        , "\n"
        , "# bin directory with symlinks for PATH integration\n"
        , "mkdir -p \"$bin\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/xz\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/unxz\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/xzcat\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/lzma\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/lzmadec\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/lzcat\"\n"
        , "\n"
        , "# Verify\n"
        , "echo \"\"\n"
        , "echo \"=== Verifying xz installation ===\"\n"
        , "\"$out\" --version | head -1 || true"
        ]
      , "format": "text"
      }
    }
  ]
, "inventory": {
    "rlqgbuxu4kleo257tmrhzkllhb6thfjrmbcsr6hkxf2cduly7vta-xz-libs-5.8.3-r0.apk":
      { "id": "rlqgbuxu4kleo257tmrhzkllhb6thfjrmbcsr6hkxf2cduly7vta-xz-libs-5.8.3-r0.apk"
      , "name": "xz-libs-5.8.3-r0.apk"
      , "src": {
          "url": "https://dl-cdn.alpinelinux.org/alpine/v3.21/main/aarch64/xz-libs-5.8.3-r0.apk"
        , "checksum": "sha256:992ee804cb54b0f7067f50ccfab641b253cab8659792be24ca6dd31795d87466"
        }
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "__rubble_skip_src_split__"
          , "value": "true"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "cp -ar \"$src\" \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
