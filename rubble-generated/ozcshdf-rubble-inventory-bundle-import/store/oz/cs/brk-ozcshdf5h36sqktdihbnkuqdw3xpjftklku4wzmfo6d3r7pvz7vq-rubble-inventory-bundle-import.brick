{ "id": "ozcshdf5h36sqktdihbnkuqdw3xpjftklku4wzmfo6d3r7pvz7vq-rubble-inventory-bundle-import"
, "name": "rubble-inventory-bundle-import"
, "platform": "x86_64-linux"
, "build_platform": "x86_64-linux"
, "rubble_home": "/var/lib/rubble"
, "inputs": [
    { "brick": "zkiff2cic77r6rxw3quhxg6gu4rznq4omwpz5tui7zwbvlqj6mbq-ld-musl.so"
    , "alias": "ld_musl"
    , "transitive": "false"
    }
  , { "brick": "wqckb6fysqnzuzmnm3hrgnie52iiuwqibunb222ynntml7x5lxjq-zstd"
    , "alias": "zstd"
    , "transitive": "false"
    }
  , { "brick": "bxchorbehgapcopsqwo7w5zwjgenujywlkkytlnad3dvy5hpqc5q-bash"
    , "alias": "bash"
    , "transitive": "false"
    }
  , { "brick": "jfai7zz72pherkoxskwv2r6de64ms2lv7eetewbbhcemhfmvu7sq-gnu-tar"
    , "alias": "gnu_tar"
    , "transitive": "false"
    }
  , { "brick": "72mkfvxl5mmbm7vwb7lqf2zdm4fspzwzv2cmpnsrum2l4c77u5cq-coreutils"
    , "alias": "coreutils"
    , "transitive": "false"
    }
  , { "brick": "5oavqnspap5hj3z5lttv2hn2sshy7kavg2e3diuo23coozqg2gaa-RubbleR.git.partial"
    , "alias": "src"
    , "transitive": "false"
    , "hooks": {
        "post-checkout": [
          { "install-to": [
              { "output": "dir"
              , "dir": "./" }
            ]
          }
        , { "shell": {
              "value": [
                "( source \"${script}\" \"${dir}\" )"
              ]
            , "format": "text"
            }
          }
        ]
      }
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "RUBBLE_SRC_LOCAL_PATHS all_proxy http_proxy https_proxy no_proxy" }
  ]
, "var": [
    { "name": "importer_platform"
    , "value": "x86_64-linux"
    }
  ]
, "outputs": [
    { "name": "out" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "payload_dir=payload\n"
        , "mkdir -p \"$payload_dir\"\n"
        , "cp -L \"${coreutils}/lib/libacl.so.1\" \"$payload_dir/libacl.so.1\"\n"
        , "cp -L \"${coreutils}/lib/libattr.so.1\" \"$payload_dir/libattr.so.1\"\n"
        , "cp -L \"${coreutils}/lib/libcrypto.so.3\" \"$payload_dir/libcrypto.so.3\"\n"
        , "cp -L \"${coreutils}/lib/libutmps.so.0.1\" \"$payload_dir/libutmps.so.0.1\"\n"
        , "cp -L \"${coreutils}/lib/libskarnet.so.2.14\" \"$payload_dir/libskarnet.so.2.14\"\n"
        , "cp -L \"${zstd[lib]}/libzstd.so.1\" \"$payload_dir/libzstd.so.1\"\n"
        , "\n"
        , "scripts/generate-rubble-inventory-bundle-import.sh \\\n"
        , "  --template scripts/rubble-inventory-bundle-import.sh \\\n"
        , "  --output \"$out\" \\\n"
        , "  --platform \"$importer_platform\" \\\n"
        , "  --coreutils-bin \"${coreutils}/bin\" \\\n"
        , "  --payload bash bash \"${bash}/bin/bash\" 0700 \\\n"
        , "  --payload zstd bin/zstd \"${zstd}\" 0700 \\\n"
        , "  --payload tar bin/tar \"${gnu_tar}\" 0700 \\\n"
        , "  --payload coreutils bin/coreutils \"${coreutils}/bin/coreutils\" 0700 \\\n"
        , "  --payload loader lib/ld-musl.so \"${ld_musl}\" 0700 \\\n"
        , "  --payload libacl lib/libacl.so.1 \"$payload_dir/libacl.so.1\" 0600 \\\n"
        , "  --payload libattr lib/libattr.so.1 \"$payload_dir/libattr.so.1\" 0600 \\\n"
        , "  --payload libcrypto lib/libcrypto.so.3 \"$payload_dir/libcrypto.so.3\" 0600 \\\n"
        , "  --payload libutmps lib/libutmps.so.0.1 \"$payload_dir/libutmps.so.0.1\" 0600 \\\n"
        , "  --payload libskarnet lib/libskarnet.so.2.14 \"$payload_dir/libskarnet.so.2.14\" 0600 \\\n"
        , "  --payload libzstd lib/libzstd.so.1 \"$payload_dir/libzstd.so.1\" 0600 \\\n"
        , "  --command bash bash direct - \\\n"
        , "  --command zstd zstd loader - \\\n"
        , "  --command tar tar loader - \\\n"
        , "  --command cp coreutils coreutils-loader cp \\\n"
        , "  --command chmod coreutils coreutils-loader chmod \\\n"
        , "  --command mkdir coreutils coreutils-loader mkdir \\\n"
        , "  --command rm coreutils coreutils-loader rm \\\n"
        , "  --command sha256sum coreutils coreutils-loader sha256sum \\\n"
        , "  --command stat coreutils coreutils-loader stat\n"
        , "\n"
        , "\"$out\" --help >/dev/null"
        ]
      , "format": "text"
      }
    }
  ]
, "inventory": {
    "hl6djaj44qkp6rily6m7uf6lsksicuvyiukbsphwqzo7zhddpzna-zstd-libs-1.5.6-r2.apk":
      { "id": "hl6djaj44qkp6rily6m7uf6lsksicuvyiukbsphwqzo7zhddpzna-zstd-libs-1.5.6-r2.apk"
