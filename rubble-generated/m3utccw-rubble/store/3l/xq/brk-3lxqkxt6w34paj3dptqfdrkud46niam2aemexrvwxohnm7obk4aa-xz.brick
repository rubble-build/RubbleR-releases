{ "id": "3lxqkxt6w34paj3dptqfdrkud46niam2aemexrvwxohnm7obk4aa-xz"
, "name": "xz"
, "platform": "x86_64-linux"
, "build_platform": "x86_64-linux"
, "rubble_home": "/var/lib/rubble"
, "inputs": [
    { "brick": "2cr3miaqwsfbjz5dox46ivtiopgc6go2pymeqgeqlohjdercgi2q-xz-libs-5.8.3-r0.apk"
    , "alias": "xz_libs_apk"
    , "transitive": "false"
    }
  , { "brick": "y66xqjdfnmyt3m5hsbute7ucmeumlkm2bwhhlqp6is663jgjcx6a-xz-5.8.3-r0.apk"
    , "alias": "xz_apk"
    , "transitive": "false"
    }
  , { "brick": "4z45nx65xw3y3yxdn5rw2qf5jwclaclnqqfhofeig6xotqxb7ajq-patchelf"
    , "alias": "patchelf"
    , "transitive": "false"
    }
  , { "brick": "zkiff2cic77r6rxw3quhxg6gu4rznq4omwpz5tui7zwbvlqj6mbq-ld-musl.so"
    , "alias": "ld_musl"
    , "transitive": "true"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  , { "name": "bin" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "echo \"Extracting packages...\"\n"
        , "mkdir -p xz-extract xzlibs-extract\n"
        , "tar -xzf \"$xz_apk\" -C xz-extract 2>/dev/null || true\n"
        , "tar -xzf \"$xz_libs_apk\" -C xzlibs-extract 2>/dev/null || true\n"
        , "\n"
        , "# Copy liblzma shared libraries\n"
        , "mkdir -p \"$out-lib\"\n"
        , "find xzlibs-extract -name \"liblzma.so*\" -exec cp -a {} \"$out-lib/\" \\;\n"
        , "\n"
        , "# out is the xz binary itself\n"
        , "cp xz-extract/usr/bin/xz \"$out\"\n"
        , "chmod +x \"$out\"\n"
        , "\n"
        , "# Patch ELF binary\n"
        , "\"$patchelf\" --set-interpreter \"$ld_musl\" --set-rpath \"$out-lib\" \"$out\"\n"
        , "\n"
        , "# bin directory with symlinks for PATH integration\n"
        , "mkdir -p \"$bin\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/xz\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/unxz\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/xzcat\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/lzma\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/lzmadec\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/lzcat\"\n"
        , "\n"
        , "# Verify\n"
        , "echo \"\"\n"
        , "echo \"=== Verifying xz installation ===\"\n"
        , "\"$out\" --version | head -1 || true"
        ]
      , "format": "text"
      }
    }
  ]
, "inventory": {
    "2cr3miaqwsfbjz5dox46ivtiopgc6go2pymeqgeqlohjdercgi2q-xz-libs-5.8.3-r0.apk":
      { "id": "2cr3miaqwsfbjz5dox46ivtiopgc6go2pymeqgeqlohjdercgi2q-xz-libs-5.8.3-r0.apk"
      , "name": "xz-libs-5.8.3-r0.apk"
      , "src": {
          "url": "https://dl-cdn.alpinelinux.org/alpine/v3.21/main/x86_64/xz-libs-5.8.3-r0.apk"
        , "checksum": "sha256:0a6e2ffa63da3314193103cc33dd0bb07a7c0683cc0001fde1fa0cf036a7ddeb"
        }
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "__rubble_skip_src_split__"
          , "value": "true"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "cp -ar \"$src\" \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "y66xqjdfnmyt3m5hsbute7ucmeumlkm2bwhhlqp6is663jgjcx6a-xz-5.8.3-r0.apk":
      { "id": "y66xqjdfnmyt3m5hsbute7ucmeumlkm2bwhhlqp6is663jgjcx6a-xz-5.8.3-r0.apk"
      , "name": "xz-5.8.3-r0.apk"
      , "src": {
