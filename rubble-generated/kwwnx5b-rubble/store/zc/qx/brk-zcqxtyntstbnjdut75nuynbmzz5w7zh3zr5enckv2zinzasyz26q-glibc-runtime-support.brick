  , "zkiff2cic77r6rxw3quhxg6gu4rznq4omwpz5tui7zwbvlqj6mbq-ld-musl.so":
      { "id": "zkiff2cic77r6rxw3quhxg6gu4rznq4omwpz5tui7zwbvlqj6mbq-ld-musl.so"
      , "name": "ld-musl.so"
      , "platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "rpxr23txqir7gm3jeg34or6v3x33tk66wsicortn5nabw7pgv4za-musl-1.2.5-r11.apk"
          , "alias": "src"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "musl_interpreter"
          , "value": "ld-musl-x86_64.so.1"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "echo \"Extracting musl interpreter...\"\n"
              , "tar -xzf \"$src\" 2>/dev/null || true\n"
              , "\n"
              , "cp -a \"lib/$musl_interpreter\" \"$out\"\n"
              , "\n"
              , "echo \"\"\n"
              , "echo \"=== musl interpreter ===\"\n"
              , "test -s \"$out\"\n"
              , "echo \"$out\"\n"
              , "ls -l \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
