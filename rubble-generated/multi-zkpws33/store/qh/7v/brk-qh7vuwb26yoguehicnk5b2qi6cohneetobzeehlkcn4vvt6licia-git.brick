  , "zcbnhzsvsrb2ugrvykackedb4zet6pjg7txbszo4tgwdkjokandq-gnu-sed":
      { "id": "zcbnhzsvsrb2ugrvykackedb4zet6pjg7txbszo4tgwdkjokandq-gnu-sed"
      , "name": "gnu-sed"
      , "platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "gnsdsnsfgkb2hv2pa3ejhm3rrxa65ls7pz6v7cbyj6uuwncqnqfa-sed-4.9-r2.apk"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "hdqxqr4vfc2rgc3rj5ywrpaykxqly77eix55tldf7wd7nqimpqfa-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "wkmpl2hwgob7qvcfpgzvx56hogur3qhmor7od77tv6hr4gd7eurq-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "5egteflbtlhbpl5lxsf77tssx5r2xozci62fdy42ah5ennedwyeq-musl-install-tools"
          , "alias": "musl_tools"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar -xzf \"$src\" 2>/dev/null || true\n"
              , "\"${musl_tools[install]}\" bin/sed \"$out\" \"$patchelf\" \"$ld_musl\"\n"
              , "\"${musl_tools[link_commands]}\" \"$out\" \"$bin\" sed\n"
              , "\n"
              , "printf 'rubble42\\n' > \"$TMP/sed-probe\"\n"
              , "\"$out\" -E -i 's/[0-9]+/-gnu/' \"$TMP/sed-probe\"\n"
              , "test \"$(cat \"$TMP/sed-probe\")\" = rubble-gnu\n"
              , "rm -f \"$TMP/sed-probe\""
              ]
            , "format": "text"
            }
          }
        ]
      }
