{ "id": "xkpwht5j77al73t57tas35u6xacltjd3sdjh6edfidlq5jbuz4ga-wasm-bindgen-cli-0.2.130"
, "name": "wasm-bindgen-cli-0.2.130"
, "platform": "x86_64-linux"
, "rubble_home": "/var/lib/rubble"
, "opaque": true
, "inputs": [
    { "brick": "272k37mp77qv4mpwmnerkot5ncyfhm7zor5c63iq2n4woia4kfaa-wasm-bindgen-0.2.130-x86_64-unknown-linux-musl.tar.gz"
    , "alias": "src"
    , "transitive": "false"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "bin" }
  , { "name": "env" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "tar -xzf \"$src\"\n"
        , "wasm_bindgen_bin=$(find . -type f -name wasm-bindgen | head -n 1)\n"
        , "wasm_bindgen_test_runner_bin=$(find . -type f -name wasm-bindgen-test-runner | head -n 1)\n"
        , "if [[ -z \"$wasm_bindgen_bin\" || -z \"$wasm_bindgen_test_runner_bin\" ]]; then\n"
        , "  echo \"wasm-bindgen CLI binaries not found in release archive\"\n"
        , "  exit 1\n"
        , "fi\n"
        , "\n"
        , "mkdir -p \"$bin\"\n"
        , "cp \"$wasm_bindgen_bin\" \"$bin/wasm-bindgen\"\n"
        , "cp \"$wasm_bindgen_test_runner_bin\" \"$bin/wasm-bindgen-test-runner\"\n"
        , "chmod +x \"$bin/wasm-bindgen\" \"$bin/wasm-bindgen-test-runner\"\n"
        , "\n"
        , "while IFS= builtin read -r __rubble_output_line; do\n"
        , "  builtin printf '%s\\n' \"$__rubble_output_line\"\n"
        , "done > \"$env\" <<EOF\n"
        , "export PATH=\"$bin:\\${PATH}\"\n"
        , "export WASM_BINDGEN=\"$bin/wasm-bindgen\"\n"
        , "export WASM_BINDGEN_TEST_RUNNER=\"$bin/wasm-bindgen-test-runner\"\n"
        , "EOF\n"
        , "builtin unset __rubble_output_line\n"
        , "\n"
        , "[[ \"$(\"$bin/wasm-bindgen\" --version)\" == \"wasm-bindgen 0.2.130\" ]]"
        ]
      , "format": "text"
      }
    }
  ]
, "inventory": {
    "272k37mp77qv4mpwmnerkot5ncyfhm7zor5c63iq2n4woia4kfaa-wasm-bindgen-0.2.130-x86_64-unknown-linux-musl.tar.gz":
      { "id": "272k37mp77qv4mpwmnerkot5ncyfhm7zor5c63iq2n4woia4kfaa-wasm-bindgen-0.2.130-x86_64-unknown-linux-musl.tar.gz"
      , "name": "wasm-bindgen-0.2.130-x86_64-unknown-linux-musl.tar.gz"
      , "src": {
          "url": "https://github.com/wasm-bindgen/wasm-bindgen/releases/download/0.2.130/wasm-bindgen-0.2.130-x86_64-unknown-linux-musl.tar.gz"
        , "checksum": "sha256:9687f3bb551b9f66f37ed32a40d7913a00f7962db653054e56857bc306c3227f"
        }
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "__rubble_skip_src_split__"
          , "value": "true"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "cp -ar \"$src\" \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  }
}
