{ "id": "hseqkp4htbof2oy5ft32zmuk6nrjwse7qhf2e7nlyfrrphs3sc5a-wasm-pack-0.15.0"
, "name": "wasm-pack-0.15.0"
, "platform": "x86_64-linux"
, "rubble_home": "/var/lib/rubble"
, "opaque": true
, "inputs": [
    { "brick": "4mtrsm6btbhfrahkgwn4ss2s2vcmwa5frmg7ndtsnh7bjgjm2hpa-wasm-pack-v0.15.0-x86_64-unknown-linux-musl.tar.gz"
    , "alias": "src"
    , "transitive": "false"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  , { "name": "env" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "tar -xzf \"$src\"\n"
        , "wasm_pack_bin=$(find . -type f -name wasm-pack | head -n 1)\n"
        , "if [[ -z \"$wasm_pack_bin\" ]]; then\n"
        , "  echo \"wasm-pack binary not found in release archive\"\n"
        , "  exit 1\n"
        , "fi\n"
        , "\n"
        , "mkdir -p \"$out/bin\"\n"
        , "cp \"$wasm_pack_bin\" \"$out/bin/wasm-pack\"\n"
        , "chmod +x \"$out/bin/wasm-pack\"\n"
        , "\n"
        , "while IFS= builtin read -r __rubble_output_line; do\n"
        , "  builtin printf '%s\\n' \"$__rubble_output_line\"\n"
        , "done > \"$env\" <<EOF\n"
        , "export PATH=\"$out/bin:\\${PATH}\"\n"
        , "export WASM_PACK=\"$out/bin/wasm-pack\"\n"
        , "declare -p PATH WASM_PACK\n"
        , "\"\\$WASM_PACK\" --version\n"
        , "EOF\n"
        , "builtin unset __rubble_output_line\n"
        , "\n"
        , "\"$out/bin/wasm-pack\" --version"
        ]
      , "format": "text"
      }
    }
  ]
, "inventory": {
    "4mtrsm6btbhfrahkgwn4ss2s2vcmwa5frmg7ndtsnh7bjgjm2hpa-wasm-pack-v0.15.0-x86_64-unknown-linux-musl.tar.gz":
      { "id": "4mtrsm6btbhfrahkgwn4ss2s2vcmwa5frmg7ndtsnh7bjgjm2hpa-wasm-pack-v0.15.0-x86_64-unknown-linux-musl.tar.gz"
      , "name": "wasm-pack-v0.15.0-x86_64-unknown-linux-musl.tar.gz"
      , "src": {
          "url": "https://github.com/wasm-bindgen/wasm-pack/releases/download/v0.15.0/wasm-pack-v0.15.0-x86_64-unknown-linux-musl.tar.gz"
        , "checksum": "sha256:c09f971ecaed9a2efc80fdcea7a00ef6b53c7fadc8c57d1f61b53a6aa66b668a"
        }
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "__rubble_skip_src_split__"
          , "value": "true"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "cp -ar \"$src\" \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  }
}
