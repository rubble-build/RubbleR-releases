{ "id": "bxchorbehgapcopsqwo7w5zwjgenujywlkkytlnad3dvy5hpqc5q-bash"
, "name": "bash"
, "platform": "x86_64-linux"
, "rubble_home": "/var/lib/rubble"
, "inputs": [
    { "brick": "4cnw6f44o4vlikwytizm5k5sqix42ok6gelmtn7wuaw7gl2xic6a-bash-linux-x86_64"
    , "alias": "src"
    , "transitive": "false"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "var": [
    { "name": "version"
    , "value": "5.2.015"
    }
  ]
, "outputs": [
    { "name": "out" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "mkdir -p \"$out/bin\"\n"
        , "\n"
        , "# Copy bash binary (src is the downloaded file directly)\n"
        , "cp -v \"$src\" \"$out/bin/bash\"\n"
        , "chmod +x \"$out/bin/bash\"\n"
        , "\n"
        , "# Create sh symlink\n"
        , "ln -s bash \"$out/bin/sh\"\n"
        , "\n"
        , "# Verify\n"
        , "echo \"\"\n"
        , "echo \"=== Verifying bash installation ===\"\n"
        , "\"$out/bin/bash\" --version\n"
        , "test -x \"$out/bin/bash\"\n"
        , "\"$out/bin/bash\" -c 'echo bash runtime check'"
        ]
      , "format": "text"
      }
    }
  ]
, "inventory": {
    "4cnw6f44o4vlikwytizm5k5sqix42ok6gelmtn7wuaw7gl2xic6a-bash-linux-x86_64":
      { "id": "4cnw6f44o4vlikwytizm5k5sqix42ok6gelmtn7wuaw7gl2xic6a-bash-linux-x86_64"
      , "name": "bash-linux-x86_64"
      , "src": {
          "url": "https://github.com/robxu9/bash-static/releases/download/5.2.015-1.2.3-2/bash-linux-x86_64"
        , "checksum": "sha256:64469a9512a00199c85622ec56f870f97d50457a4e06e0cfa39bae7adf0cc8f2"
        }
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "__rubble_skip_src_split__"
          , "value": "true"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "cp -ar \"$src\" \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  }
}
