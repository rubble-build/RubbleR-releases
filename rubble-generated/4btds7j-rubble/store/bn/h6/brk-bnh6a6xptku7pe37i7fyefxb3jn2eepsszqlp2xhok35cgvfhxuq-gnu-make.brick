{ "id": "bnh6a6xptku7pe37i7fyefxb3jn2eepsszqlp2xhok35cgvfhxuq-gnu-make"
, "name": "gnu-make"
, "platform": "x86_64-linux"
, "build_platform": "x86_64-linux"
, "rubble_home": "/var/lib/rubble"
, "inputs": [
    { "brick": "4z45nx65xw3y3yxdn5rw2qf5jwclaclnqqfhofeig6xotqxb7ajq-patchelf"
    , "alias": "patchelf"
    , "transitive": "false"
    }
  , { "brick": "opmf3fnkrx63nigobxuvurfjeg772qcva6agm646urua5asfsc6a-make-4.4.1-r2.apk"
    , "alias": "src"
    , "transitive": "false"
    }
  , { "brick": "zkiff2cic77r6rxw3quhxg6gu4rznq4omwpz5tui7zwbvlqj6mbq-ld-musl.so"
    , "alias": "ld_musl"
    , "transitive": "true"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  , { "name": "bin" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "echo \"Extracting make package...\"\n"
        , "tar -xzf \"$src\" 2>/dev/null || true\n"
        , "\n"
        , "# out is the make binary itself\n"
        , "cp usr/bin/make \"$out\"\n"
        , "chmod +x \"$out\"\n"
        , "\n"
        , "# Patch ELF binary to use musl interpreter from runtime home\n"
        , "\"$patchelf\" --set-interpreter \"$ld_musl\" \"$out\"\n"
        , "\n"
        , "# bin directory with symlinks for PATH integration\n"
        , "mkdir -p \"$bin\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/make\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/gmake\"\n"
        , "\n"
        , "# Verify\n"
        , "echo \"\"\n"
        , "echo \"=== Verifying GNU Make installation ===\"\n"
        , "\"$out\" --version | head -1 || true"
        ]
      , "format": "text"
      }
    }
  ]
, "inventory": {
    "4z45nx65xw3y3yxdn5rw2qf5jwclaclnqqfhofeig6xotqxb7ajq-patchelf":
      { "id": "4z45nx65xw3y3yxdn5rw2qf5jwclaclnqqfhofeig6xotqxb7ajq-patchelf"
      , "name": "patchelf"
      , "platform": "x86_64-linux"
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "download_url"
          , "value": "https://github.com/NixOS/patchelf/releases/download/0.18.0/patchelf-0.18.0-x86_64.tar.gz"
          }
        ]
      , "outputs": [
          { "name": "bin" }
        , { "name": "share" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "curl -Lfs --output patchelf.tar.gz \"$download_url\"\n"
              , "tar -xvf patchelf.tar.gz\n"
              , "mv bin/patchelf \"$bin\"\n"
              , "mv share \"$share\"\n"
              , "\"$bin\" --version"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "rpxr23txqir7gm3jeg34or6v3x33tk66wsicortn5nabw7pgv4za-musl-1.2.5-r11.apk":
      { "id": "rpxr23txqir7gm3jeg34or6v3x33tk66wsicortn5nabw7pgv4za-musl-1.2.5-r11.apk"
      , "name": "musl-1.2.5-r11.apk"
      , "src": {
          "url": "https://dl-cdn.alpinelinux.org/alpine/v3.21/main/x86_64/musl-1.2.5-r11.apk"
        , "checksum": "sha256:61e84757a8bfbc0d7fa8f4ce6de9cd4d791714369d78f6a08e5b03510fb2a623"
        }
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "__rubble_skip_src_split__"
          , "value": "true"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "cp -ar \"$src\" \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "opmf3fnkrx63nigobxuvurfjeg772qcva6agm646urua5asfsc6a-make-4.4.1-r2.apk":
      { "id": "opmf3fnkrx63nigobxuvurfjeg772qcva6agm646urua5asfsc6a-make-4.4.1-r2.apk"
      , "name": "make-4.4.1-r2.apk"
      , "src": {
          "url": "https://dl-cdn.alpinelinux.org/alpine/v3.21/main/x86_64/make-4.4.1-r2.apk"
        , "checksum": "sha256:a61bf1442fa3cdee6ea7188e28673dba7b36bf2f469ccaa6b119cb95c3338b43"
        }
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "__rubble_skip_src_split__"
          , "value": "true"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "cp -ar \"$src\" \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "zkiff2cic77r6rxw3quhxg6gu4rznq4omwpz5tui7zwbvlqj6mbq-ld-musl.so":
      { "id": "zkiff2cic77r6rxw3quhxg6gu4rznq4omwpz5tui7zwbvlqj6mbq-ld-musl.so"
      , "name": "ld-musl.so"
      , "platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "rpxr23txqir7gm3jeg34or6v3x33tk66wsicortn5nabw7pgv4za-musl-1.2.5-r11.apk"
          , "alias": "src"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "musl_interpreter"
          , "value": "ld-musl-x86_64.so.1"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "echo \"Extracting musl interpreter...\"\n"
              , "tar -xzf \"$src\" 2>/dev/null || true\n"
              , "\n"
              , "cp -a \"lib/$musl_interpreter\" \"$out\"\n"
              , "\n"
              , "echo \"\"\n"
              , "echo \"=== musl interpreter ===\"\n"
              , "test -s \"$out\"\n"
              , "echo \"$out\"\n"
              , "ls -l \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  }
}
