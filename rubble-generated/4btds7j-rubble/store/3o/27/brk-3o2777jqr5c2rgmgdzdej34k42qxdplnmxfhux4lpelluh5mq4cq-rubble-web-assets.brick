          , "alias": "mpc_src"
          , "transitive": "false"
          }
        , { "brick": "6qywaqu63vt3ydbo74p2fqxifkn77izwg5amobej6nca3oao2xla-isl-0.24.tar.bz2"
          , "alias": "isl_src"
          , "transitive": "false"
          }
        , { "brick": "apwv2emy6cpgfjhifot4on26vbuiigqxu2nabpoyf42xknawsowa-gmp-6.2.1.tar.bz2"
          , "alias": "gmp_src"
          , "transitive": "false"
          }
        , { "brick": "lkvwp2vgtnqksd4pvrkpdnnyohghv2t4eufxpfrczxeijtowkjba-gcc-14.2.0.tar.xz"
          , "alias": "gcc_src"
          , "transitive": "false"
          }
        , { "brick": "ic3mcp6r2byudz4wwzrzs7ld3te3lmfdcopyerhhnjybz6b4gz5q-gcc"
          , "alias": "musl_gcc"
          , "transitive": "false"
          }
        , { "brick": "bcijixntbfjfueijbqlib6knpsyc36k6jzcnlakihhimsazq2b7a-python3"
          , "alias": "python3"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "export PATH=\"$out/bin:$PATH\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "odzciqpr5fl5qqpdqnohs7qpqqwvahqodbydsv7er2ztrfnfhbuq-bootstrap-env"
          , "alias": "bootstrap_env"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$out/setup-env.sh\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "mi65hk5fk6kh6hh7rtv3dp2aff6z3zadlz3kqt6pc5thxhfas4xa-linux-headers"
          , "alias": "linux_headers"
          , "transitive": "false"
          }
        , { "brick": "fynes4jr5ntfmo2jjyaquumpfr4ucq35bbc5nmcge6o7bcgldoiq-binutils-cross"
          , "alias": "binutils_cross"
          , "transitive": "false"
          }
        , { "brick": "jvkfwgfep6e6qwbgfpblin3txpogtyrlb7uc3kbj3trfalngsh6q-glibc-cross"
          , "alias": "glibc_cross"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "BUILD_JOBS all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "gcc_version"
          , "value": "14.2.0"
          }
        , { "name": "target_triple"
          , "value": "x86_64-linux-gnu"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "jobs=\"${BUILD_JOBS:-$(nproc)}\"\n"
              , "is_elf() {\n"
              , "  [ -f \"$1\" ] && [ \"$(LC_ALL=C head -c 4 \"$1\" 2>/dev/null)\" = \"$(printf '\\177ELF')\" ]\n"
              , "}\n"
              , "\n"
              , "echo \"=== Extracting GCC ${gcc_version} ===\"\n"
              , "tar xf \"$gcc_src\"\n"
              , "cd \"gcc-${gcc_version}\"\n"
              , "\n"
              , "echo \"=== Extracting GCC prerequisites ===\"\n"
              , "for prereq in \"$gmp_src\" \"$mpfr_src\" \"$mpc_src\" \"$isl_src\"; do\n"
              , "  echo \"  Extracting $(basename \"$prereq\")...\"\n"
              , "  tar xf \"$prereq\"\n"
              , "done\n"
              , "ln -sf gmp-6.2.1 gmp\n"
              , "ln -sf mpfr-4.1.0 mpfr\n"
              , "ln -sf mpc-1.2.1 mpc\n"
              , "ln -sf isl-0.24 isl\n"
              , "\n"
              , "echo \"=== Configuring full GCC cross (target=${target_triple}) ===\"\n"
              , "mkdir build && cd build\n"
              , "\n"
              , "# Host compiler setup\n"
              , "host_triple=\"$(${musl_gcc}/bin/gcc -dumpmachine)\"\n"
              , "gcc_ver=\"$(\"${musl_gcc}/bin/gcc\" -dumpversion)\"\n"
              , "musl_inc=\"-nostdinc -isystem ${musl_gcc}/lib/gcc/${host_triple}/${gcc_ver}/include -isystem ${musl_gcc}/include\"\n"
              , "cxx_inc=\"-isystem ${musl_gcc}/include/c++/${gcc_ver} -isystem ${musl_gcc}/include/c++/${gcc_ver}/${host_triple}\"\n"
              , "host_link_flags=\"-static -no-pie\"\n"
              , "export CC=\"${musl_gcc}/bin/gcc -fno-lto ${host_link_flags} ${musl_inc}\"\n"
              , "export CXX=\"${musl_gcc}/bin/g++ -fno-lto ${host_link_flags} -nostdinc ${cxx_inc} -isystem ${musl_gcc}/lib/gcc/${host_triple}/${gcc_ver}/include -isystem ${musl_gcc}/include\"\n"
              , "export CFLAGS=\"\"\n"
              , "export CXXFLAGS=\"\"\n"
              , "export LDFLAGS=\"${host_link_flags}\"\n"
              , "build_shell=\"$bootstrap_env/bin/bash\"\n"
              , "export CONFIG_SHELL=\"$build_shell\"\n"
              , "export SHELL=\"$build_shell\"\n"
              , "export MAKEINFO=true\n"
              , "\n"
              , "mkdir -p \"$PWD/bin-wrappers\"\n"
              , "{\n"
              , "  printf '#!%s\\n' \"$build_shell\"\n"
              , "  printf '%s\\n' \\\n"
              , "    'out=' \\\n"
              , "    'while [ \"$#\" -gt 0 ]; do' \\\n"
              , "    '  case \"$1\" in' \\\n"
              , "    '    --output=*) out=\"${1#--output=}\" ;;' \\\n"
              , "    '    --output) shift; out=\"${1:-}\" ;;' \\\n"
              , "    '  esac' \\\n"
              , "    '  shift || break' \\\n"
              , "    'done' \\\n"
              , "    'if [ -n \"$out\" ]; then : > \"$out\"; fi' \\\n"
              , "    'exit 0'\n"
              , "} > \"$PWD/bin-wrappers/pod2man\"\n"
              , "printf '#!%s\\nexec %s/bin/%s-c++filt \"$@\"\\n' \"$build_shell\" \"${binutils_cross}\" \"${target_triple}\" > \"$PWD/bin-wrappers/c++filt\"\n"
              , "\n"
              , "# Wrap AR/RANLIB to strip --plugin args\n"
              , "printf '#!%s\\nargs=\"\"\\nskip_next=false\\nfor arg in \"$@\"; do\\n  if $skip_next; then skip_next=false; continue; fi\\n  case \"$arg\" in\\n    --plugin) skip_next=true ;;\\n    --plugin=*) ;;\\n    *) args=\"$args $arg\" ;;\\n  esac\\ndone\\nexec %s/bin/ar $args\\n' \"$build_shell\" \"${musl_gcc}\" > \"$PWD/bin-wrappers/ar\"\n"
              , "printf '#!%s\\nargs=\"\"\\nskip_next=false\\nfor arg in \"$@\"; do\\n  if $skip_next; then skip_next=false; continue; fi\\n  case \"$arg\" in\\n    --plugin) skip_next=true ;;\\n    --plugin=*) ;;\\n    *) args=\"$args $arg\" ;;\\n  esac\\ndone\\nexec %s/bin/ranlib $args\\n' \"$build_shell\" \"${musl_gcc}\" > \"$PWD/bin-wrappers/ranlib\"\n"
              , "chmod +x \"$PWD/bin-wrappers/ar\" \"$PWD/bin-wrappers/ranlib\" \"$PWD/bin-wrappers/pod2man\" \"$PWD/bin-wrappers/c++filt\"\n"
              , "export AR=\"$PWD/bin-wrappers/ar\"\n"
              , "export RANLIB=\"$PWD/bin-wrappers/ranlib\"\n"
              , "export POD2MAN=\"$PWD/bin-wrappers/pod2man\"\n"
              , "export CXXFILT=\"$PWD/bin-wrappers/c++filt\"\n"
              , "export PATH=\"$PWD/bin-wrappers:${binutils_cross}/bin:$PATH\"\n"
              , "export AS_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-as\"\n"
              , "export LD_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-ld\"\n"
              , "export AR_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-ar\"\n"
              , "export RANLIB_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-ranlib\"\n"
              , "export NM_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-nm\"\n"
              , "export OBJCOPY_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-objcopy\"\n"
              , "export OBJDUMP_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-objdump\"\n"
              , "export READELF_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-readelf\"\n"
              , "export STRIP_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-strip\"\n"
              , "export CXXFILT_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-c++filt\"\n"
              , "\n"
              , "# Target libraries invoke target binutils by program name during nested\n"
              , "# makes, so bind them to the declared cross binutils instead of the host.\n"
              , "export PATH=\"${binutils_cross}/bin:${PATH}\"\n"
              , "export AS_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-as\"\n"
              , "export LD_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-ld\"\n"
              , "export AR_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-ar\"\n"
              , "export RANLIB_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-ranlib\"\n"
              , "export NM_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-nm\"\n"
              , "export STRIP_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-strip\"\n"
              , "export OBJDUMP_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-objdump\"\n"
              , "export OBJCOPY_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-objcopy\"\n"
              , "export READELF_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-readelf\"\n"
              , "export CXXFILT_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-c++filt\"\n"
              , "\n"
              , "# Assemble the target sysroot inside the runtime output. GCC records the\n"
              , "# configured sysroot in the installed compiler, so it must never point at the\n"
              , "# transient build directory.\n"
              , "sysroot=\"$out/${target_triple}\"\n"
              , "mkdir -p \"$sysroot/include\" \"$sysroot/lib\" \"$sysroot/usr/include\" \"$sysroot/usr/lib\"\n"
              , "cp -a \"${linux_headers}/include/\"* \"$sysroot/include/\"\n"
              , "cp -a \"${glibc_cross}/include/\"* \"$sysroot/include/\"\n"
              , "cp -a \"${glibc_cross}/lib/\"* \"$sysroot/lib/\"\n"
              , "cp -a \"${linux_headers}/include/\"* \"$sysroot/usr/include/\"\n"
              , "cp -a \"${glibc_cross}/include/\"* \"$sysroot/usr/include/\"\n"
              , "cp -a \"${glibc_cross}/lib/\"* \"$sysroot/usr/lib/\"\n"
              , "# Symlink lib -> usr/lib for the linker to find crt files\n"
              , "ln -sf usr/lib \"$sysroot/lib64\"\n"
              , "\n"
              , "# GCC target library builds and libtool relinks may resolve linker scripts\n"
              , "# through -B/-L without applying --sysroot. Keep every sysroot linker script\n"
              , "# self-contained and relative to its library search directory.\n"
              , "for f in \"$sysroot/lib/libc.so\" \"$sysroot/lib/libm.so\" \\\n"
              , "         \"$sysroot/usr/lib/libc.so\" \"$sysroot/usr/lib/libm.so\"; do\n"
              , "  [ -f \"$f\" ] || continue\n"
              , "  if ! is_elf \"$f\"; then\n"
              , "    sed -i \"s|${glibc_cross}/lib/||g\" \"$f\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "\"$build_shell\" ../configure \\\n"
              , "  --prefix=\"$out\" \\\n"
              , "  --build=\"${host_triple}\" \\\n"
              , "  --host=\"${host_triple}\" \\\n"
              , "  --target=\"${target_triple}\" \\\n"
              , "  --with-sysroot=\"$sysroot\" \\\n"
              , "  --with-local-prefix=\"$out\" \\\n"
              , "  --enable-languages=c,c++ \\\n"
              , "  --enable-shared \\\n"
              , "  --enable-threads=posix \\\n"
              , "  --enable-__cxa_atexit \\\n"
              , "  --enable-default-pie \\\n"
              , "  --disable-libssp \\\n"
              , "  --disable-multilib \\\n"
              , "  --disable-nls \\\n"
              , "  --disable-werror \\\n"
              , "  --disable-plugins \\\n"
              , "  --disable-lto \\\n"
              , "  --with-as=\"${binutils_cross}/bin/${target_triple}-as\" \\\n"
              , "  --with-ld=\"${binutils_cross}/bin/${target_triple}-ld\"\n"
              , "\n"
              , "echo \"=== Building full GCC (jobs=$jobs) ===\"\n"
              , "make LDFLAGS=\"${LDFLAGS}\" -j \"$jobs\" SHELL=\"$build_shell\" MAKEINFO=true POD2MAN=\"$POD2MAN\"\n"
              , "\n"
              , "echo \"=== Installing ===\"\n"
              , "make LDFLAGS=\"${LDFLAGS}\" install SHELL=\"$build_shell\" MAKEINFO=true POD2MAN=\"$POD2MAN\"\n"
              , "\n"
              , "echo \"=== Removing build-only documentation and install tools ===\"\n"
              , "rm -rf \\\n"
              , "  \"$out/share/man\" \\\n"
              , "  \"$out/share/info\" \\\n"
              , "  \"$out/lib/gcc/${target_triple}/${gcc_version}/install-tools\" \\\n"
              , "  \"$out/libexec/gcc/${target_triple}/${gcc_version}/install-tools\"\n"
              , "\n"
              , "echo \"=== Stripping debug sections ===\"\n"
              , "readelf_tool=\"${binutils_cross}/bin/${target_triple}-readelf\"\n"
              , "strip_tool=\"${binutils_cross}/bin/${target_triple}-strip\"\n"
              , "while IFS= read -r -d '' file; do\n"
              , "  if \"$readelf_tool\" -h \"$file\" >/dev/null 2>&1; then\n"
              , "    \"$strip_tool\" --strip-debug \"$file\"\n"
              , "  else\n"
              , "    case \"$file\" in\n"
              , "      *.a) \"$strip_tool\" --strip-debug \"$file\" 2>/dev/null || true ;;\n"
              , "    esac\n"
              , "  fi\n"
              , "done < <(find \"$out\" -type f -print0)\n"
              , "\n"
              , "echo \"=== GCC cross build complete ===\"\n"
              , "\"$out/bin/${target_triple}-gcc\" --version 2>&1 | head -1 || true\n"
              , "\"$out/bin/${target_triple}-g++\" --version 2>&1 | head -1 || true\n"
              , "echo \"=== libstdc++ ===\"\n"
              , "find \"$out\" -name \"libstdc++*\" -type f | head -5 || true"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "nzb2pbw34bakjvazqm2mvjmsicsn7rtucdvssslrrux4e2fwh7na-binutils":
      { "id": "nzb2pbw34bakjvazqm2mvjmsicsn7rtucdvssslrrux4e2fwh7na-binutils"
      , "name": "binutils"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "kunm4aanjegga2okph6bty3sklbipirbunbmraanvx2vakcuqdpa-binutils-2.44.tar.xz"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "odzciqpr5fl5qqpdqnohs7qpqqwvahqodbydsv7er2ztrfnfhbuq-bootstrap-env"
          , "alias": "bootstrap_env"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$out/setup-env.sh\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "mi65hk5fk6kh6hh7rtv3dp2aff6z3zadlz3kqt6pc5thxhfas4xa-linux-headers"
          , "alias": "linux_headers"
          , "transitive": "false"
          }
        , { "brick": "fynes4jr5ntfmo2jjyaquumpfr4ucq35bbc5nmcge6o7bcgldoiq-binutils-cross"
          , "alias": "binutils_cross"
          , "transitive": "false"
          }
        , { "brick": "jvkfwgfep6e6qwbgfpblin3txpogtyrlb7uc3kbj3trfalngsh6q-glibc-cross"
          , "alias": "glibc_cross"
          , "transitive": "true"
          }
        , { "brick": "6tvdn5ancn4exj4lpigfvjqpw5e37vcgjhtdpvstmzkhdu3yx7ba-gcc-cross"
          , "alias": "gcc_cross"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "BUILD_JOBS all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "binutils_version"
          , "value": "2.44"
          }
        , { "name": "ld_linux_name"
          , "value": "ld-linux-x86-64.so.2"
          }
        , { "name": "target_triple"
          , "value": "x86_64-linux-gnu"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "jobs=\"${BUILD_JOBS:-$(nproc)}\"\n"
              , "\n"
              , "echo \"=== Extracting binutils ${binutils_version} ===\"\n"
              , "tar xf \"$src\"\n"
              , "cd \"binutils-${binutils_version}\"\n"
              , "\n"
              , "runtime_debug_dir=\"${out}/lib/debug\"\n"
              , "\n"
              , "echo \"=== Preparing sysroot ===\"\n"
              , "sysroot=\"$PWD/sysroot\"\n"
              , "mkdir -p \"$sysroot/usr/include\" \"$sysroot/usr/lib\"\n"
              , "\n"
              , "# Copy glibc headers and libs into sysroot\n"
              , "cp -a \"${glibc_cross}/include/\"* \"$sysroot/usr/include/\"\n"
              , "cp -a \"${glibc_cross}/lib/\"* \"$sysroot/usr/lib/\"\n"
              , "\n"
              , "# Add kernel headers\n"
              , "cp -a \"${linux_headers}/include/linux\" \"$sysroot/usr/include/\"\n"
              , "cp -a \"${linux_headers}/include/asm\" \"$sysroot/usr/include/\"\n"
              , "cp -a \"${linux_headers}/include/asm-generic\" \"$sysroot/usr/include/\"\n"
              , "\n"
              , "# Patch libc.so linker script to use relative sysroot paths\n"
              , "if [ -f \"$sysroot/usr/lib/libc.so\" ]; then\n"
              , "  sed -i \"s|${glibc_cross}/lib/|/usr/lib/|g\" \"$sysroot/usr/lib/libc.so\"\n"
              , "fi\n"
              , "\n"
              , "echo \"=== Configuring binutils (native, target=${target_triple}) ===\"\n"
              , "mkdir build && cd build\n"
              , "\n"
              , "# Use gcc-cross to compile. The cross compiler is statically linked (musl)\n"
              , "# and produces glibc-linked aarch64 binaries.\n"
              , "# Embed -B to help GCC find glibc crt*.o startup files.\n"
              , "export CC=\"${gcc_cross}/bin/${target_triple}-gcc -B${glibc_cross}/lib\"\n"
              , "export CXX=\"${gcc_cross}/bin/${target_triple}-g++ -B${glibc_cross}/lib\"\n"
              , "export CPP=\"${gcc_cross}/bin/${target_triple}-gcc -E --sysroot=$sysroot -B${glibc_cross}/lib\"\n"
              , "export CXXCPP=\"${gcc_cross}/bin/${target_triple}-g++ -E --sysroot=$sysroot -B${glibc_cross}/lib\"\n"
              , "build_shell=\"$bootstrap_env/bin/bash\"\n"
              , "export CONFIG_SHELL=\"$build_shell\"\n"
              , "export SHELL=\"$build_shell\"\n"
              , "export AS=\"${binutils_cross}/bin/${target_triple}-as\"\n"
              , "export AR=\"${binutils_cross}/bin/${target_triple}-ar\"\n"
              , "export LD=\"${binutils_cross}/bin/${target_triple}-ld\"\n"
              , "export NM=\"${binutils_cross}/bin/${target_triple}-nm\"\n"
              , "export OBJCOPY=\"${binutils_cross}/bin/${target_triple}-objcopy\"\n"
              , "export OBJDUMP=\"${binutils_cross}/bin/${target_triple}-objdump\"\n"
              , "export RANLIB=\"${binutils_cross}/bin/${target_triple}-ranlib\"\n"
              , "export READELF=\"${binutils_cross}/bin/${target_triple}-readelf\"\n"
              , "export STRIP=\"${binutils_cross}/bin/${target_triple}-strip\"\n"
              , "tool_shims=\"$PWD/rubble-build-tool-shims\"\n"
              , "mkdir -p \"$tool_shims\"\n"
              , "{\n"
              , "  printf '#!%s\\n' \"$build_shell\"\n"
              , "  printf '%s\\n' \\\n"
              , "    'out=' \\\n"
              , "    'while [ \"$#\" -gt 0 ]; do' \\\n"
              , "    '  case \"$1\" in' \\\n"
              , "    '    --output=*)' \\\n"
              , "    '      out=\"${1#--output=}\"' \\\n"
              , "    '      ;;' \\\n"
              , "    '    --output)' \\\n"
              , "    '      shift' \\\n"
              , "    '      out=\"${1:-}\"' \\\n"
              , "    '      ;;' \\\n"
              , "    '  esac' \\\n"
              , "    '  shift || break' \\\n"
              , "    'done' \\\n"
              , "    'if [ -n \"$out\" ]; then' \\\n"
              , "    '  : > \"$out\"' \\\n"
              , "    'fi' \\\n"
              , "    'exit 0'\n"
              , "} > \"$tool_shims/pod2man\"\n"
              , "chmod +x \"$tool_shims/pod2man\"\n"
              , "{\n"
              , "  printf '#!%s\\n' \"$build_shell\"\n"
              , "  printf '%s\\n' 'exit 0'\n"
              , "} > \"$tool_shims/ldconfig\"\n"
              , "chmod +x \"$tool_shims/ldconfig\"\n"
              , "export PATH=\"$tool_shims:$PATH\"\n"
              , "export PKG_CONFIG=false\n"
              , "export PKG_CONFIG_LIBDIR=/nonexistent\n"
              , "export MAKEINFO=true\n"
              , "export POD2MAN=\"$tool_shims/pod2man\"\n"
              , "export AM_UPDATE_INFO_DIR=no\n"
              , "true_tool=\"$bootstrap_env/bin/true\"\n"
              , "export ac_cv_path_LDCONFIG=\"$true_tool\"\n"
              , "export lt_cv_path_LDCONFIG=\"$true_tool\"\n"
              , "\n"
              , "# Link against glibc-cross with correct interpreter and rpath\n"
              , "export LDFLAGS=\"-L${glibc_cross}/lib -Wl,--dynamic-linker=${glibc_cross}/lib/${ld_linux_name} -Wl,-rpath,${glibc_cross}/lib\"\n"
              , "export CFLAGS=\"--sysroot=$sysroot\"\n"
              , "export CXXFLAGS=\"$CFLAGS\"\n"
              , "\n"
              , "\"$build_shell\" ../configure \\\n"
              , "  --prefix=\"$out\" \\\n"
              , "  --build=\"${target_triple}\" \\\n"
              , "  --host=\"${target_triple}\" \\\n"
              , "  --target=\"${target_triple}\" \\\n"
              , "  --with-sysroot \\\n"
              , "  --with-separate-debug-dir=\"$runtime_debug_dir\" \\\n"
              , "  --with-lib-path=: \\\n"
              , "  --disable-multilib \\\n"
              , "  --disable-nls \\\n"
              , "  --disable-werror \\\n"
              , "  --disable-gprofng \\\n"
              , "  --without-debuginfod \\\n"
              , "  --enable-plugins \\\n"
              , "  --enable-deterministic-archives\n"
              , "\n"
              , "echo \"=== Building binutils (jobs=$jobs) ===\"\n"
              , "make -j \"$jobs\" SHELL=\"$build_shell\" MAKEINFO=true POD2MAN=\"$POD2MAN\" AM_UPDATE_INFO_DIR=no\n"
              , "\n"
              , "echo \"=== Installing ===\"\n"
              , "make install SHELL=\"$build_shell\" MAKEINFO=true POD2MAN=\"$POD2MAN\" AM_UPDATE_INFO_DIR=no\n"
              , "\n"
              , "echo \"=== Removing build-only metadata and documentation ===\"\n"
              , "rm -rf \"$out/share/man\" \"$out/share/info\"\n"
              , "find \"$out\" -name \"*.la\" -type f -delete\n"
              , "\n"
              , "echo \"=== Stripping debug sections ===\"\n"
              , "while IFS= read -r -d '' file; do\n"
              , "  if \"$READELF\" -h \"$file\" >/dev/null 2>&1; then\n"
              , "    \"$STRIP\" --strip-debug \"$file\"\n"
              , "  fi\n"
              , "done < <(find \"$out\" -type f -print0)\n"
              , "\n"
              , "echo \"=== Verifying self-containment ===\"\n"
              , "\"$out/bin/ld\" --print-sysroot || true\n"
              , "\"$out/bin/ld\" --verbose 2>/dev/null | grep \"SEARCH_DIR\" | head -1 || true\n"
              , "echo \"--- ld binary ---\"\n"
              , "\"$READELF\" -l \"$out/bin/ld\" 2>/dev/null | grep \"Requesting program interpreter\" || true\n"
              , "\"$READELF\" -d \"$out/bin/ld\" 2>/dev/null | grep -E \"RPATH|RUNPATH\" || true\n"
              , "echo \"--- as binary ---\"\n"
              , "\"$READELF\" -l \"$out/bin/as\" 2>/dev/null | grep \"Requesting program interpreter\" || true\n"
              , "\"$READELF\" -d \"$out/bin/as\" 2>/dev/null | grep -E \"RPATH|RUNPATH\" || true"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "imeplfa6zl7e2prrmyxvkm6htg2qye727chyivkvars3raq45vgq-gcc":
      { "id": "imeplfa6zl7e2prrmyxvkm6htg2qye727chyivkvars3raq45vgq-gcc"
      , "name": "gcc"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "6fkbbg6pc4yfhgvgo5pvqnh3447niza2cjqxt27aibzytwyzdj7a-mpfr-4.1.0.tar.bz2"
          , "alias": "mpfr_src"
          , "transitive": "false"
          }
        , { "brick": "2gnnygccogetfxv3mfq5wrsghkq4swdc45zuyny7q3jyhq5xwe3a-mpc-1.2.1.tar.gz"
          , "alias": "mpc_src"
          , "transitive": "false"
          }
        , { "brick": "6qywaqu63vt3ydbo74p2fqxifkn77izwg5amobej6nca3oao2xla-isl-0.24.tar.bz2"
          , "alias": "isl_src"
          , "transitive": "false"
          }
        , { "brick": "apwv2emy6cpgfjhifot4on26vbuiigqxu2nabpoyf42xknawsowa-gmp-6.2.1.tar.bz2"
          , "alias": "gmp_src"
          , "transitive": "false"
          }
        , { "brick": "lkvwp2vgtnqksd4pvrkpdnnyohghv2t4eufxpfrczxeijtowkjba-gcc-14.2.0.tar.xz"
          , "alias": "gcc_src"
          , "transitive": "false"
          }
        , { "brick": "bcijixntbfjfueijbqlib6knpsyc36k6jzcnlakihhimsazq2b7a-python3"
          , "alias": "python3"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "export PATH=\"$out/bin:$PATH\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "odzciqpr5fl5qqpdqnohs7qpqqwvahqodbydsv7er2ztrfnfhbuq-bootstrap-env"
          , "alias": "bootstrap_env"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$out/setup-env.sh\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "mi65hk5fk6kh6hh7rtv3dp2aff6z3zadlz3kqt6pc5thxhfas4xa-linux-headers"
          , "alias": "linux_headers"
          , "transitive": "false"
          }
        , { "brick": "fynes4jr5ntfmo2jjyaquumpfr4ucq35bbc5nmcge6o7bcgldoiq-binutils-cross"
          , "alias": "binutils_cross"
          , "transitive": "false"
          }
        , { "brick": "jvkfwgfep6e6qwbgfpblin3txpogtyrlb7uc3kbj3trfalngsh6q-glibc-cross"
          , "alias": "glibc_cross"
          , "transitive": "true"
          }
        , { "brick": "6tvdn5ancn4exj4lpigfvjqpw5e37vcgjhtdpvstmzkhdu3yx7ba-gcc-cross"
          , "alias": "gcc_cross"
          , "transitive": "false"
          }
        , { "brick": "nzb2pbw34bakjvazqm2mvjmsicsn7rtucdvssslrrux4e2fwh7na-binutils"
          , "alias": "binutils_native"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "BUILD_JOBS all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "gcc_version"
          , "value": "14.2.0"
          }
        , { "name": "ld_linux_name"
          , "value": "ld-linux-x86-64.so.2"
          }
        , { "name": "target_triple"
          , "value": "x86_64-linux-gnu"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "jobs=\"${BUILD_JOBS:-$(nproc)}\"\n"
              , "is_elf() {\n"
              , "  [ -f \"$1\" ] && [ \"$(LC_ALL=C head -c 4 \"$1\" 2>/dev/null)\" = \"$(printf '\\177ELF')\" ]\n"
              , "}\n"
              , "\n"
              , "echo \"=== Extracting GCC ${gcc_version} ===\"\n"
              , "tar xf \"$gcc_src\"\n"
              , "cd \"gcc-${gcc_version}\"\n"
              , "\n"
              , "echo \"=== Extracting GCC prerequisites ===\"\n"
              , "for prereq in \"$gmp_src\" \"$mpfr_src\" \"$mpc_src\" \"$isl_src\"; do\n"
              , "  echo \"  Extracting $(basename \"$prereq\")...\"\n"
              , "  tar xf \"$prereq\"\n"
              , "done\n"
              , "ln -sf gmp-6.2.1 gmp\n"
              , "ln -sf mpfr-4.1.0 mpfr\n"
              , "ln -sf mpc-1.2.1 mpc\n"
              , "ln -sf isl-0.24 isl\n"
              , "\n"
              , "echo \"=== Configuring native GCC (target=${target_triple}) ===\"\n"
              , "mkdir build && cd build\n"
              , "\n"
              , "# Use gcc-cross as the host compiler (statically linked, runs everywhere).\n"
              , "# -B${glibc_cross}/lib tells GCC where to find crt*.o startup files.\n"
              , "# --sysroot points to a build-time sysroot with glibc+kernel headers.\n"
              , "# --with-sysroot=$out tells the installed GCC where its sysroot lives.\n"
              , "sysroot=\"$PWD/sysroot\"\n"
              , "mkdir -p \"$sysroot/usr/include\" \"$sysroot/usr/lib\"\n"
              , "cp -a \"${linux_headers}/include/\"* \"$sysroot/usr/include/\"\n"
              , "cp -a \"${glibc_cross}/include/\"* \"$sysroot/usr/include/\"\n"
              , "cp -a \"${glibc_cross}/lib/\"* \"$sysroot/usr/lib/\"\n"
              , "ln -sf usr/lib \"$sysroot/lib64\"\n"
              , "\n"
              , "# Patch libc.so/libm.so linker scripts for sysroot-relative paths\n"
              , "sed -i \"s|${glibc_cross}/lib/|/usr/lib/|g\" \"$sysroot/usr/lib/libc.so\"\n"
              , "if ! is_elf \"$sysroot/usr/lib/libm.so\"; then\n"
              , "  sed -i \"s|${glibc_cross}/lib/|/usr/lib/|g\" \"$sysroot/usr/lib/libm.so\"\n"
              , "fi\n"
              , "\n"
              , "# Pre-create $out sysroot structure so xgcc (stage1) can find glibc\n"
              , "mkdir -p \"$out/usr/include\" \"$out/usr/lib\" \"$out/lib\"\n"
              , "cp -a \"${linux_headers}/include/\"* \"$out/usr/include/\"\n"
              , "cp -a \"${glibc_cross}/include/\"* \"$out/usr/include/\"\n"
              , "cp -a \"${glibc_cross}/lib/\"*.so* \"$out/usr/lib/\" 2>/dev/null || true\n"
              , "cp -a \"${glibc_cross}/lib/\"*.a \"$out/usr/lib/\" 2>/dev/null || true\n"
              , "cp -a \"${glibc_cross}/lib/\"*.o \"$out/usr/lib/\" 2>/dev/null || true\n"
              , "# Patch linker scripts in $out/usr/lib for sysroot-relative paths\n"
              , "for f in \"$out/usr/lib/libc.so\" \"$out/usr/lib/libm.so\"; do\n"
              , "  if [ -f \"$f\" ] && ! is_elf \"$f\"; then\n"
              , "    sed -i \"s|${glibc_cross}/lib/|/usr/lib/|g\" \"$f\"\n"
              , "  fi\n"
              , "done\n"
              , "# ld-linux must also be in $out/lib for --with-sysroot to find it\n"
              , "cp -a \"${glibc_cross}/lib/${ld_linux_name}\" \"$out/lib/\" 2>/dev/null || true\n"
              , "\n"
              , "export CC=\"${gcc_cross}/bin/${target_triple}-gcc -fno-lto -B${glibc_cross}/lib --sysroot=$sysroot\"\n"
              , "export CXX=\"${gcc_cross}/bin/${target_triple}-g++ -fno-lto -B${glibc_cross}/lib --sysroot=$sysroot\"\n"
              , "export AR=\"${binutils_cross}/bin/${target_triple}-ar\"\n"
              , "export RANLIB=\"${binutils_cross}/bin/${target_triple}-ranlib\"\n"
              , "build_shell=\"$bootstrap_env/bin/bash\"\n"
              , "export CONFIG_SHELL=\"$build_shell\"\n"
              , "export SHELL=\"$build_shell\"\n"
              , "export MAKEINFO=true\n"
              , "\n"
              , "mkdir -p \"$PWD/bin-wrappers\"\n"
              , "{\n"
              , "  printf '#!%s\\n' \"$build_shell\"\n"
              , "  printf '%s\\n' \\\n"
              , "    'out=' \\\n"
              , "    'while [ \"$#\" -gt 0 ]; do' \\\n"
              , "    '  case \"$1\" in' \\\n"
              , "    '    --output=*) out=\"${1#--output=}\" ;;' \\\n"
              , "    '    --output) shift; out=\"${1:-}\" ;;' \\\n"
              , "    '  esac' \\\n"
              , "    '  shift || break' \\\n"
              , "    'done' \\\n"
              , "    'if [ -n \"$out\" ]; then : > \"$out\"; fi' \\\n"
              , "    'exit 0'\n"
              , "} > \"$PWD/bin-wrappers/pod2man\"\n"
              , "\n"
              , "# Wrap AR/RANLIB to strip --plugin args (build system adds them automatically\n"
              , "# but the host binutils-cross was built without plugin support)\n"
              , "printf '#!%s\\nargs=\"\"\\nskip_next=false\\nfor arg in \"$@\"; do\\n  if $skip_next; then skip_next=false; continue; fi\\n  case \"$arg\" in\\n    --plugin) skip_next=true ;;\\n    --plugin=*) ;;\\n    *) args=\"$args $arg\" ;;\\n  esac\\ndone\\nexec %s/bin/%s-ar $args\\n' \"$build_shell\" \"${binutils_cross}\" \"${target_triple}\" > \"$PWD/bin-wrappers/ar\"\n"
              , "printf '#!%s\\nargs=\"\"\\nskip_next=false\\nfor arg in \"$@\"; do\\n  if $skip_next; then skip_next=false; continue; fi\\n  case \"$arg\" in\\n    --plugin) skip_next=true ;;\\n    --plugin=*) ;;\\n    *) args=\"$args $arg\" ;;\\n  esac\\ndone\\nexec %s/bin/%s-ranlib $args\\n' \"$build_shell\" \"${binutils_cross}\" \"${target_triple}\" > \"$PWD/bin-wrappers/ranlib\"\n"
              , "chmod +x \"$PWD/bin-wrappers/ar\" \"$PWD/bin-wrappers/ranlib\" \"$PWD/bin-wrappers/pod2man\"\n"
              , "export AR=\"$PWD/bin-wrappers/ar\"\n"
              , "export RANLIB=\"$PWD/bin-wrappers/ranlib\"\n"
              , "export POD2MAN=\"$PWD/bin-wrappers/pod2man\"\n"
              , "export PATH=\"$PWD/bin-wrappers:${binutils_cross}/bin:${binutils_native}/bin:$PATH\"\n"
              , "export AS_FOR_TARGET=\"${binutils_native}/bin/as\"\n"
              , "export LD_FOR_TARGET=\"${binutils_native}/bin/ld\"\n"
              , "export AR_FOR_TARGET=\"${binutils_native}/bin/ar\"\n"
              , "export RANLIB_FOR_TARGET=\"${binutils_native}/bin/ranlib\"\n"
              , "export NM_FOR_TARGET=\"${binutils_native}/bin/nm\"\n"
              , "export OBJCOPY_FOR_TARGET=\"${binutils_native}/bin/objcopy\"\n"
              , "export OBJDUMP_FOR_TARGET=\"${binutils_native}/bin/objdump\"\n"
              , "export READELF_FOR_TARGET=\"${binutils_native}/bin/readelf\"\n"
              , "export STRIP_FOR_TARGET=\"${binutils_native}/bin/strip\"\n"
              , "\n"
              , "# Target libraries invoke target binutils by program name during nested\n"
              , "# makes, so bind them to declared tools rather than host-installed ones.\n"
              , "export PATH=\"${binutils_cross}/bin:${binutils_native}/bin:${PATH}\"\n"
              , "export AS_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-as\"\n"
              , "export LD_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-ld\"\n"
              , "export AR_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-ar\"\n"
              , "export RANLIB_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-ranlib\"\n"
              , "export NM_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-nm\"\n"
              , "export STRIP_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-strip\"\n"
              , "export OBJDUMP_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-objdump\"\n"
              , "export OBJCOPY_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-objcopy\"\n"
              , "export READELF_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-readelf\"\n"
              , "\n"
              , "# LDFLAGS embeds glibc-cross interpreter/rpath into all output binaries.\n"
              , "# LDFLAGS_FOR_TARGET must also include --dynamic-linker so target conftest\n"
              , "# programs run with glibc-cross's ld-linux instead of the system one.\n"
              , "export CFLAGS=\"\"\n"
              , "export CXXFLAGS=\"\"\n"
              , "glibc_rpath=\"${glibc_cross}/lib\"\n"
              , "ldflags_common=\"-L${glibc_rpath} -Wl,--dynamic-linker=${glibc_rpath}/${ld_linux_name} -Wl,-rpath,${glibc_rpath}\"\n"
              , "export LDFLAGS=\"${ldflags_common}\"\n"
              , "export LDFLAGS_FOR_TARGET=\"${ldflags_common}\"\n"
              , "\n"
              , "\"$build_shell\" ../configure \\\n"
              , "  --prefix=\"$out\" \\\n"
              , "  --build=\"${target_triple}\" \\\n"
              , "  --host=\"${target_triple}\" \\\n"
              , "  --target=\"${target_triple}\" \\\n"
              , "  --enable-languages=c,c++ \\\n"
              , "  --enable-shared \\\n"
              , "  --enable-threads=posix \\\n"
              , "  --enable-__cxa_atexit \\\n"
              , "  --enable-default-pie \\\n"
              , "  --enable-default-ssp \\\n"
              , "  --disable-libssp \\\n"
              , "  --disable-multilib \\\n"
              , "  --disable-nls \\\n"
              , "  --disable-werror \\\n"
              , "  --disable-plugins \\\n"
              , "  --disable-lto \\\n"
              , "  --disable-bootstrap \\\n"
              , "  --with-as=\"${binutils_native}/bin/as\" \\\n"
              , "  --with-ld=\"${binutils_native}/bin/ld\" \\\n"
              , "  --with-local-prefix=\"$out\" \\\n"
              , "  --with-sysroot=\"$out\"\n"
              , "\n"
              , "echo \"=== Building native GCC (jobs=$jobs) ===\"\n"
              , "make BOOT_LDFLAGS=\"${ldflags_common}\" -j \"$jobs\" SHELL=\"$build_shell\" MAKEINFO=true POD2MAN=\"$POD2MAN\"\n"
              , "\n"
              , "echo \"=== Installing ===\"\n"
              , "make install SHELL=\"$build_shell\" MAKEINFO=true POD2MAN=\"$POD2MAN\"\n"
              , "\n"
              , "echo \"=== Removing build-only documentation and install tools ===\"\n"
              , "rm -rf \\\n"
              , "  \"$out/share/man\" \\\n"
              , "  \"$out/share/info\" \\\n"
              , "  \"$out/lib/gcc/${target_triple}/${gcc_version}/install-tools\" \\\n"
              , "  \"$out/libexec/gcc/${target_triple}/${gcc_version}/install-tools\"\n"
              , "\n"
              , "# Copy glibc runtime libraries into $out/lib for self-containment\n"
              , "echo \"=== Installing glibc runtime ===\"\n"
              , "cp -a \"${glibc_cross}/lib/\"*.so* \"$out/lib/\" 2>/dev/null || true\n"
              , "cp -a \"${glibc_cross}/lib/\"*.a \"$out/lib/\" 2>/dev/null || true\n"
              , "cp -a \"${glibc_cross}/lib/\"*.o \"$out/lib/\" 2>/dev/null || true\n"
              , "\n"
              , "# Ensure linker scripts in $out/lib use correct self-referencing paths\n"
              , "for f in \"$out/lib/libc.so\" \"$out/lib/libm.so\"; do\n"
              , "  if [ -f \"$f\" ] && ! is_elf \"$f\"; then\n"
              , "    sed -i \"s|${glibc_cross}/lib/||g\" \"$f\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "echo \"=== Stripping debug sections ===\"\n"
              , "readelf_tool=\"${binutils_native}/bin/readelf\"\n"
              , "strip_tool=\"${binutils_native}/bin/strip\"\n"
              , "while IFS= read -r -d '' file; do\n"
              , "  if \"$readelf_tool\" -h \"$file\" >/dev/null 2>&1; then\n"
              , "    \"$strip_tool\" --strip-debug \"$file\"\n"
              , "  else\n"
              , "    case \"$file\" in\n"
              , "      *.a) \"$strip_tool\" --strip-debug \"$file\" 2>/dev/null || true ;;\n"
              , "    esac\n"
              , "  fi\n"
              , "done < <(find \"$out\" -type f -print0)\n"
              , "\n"
              , "echo \"=== Native GCC build complete ===\"\n"
              , "\"$out/bin/gcc\" --version 2>&1 | head -1 || true\n"
              , "\"$out/bin/g++\" --version 2>&1 | head -1 || true\n"
              , "\n"
              , "echo \"=== Self-containment check ===\"\n"
              , "\"$READELF_FOR_TARGET\" -l \"$out/bin/gcc\" 2>/dev/null | grep \"Requesting program interpreter\" || true\n"
              , "\"$READELF_FOR_TARGET\" -d \"$out/bin/gcc\" 2>/dev/null | grep -E \"RPATH|RUNPATH\" || true\n"
              , "\"$READELF_FOR_TARGET\" -l \"$out/libexec/gcc/${target_triple}/14.2.0/cc1\" 2>/dev/null | grep \"Requesting program interpreter\" || true"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "yv3d46ueo4dxkdyjw4goau4ndtb2e2u2i7gh7jkowieof3hqoxkq-gcc-glibc":
      { "id": "yv3d46ueo4dxkdyjw4goau4ndtb2e2u2i7gh7jkowieof3hqoxkq-gcc-glibc"
      , "name": "gcc-glibc"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "cm5le2xhmapvc7ocadlvrx3k7n7bf35nr6rodwvc5fktgx62urkq-zlib-1.3.2.tar.gz"
          , "alias": "zlib_src"
          , "transitive": "false"
          }
        , { "brick": "odzciqpr5fl5qqpdqnohs7qpqqwvahqodbydsv7er2ztrfnfhbuq-bootstrap-env"
          , "alias": "bootstrap_env"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$out/setup-env.sh\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "mi65hk5fk6kh6hh7rtv3dp2aff6z3zadlz3kqt6pc5thxhfas4xa-linux-headers"
          , "alias": "linux_headers"
          , "transitive": "false"
          }
        , { "brick": "jvkfwgfep6e6qwbgfpblin3txpogtyrlb7uc3kbj3trfalngsh6q-glibc-cross"
          , "alias": "glibc"
          , "transitive": "true"
          }
        , { "brick": "nzb2pbw34bakjvazqm2mvjmsicsn7rtucdvssslrrux4e2fwh7na-binutils"
          , "alias": "binutils"
          , "transitive": "true"
          }
        , { "brick": "imeplfa6zl7e2prrmyxvkm6htg2qye727chyivkvars3raq45vgq-gcc"
          , "alias": "gcc_native"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "BUILD_JOBS all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "gcc_major"
          , "value": "14"
          }
        , { "name": "gcc_version"
          , "value": "14.2.0"
          }
        , { "name": "ld_linux_name"
          , "value": "ld-linux-x86-64.so.2"
          }
        , { "name": "target_triple"
          , "value": "x86_64-linux-gnu"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "echo \"=== Assembling GCC toolchain ===\"\n"
              , "is_elf() {\n"
              , "  [ -f \"$1\" ] && [ \"$(LC_ALL=C head -c 4 \"$1\" 2>/dev/null)\" = \"$(printf '\\177ELF')\" ]\n"
              , "}\n"
              , "\n"
              , "gcc_libdir=\"$out/lib/gcc/${target_triple}/${gcc_version}\"\n"
              , "gcc_libexecdir=\"$out/libexec/gcc/${target_triple}/${gcc_version}\"\n"
              , "\n"
              , "mkdir -p \"$out/bin\" \"$out/lib\" \"$gcc_libdir\" \"$gcc_libexecdir\" \"$out/include\"\n"
              , "\n"
              , "# --- GCC compiler binaries (copy so specs resolve relative to $out) ---\n"
              , "for bin in gcc g++ cpp gcov gcov-dump gcov-tool gcc-ar gcc-nm gcc-ranlib; do\n"
              , "  [ -f \"${gcc_native}/bin/$bin\" ] && cp -a \"${gcc_native}/bin/$bin\" \"$out/bin/\"\n"
              , "done\n"
              , "ln -sf gcc \"$out/bin/cc\"\n"
              , "ln -sf g++ \"$out/bin/c++\"\n"
              , "\n"
              , "# --- Binutils ---\n"
              , "for tool in ar as ld ld.bfd nm objcopy objdump ranlib readelf size \\\n"
              , "            strings strip addr2line c++filt elfedit gprof; do\n"
              , "  [ -f \"${binutils}/bin/$tool\" ] && ln -sf \"${binutils}/bin/$tool\" \"$out/bin/$tool\"\n"
              , "done\n"
              , "\n"
              , "# --- GCC internal executables (symlink to original) ---\n"
              , "for f in cc1 cc1plus collect2 lto-wrapper lto1 g++-mapper-server; do\n"
              , "  src=\"${gcc_native}/libexec/gcc/${target_triple}/${gcc_version}/$f\"\n"
              , "  [ -f \"$src\" ] && ln -sf \"$src\" \"$gcc_libexecdir/$f\"\n"
              , "done\n"
              , "# Symlink binutils into libexec so collect2 can find them\n"
              , "for tool in ld as nm ar ranlib objcopy objdump strip; do\n"
              , "  [ -f \"$out/bin/$tool\" ] && [ ! -e \"$gcc_libexecdir/$tool\" ] && \\\n"
              , "    ln -sf \"$out/bin/$tool\" \"$gcc_libexecdir/$tool\"\n"
              , "done\n"
              , "\n"
              , "# --- GCC internal includes and crt objects ---\n"
              , "src_gcc_lib=\"${gcc_native}/lib/gcc/${target_triple}/${gcc_version}\"\n"
              , "ln -sf \"$src_gcc_lib/include\" \"$gcc_libdir/include\"\n"
              , "ln -sf \"$src_gcc_lib/include-fixed\" \"$gcc_libdir/include-fixed\"\n"
              , "cp -a \"$src_gcc_lib\"/*.o \"$gcc_libdir/\" 2>/dev/null || true\n"
              , "cp -a \"$src_gcc_lib\"/*.a \"$gcc_libdir/\" 2>/dev/null || true\n"
              , "\n"
              , "# --- GCC runtime shared libraries (from lib64/) ---\n"
              , "if [ -d \"${gcc_native}/lib64\" ]; then\n"
              , "  find \"${gcc_native}/lib64\" -maxdepth 1 \\( -name \"*.so*\" -o -name \"*.a\" \\) \\\n"
              , "    -exec cp -a {} \"$out/lib/\" \\;\n"
              , "fi\n"
              , "# lib64 -> lib symlink for GCC's search paths\n"
              , "ln -sf lib \"$out/lib64\"\n"
              , "\n"
              , "# --- glibc libraries and crt objects ---\n"
              , "cp -a \"${glibc}/lib/\"*.so* \"$out/lib/\" 2>/dev/null || true\n"
              , "cp -a \"${glibc}/lib/\"*.a \"$out/lib/\" 2>/dev/null || true\n"
              , "cp -a \"${glibc}/lib/\"*.o \"$out/lib/\" 2>/dev/null || true\n"
              , "\n"
              , "# --- Headers ---\n"
              , "cp -a \"${glibc}/include/\"* \"$out/include/\"\n"
              , "cp -a \"${linux_headers}/include/\"* \"$out/include/\"\n"
              , "if [ -d \"${gcc_native}/include/c++\" ]; then\n"
              , "  mkdir -p \"$out/include/c++\"\n"
              , "  cp -a \"${gcc_native}/include/c++/\"* \"$out/include/c++/\"\n"
              , "fi\n"
              , "\n"
              , "# --- Fix glibc linker scripts to use $out paths ---\n"
              , "for f in \"$out/lib/libc.so\" \"$out/lib/libm.so\"; do\n"
              , "  if [ -f \"$f\" ] && ! is_elf \"$f\"; then\n"
              , "    sed -i \"s|${glibc}/lib/||g\" \"$f\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# --- Create GCC specs for self-contained output ---\n"
              , "gcc_specs=\"$gcc_libdir/specs\"\n"
              , "\"${gcc_native}/bin/gcc\" -dumpspecs > \"$gcc_specs\"\n"
              , "\n"
              , "# Replace system dynamic linker paths with store paths.\n"
              , "# x86_64 uses /lib64/ prefix for ld-linux-x86-64, aarch64 uses /lib/\n"
              , "sed -i \"s|/lib/ld-linux-aarch64|$out/lib/ld-linux-aarch64|g; \\\n"
              , "        s|/lib64/ld-linux-x86-64|$out/lib/ld-linux-x86-64|g; \\\n"
              , "        s|/libx32/ld-linux-x32|$out/lib/ld-linux-x32|g; \\\n"
              , "        s|/lib/ld-linux.so|$out/lib/ld-linux.so|g; \\\n"
              , "        s|/lib/ld-musl-|$out/lib/ld-musl-|g\" \"$gcc_specs\"\n"
              , "\n"
              , "# Add -rpath so compiled output binaries find store libs at runtime.\n"
              , "sed -i \"s|%(link_gcc_c_sequence)}}|%(link_gcc_c_sequence)}} -rpath $out/lib|\" \"$gcc_specs\"\n"
              , "\n"
              , "# --- Build and install zlib (needed by LLVM/rustc) ---\n"
              , "echo \"=== Building zlib ===\"\n"
              , "tar -xzf \"$zlib_src\"\n"
              , "cd zlib-*/\n"
              , "build_shell=\"$bootstrap_env/bin/bash\"\n"
              , "export CONFIG_SHELL=\"$build_shell\"\n"
              , "export SHELL=\"$build_shell\"\n"
              , "CC=\"$out/bin/gcc\" \\\n"
              , "  CFLAGS=\"-O2 -fPIC\" \\\n"
              , "  LDFLAGS=\"-Wl,-rpath,$out/lib -Wl,--dynamic-linker,$out/lib/${ld_linux_name}\" \\\n"
              , "  \"$build_shell\" ./configure --prefix=\"$out\"\n"
              , "make -j\"${BUILD_JOBS:-$(nproc)}\" SHELL=\"$build_shell\"\n"
              , "make install SHELL=\"$build_shell\"\n"
              , "cd ..\n"
              , "\n"
              , "# --- Self-containment notes ---\n"
              , "# GCC binaries (copied from gcc-native) already have correct interpreter and\n"
              , "# rpath pointing to glibc-cross in the store. Shared libs from glibc-cross are\n"
              , "# self-contained. No patchelf needed — all paths are within /var/lib/rubble/store.\n"
              , "\n"
              , "# === Verification ===\n"
              , "echo \"\"\n"
              , "echo \"=== GCC toolchain assembled ===\"\n"
              , "\"$out/bin/gcc\" --version | head -1 || true\n"
              , "\n"
              , "echo \"=== Self-containment check ===\"\n"
              , "\"$out/bin/readelf\" -l \"$out/bin/gcc\" 2>/dev/null | grep \"interpreter\" || true\n"
              , "\"$out/bin/readelf\" -d \"$out/bin/gcc\" 2>/dev/null | grep -E \"RPATH|RUNPATH\" || true\n"
              , "\n"
              , "echo \"=== Compilation test ===\"\n"
              , "test_source=\"${TMP}/test_tc.c\"\n"
              , "test_binary=\"${TMP}/test_tc\"\n"
              , "printf '#include <stdio.h>\\nint main() { printf(\"Hello from toolchain!\\\\n\"); return 0; }\\n' > \"$test_source\"\n"
              , "\"$out/bin/gcc\" -o \"$test_binary\" \"$test_source\" 2>&1 || true\n"
              , "if [ -f \"$test_binary\" ]; then\n"
              , "  echo \"Output binary:\"\n"
              , "  \"$out/bin/readelf\" -l \"$test_binary\" 2>/dev/null | grep \"interpreter\" || true\n"
              , "  \"$out/bin/readelf\" -d \"$test_binary\" 2>/dev/null | grep -E \"RPATH|RUNPATH\" || true\n"
              , "  \"$test_binary\" || echo \"(test binary could not run - expected during cross build)\"\n"
              , "fi\n"
              , "rm -f \"$test_source\" \"$test_binary\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "6c27hhwo3t5rbvmuglu67jrqofxvkryimxpcrdyxvntmipbamqca-rustc-1.94.0":
      { "id": "6c27hhwo3t5rbvmuglu67jrqofxvkryimxpcrdyxvntmipbamqca-rustc-1.94.0"
      , "name": "rustc-1.94.0"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "p35fui5viqtrg47hzy5wwvgkewwbtgsqytapgqav4jzy4w5vud4a-rustc-1.94.0-x86_64-unknown-linux-gnu.tar.xz"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "c5mx6r24inu4xhdgcdtdjpfflxamue4idrmbz4koxqv6frtuwjwq-rust-std-1.94.0"
          , "alias": "rust_std"
          , "transitive": "false"
          }
        , { "brick": "ztbwuqmg77pfi6tzkoy4asfmpiy22x6lugzprlhhhvjldam36n4q-rubble-script-shebang"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$script\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "4z45nx65xw3y3yxdn5rw2qf5jwclaclnqqfhofeig6xotqxb7ajq-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "bxchorbehgapcopsqwo7w5zwjgenujywlkkytlnad3dvy5hpqc5q-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "yv3d46ueo4dxkdyjw4goau4ndtb2e2u2i7gh7jkowieof3hqoxkq-gcc-glibc"
          , "alias": "gcc_glibc"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar --strip-components=1 -Jxvf \"$src\"\n"
              , "mkdir -pv \"$out\"\n"
              , "mv rustc/bin \"$out\"\n"
              , "mv rustc/libexec \"$out\"\n"
              , "mv rustc/lib \"$out\"\n"
              , "\n"
              , "# Install rust-std into sysroot so rustc can find std for host compilation\n"
              , "for target_dir in \"$rust_std\"/lib/rustlib/*/lib; do\n"
              , "  target=$(basename \"$(dirname \"$target_dir\")\")\n"
              , "  mkdir -p \"$out/lib/rustlib/$target\"\n"
              , "  cp -a \"$target_dir\" \"$out/lib/rustlib/$target/\"\n"
              , "done\n"
              , "\n"
              , "# On Linux, patchelf ELF binaries to use store's glibc dynamic linker\n"
              , "if [ -n \"${gcc_glibc:-}\" ]; then\n"
              , "  rubble_script_shebang_register \"$bash/bin/bash\" sh bash\n"
              , "\n"
              , "  shebang_scripts=()\n"
              , "  for script in \"$out/bin/rust-gdb\" \"$out/bin/rust-gdbgui\" \"$out/bin/rust-lldb\"; do\n"
              , "    [ -f \"$script\" ] || continue\n"
              , "    shebang_scripts+=(\"$script\")\n"
              , "  done\n"
              , "  if ((${#shebang_scripts[@]} > 0)); then\n"
              , "    rubble_script_shebang_rewrite_all --strict \"${shebang_scripts[@]}\"\n"
              , "  fi\n"
              , "\n"
              , "  ld_linux=$(echo \"$gcc_glibc\"/lib/ld-linux-*.so.* | awk '{print $1}')\n"
              , "  lib_path=\"$gcc_glibc/lib:$out/lib\"\n"
              , "\n"
              , "  # Patch executables (set interpreter + rpath)\n"
              , "  find \"$out/bin\" \"$out/libexec\" \"$out/lib/rustlib\" -type f 2>/dev/null | while read -r f; do\n"
              , "    \"$gcc_glibc/bin/readelf\" -l \"$f\" 2>/dev/null | grep -q \"INTERP\" || continue\n"
              , "    \"$patchelf\" --set-interpreter \"$ld_linux\" --set-rpath \"$lib_path\" \"$f\"\n"
              , "  done\n"
              , "\n"
              , "  # Patch shared libraries (set rpath so transitive deps resolve)\n"
              , "  find \"$out/lib\" -name '*.so*' -type f 2>/dev/null | while read -r f; do\n"
              , "    \"$gcc_glibc/bin/readelf\" -h \"$f\" 2>/dev/null | grep -q \"DYN\" || continue\n"
              , "    \"$patchelf\" --set-rpath \"$lib_path\" \"$f\"\n"
              , "  done\n"
              , "fi"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "witvf4jysqronx2ikpiajarjnc6lzsi4sqlmelyluucni7sudcoa-llvm-tools-1.94.0":
      { "id": "witvf4jysqronx2ikpiajarjnc6lzsi4sqlmelyluucni7sudcoa-llvm-tools-1.94.0"
      , "name": "llvm-tools-1.94.0"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "4z45nx65xw3y3yxdn5rw2qf5jwclaclnqqfhofeig6xotqxb7ajq-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "hsyi55wlvnlzocc3t5nac44lqr62jzqndxhhgwdvwju3vshv6zla-llvm-tools-1.94.0-x86_64-unknown-linux-gnu.tar.xz"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "yv3d46ueo4dxkdyjw4goau4ndtb2e2u2i7gh7jkowieof3hqoxkq-gcc-glibc"
          , "alias": "gcc_glibc"
          , "transitive": "true"
          }
        , { "brick": "6c27hhwo3t5rbvmuglu67jrqofxvkryimxpcrdyxvntmipbamqca-rustc-1.94.0"
          , "alias": "rustc"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "target_triple=\"${src[name]#*${name}-}\"\n"
              , "target_triple=\"${target_triple%%.*}\"\n"
              , "tar --strip-components=1 -Jxvf \"$src\"\n"
              , "mkdir -pv \"$out\"\n"
              , "mv -v ./llvm-tools-preview/lib/rustlib/${target_triple}/bin \"$out\"\n"
              , "\n"
              , "# On Linux, patchelf ELF binaries to use store's glibc dynamic linker\n"
              , "if [ -n \"${gcc_glibc:-}\" ]; then\n"
              , "  ld_linux=$(echo \"$gcc_glibc\"/lib/ld-linux-*.so.* | awk '{print $1}')\n"
              , "  lib_path=\"$gcc_glibc/lib\"\n"
              , "  # llvm-tools binaries link against libLLVM.so from rustc\n"
              , "  [ -n \"${rustc:-}\" ] && lib_path=\"$lib_path:$rustc/lib\"\n"
              , "  for f in \"$out\"/bin/*; do\n"
              , "    [ -f \"$f\" ] && [ ! -L \"$f\" ] || continue\n"
              , "    \"$gcc_glibc/bin/readelf\" -l \"$f\" 2>/dev/null | grep -q \"INTERP\" || continue\n"
              , "    \"$patchelf\" --set-interpreter \"$ld_linux\" --set-rpath \"$lib_path\" \"$f\"\n"
              , "  done\n"
              , "fi"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "2zcsx4l6ph24tmaok5hwzpgr73kyxs3kxixfrxqodfw5ubmqhidq-linux-native-toolchain":
      { "id": "2zcsx4l6ph24tmaok5hwzpgr73kyxs3kxixfrxqodfw5ubmqhidq-linux-native-toolchain"
      , "name": "linux-native-toolchain"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "oolqu2vtbb4frcjavzuszx435gk62yg4qby6szr2w6rv4zzuj3zq-perl"
          , "alias": "perl"
          , "transitive": "true"
          }
        , { "brick": "yv3d46ueo4dxkdyjw4goau4ndtb2e2u2i7gh7jkowieof3hqoxkq-gcc-glibc"
          , "alias": "gcc"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "gcc_version"
          , "value": "14.2.0"
          }
        , { "name": "gnu_triple"
          , "value": "x86_64-linux-gnu"
          }
        , { "name": "ld_linux_name"
          , "value": "ld-linux-x86-64.so.2"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "while IFS= builtin read -r __rubble_output_line; do\n"
              , "  builtin printf '%s\\n' \"$__rubble_output_line\"\n"
              , "done > \"$out\" << EOF\n"
              , "# Linux Native Toolchain Environment (glibc GCC)\n"
              , "\n"
              , "# Add GCC and perl to PATH\n"
              , "export PATH=\"$perl/bin:$gcc/bin:\\${PATH}\"\n"
              , "\n"
              , "# Set PERL5LIB for OpenSSL build\n"
              , "export PERL5LIB=\"$perl/share/perl5/core_perl:$perl/lib/perl5/core_perl\\${PERL5LIB:+:}\\${PERL5LIB:-}\"\n"
              , "\n"
              , "# Set compiler environment variables\n"
              , "export CC=\"$gcc/bin/gcc\"\n"
              , "export CXX=\"$gcc/bin/g++\"\n"
              , "export AR=\"$gcc/bin/ar\"\n"
              , "export RANLIB=\"$gcc/bin/ranlib\"\n"
              , "export NM=\"$gcc/bin/nm\"\n"
              , "export LD=\"$gcc/bin/ld\"\n"
              , "\n"
              , "# Set include paths for glibc headers and GCC internal headers\n"
              , "export C_INCLUDE_PATH=\"$gcc/include:$gcc/lib/gcc/${gnu_triple}/${gcc_version}/include\"\n"
              , "export CPLUS_INCLUDE_PATH=\"$gcc/include/c++/${gcc_version}:$gcc/include/c++/${gcc_version}/${gnu_triple}:$gcc/include:$gcc/lib/gcc/${gnu_triple}/${gcc_version}/include\"\n"
              , "\n"
              , "# Prevent pkg-config from finding host system packages (hermetic build)\n"
              , "export PKG_CONFIG_LIBDIR=\"\"\n"
              , "\n"
              , "# Set linker and compiler flags\n"
              , "export LDFLAGS=\"-L$gcc/lib -L$gcc/lib/gcc/${gnu_triple}/${gcc_version} -Wl,--dynamic-linker=$gcc/lib/${ld_linux_name} -Wl,-rpath=$gcc/lib\"\n"
              , "export CFLAGS=\"-I$gcc/include -B$gcc/lib/gcc/${gnu_triple}/${gcc_version}\"\n"
              , "export CXXFLAGS=\"-I$gcc/include/c++/${gcc_version} -I$gcc/include -B$gcc/lib/gcc/${gnu_triple}/${gcc_version}\"\n"
              , "\n"
              , "# For Rust: set linker flags so compiled binaries use our bundled glibc\n"
              , "export RUSTFLAGS=\"\\${RUSTFLAGS:+\\${RUSTFLAGS} }-C link-arg=-L$gcc/lib -C link-arg=-L$gcc/lib/gcc/${gnu_triple}/${gcc_version} -C link-arg=-Wl,--dynamic-linker=$gcc/lib/${ld_linux_name} -C link-arg=-Wl,-rpath=$gcc/lib\"\n"
              , "\n"
              , "# Debug output\n"
              , "echo \"Linux Native Toolchain configured (glibc GCC):\"\n"
              , "echo \"  GCC: $gcc\"\n"
              , "echo \"  CC:   \\$CC\"\n"
              , "echo \"  PATH includes: $gcc/bin\"\n"
              , "\n"
              , "# Verify tools are available\n"
              , "type -a gcc cc || true\n"
              , "gcc --version | head -1 || true\n"
              , "EOF\n"
              , "builtin unset __rubble_output_line"
              ]
            , "format": "text"
            }
          }
        ]
      }
