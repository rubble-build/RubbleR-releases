        , { "shell": {
              "value": [
                "source \"${rubble_canonical_script[script]}\"\n"
              , "\n"
              , "if ! rubble_canonical_script > \"$script\" <<__PATCH_WRAPPER_CANONICAL_SCRIPT_207__\n"
              , "src_script=\"${brick[src:script]}\"\n"
              , "patchset_file=\"$patchset\"\n"
              , "added_path=\"$added\"\n"
              , "deleted_file=\"$deleted\"\n"
              , "renamed_file=\"$renamed\"\n"
              , "__PATCH_WRAPPER_CANONICAL_SCRIPT_207__\n"
              , "then\n"
              , "  __log_error \"failed to write canonical patch wrapper preamble\"\n"
              , "  builtin exit 1\n"
              , "fi\n"
              , "\n"
              , "if ! rubble-exec cat >> \"$script\" <<'__PATCH_WRAPPER_RAW_SCRIPT_207__'\n"
              , "builtin set -o pipefail\n"
              , "set -x\n"
              , "dest=\"${1:?missing destination dir}\"\n"
              , "\n"
              , "function __log_error() { builtin echo \"[ERROR] [patch-wrapper] $*\" >&2; }\n"
              , "function __log_info() { builtin echo \"[INFO] [patch-wrapper] $*\" >&2; }\n"
              , "function __log_debug() { builtin echo \"[DEBUG] [patch-wrapper] $*\" >&2; }\n"
              , "function __log_trace() { builtin echo \"[TRACE] [patch-wrapper] $*\" >&2; }\n"
              , "\n"
              , "function __rubble_patch_wrapper_validate_path() {\n"
              , "  builtin local record_kind=\"${1:?missing record kind}\"\n"
              , "  builtin local path=\"${2-}\"\n"
              , "  builtin local segment\n"
              , "  builtin local -a segments\n"
              , "  segments=()\n"
              , "\n"
              , "  if [[ -z \"$path\" ]]; then\n"
              , "    __log_error \"[PatchSet] ${record_kind}: path must not be empty\"\n"
              , "    builtin return 1\n"
              , "  else\n"
              , "    __log_trace \"[PatchSet] ${record_kind}: path is non-empty\"\n"
              , "  fi\n"
              , "  if [[ \"$path\" == /* || \"$path\" =~ ^[A-Za-z]: ]]; then\n"
              , "    __log_error \"[PatchSet] ${record_kind}: path must be relative: ${path}\"\n"
              , "    builtin return 1\n"
              , "  else\n"
              , "    __log_trace \"[PatchSet] ${record_kind}: path is relative: ${path}\"\n"
              , "  fi\n"
              , "  if [[ \"$path\" == *\\\\* ]]; then\n"
              , "    __log_error \"[PatchSet] ${record_kind}: path contains a backslash: ${path}\"\n"
              , "    builtin return 1\n"
              , "  else\n"
              , "    __log_trace \"[PatchSet] ${record_kind}: path uses portable separators: ${path}\"\n"
              , "  fi\n"
              , "  if [[ \"$path\" =~ [[:cntrl:]] || \"$path\" == *$'\\u2028'* || \"$path\" == *$'\\u2029'* ]]; then\n"
              , "    __log_error \"[PatchSet] ${record_kind}: path contains an ambiguous character\"\n"
              , "    builtin return 1\n"
              , "  else\n"
              , "    __log_trace \"[PatchSet] ${record_kind}: path contains no ambiguous characters: ${path}\"\n"
              , "  fi\n"
              , "  if [[ \"$path\" == */ || \"$path\" == *//* ]]; then\n"
              , "    __log_error \"[PatchSet] ${record_kind}: path contains an empty segment: ${path}\"\n"
              , "    builtin return 1\n"
              , "  else\n"
              , "    __log_trace \"[PatchSet] ${record_kind}: path contains no empty segments: ${path}\"\n"
              , "  fi\n"
              , "\n"
              , "  builtin local IFS=/\n"
              , "  builtin read -r -a segments <<< \"$path\"\n"
              , "  for segment in \"${segments[@]}\"; do\n"
              , "    if [[ \"$segment\" == \".\" || \"$segment\" == \"..\" ]]; then\n"
              , "      __log_error \"[PatchSet] ${record_kind}: path contains a traversal segment: ${path}\"\n"
              , "      builtin return 1\n"
              , "    else\n"
              , "      __log_trace \"[PatchSet] ${record_kind}: accepted path segment: ${segment}\"\n"
              , "    fi\n"
              , "  done\n"
              , "  __log_debug \"[PatchSet] ${record_kind}: accepted path: ${path}\"\n"
              , "}\n"
              , "\n"
              , "function __rubble_patch_wrapper_validate_manifest() {\n"
              , "  builtin local manifest_kind=\"${1:?missing manifest kind}\"\n"
              , "  builtin local manifest_file=\"${2:?missing manifest file}\"\n"
              , "  builtin local nul_prefix\n"
              , "\n"
              , "  if [[ -L \"$manifest_file\" || ! -f \"$manifest_file\" ]]; then\n"
              , "    __log_error \"[PatchSet] ${manifest_kind}: expected regular output file: ${manifest_file}\"\n"
              , "    builtin return 1\n"
              , "  else\n"
              , "    __log_trace \"[PatchSet] ${manifest_kind}: regular output file validated: ${manifest_file}\"\n"
              , "  fi\n"
              , "  if builtin read -r -d '' nul_prefix < \"$manifest_file\"; then\n"
              , "    __log_error \"[PatchSet] ${manifest_kind}: manifest contains NUL\"\n"
              , "    builtin return 1\n"
              , "  else\n"
              , "    __log_trace \"[PatchSet] ${manifest_kind}: manifest contains no NUL\"\n"
              , "  fi\n"
              , "}\n"
              , "\n"
              , "function __rubble_patch_wrapper_apply_patchset() {\n"
              , "  if [[ -L \"$patchset_file\" || ! -f \"$patchset_file\" ]]; then\n"
              , "    __log_error \"[PatchSet] patchset: expected regular output file: ${patchset_file}\"\n"
              , "    builtin return 1\n"
              , "  else\n"
              , "    __log_trace \"[PatchSet] patchset: regular output file validated: ${patchset_file}\"\n"
              , "  fi\n"
              , "  if [[ -s \"$patchset_file\" ]]; then\n"
              , "    __log_info \"[PatchSet] patchset: decompress and apply aggregate patch source=${patchset_file} destination=${dest} compression=zstd\"\n"
              , "    if (builtin cd \"$dest\" && rubble-exec zstd -dc -- \"$patchset_file\" | rubble-exec patch -p1); then\n"
              , "      __log_info \"[PatchSet] patchset: aggregate patch applied destination=${dest}\"\n"
              , "    else\n"
              , "      __log_error \"[PatchSet] patchset: aggregate patch failed source=${patchset_file} destination=${dest} compression=zstd\"\n"
              , "      builtin return 1\n"
              , "    fi\n"
              , "  else\n"
              , "    __log_debug \"[PatchSet] patchset: skip empty patchset sentinel: ${patchset_file}\"\n"
              , "  fi\n"
              , "}\n"
              , "\n"
              , "function __rubble_patch_wrapper_apply_additions() {\n"
              , "  if [[ -L \"$added_path\" ]]; then\n"
              , "    __log_error \"[PatchSet] added: symbolic-link output is invalid: ${added_path}\"\n"
              , "    builtin return 1\n"
              , "  elif [[ -d \"$added_path\" ]]; then\n"
              , "    __log_info \"[PatchSet] added: copy directory source=${added_path} destination=${dest}\"\n"
              , "    if rubble-exec cp -a -- \"$added_path/.\" \"$dest/\"; then\n"
              , "      __log_info \"[PatchSet] added: directory copied destination=${dest}\"\n"
              , "    else\n"
              , "      __log_error \"[PatchSet] added: directory copy failed source=${added_path} destination=${dest}\"\n"
              , "      builtin return 1\n"
              , "    fi\n"
              , "  elif [[ -f \"$added_path\" ]]; then\n"
              , "    if [[ -s \"$added_path\" ]]; then\n"
              , "      __log_error \"[PatchSet] added: regular-file sentinel must be empty: ${added_path}\"\n"
              , "      builtin return 1\n"
              , "    else\n"
              , "      __log_debug \"[PatchSet] added: skip empty regular-file sentinel: ${added_path}\"\n"
              , "    fi\n"
              , "  else\n"
              , "    __log_error \"[PatchSet] added: expected directory or empty regular-file sentinel: ${added_path}\"\n"
              , "    builtin return 1\n"
              , "  fi\n"
              , "}\n"
              , "\n"
              , "function __rubble_patch_wrapper_apply_deletions() {\n"
              , "  builtin local path\n"
              , "  builtin local record_count=0\n"
              , "\n"
              , "  if __rubble_patch_wrapper_validate_manifest \"deleted\" \"$deleted_file\"; then\n"
              , "    __log_trace \"[PatchSet] deleted: manifest validation completed\"\n"
              , "  else\n"
              , "    builtin return 1\n"
              , "  fi\n"
              , "  if [[ -s \"$deleted_file\" ]]; then\n"
              , "    __log_debug \"[PatchSet] deleted: process manifest: ${deleted_file}\"\n"
              , "  else\n"
              , "    __log_debug \"[PatchSet] deleted: skip empty manifest: ${deleted_file}\"\n"
              , "  fi\n"
              , "  while IFS= builtin read -r path || [[ -n \"$path\" ]]; do\n"
              , "    if __rubble_patch_wrapper_validate_path \"deleted record\" \"$path\"; then\n"
              , "      __log_trace \"[PatchSet] deleted: record path validated: ${path}\"\n"
              , "    else\n"
              , "      builtin return 1\n"
              , "    fi\n"
              , "    __log_info \"[PatchSet] deleted: remove path=${dest}/${path}\"\n"
              , "    if rubble-exec rm -f -- \"$dest/$path\"; then\n"
              , "      __log_trace \"[PatchSet] deleted: removed path=${dest}/${path}\"\n"
              , "    else\n"
              , "      __log_error \"[PatchSet] deleted: remove failed path=${dest}/${path}\"\n"
              , "      builtin return 1\n"
              , "    fi\n"
              , "    record_count=$((record_count + 1))\n"
              , "  done < \"$deleted_file\"\n"
              , "  __log_debug \"[PatchSet] deleted: processed records=${record_count}\"\n"
              , "}\n"
              , "\n"
              , "function __rubble_patch_wrapper_apply_renames() {\n"
              , "  builtin local line\n"
              , "  builtin local old_path\n"
              , "  builtin local new_path\n"
              , "  builtin local new_parent\n"
              , "  builtin local record_count=0\n"
              , "\n"
              , "  if __rubble_patch_wrapper_validate_manifest \"renamed\" \"$renamed_file\"; then\n"
              , "    __log_trace \"[PatchSet] renamed: manifest validation completed\"\n"
              , "  else\n"
              , "    builtin return 1\n"
              , "  fi\n"
              , "  if [[ -s \"$renamed_file\" ]]; then\n"
              , "    __log_debug \"[PatchSet] renamed: process manifest: ${renamed_file}\"\n"
              , "  else\n"
              , "    __log_debug \"[PatchSet] renamed: skip empty manifest: ${renamed_file}\"\n"
              , "  fi\n"
              , "  while IFS= builtin read -r line || [[ -n \"$line\" ]]; do\n"
              , "    if [[ \"$line\" == *$'\\t'* ]]; then\n"
              , "      __log_trace \"[PatchSet] renamed: record contains field separator\"\n"
              , "    else\n"
              , "      __log_error \"[PatchSet] renamed: record must contain one tab separator\"\n"
              , "      builtin return 1\n"
              , "    fi\n"
              , "    old_path=\"${line%%$'\\t'*}\"\n"
              , "    new_path=\"${line#*$'\\t'}\"\n"
              , "    if [[ \"$new_path\" == *$'\\t'* ]]; then\n"
              , "      __log_error \"[PatchSet] renamed: record contains more than one tab separator\"\n"
              , "      builtin return 1\n"
              , "    else\n"
              , "      __log_trace \"[PatchSet] renamed: record contains exactly one field separator\"\n"
              , "    fi\n"
              , "    if __rubble_patch_wrapper_validate_path \"rename source\" \"$old_path\"; then\n"
              , "      __log_trace \"[PatchSet] renamed: source path validated: ${old_path}\"\n"
              , "    else\n"
              , "      builtin return 1\n"
              , "    fi\n"
              , "    if __rubble_patch_wrapper_validate_path \"rename destination\" \"$new_path\"; then\n"
              , "      __log_trace \"[PatchSet] renamed: destination path validated: ${new_path}\"\n"
              , "    else\n"
              , "      builtin return 1\n"
              , "    fi\n"
              , "    if [[ \"$new_path\" == */* ]]; then\n"
              , "      new_parent=\"$dest/${new_path%/*}\"\n"
              , "      __log_trace \"[PatchSet] renamed: destination has nested parent: ${new_parent}\"\n"
              , "    else\n"
              , "      new_parent=\"$dest\"\n"
              , "      __log_trace \"[PatchSet] renamed: destination uses checkout root parent: ${new_parent}\"\n"
              , "    fi\n"
              , "    __log_info \"[PatchSet] renamed: create destination parent=${new_parent}\"\n"
              , "    if rubble-exec mkdir -p -- \"$new_parent\"; then\n"
              , "      __log_trace \"[PatchSet] renamed: destination parent ready=${new_parent}\"\n"
              , "    else\n"
              , "      __log_error \"[PatchSet] renamed: create destination parent failed=${new_parent}\"\n"
              , "      builtin return 1\n"
              , "    fi\n"
              , "    __log_info \"[PatchSet] renamed: move source=${dest}/${old_path} destination=${dest}/${new_path}\"\n"
              , "    if rubble-exec mv -- \"$dest/$old_path\" \"$dest/$new_path\"; then\n"
              , "      __log_trace \"[PatchSet] renamed: move completed destination=${dest}/${new_path}\"\n"
              , "    else\n"
              , "      __log_error \"[PatchSet] renamed: move failed source=${dest}/${old_path} destination=${dest}/${new_path}\"\n"
              , "      builtin return 1\n"
              , "    fi\n"
              , "    record_count=$((record_count + 1))\n"
              , "  done < \"$renamed_file\"\n"
              , "  __log_debug \"[PatchSet] renamed: processed records=${record_count}\"\n"
              , "}\n"
              , "\n"
              , "__log_info \"[PatchSet] base: materialize source destination=${dest}\"\n"
              , "if (source \"$src_script\" \"$dest\"); then\n"
              , "  __log_info \"[PatchSet] base: source materialized destination=${dest}\"\n"
              , "else\n"
              , "  __log_error \"[PatchSet] base: source materialization failed destination=${dest}\"\n"
              , "  builtin return 1\n"
              , "fi\n"
              , "if __rubble_patch_wrapper_apply_patchset; then\n"
              , "  __log_trace \"[PatchSet] patchset phase completed\"\n"
              , "else\n"
              , "  builtin return 1\n"
              , "fi\n"
              , "if __rubble_patch_wrapper_apply_additions; then\n"
              , "  __log_trace \"[PatchSet] additions phase completed\"\n"
              , "else\n"
              , "  builtin return 1\n"
              , "fi\n"
              , "if __rubble_patch_wrapper_apply_deletions; then\n"
              , "  __log_trace \"[PatchSet] deletions phase completed\"\n"
              , "else\n"
              , "  builtin return 1\n"
              , "fi\n"
              , "if __rubble_patch_wrapper_apply_renames; then\n"
              , "  __log_trace \"[PatchSet] renames phase completed\"\n"
              , "else\n"
              , "  builtin return 1\n"
              , "fi\n"
              , "__log_info \"[PatchSet] patch wrapper completed destination=${dest}\"\n"
              , "\n"
              , "__PATCH_WRAPPER_RAW_SCRIPT_207__\n"
              , "then\n"
              , "  __log_error \"failed to append raw patch wrapper body\"\n"
              , "  builtin exit 1\n"
              , "fi\n"
              , "\n"
              , "mkdir -p \"$dir\"\n"
              , "echo \"$brick_src_commit\" > \"$dir/.rubble-deferred\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "zlqkh4hv6jitrpj2uumu62lrfbvr6hozsu4j6wjoo75glrnl4f6a-RubbleR.git.partial":
      { "id": "zlqkh4hv6jitrpj2uumu62lrfbvr6hozsu4j6wjoo75glrnl4f6a-RubbleR.git.partial"
      , "name": "RubbleR.git.partial"
      , "src": {
          "repo": "https://github.com/chaifeng/RubbleR.git"
        , "commit": "85f86cf23402b123519ec5fbc374688f9ca1f8cb"
        , "paths": [
            "./Cargo.lock"
          , "./Cargo.toml"
          , "./rubble_derive/Cargo.toml"
          , "./rust-toolchain.toml"
          ]
        }
      , "inputs": [
          { "brick": "jzib76o6jwvszofr4g7p5ceo7li2szw2zm25pt6bwpu4plo7wdwq-rubble-src-checkout"
          , "alias": "rubble_src_checkout"
          , "transitive": "false"
          }
        , { "brick": "xpsu7cfnztrrwbvvhovnnlzvjzp3f6qf6funj7ehcobaqgpnx6ha-rubble-canonical-script"
          , "alias": "rubble_canonical_script"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "RUBBLE_SRC_FETCH_MODE RUBBLE_SRC_LOCAL_PATHS all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "__rubble_skip_src_split__"
          , "value": "true"
          }
        ]
      , "outputs": [
          { "name": "dir" }
        , { "name": "archive__impure__" }
        , { "name": "script" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -v \"$dir\"\n"
              , "echo \"${brick[src::commit]}\" > \"${dir}/.rubble-deferred\"\n"
              , "\n"
              , "mkdir -v \"$archive\"\n"
              , "echo \"${brick[src::commit]}\" > \"${archive}/.rubble-deferred\"\n"
              , "\n"
              , "source \"${rubble_canonical_script[script]}\"\n"
              , "\n"
              , "rubble_canonical_script << __EOF_SCRIPT_207__ | tee \"$script\"\n"
              , "set -x\n"
              , "\n"
              , "declare -p brick &>/dev/null || declare -A brick\n"
              , "repo=\"\\${brick_src_repo:-\\${brick[src::origin]:-${brick[src::origin]}}}\"\n"
              , "commit=\"\\${brick_src_commit:-\\${brick[src::commit]:-${brick[src::commit]}}}\"\n"
              , "paths=\"${brick[src::paths]}\"\n"
              , "gitRepoCredential=\"\"\n"
              , "src_archive=\"$archive\"\n"
              , "inner_path=\"\"\n"
              , "deferred_marker=\".rubble-deferred\"\n"
              , "\n"
              , "if [[ -z \"\\${repo:-}\" || -z \"\\${commit:-}\" ]]; then\n"
              , "    echo \"Error: Missing repo or commit information\" >&2\n"
              , "    exit 1\n"
              , "fi\n"
              , "\n"
              , "source \"${rubble_src_checkout}\" \"\\${1:-\\${dir}}\"\n"
              , "__EOF_SCRIPT_207__"
              ]
            , "format": "text"
            }
          }
        ]
      }
