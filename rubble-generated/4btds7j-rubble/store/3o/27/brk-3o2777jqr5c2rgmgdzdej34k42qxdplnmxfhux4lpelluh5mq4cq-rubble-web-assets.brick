              , "cd \"$node_source_dir\"\n"
              , "\n"
              , "export HOME=\"$PWD/home\"\n"
              , "mkdir -p \"$HOME\"\n"
              , "export PYTHON=\"$python_bin\"\n"
              , "export PKG_CONFIG=false\n"
              , "export PKG_CONFIG_LIBDIR=/nonexistent\n"
              , "\n"
              , "echo \"=== Configuring Node.js ${node_version} ===\"\n"
              , "\"$python_bin\" ./configure \\\n"
              , "  --prefix=\"$out\" \\\n"
              , "  --openssl-no-asm\n"
              , "\n"
              , "echo \"=== Building Node.js ${node_version} (jobs=$jobs) ===\"\n"
              , "make -C out -j \"$jobs\" BUILDTYPE=Release V= node SHELL=\"$CONFIG_SHELL\"\n"
              , "\n"
              , "echo \"=== Installing runtime Node.js ${node_version} ===\"\n"
              , "\"$python_bin\" tools/install.py install \\\n"
              , "  --dest-dir \"\" \\\n"
              , "  --prefix \"$out\" \\\n"
              , "  --build-dir out/Release \\\n"
              , "  --root-dir \"$PWD\"\n"
              , "\n"
              , "echo \"=== Normalizing Node.js runtime shebangs ===\"\n"
              , "node_bin=\"$out/bin/node\"\n"
              , "bash_bin=\"$bash/bin/bash\"\n"
              , "test -x \"$node_bin\"\n"
              , "test -x \"$bash_bin\"\n"
              , "\n"
              , "rubble_script_shebang_register \"$node_bin\" node\n"
              , "rubble_script_shebang_register \"$python_bin\" python python3\n"
              , "rubble_script_shebang_register \"$bash_bin\" sh bash\n"
              , "\n"
              , "# PowerShell shims are not Linux entrypoints and no pwsh brick is declared.\n"
              , "find \"$out\" -type f -name '*.ps1' -print0 | while IFS= read -r -d '' installed_file; do\n"
              , "  IFS= read -r first_line < \"$installed_file\" || continue\n"
              , "  case \"$first_line\" in\n"
              , "    '#!/usr/bin/env pwsh'*|'#! /usr/bin/env pwsh'*)\n"
              , "      chmod -x \"$installed_file\"\n"
              , "      ;;\n"
              , "  esac\n"
              , "done\n"
              , "\n"
              , "set -o pipefail\n"
              , "rubble_script_shebang_find --all --print0 \"$out\" |\n"
              , "  while IFS= read -r -d '' installed_file; do\n"
              , "    case \"$installed_file\" in\n"
              , "      *.ps1)\n"
              , "        continue\n"
              , "        ;;\n"
              , "    esac\n"
              , "    rubble_script_shebang_rewrite_all --strict \"$installed_file\"\n"
              , "  done\n"
              , "\n"
              , "echo \"=== Verifying runtime Node.js ${node_version} binary ===\"\n"
              , "actual_node_version=$(\"$out/bin/node\" --version)\n"
              , "actual_platform=$(\"$out/bin/node\" -p 'process.platform')\n"
              , "actual_arch=$(\"$out/bin/node\" -p 'process.arch')\n"
              , "actual_npm_version=$(\"$out/bin/npm\" --version)\n"
              , "actual_npx_version=$(\"$out/bin/npx\" --version)\n"
              , "actual_corepack_version=$(\"$out/bin/corepack\" --version)\n"
              , "\n"
              , "echo \"node: $actual_node_version\"\n"
              , "echo \"npm: $actual_npm_version\"\n"
              , "echo \"npx: $actual_npx_version\"\n"
              , "echo \"corepack: $actual_corepack_version\"\n"
              , "echo \"platform: $actual_platform\"\n"
              , "echo \"arch: $actual_arch\"\n"
              , "\n"
              , "if [ \"$actual_node_version\" != \"$node_version\" ]; then\n"
              , "  echo \"Expected Node.js $node_version, got $actual_node_version\" >&2\n"
              , "  exit 1\n"
              , "fi\n"
              , "if [ \"$actual_platform\" != \"linux\" ]; then\n"
              , "  echo \"Expected process.platform linux, got $actual_platform\" >&2\n"
              , "  exit 1\n"
              , "fi\n"
              , "if [ \"$actual_arch\" != \"$node_arch\" ]; then\n"
              , "  echo \"Expected process.arch $node_arch, got $actual_arch\" >&2\n"
              , "  exit 1\n"
              , "fi\n"
              , "\n"
              , "expected_interpreter=\"$gcc_runtime/lib/$ld_linux_name\"\n"
              , "interpreter=$(\"$readelf_tool\" -l \"$out/bin/node\" | sed -n 's/.*Requesting program interpreter: \\(.*\\)]/\\1/p')\n"
              , "echo \"ELF interpreter: ${interpreter}\"\n"
              , "echo \"Expected ELF interpreter: ${expected_interpreter}\"\n"
              , "if [ \"$interpreter\" != \"$expected_interpreter\" ]; then\n"
              , "  echo \"Expected Node.js interpreter $expected_interpreter, got $interpreter\" >&2\n"
              , "  exit 1\n"
              , "fi\n"
              , "\n"
              , "node_rpath=$(\"$readelf_tool\" -d \"$out/bin/node\" | sed -n 's/.*\\(RPATH\\|RUNPATH\\).*: \\[\\(.*\\)\\]/\\2/p')\n"
              , "echo \"ELF RPATH/RUNPATH: ${node_rpath}\"\n"
              , "if [ -z \"$node_rpath\" ]; then\n"
              , "  echo \"Expected Node.js RPATH/RUNPATH to reference Rubble runtime libraries\" >&2\n"
              , "  exit 1\n"
              , "fi\n"
              , "case \":$node_rpath:\" in\n"
              , "  *\":$gcc_runtime/lib:\"*) ;;\n"
              , "  *)\n"
              , "    echo \"Expected Node.js RPATH/RUNPATH to include $gcc_runtime/lib\" >&2\n"
              , "    exit 1\n"
              , "    ;;\n"
              , "esac\n"
              , "IFS=: read -r -a node_rpath_entries <<< \"$node_rpath\"\n"
              , "for node_rpath_entry in \"${node_rpath_entries[@]}\"; do\n"
              , "  case \"$node_rpath_entry\" in\n"
              , "    /home/*/.rubble/*|/usr|/usr/*|/etc|/etc/*|/lib|/lib/*|/lib64|/lib64/*)\n"
              , "      echo \"Unexpected host or user-store path in Node.js RPATH/RUNPATH: $node_rpath_entry\" >&2\n"
              , "      exit 1\n"
              , "      ;;\n"
              , "  esac\n"
              , "done"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "cbi3fhmbxe5za4vfxlupx2wwtyrb5gk532gdlckzmg4ds4wtc33a-nodejs-22.22.3":
      { "id": "cbi3fhmbxe5za4vfxlupx2wwtyrb5gk532gdlckzmg4ds4wtc33a-nodejs-22.22.3"
      , "name": "nodejs-22.22.3"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "ztbwuqmg77pfi6tzkoy4asfmpiy22x6lugzprlhhhvjldam36n4q-rubble-script-shebang"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$script\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "bxchorbehgapcopsqwo7w5zwjgenujywlkkytlnad3dvy5hpqc5q-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "pi47flk3wslxukcxfmqnxlpw7diebs2b2zzrjf6l6ptrrjnj64hq-bootstrap-build-tools"
          , "alias": "bootstrap"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$out/setup-env.sh\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "hyfmtwjfp6yvb6fgojre747fu5vfeuev2qebhgehbs3lio65bxuq-python3-glibc-3.13.13"
          , "alias": "python3"
          , "transitive": "true"
          }
        , { "brick": "umweux52j2zinu2quecfvrdlnf7e3ssar3gjgjkllj4io3gvedtq-nodejs-22.22.3-runtime"
          , "alias": "nodejs_runtime"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "ld_linux_name"
          , "value": "ld-linux-x86-64.so.2"
          }
        , { "name": "node_arch"
          , "value": "x64"
          }
        , { "name": "node_version"
          , "value": "v22.22.3"
          }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "env" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "write_heredoc_file() {\n"
              , "  local target=\"$1\"\n"
              , "  local content\n"
              , "  IFS= read -r -d '' content || true\n"
              , "  builtin printf '%s' \"$content\" > \"$target\"\n"
              , "}\n"
              , "\n"
              , "node_runtime_tree=\"${nodejs_runtime:?nodejs-runtime did not export an output path}\"\n"
              , "python_bin=\"$python3/bin/python3\"\n"
              , "test -d \"$node_runtime_tree\"\n"
              , "test -x \"$node_runtime_tree/bin/node\"\n"
              , "test -x \"$bash/bin/bash\"\n"
              , "test -x \"$python_bin\"\n"
              , "\n"
              , "export HOME=\"$PWD/home\"\n"
              , "mkdir -p \"$HOME\"\n"
              , "\n"
              , "echo \"=== Creating Node.js ${node_version} facade ===\"\n"
              , "rm -rf \"$out\"\n"
              , "mkdir -p \"$out/bin\"\n"
              , "\n"
              , "write_node_entrypoint() {\n"
              , "  local script_file=\"$1\"\n"
              , "  local target_js=\"$2\"\n"
              , "  local tmp_file=\"${script_file}.entrypoint.tmp\"\n"
              , "  mkdir -p \"${script_file%/*}\"\n"
              , "  {\n"
              , "    printf '#!%s/bin/node\\n' \"$out\"\n"
              , "    printf 'require(\"%s\");\\n' \"$target_js\"\n"
              , "  } > \"$tmp_file\"\n"
              , "  chmod 755 \"$tmp_file\"\n"
              , "  mv \"$tmp_file\" \"$script_file\"\n"
              , "}\n"
              , "\n"
              , "ln -s \"$node_runtime_tree/bin/node\" \"$out/bin/node\"\n"
              , "write_node_entrypoint \"$out/bin/npm\" \"$node_runtime_tree/lib/node_modules/npm/bin/npm-cli.js\"\n"
              , "write_node_entrypoint \"$out/bin/npx\" \"$node_runtime_tree/lib/node_modules/npm/bin/npx-cli.js\"\n"
              , "write_node_entrypoint \"$out/bin/corepack\" \"$node_runtime_tree/lib/node_modules/corepack/dist/corepack.js\"\n"
              , "\n"
              , "echo \"=== Normalizing Node.js facade entrypoint shebangs ===\"\n"
              , "rubble_script_shebang_register \"$out/bin/node\" node\n"
              , "rubble_script_shebang_rewrite_all --strict --all \"$out\"\n"
              , "\n"
              , "find \"$out\" -type l -print0 | while IFS= read -r -d '' installed_link; do\n"
              , "  link_target=$(readlink \"$installed_link\")\n"
              , "  case \"$link_target\" in\n"
              , "    \"$node_runtime_tree\"|\"$node_runtime_tree\"/*) ;;\n"
              , "    /home/*/.rubble/*|/usr|/usr/*|/etc|/etc/*|/lib|/lib/*|/lib64|/lib64/*)\n"
              , "      echo \"Unexpected host or user-store symlink after Node.js facade install: $installed_link -> $link_target\" >&2\n"
              , "      exit 1\n"
              , "      ;;\n"
              , "    *)\n"
              , "      echo \"Unexpected non-Node-runtime symlink after Node.js facade install: $installed_link -> $link_target\" >&2\n"
              , "      exit 1\n"
              , "      ;;\n"
              , "  esac\n"
              , "done\n"
              , "\n"
              , "while IFS= builtin read -r __rubble_output_line; do\n"
              , "  builtin printf '%s\\n' \"$__rubble_output_line\"\n"
              , "done > \"$env\" <<EOF\n"
              , "export PATH=\"$out/bin:\\${PATH}\"\n"
              , "export NODE=\"$out/bin/node\"\n"
              , "export NPM=\"$out/bin/npm\"\n"
              , "export NPX=\"$out/bin/npx\"\n"
              , "export COREPACK=\"$out/bin/corepack\"\n"
              , "export PYTHON=\"$python_bin\"\n"
              , "export PYTHON3=\"$python_bin\"\n"
              , "export NODEJS_RUNTIME_PREFIX=\"$node_runtime_tree\"\n"
              , "export npm_config_audit=false\n"
              , "export npm_config_fund=false\n"
              , "export npm_config_update_notifier=false\n"
              , "export npm_config_progress=false\n"
              , "export npm_config_python=\"$python_bin\"\n"
              , "export npm_config_script_shell=\"$bash/bin/bash\"\n"
              , "declare -p PATH NODE NPM NPX COREPACK PYTHON PYTHON3 NODEJS_RUNTIME_PREFIX\n"
              , "declare -p npm_config_audit npm_config_fund npm_config_update_notifier npm_config_progress npm_config_python npm_config_script_shell\n"
              , "\"\\$NODE\" --version\n"
              , "\"\\$NPM\" --version\n"
              , "\"\\$NPX\" --version\n"
              , "\"\\$COREPACK\" --version\n"
              , "EOF\n"
              , "builtin unset __rubble_output_line\n"
              , "\n"
              , "echo \"=== Verifying Node.js ${node_version} facade ===\"\n"
              , "actual_node_version=$(\"$out/bin/node\" --version)\n"
              , "actual_npm_version=$(\"$out/bin/npm\" --version)\n"
              , "actual_npx_version=$(\"$out/bin/npx\" --version)\n"
              , "actual_corepack_version=$(\"$out/bin/corepack\" --version)\n"
              , "actual_platform=$(\"$out/bin/node\" -p 'process.platform')\n"
              , "actual_arch=$(\"$out/bin/node\" -p 'process.arch')\n"
              , "actual_prefix=$(\"$out/bin/node\" -p 'process.config.variables.node_prefix || \"\"')\n"
              , "\n"
              , "echo \"node: $actual_node_version\"\n"
              , "echo \"npm: $actual_npm_version\"\n"
              , "echo \"npx: $actual_npx_version\"\n"
              , "echo \"corepack: $actual_corepack_version\"\n"
              , "echo \"platform: $actual_platform\"\n"
              , "echo \"arch: $actual_arch\"\n"
              , "echo \"prefix: $actual_prefix\"\n"
              , "\n"
              , "if [ \"$actual_node_version\" != \"$node_version\" ]; then\n"
              , "  echo \"Expected Node.js $node_version, got $actual_node_version\" >&2\n"
              , "  exit 1\n"
              , "fi\n"
              , "if [ \"$actual_platform\" != \"linux\" ]; then\n"
              , "  echo \"Expected process.platform linux, got $actual_platform\" >&2\n"
              , "  exit 1\n"
              , "fi\n"
              , "if [ \"$actual_arch\" != \"$node_arch\" ]; then\n"
              , "  echo \"Expected process.arch $node_arch, got $actual_arch\" >&2\n"
              , "  exit 1\n"
              , "fi\n"
              , "if [ \"$actual_prefix\" != \"$node_runtime_tree\" ]; then\n"
              , "  echo \"Expected Node.js prefix $node_runtime_tree, got $actual_prefix\" >&2\n"
              , "  exit 1\n"
              , "fi\n"
              , "\n"
              , "echo \"=== Verifying npm script shell ===\"\n"
              , "probe_dir=\"$PWD/npm-script-probe\"\n"
              , "rm -rf \"$probe_dir\"\n"
              , "mkdir -p \"$probe_dir\"\n"
              , "write_heredoc_file \"$probe_dir/package.json\" <<'EOF'\n"
              , "{\"scripts\":{\"probe\":\"[[ -n \\\"$BASH_VERSION\\\" ]] && printf ok > probe.txt\"}}\n"
              , "EOF\n"
              , "(\n"
              , "  cd \"$probe_dir\"\n"
              , "  unset BASH_XTRACEFD\n"
              , "  npm_config_audit=false \\\n"
              , "  npm_config_fund=false \\\n"
              , "  npm_config_update_notifier=false \\\n"
              , "  npm_config_progress=false \\\n"
              , "  npm_config_script_shell=\"$bash/bin/bash\" \\\n"
              , "    \"$out/bin/npm\" run --silent probe\n"
              , "  IFS= read -r probe_result < probe.txt || true\n"
              , "  if [ \"$probe_result\" != \"ok\" ]; then\n"
              , "    echo \"Expected npm script shell probe to write ok, got $probe_result\" >&2\n"
              , "    exit 1\n"
              , "  fi\n"
              , ")\n"
              , "\n"
              , "echo \"=== Verifying npm node-gyp Python contract ===\"\n"
              , "node_gyp_probe_dir=\"$PWD/node-gyp-probe\"\n"
              , "rm -rf \"$node_gyp_probe_dir\"\n"
              , "mkdir -p \"$node_gyp_probe_dir/home\" \"$node_gyp_probe_dir/project\"\n"
              , "write_heredoc_file \"$node_gyp_probe_dir/project/binding.gyp\" <<'EOF'\n"
              , "{\"targets\":[{\"target_name\":\"empty\",\"sources\":[]}]}\n"
              , "EOF\n"
              , "(\n"
              , "  cd \"$node_gyp_probe_dir/project\"\n"
              , "  unset BASH_XTRACEFD\n"
              , "  env -i \\\n"
              , "    HOME=\"$node_gyp_probe_dir/home\" \\\n"
              , "    PATH=\"$out/bin\" \\\n"
              , "    PYTHON=\"$python_bin\" \\\n"
              , "    PYTHON3=\"$python_bin\" \\\n"
              , "    npm_config_python=\"$python_bin\" \\\n"
              , "    npm_config_audit=false \\\n"
              , "    npm_config_fund=false \\\n"
              , "    npm_config_update_notifier=false \\\n"
              , "    npm_config_progress=false \\\n"
              , "    \"$out/bin/node\" \"$node_runtime_tree/lib/node_modules/npm/node_modules/node-gyp/bin/node-gyp.js\" configure --nodedir=\"$node_runtime_tree\" \\\n"
              , "      >node-gyp.out 2>node-gyp.err\n"
              , "  found_python=false\n"
              , "  while IFS= read -r node_gyp_line || [ -n \"$node_gyp_line\" ]; do\n"
              , "    case \"$node_gyp_line\" in\n"
              , "      *\"find Python using Python version \"*\" found at \\\"$python_bin\\\"\"*)\n"
              , "        found_python=true\n"
              , "        ;;\n"
              , "    esac\n"
              , "  done < node-gyp.err\n"
              , "  if [ \"$found_python\" != true ]; then\n"
              , "    echo \"Expected node-gyp to use declared Python $python_bin\" >&2\n"
              , "    while IFS= read -r node_gyp_line || [ -n \"$node_gyp_line\" ]; do\n"
              , "      printf '%s\\n' \"$node_gyp_line\" >&2\n"
              , "    done < node-gyp.err\n"
              , "    exit 1\n"
              , "  fi\n"
              , ")"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "6ltohnsz2vube6vjyzkgpm63uitpbekkkycn5rgb7em2mzx4al4q-rubble-web-node-modules":
      { "id": "6ltohnsz2vube6vjyzkgpm63uitpbekkkycn5rgb7em2mzx4al4q-rubble-web-node-modules"
      , "name": "rubble-web-node-modules"
      , "platform": "x86_64-linux"
