        , "checksum": "sha256:2ab91ff401783ccca64f75d10c882e957bdfd60e2bf5a72f8421793729b78a71"
        }
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "__rubble_skip_src_split__"
          , "value": "true"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "cp -ar \"$src\" \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "hyfmtwjfp6yvb6fgojre747fu5vfeuev2qebhgehbs3lio65bxuq-python3-glibc-3.13.13":
      { "id": "hyfmtwjfp6yvb6fgojre747fu5vfeuev2qebhgehbs3lio65bxuq-python3-glibc-3.13.13"
      , "name": "python3-glibc-3.13.13"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
