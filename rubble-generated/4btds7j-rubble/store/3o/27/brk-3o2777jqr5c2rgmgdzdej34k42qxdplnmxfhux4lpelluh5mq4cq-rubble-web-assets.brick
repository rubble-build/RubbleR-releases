        , { "brick": "ornuxzu76lwe2ndtm6n7andz5hgz3zxp74v362ssga4lrb7jumla-Python-3.13.13.tar.xz"
          , "alias": "src"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "BUILD_JOBS all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "python_major_minor"
          , "value": "3.13"
