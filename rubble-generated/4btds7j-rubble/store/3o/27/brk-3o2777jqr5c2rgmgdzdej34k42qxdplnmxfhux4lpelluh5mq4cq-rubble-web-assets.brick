                      "export PATH=\"$out/bin:$PATH\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "rubble_canonical_script > \"$out\" <<EOF\n"
              , "export PATH=\"$PATH\"\n"
              , "export RUSTFLAGS=\"${RUSTFLAGS:-}\"\n"
              , "export SDKROOT=\"${SDKROOT:-}\"\n"
              , "export CC=\"${CC:-}\"\n"
              , "export CXX=\"${CXX:-}\"\n"
              , "export AR=\"${AR:-}\"\n"
              , "export RANLIB=\"${RANLIB:-}\"\n"
              , "export NM=\"${NM:-}\"\n"
              , "export LD=\"${LD:-}\"\n"
              , "export LDFLAGS=\"${LDFLAGS:-}\"\n"
              , "export CFLAGS=\"${CFLAGS:-}\"\n"
              , "export CXXFLAGS=\"${CXXFLAGS:-}\"\n"
              , "export C_INCLUDE_PATH=\"${C_INCLUDE_PATH:-}\"\n"
              , "export CPLUS_INCLUDE_PATH=\"${CPLUS_INCLUDE_PATH:-}\"\n"
              , "# Prevent pkg-config from finding host system packages (hermetic build)\n"
              , "export PKG_CONFIG_LIBDIR=\"${PKG_CONFIG_LIBDIR:-}\"\n"
              , "# PERL5LIB is needed for OpenSSL build (perl modules location)\n"
              , "export PERL5LIB=\"${PERL5LIB:-}\"\n"
              , "declare -p PATH RUSTFLAGS\n"
              , "\n"
              , "type -a cargo rustc\n"
              , "cargo --version\n"
              , "rustc -vV\n"
              , "EOF"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "rd7qcorm656iqae3s6ypqtldq5aw2qxywfc6uc5rt7angt2mbfsq-bzip2-dev-1.0.8":
      { "id": "rd7qcorm656iqae3s6ypqtldq5aw2qxywfc6uc5rt7angt2mbfsq-bzip2-dev-1.0.8"
      , "name": "bzip2-dev-1.0.8"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "htbzz6bih7yozjd67du3sha2tvuaugif6hfibqqi4ype7rt22kha-bzip2-1.0.8.tar.gz"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "pi47flk3wslxukcxfmqnxlpw7diebs2b2zzrjf6l6ptrrjnj64hq-bootstrap-build-tools"
          , "alias": "bootstrap"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$out/setup-env.sh\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "2zcsx4l6ph24tmaok5hwzpgr73kyxs3kxixfrxqodfw5ubmqhidq-linux-native-toolchain"
          , "alias": "native_toolchain"
          , "transitive": "false"
          , "after": [
              "bootstrap"
            ]
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$out\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "BUILD_JOBS all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "bzip2_version"
          , "value": "1.0.8"
          }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "env" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "write_heredoc_file() {\n"
              , "  local target=\"$1\"\n"
              , "  local content\n"
              , "  IFS= read -r -d '' content || true\n"
              , "  builtin printf '%s' \"$content\" > \"$target\"\n"
              , "}\n"
              , "\n"
              , "jobs=\"${BUILD_JOBS:-$(nproc)}\"\n"
              , "case \"$jobs\" in\n"
              , "  ''|*[!0-9]*|0)\n"
              , "    echo \"BUILD_JOBS must be a positive integer, got: ${jobs:-<empty>}\" >&2\n"
              , "    exit 1\n"
              , "    ;;\n"
              , "esac\n"
              , "\n"
              , "echo \"=== Extracting bzip2 ${bzip2_version} ===\"\n"
              , "tar -xzf \"$src\"\n"
              , "cd \"bzip2-${bzip2_version}\"\n"
              , "\n"
              , "echo \"=== Building bzip2 ${bzip2_version} static library (jobs=$jobs) ===\"\n"
              , "make -j \"$jobs\" libbz2.a \\\n"
              , "  CC=\"$CC\" \\\n"
              , "  AR=\"$AR\" \\\n"
              , "  RANLIB=\"$RANLIB\" \\\n"
              , "  CFLAGS=\"${CFLAGS:-} -fPIC -O2 -D_FILE_OFFSET_BITS=64\"\n"
              , "\n"
              , "echo \"=== Installing bzip2 ${bzip2_version} development files ===\"\n"
              , "mkdir -p \"$out/include\" \"$out/lib\"\n"
              , "cp bzlib.h \"$out/include/\"\n"
              , "cp libbz2.a \"$out/lib/\"\n"
              , "\n"
              , "write_heredoc_file \"$env\" <<EOF\n"
              , "set -euo pipefail\n"
              , "export BZIP2_ROOT=\"$out\"\n"
              , "export CPATH=\"$out/include:\\${CPATH:-}\"\n"
              , "export LIBRARY_PATH=\"$out/lib:\\${LIBRARY_PATH:-}\"\n"
              , "declare -p BZIP2_ROOT CPATH LIBRARY_PATH\n"
              , "EOF\n"
              , "\n"
              , "echo \"=== Verifying bzip2 ${bzip2_version} development files ===\"\n"
              , "test -f \"$out/include/bzlib.h\"\n"
              , "test -f \"$out/lib/libbz2.a\"\n"
              , "\n"
              , "write_heredoc_file bzip2-probe.c <<'EOF'\n"
              , "#include <bzlib.h>\n"
              , "\n"
              , "int main(void) {\n"
              , "  bz_stream stream = {0};\n"
              , "  int result = BZ2_bzCompressInit(&stream, 1, 0, 0);\n"
              , "  if (result == BZ_OK) {\n"
              , "    BZ2_bzCompressEnd(&stream);\n"
              , "  }\n"
              , "  return result == BZ_OK ? 0 : 1;\n"
              , "}\n"
              , "EOF\n"
              , "\"$CC\" ${CFLAGS:-} -I\"$out/include\" bzip2-probe.c \"$out/lib/libbz2.a\" ${LDFLAGS:-} -o bzip2-probe\n"
              , "./bzip2-probe\n"
              , "\n"
              , "readelf_tool=\"$(dirname \"$CC\")/readelf\"\n"
              , "test -x \"$readelf_tool\"\n"
              , "interpreter=$(\"$readelf_tool\" -l bzip2-probe | sed -n 's/.*Requesting program interpreter: \\(.*\\)]/\\1/p')\n"
              , "echo \"ELF interpreter: ${interpreter}\"\n"
              , "case \"$interpreter\" in\n"
              , "  /var/lib/rubble/store/*/ld-linux-*) ;;\n"
              , "  *)\n"
              , "    echo \"Expected a Rubble runtime glibc interpreter, got: ${interpreter:-<empty>}\" >&2\n"
              , "    exit 1\n"
              , "    ;;\n"
              , "esac"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "tqy4qpzhtx4hfedwhqndhhx2drukfqbnlfvaqolonbawt54sbz4a-RubbleR.git.partial":
      { "id": "tqy4qpzhtx4hfedwhqndhhx2drukfqbnlfvaqolonbawt54sbz4a-RubbleR.git.partial"
      , "name": "RubbleR.git.partial"
      , "src": {
          "repo": "https://github.com/chaifeng/RubbleR.git"
