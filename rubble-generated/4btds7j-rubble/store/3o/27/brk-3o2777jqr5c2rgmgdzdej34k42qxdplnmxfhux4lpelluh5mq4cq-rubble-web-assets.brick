          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "zkiff2cic77r6rxw3quhxg6gu4rznq4omwpz5tui7zwbvlqj6mbq-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "m3kjkdeft5hmipen5zictvl4m3yedcwwzmeokbmgisozz3pofnua-gzip-1.13-r0.apk"
          , "alias": "src"
