        , { "brick": "l24qwy42aqiewm3ebjhacljc76ulo4vdrxgfyizlt2oztxqco5jq-mpdecimal-4.0.0-r0.apk"
          , "alias": "mpdecimal_apk"
          , "transitive": "false"
          }
        , { "brick": "yawesszimcd2qlnyer7jhtzq53jkzoadt5yxtoqgqjfmirmyrccq-libstdc__-14.2.0-r4.apk"
          , "alias": "libstdcpp_apk"
          , "transitive": "false"
          }
        , { "brick": "wdo34y7tme4bosf2fda6yjm7eqqsvedws6mqugeq2ixcennl3ikq-libssl3-3.3.7-r0.apk"
          , "alias": "libssl3_apk"
          , "transitive": "false"
          }
        , { "brick": "onlk2zatshrcc5wdjmkfvypvk27d3g5b3yw5p2bxwlfzdfjcyndq-libpanelw-6.5_p20241006-r3.apk"
          , "alias": "libpanelw_apk"
          , "transitive": "false"
          }
        , { "brick": "c6xxyv3vzmxvlpcvxl2ovsj3kswtkjuqodjgzeyznro4rzkygnba-libncursesw-6.5_p20241006-r3.apk"
          , "alias": "libncursesw_apk"
          , "transitive": "false"
          }
        , { "brick": "ygiy7hr5xdujt354tflhamaynd7pulonibb4exgkrqfb6eyq3ova-libgcc-14.2.0-r4.apk"
          , "alias": "libgcc_apk"
          , "transitive": "false"
          }
        , { "brick": "gnnsnnf6yelk7gnriytilbxswxoiys2ynfurvdpenuuj3ynneg4q-libffi-3.4.7-r0.apk"
          , "alias": "libffi_apk"
          , "transitive": "false"
          }
        , { "brick": "plwm6dnj2vspzbvwjmcclazg7rruyjy5x2vnvpivffgqvl5laiuq-libexpat-2.8.3-r0.apk"
          , "alias": "libexpat_apk"
          , "transitive": "false"
          }
        , { "brick": "oqoaxy5m5bddhssgfc7jhe5q7mna2ydylmq75vxuvraqx2tqk2ca-libcrypto3-3.3.7-r0.apk"
          , "alias": "libcrypto3_apk"
          , "transitive": "false"
          }
        , { "brick": "ivlvi6gy2ft3ha4xhyhznjq4ddnj2gje7icw3knjcb73ltiwrfqq-libbz2-1.0.8-r6.apk"
          , "alias": "libbz2_apk"
          , "transitive": "false"
          }
        , { "brick": "zkiff2cic77r6rxw3quhxg6gu4rznq4omwpz5tui7zwbvlqj6mbq-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "y5wlnu6yes4le6p335gxl52cnwerqwljbxo7micl3flp45e2q63a-gdbm-1.24-r0.apk"
          , "alias": "gdbm_apk"
          , "transitive": "false"
          }
        , { "brick": "bxchorbehgapcopsqwo7w5zwjgenujywlkkytlnad3dvy5hpqc5q-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "72mkfvxl5mmbm7vwb7lqf2zdm4fspzwzv2cmpnsrum2l4c77u5cq-coreutils"
          , "alias": "coreutils"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "musl_interpreter"
          , "value": "ld-musl-x86_64.so.1"
          }
        , { "name": "python_version"
          , "value": "3.12"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p \"$out/bin\" \"$out/lib\" \"$out/share\" extract\n"
              , "\n"
              , "echo \"=== Extracting Alpine Python packages ===\"\n"
              , "for apk in \"$python3_apk\" \"$libbz2_apk\" \"$libcrypto3_apk\" \"$libssl3_apk\" \\\n"
              , "           \"$libexpat_apk\" \"$libffi_apk\" \"$gdbm_apk\" \"$xz_libs_apk\" \\\n"
              , "           \"$mpdecimal_apk\" \"$libncursesw_apk\" \"$libpanelw_apk\" \\\n"
              , "           \"$readline_apk\" \"$sqlite_libs_apk\" \"$zlib_apk\" \"$libgcc_apk\" \\\n"
              , "           \"$libstdcpp_apk\"; do\n"
              , "  echo \"  Extracting $(basename \"$apk\")...\"\n"
              , "  tar -xzf \"$apk\" -C extract\n"
              , "done\n"
              , "\n"
              , "echo \"=== Installing Python runtime files ===\"\n"
              , "ln -sf \"$ld_musl\" \"$out/lib/$musl_interpreter\"\n"
              , "ln -sf \"$musl_interpreter\" \"$out/lib/libc.${musl_interpreter#ld-}\"\n"
              , "\n"
              , "for libdir in extract/lib extract/usr/lib; do\n"
              , "  if [ -d \"$libdir\" ]; then\n"
              , "    find \"$libdir\" -maxdepth 1 -name \"*.so*\" -type f -exec cp -a {} \"$out/lib/\" \\;\n"
              , "    find \"$libdir\" -maxdepth 1 -name \"*.so*\" -type l -exec cp -a {} \"$out/lib/\" \\;\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "cp -a \"extract/usr/lib/python${python_version}\" \"$out/lib/\"\n"
              , "cp -a extract/usr/share/* \"$out/share/\" 2>/dev/null || true\n"
              , "cp \"extract/usr/bin/python${python_version}\" \"$out/bin/python${python_version}.bin\"\n"
              , "chmod +x \"$out/bin/python${python_version}.bin\"\n"
              , "\n"
              , "echo \"=== Patching Python ELF files ===\"\n"
              , "\"$patchelf\" --set-interpreter \"$ld_musl\" --set-rpath \"$out/lib\" \"$out/bin/python${python_version}.bin\"\n"
              , "find \"$out/lib\" -type f \\( -name \"*.so\" -o -name \"*.so.*\" \\) | while read -r elf_file; do\n"
              , "  chmod u+w \"$elf_file\" 2>/dev/null || true\n"
              , "  if \"$patchelf\" --print-rpath \"$elf_file\" >/dev/null 2>&1; then\n"
              , "    \"$patchelf\" --set-rpath \"$out/lib\" \"$elf_file\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "create_python_wrapper() {\n"
              , "  local wrapper_path=\"$1\"\n"
              , "  {\n"
              , "    printf '#!%s\\n' \"$bash/bin/bash\"\n"
              , "    printf 'PYTHON_HOME=\"%s\"\\n' \"$out\"\n"
              , "    printf 'export PYTHONHOME=\"$PYTHON_HOME\"\\n'\n"
              , "    printf 'export PYTHONPATH=\"$PYTHON_HOME/lib/python%s${PYTHONPATH:+:}${PYTHONPATH:-}\"\\n' \"$python_version\"\n"
              , "    printf 'export LD_LIBRARY_PATH=\"$PYTHON_HOME/lib${LD_LIBRARY_PATH:+:}${LD_LIBRARY_PATH:-}\"\\n'\n"
              , "    printf 'exec \"$PYTHON_HOME/bin/python%s.bin\" \"$@\"\\n' \"$python_version\"\n"
              , "  } > \"$wrapper_path\"\n"
              , "  chmod +x \"$wrapper_path\"\n"
              , "}\n"
              , "\n"
              , "create_python_wrapper \"$out/bin/python\"\n"
              , "create_python_wrapper \"$out/bin/python3\"\n"
              , "create_python_wrapper \"$out/bin/python${python_version}\"\n"
              , "\n"
              , "require_line_equals() {\n"
              , "  local file=\"$1\" expected=\"$2\" line\n"
              , "  while IFS= read -r line || [ -n \"$line\" ]; do\n"
              , "    if [ \"$line\" = \"$expected\" ]; then\n"
              , "      return 0\n"
              , "    fi\n"
              , "  done < \"$file\"\n"
              , "  echo \"Expected line not found in $file: $expected\" >&2\n"
              , "  exit 1\n"
              , "}\n"
              , "\n"
              , "require_file_contains() {\n"
              , "  local file=\"$1\" needle=\"$2\" line\n"
              , "  while IFS= read -r line || [ -n \"$line\" ]; do\n"
              , "    if [[ \"$line\" == *\"$needle\"* ]]; then\n"
              , "      return 0\n"
              , "    fi\n"
              , "  done < \"$file\"\n"
              , "  echo \"Expected text not found in $file: $needle\" >&2\n"
              , "  exit 1\n"
              , "}\n"
              , "\n"
              , "require_file_not_contains() {\n"
              , "  local file=\"$1\" needle=\"$2\" line\n"
              , "  while IFS= read -r line || [ -n \"$line\" ]; do\n"
              , "    if [[ \"$line\" == *\"$needle\"* ]]; then\n"
              , "      echo \"Unexpected text in $file: $needle\" >&2\n"
              , "      echo \"Offending line: $line\" >&2\n"
              , "      exit 1\n"
              , "    fi\n"
              , "  done < \"$file\"\n"
              , "}\n"
              , "\n"
              , "normalize_make_var() {\n"
              , "  local file=\"$1\" key=\"$2\" value=\"$3\" expected tab\n"
              , "  tab=\"$(printf '\\t')\"\n"
              , "  expected=\"${key}=${tab}${value}\"\n"
              , "  sed -i \"s|^${key}[[:space:]]*=.*|${expected}|\" \"$file\"\n"
              , "  require_line_equals \"$file\" \"$expected\"\n"
              , "}\n"
              , "\n"
              , "normalize_sysconfig_var() {\n"
              , "  local file=\"$1\" key=\"$2\" value=\"$3\" expected\n"
              , "  expected=\"    '${key}': '${value}',\"\n"
              , "  sed -i \"s|^[[:space:]]*'${key}': .*|${expected}|\" \"$file\"\n"
              , "  require_line_equals \"$file\" \"$expected\"\n"
              , "}\n"
              , "\n"
              , "check_public_python_config_file() {\n"
              , "  local file=\"$1\"\n"
              , "  require_file_not_contains \"$file\" \"bootstrap-build-tools\"\n"
              , "  require_file_not_contains \"$file\" \"/usr/bin/install\"\n"
              , "  require_file_not_contains \"$file\" \"/usr/bin/mkdir\"\n"
              , "  require_file_not_contains \"$file\" \"./install-sh -c -d\"\n"
              , "}\n"
              , "\n"
              , "echo \"=== Normalizing Python runtime build configuration ===\"\n"
              , "runtime_sh=\"$bash/bin/sh\"\n"
              , "runtime_install=\"$coreutils/bin/install\"\n"
              , "runtime_mkdir=\"$coreutils/bin/mkdir\"\n"
              , "test -x \"$runtime_sh\"\n"
              , "test -x \"$runtime_install\"\n"
              , "test -x \"$runtime_mkdir\"\n"
              , "python_config_dir=$(find \"$out/lib/python${python_version}\" -maxdepth 1 -type d -name \"config-${python_version}-*\" -print -quit)\n"
              , "if [ -z \"$python_config_dir\" ] || [ ! -f \"$python_config_dir/Makefile\" ]; then\n"
              , "  echo \"Expected installed Python Makefile under $out/lib/python${python_version}\" >&2\n"
              , "  exit 1\n"
              , "fi\n"
              , "python_sysconfig_data=$(find \"$out/lib/python${python_version}\" -maxdepth 1 -type f -name \"_sysconfigdata_*.py\" -print -quit)\n"
              , "if [ -z \"$python_sysconfig_data\" ] || [ ! -f \"$python_sysconfig_data\" ]; then\n"
              , "  echo \"Expected installed Python sysconfig data under $out/lib/python${python_version}\" >&2\n"
              , "  exit 1\n"
              , "fi\n"
              , "\n"
              , "normalize_make_var \"$python_config_dir/Makefile\" \"SHELL\" \"$runtime_sh -e\"\n"
              , "normalize_make_var \"$python_config_dir/Makefile\" \"INSTALL\" \"$runtime_install -c\"\n"
              , "normalize_make_var \"$python_config_dir/Makefile\" \"INSTALL_PROGRAM\" \"$runtime_install -c\"\n"
              , "normalize_make_var \"$python_config_dir/Makefile\" \"INSTALL_SCRIPT\" \"$runtime_install -c\"\n"
              , "normalize_make_var \"$python_config_dir/Makefile\" \"INSTALL_DATA\" \"$runtime_install -c -m 644\"\n"
              , "normalize_make_var \"$python_config_dir/Makefile\" \"INSTALL_SHARED\" \"$runtime_install -c -m 755\"\n"
              , "normalize_make_var \"$python_config_dir/Makefile\" \"MKDIR_P\" \"$runtime_mkdir -p\"\n"
              , "\n"
              , "normalize_sysconfig_var \"$python_sysconfig_data\" \"SHELL\" \"$runtime_sh -e\"\n"
              , "normalize_sysconfig_var \"$python_sysconfig_data\" \"INSTALL\" \"$runtime_install -c\"\n"
              , "normalize_sysconfig_var \"$python_sysconfig_data\" \"INSTALL_PROGRAM\" \"$runtime_install -c\"\n"
              , "normalize_sysconfig_var \"$python_sysconfig_data\" \"INSTALL_SCRIPT\" \"$runtime_install -c\"\n"
              , "normalize_sysconfig_var \"$python_sysconfig_data\" \"INSTALL_DATA\" \"$runtime_install -c -m 644\"\n"
              , "normalize_sysconfig_var \"$python_sysconfig_data\" \"INSTALL_SHARED\" \"$runtime_install -c -m 755\"\n"
              , "normalize_sysconfig_var \"$python_sysconfig_data\" \"MKDIR_P\" \"$runtime_mkdir -p\"\n"
              , "\n"
              , "check_public_python_config_file \"$python_config_dir/Makefile\"\n"
              , "check_public_python_config_file \"$python_sysconfig_data\"\n"
              , "\n"
              , "python_subprocess=\"$out/lib/python${python_version}/subprocess.py\"\n"
              , "if [ -f \"$python_subprocess\" ]; then\n"
              , "  sed -i \"s|else '/bin/sh')|else '$runtime_sh')|\" \"$python_subprocess\"\n"
              , "  require_file_contains \"$python_subprocess\" \"else '$runtime_sh')\"\n"
              , "  require_file_not_contains \"$python_subprocess\" \"else '/bin/sh')\"\n"
              , "else\n"
              , "  echo \"Expected Python subprocess module at $python_subprocess\" >&2\n"
              , "  exit 1\n"
              , "fi\n"
              , "\n"
              , "echo \"=== Normalizing executable Python shebangs ===\"\n"
              , "rubble_script_shebang_register \"$out/bin/python3\" python python3 \"python${python_version}\"\n"
              , "rubble_script_shebang_register \"$bash/bin/bash\" sh bash\n"
              , "rubble_script_shebang_rewrite_all --strict \"$out\"\n"
              , "\n"
              , "echo \"=== Verifying Python installation ===\"\n"
              , "\"$out/bin/python3\" --version\n"
              , "RUBBLE_EXPECTED_SHELL=\"$runtime_sh -e\" \\\n"
              , "RUBBLE_EXPECTED_INSTALL=\"$runtime_install -c\" \\\n"
              , "RUBBLE_EXPECTED_INSTALL_DATA=\"$runtime_install -c -m 644\" \\\n"
              , "RUBBLE_EXPECTED_INSTALL_SHARED=\"$runtime_install -c -m 755\" \\\n"
              , "RUBBLE_EXPECTED_MKDIR_P=\"$runtime_mkdir -p\" \\\n"
              , "\"$out/bin/python3\" - <<'PY'\n"
              , "import bz2\n"
              , "import ctypes\n"
              , "import curses\n"
              , "import dbm.ndbm\n"
              , "import decimal\n"
              , "import hashlib\n"
              , "import lzma\n"
              , "import os\n"
              , "import readline\n"
              , "import sqlite3\n"
              , "import ssl\n"
              , "import subprocess\n"
              , "import sys\n"
              , "import sysconfig\n"
              , "import zlib\n"
              , "\n"
              , "expected = {\n"
              , "    \"SHELL\": os.environ[\"RUBBLE_EXPECTED_SHELL\"],\n"
              , "    \"INSTALL\": os.environ[\"RUBBLE_EXPECTED_INSTALL\"],\n"
              , "    \"INSTALL_PROGRAM\": os.environ[\"RUBBLE_EXPECTED_INSTALL\"],\n"
              , "    \"INSTALL_SCRIPT\": os.environ[\"RUBBLE_EXPECTED_INSTALL\"],\n"
              , "    \"INSTALL_DATA\": os.environ[\"RUBBLE_EXPECTED_INSTALL_DATA\"],\n"
              , "    \"INSTALL_SHARED\": os.environ[\"RUBBLE_EXPECTED_INSTALL_SHARED\"],\n"
              , "    \"MKDIR_P\": os.environ[\"RUBBLE_EXPECTED_MKDIR_P\"],\n"
              , "}\n"
              , "for key, value in expected.items():\n"
              , "    actual = sysconfig.get_config_var(key)\n"
              , "    assert actual == value, f\"{key}: expected {value!r}, got {actual!r}\"\n"
              , "shell_result = subprocess.run(\"printf shell-runtime-ok\", shell=True, check=True, text=True, capture_output=True)\n"
              , "assert shell_result.stdout == \"shell-runtime-ok\"\n"
              , "print(sys.version.split()[0])\n"
              , "print(shell_result.stdout)\n"
              , "print(\"python runtime modules ok\")\n"
              , "PY"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "odzciqpr5fl5qqpdqnohs7qpqqwvahqodbydsv7er2ztrfnfhbuq-bootstrap-env":
      { "id": "odzciqpr5fl5qqpdqnohs7qpqqwvahqodbydsv7er2ztrfnfhbuq-bootstrap-env"
      , "name": "bootstrap-env"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "wqckb6fysqnzuzmnm3hrgnie52iiuwqibunb222ynntml7x5lxjq-zstd"
          , "alias": "zstd"
          , "transitive": "true"
          }
        , { "brick": "bckpkewd24sqpe6rkydj4yn3u2zzm2fpcukdzgimleqxusuefnyq-xz"
          , "alias": "xz"
          , "transitive": "true"
          }
        , { "brick": "bb3woz66hfzaf7nxyfp5ihp6vxai7te2ymga2i65rr4rqmaipiyq-unzip"
          , "alias": "unzip"
          , "transitive": "true"
          }
        , { "brick": "stljkkdnfyucz33nxoovmbhimt6ff63ihoue4xv5uddik7it2v2q-m4"
          , "alias": "m4"
          , "transitive": "true"
          }
        , { "brick": "pobrsy2ju6afixohsh7wvks3aeccssrma4wwzy7ovmfg5qcucf7a-gzip"
          , "alias": "gzip"
          , "transitive": "true"
          }
        , { "brick": "eni6622eybzafiaivzmic5h3itxj6zsfrz2e7ifzoe2zlab25wua-grep"
          , "alias": "grep"
          , "transitive": "true"
          }
        , { "brick": "rtt7zlxbdwlqvf6xcv3ibd2j72sav5aq7a4osmz6in3hijdh67va-gpatch"
          , "alias": "gpatch"
          , "transitive": "true"
          }
        , { "brick": "gmiepopf36g4nt4bgf2k6ydxwomd3eahnlg5kzfd7itw6you5ynq-gnu-sed"
          , "alias": "gnu_sed"
          , "transitive": "true"
          }
        , { "brick": "bnh6a6xptku7pe37i7fyefxb3jn2eepsszqlp2xhok35cgvfhxuq-gnu-make"
          , "alias": "gnu_make"
          , "transitive": "true"
          }
        , { "brick": "x5qvjdfenrs6bc4xuttjluurx6ow3aj326m5ay6ni2ezq2u757va-gawk"
          , "alias": "gawk"
          , "transitive": "true"
          }
        , { "brick": "wszckkjwj7owe2w6seb3pficxwimbmjwkoqsa6m46ki64ujgqz2q-findutils"
          , "alias": "findutils"
          , "transitive": "true"
          }
        , { "brick": "n2y6cwlexb642nzfj7px6pn7pantf4zaw6mtlfscqidlarztalxq-diffutils"
          , "alias": "diffutils"
          , "transitive": "true"
          }
        , { "brick": "adcrhlud4lao22xpeqdtkmm3cbdxrk4yn7hqqh4y2wguzsupqiqq-curl"
          , "alias": "curl"
          , "transitive": "true"
          }
        , { "brick": "n6475wvske6j4dxfuhhbk6gplesuoo6c3tzd2p4bk5cciypjdqna-ca-certificates.pem"
          , "alias": "ca_certs"
          , "transitive": "true"
          }
        , { "brick": "pfctzr6y2rty63c32st2rmmgrexbnfrdgt2iic4na3bctqmrwoea-bzip2"
          , "alias": "bzip2"
          , "transitive": "true"
          }
        , { "brick": "bxchorbehgapcopsqwo7w5zwjgenujywlkkytlnad3dvy5hpqc5q-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "oolqu2vtbb4frcjavzuszx435gk62yg4qby6szr2w6rv4zzuj3zq-perl"
          , "alias": "perl"
          , "transitive": "true"
          }
        , { "brick": "l5cahjri52ofysycyibbzhr65aq4t6tyjkqtpvxk3d6oxuxjm4fa-git"
          , "alias": "git"
          , "transitive": "true"
          }
        , { "brick": "ic3mcp6r2byudz4wwzrzs7ld3te3lmfdcopyerhhnjybz6b4gz5q-gcc"
          , "alias": "gcc"
          , "transitive": "true"
          }
        , { "brick": "wkalziix43j55svwzjj2vbsjfaxxnqhhshnnfcz2v3dnih4fcqha-bison"
          , "alias": "bison"
          , "transitive": "true"
          }
        , { "brick": "jfai7zz72pherkoxskwv2r6de64ms2lv7eetewbbhcemhfmvu7sq-gnu-tar"
          , "alias": "gnu_tar"
          , "transitive": "true"
          }
        , { "brick": "72mkfvxl5mmbm7vwb7lqf2zdm4fspzwzv2cmpnsrum2l4c77u5cq-coreutils"
          , "alias": "coreutils"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p \"$out/bin\"\n"
              , "\n"
              , "# Helper function to create a wrapper script\n"
              , "# Usage: create_wrapper <wrapper_name> <actual_binary_path> [env_setup]\n"
              , "create_wrapper() {\n"
              , "  wrapper_name=$1\n"
              , "  actual_binary=$2\n"
              , "  env_setup=${3:-}\n"
              , "\n"
              , "  wrapper_path=\"$out/bin/$wrapper_name\"\n"
              , "\n"
              , "  cat > \"$wrapper_path\" << EOF\n"
              , "#!$bash/bin/bash\n"
              , "# Wrapper script for $wrapper_name\n"
              , "# Generated by bootstrap-env brick\n"
              , "${env_setup}\n"
              , "exec \"$actual_binary\" \"\\$@\"\n"
              , "EOF\n"
              , "\n"
              , "  chmod +x \"$wrapper_path\"\n"
              , "  echo \"Created wrapper: $wrapper_name -> $actual_binary\"\n"
              , "}\n"
              , "\n"
              , "# === Bash ===\n"
              , "create_wrapper \"bash\" \"$bash/bin/bash\"\n"
              , "create_wrapper \"sh\" \"$bash/bin/bash\"\n"
              , "\n"
              , "# === Coreutils ===\n"
              , "# Create wrappers for all coreutils commands\n"
              , "for cmd in \\\n"
              , "  basename cat chgrp chmod chown chroot cksum comm cp csplit cut date dd df \\\n"
              , "  dir dircolors dirname du echo env expand expr factor false fmt fold \\\n"
              , "  head hostid id install join kill link ln logname ls md5sum mkdir mkfifo \\\n"
              , "  mknod mktemp mv nice nl nohup nproc numfmt od paste pathchk pinky pr \\\n"
              , "  printenv printf ptx pwd readlink realpath rm rmdir runcon seq sha1sum \\\n"
              , "  sha224sum sha256sum sha384sum sha512sum shred shuf sleep sort split stat \\\n"
              , "  stdbuf stty sum sync tac tail tee test timeout touch tr true truncate \\\n"
              , "  tsort tty uname unexpand uniq unlink uptime users vdir wc who whoami yes \\\n"
              , "  b2sum base32 base64\n"
              , "do\n"
              , "  if [ -f \"$coreutils/bin/${cmd}\" ]; then\n"
              , "    create_wrapper \"$cmd\" \"$coreutils/bin/${cmd}\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# === curl ===\n"
              , "# curl needs SSL_CERT_FILE to find CA certificates\n"
              , "curl_env=\"export SSL_CERT_FILE=\\\"$ca_certs\\\"\"\n"
              , "create_wrapper \"curl\" \"$curl\" \"$curl_env\"\n"
              , "\n"
              , "# === Git ===\n"
              , "create_wrapper \"git\" \"$git/bin/git\"\n"
              , "\n"
              , "# === GNU tar ===\n"
              , "create_wrapper \"tar\" \"$gnu_tar\"\n"
              , "create_wrapper \"gtar\" \"$gnu_tar\"\n"
              , "\n"
              , "# === gzip ===\n"
              , "create_wrapper \"gzip\" \"$gzip\"\n"
              , "create_wrapper \"gunzip\" \"$gzip\"\n"
              , "create_wrapper \"zcat\" \"$gzip\"\n"
              , "\n"
              , "# === xz ===\n"
              , "create_wrapper \"xz\" \"$xz\"\n"
              , "for cmd in xzcat unxz lzma lzmadec lzcat; do\n"
              , "  create_wrapper \"$cmd\" \"$xz\"\n"
              , "done\n"
              , "\n"
              , "# === zstd ===\n"
              , "create_wrapper \"zstd\" \"$zstd\"\n"
              , "for cmd in zstdcat unzstd zstdmt; do\n"
              , "  create_wrapper \"$cmd\" \"$zstd\"\n"
              , "done\n"
              , "\n"
              , "# === GNU sed ===\n"
              , "create_wrapper \"sed\" \"$gnu_sed\"\n"
              , "\n"
              , "# === grep ===\n"
              , "create_wrapper \"grep\" \"$grep\"\n"
              , "create_wrapper \"egrep\" \"$grep\"\n"
              , "create_wrapper \"fgrep\" \"$grep\"\n"
              , "\n"
              , "# === GNU make ===\n"
              , "create_wrapper \"make\" \"$gnu_make\"\n"
              , "create_wrapper \"gmake\" \"$gnu_make\"\n"
              , "\n"
              , "# === gpatch ===\n"
              , "create_wrapper \"patch\" \"$gpatch\"\n"
              , "create_wrapper \"gpatch\" \"$gpatch\"\n"
              , "\n"
              , "# === findutils ===\n"
              , "for cmd in find xargs; do\n"
              , "  if [ -f \"$findutils/bin/$cmd\" ]; then\n"
              , "    create_wrapper \"$cmd\" \"$findutils/bin/$cmd\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# === bzip2 ===\n"
              , "create_wrapper \"bzip2\" \"$bzip2\"\n"
              , "create_wrapper \"bunzip2\" \"$bzip2\"\n"
              , "create_wrapper \"bzcat\" \"$bzip2\"\n"
              , "\n"
              , "# === unzip ===\n"
              , "create_wrapper \"unzip\" \"$unzip\"\n"
              , "\n"
              , "# === perl ===\n"
              , "perl_env=\"export PERL5LIB=\\\"$perl/share/perl5/core_perl:$perl/lib/perl5/core_perl\\${PERL5LIB:+:}\\${PERL5LIB:-}\\\"\"\n"
              , "create_wrapper \"perl\" \"$perl/bin/perl\" \"$perl_env\"\n"
              , "\n"
              , "# === gawk ===\n"
              , "create_wrapper \"awk\" \"$gawk\"\n"
              , "create_wrapper \"gawk\" \"$gawk\"\n"
              , "\n"
              , "# === diffutils ===\n"
              , "for cmd in diff cmp diff3 sdiff; do\n"
              , "  if [ -f \"$diffutils/bin/$cmd\" ]; then\n"
              , "    create_wrapper \"$cmd\" \"$diffutils/bin/$cmd\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# === m4 ===\n"
              , "create_wrapper \"m4\" \"$m4\"\n"
              , "\n"
              , "# === bison ===\n"
              , "bison_env=\"export BISON_PKGDATADIR=\\\"$bison/share/bison\\\"\n"
              , "export M4=\\\"$m4\\\"\"\n"
              , "create_wrapper \"bison\" \"$bison/bin/bison\" \"$bison_env\"\n"
              , "create_wrapper \"yacc\" \"$bison/bin/yacc\" \"$bison_env\"\n"
              , "\n"
              , "# === GCC toolchain ===\n"
              , "gcc_env=\"export LD_LIBRARY_PATH=\\\"$gcc/lib\\${LD_LIBRARY_PATH:+:}\\${LD_LIBRARY_PATH:-}\\\"\"\n"
              , "for cmd in gcc g++ cc cpp c89 c99; do\n"
              , "  if [ -f \"$gcc/bin/$cmd\" ]; then\n"
              , "    create_wrapper \"$cmd\" \"$gcc/bin/$cmd\" \"$gcc_env\"\n"
              , "  fi\n"
              , "done\n"
              , "for cmd in as ld ar nm ranlib strip objdump objcopy readelf strings size; do\n"
              , "  if [ -f \"$gcc/bin/$cmd\" ]; then\n"
              , "    create_wrapper \"$cmd\" \"$gcc/bin/$cmd\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# === Environment setup script ===\n"
              , "{\n"
              , "  echo \"# Bootstrap environment setup script for Linux\"\n"
              , "  echo \"# Source this file to set up environment variables for builds\"\n"
              , "  echo \"export PATH=\\\"$out/bin\\${PATH:+:}\\${PATH:-}\\\"\"\n"
              , "  echo \"export SSL_CERT_FILE=\\\"$ca_certs\\\"\"\n"
              , "  echo \"export CC=\\\"$gcc/bin/gcc\\\"\"\n"
              , "  echo \"export CXX=\\\"$gcc/bin/g++\\\"\"\n"
              , "  echo \"export AR=\\\"$gcc/bin/ar\\\"\"\n"
              , "  echo \"export RANLIB=\\\"$gcc/bin/ranlib\\\"\"\n"
              , "  echo \"export PERL5LIB=\\\"$perl/share/perl5/core_perl:$perl/lib/perl5/core_perl\\${PERL5LIB:+:}\\${PERL5LIB:-}\\\"\"\n"
              , "} > \"$out/setup-env.sh\"\n"
              , "chmod +x \"$out/setup-env.sh\"\n"
              , "echo \"Created setup-env.sh for environment variable setup\"\n"
              , "\n"
              , "# === Verification ===\n"
              , "echo \"\"\n"
              , "echo \"=== Bootstrap environment created ===\"\n"
              , "echo \"Wrappers created in: $out/bin\"\n"
              , "echo \"\"\n"
              , "echo \"Tool count: $(ls -1 \"$out/bin\" | wc -l)\"\n"
              , "echo \"\"\n"
              , "echo \"Sample verification:\"\n"
              , "\"$out/bin/bash\" --version | head -1 || true\n"
              , "\"$out/bin/ls\" --version 2>&1 | head -1 || true\n"
              , "\"$out/bin/curl\" --version | head -1 || true\n"
              , "\"$out/bin/git\" --version\n"
              , "\"$out/bin/tar\" --version | head -1 || true\n"
              , "\"$out/bin/make\" --version | head -1 || true\n"
              , "\"$out/bin/sed\" --version | head -1 || true\n"
              , "\"$out/bin/gcc\" --version | head -1 || true\n"
              , "\"$out/bin/perl\" --version 2>&1 | head -2 | tail -1 || true"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "mi65hk5fk6kh6hh7rtv3dp2aff6z3zadlz3kqt6pc5thxhfas4xa-linux-headers":
      { "id": "mi65hk5fk6kh6hh7rtv3dp2aff6z3zadlz3kqt6pc5thxhfas4xa-linux-headers"
      , "name": "linux-headers"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "r4czt3gbzhl677qs6tbtvi4i5qkwuypq3sxstv6zgzp6xt3duq7a-linux-6.12.tar.xz"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "ic3mcp6r2byudz4wwzrzs7ld3te3lmfdcopyerhhnjybz6b4gz5q-gcc"
          , "alias": "musl_gcc"
          , "transitive": "false"
          }
        , { "brick": "vaysgwzfbxgkqarrni4ntmw4vxkxaeuh77tz7ira6uvrj3bi7kcq-rsync"
          , "alias": "rsync"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "export PATH=\"$rsync/bin:$PATH\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "odzciqpr5fl5qqpdqnohs7qpqqwvahqodbydsv7er2ztrfnfhbuq-bootstrap-env"
          , "alias": "bootstrap_env"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$out/setup-env.sh\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "BUILD_JOBS all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "kernel_arch"
          , "value": "x86"
          }
        , { "name": "linux_version"
          , "value": "6.12"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "echo \"=== Extracting linux ${linux_version} ===\"\n"
              , "tar xf \"$src\"\n"
              , "cd \"linux-${linux_version}\"\n"
              , "\n"
              , "echo \"=== Installing kernel headers (arch=${kernel_arch}) ===\"\n"
              , "build_shell=\"$bootstrap_env/bin/bash\"\n"
              , "gcc_triple=\"$(${musl_gcc}/bin/gcc -dumpmachine)\"\n"
              , "gcc_ver=\"$(\"${musl_gcc}/bin/gcc\" -dumpversion | cut -d. -f1-2)\"\n"
              , "hostcc=\"${musl_gcc}/bin/gcc -fno-lto -isystem ${musl_gcc}/include -isystem ${musl_gcc}/lib/gcc/${gcc_triple}/${gcc_ver}/include\"\n"
              , "make ARCH=\"${kernel_arch}\" HOSTCC=\"$hostcc\" HOSTLDFLAGS=\"-static\" SHELL=\"$build_shell\" INSTALL_HDR_PATH=\"$out\" headers_install\n"
              , "\n"
              , "header_count=0\n"
              , "while IFS= read -r -d '' header; do\n"
              , "  header_count=$((header_count + 1))\n"
              , "done < <(find \"$out/include\" \\( -type f -o -type l \\) -name '*.h' -print0 | LC_ALL=C sort -z)\n"
              , "\n"
              , "echo \"=== Linux headers install complete ===\"\n"
              , "echo \"Installed ${header_count} header files\"\n"
              , "ls \"$out/include/\" | head -20"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "pi47flk3wslxukcxfmqnxlpw7diebs2b2zzrjf6l6ptrrjnj64hq-bootstrap-build-tools":
      { "id": "pi47flk3wslxukcxfmqnxlpw7diebs2b2zzrjf6l6ptrrjnj64hq-bootstrap-build-tools"
      , "name": "bootstrap-build-tools"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "wqckb6fysqnzuzmnm3hrgnie52iiuwqibunb222ynntml7x5lxjq-zstd"
          , "alias": "zstd"
          , "transitive": "true"
          }
        , { "brick": "bckpkewd24sqpe6rkydj4yn3u2zzm2fpcukdzgimleqxusuefnyq-xz"
          , "alias": "xz"
          , "transitive": "true"
          }
        , { "brick": "bb3woz66hfzaf7nxyfp5ihp6vxai7te2ymga2i65rr4rqmaipiyq-unzip"
          , "alias": "unzip"
          , "transitive": "true"
          }
        , { "brick": "stljkkdnfyucz33nxoovmbhimt6ff63ihoue4xv5uddik7it2v2q-m4"
          , "alias": "m4"
          , "transitive": "true"
          }
        , { "brick": "pobrsy2ju6afixohsh7wvks3aeccssrma4wwzy7ovmfg5qcucf7a-gzip"
          , "alias": "gzip"
          , "transitive": "true"
          }
        , { "brick": "eni6622eybzafiaivzmic5h3itxj6zsfrz2e7ifzoe2zlab25wua-grep"
          , "alias": "grep"
          , "transitive": "true"
          }
        , { "brick": "rtt7zlxbdwlqvf6xcv3ibd2j72sav5aq7a4osmz6in3hijdh67va-gpatch"
          , "alias": "gpatch"
          , "transitive": "true"
          }
        , { "brick": "gmiepopf36g4nt4bgf2k6ydxwomd3eahnlg5kzfd7itw6you5ynq-gnu-sed"
          , "alias": "gnu_sed"
          , "transitive": "true"
          }
        , { "brick": "bnh6a6xptku7pe37i7fyefxb3jn2eepsszqlp2xhok35cgvfhxuq-gnu-make"
          , "alias": "gnu_make"
          , "transitive": "true"
          }
        , { "brick": "x5qvjdfenrs6bc4xuttjluurx6ow3aj326m5ay6ni2ezq2u757va-gawk"
          , "alias": "gawk"
          , "transitive": "true"
          }
        , { "brick": "wszckkjwj7owe2w6seb3pficxwimbmjwkoqsa6m46ki64ujgqz2q-findutils"
          , "alias": "findutils"
          , "transitive": "true"
          }
        , { "brick": "n2y6cwlexb642nzfj7px6pn7pantf4zaw6mtlfscqidlarztalxq-diffutils"
          , "alias": "diffutils"
          , "transitive": "true"
          }
        , { "brick": "pfctzr6y2rty63c32st2rmmgrexbnfrdgt2iic4na3bctqmrwoea-bzip2"
          , "alias": "bzip2"
          , "transitive": "true"
          }
        , { "brick": "bxchorbehgapcopsqwo7w5zwjgenujywlkkytlnad3dvy5hpqc5q-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "oolqu2vtbb4frcjavzuszx435gk62yg4qby6szr2w6rv4zzuj3zq-perl"
          , "alias": "perl"
          , "transitive": "true"
          }
        , { "brick": "wkalziix43j55svwzjj2vbsjfaxxnqhhshnnfcz2v3dnih4fcqha-bison"
          , "alias": "bison"
          , "transitive": "true"
          }
        , { "brick": "jfai7zz72pherkoxskwv2r6de64ms2lv7eetewbbhcemhfmvu7sq-gnu-tar"
          , "alias": "gnu_tar"
          , "transitive": "true"
          }
        , { "brick": "72mkfvxl5mmbm7vwb7lqf2zdm4fspzwzv2cmpnsrum2l4c77u5cq-coreutils"
          , "alias": "coreutils"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p \"$out/bin\"\n"
              , "\n"
              , "create_wrapper() {\n"
              , "  wrapper_name=$1\n"
              , "  actual_binary=$2\n"
              , "  env_setup=${3:-}\n"
              , "  wrapper_path=\"$out/bin/$wrapper_name\"\n"
              , "\n"
              , "  cat > \"$wrapper_path\" <<EOF\n"
              , "#!$bash/bin/bash\n"
              , "${env_setup}\n"
              , "exec \"$actual_binary\" \"\\$@\"\n"
              , "EOF\n"
              , "  chmod +x \"$wrapper_path\"\n"
              , "  echo \"Created wrapper: $wrapper_name -> $actual_binary\"\n"
              , "}\n"
              , "\n"
              , "create_wrapper \"bash\" \"$bash/bin/bash\"\n"
              , "create_wrapper \"sh\" \"$bash/bin/bash\"\n"
              , "\n"
              , "for cmd in \\\n"
              , "  basename cat chgrp chmod chown chroot cksum comm cp csplit cut date dd df \\\n"
              , "  dir dircolors dirname du echo env expand expr factor false fmt fold \\\n"
              , "  head hostid id install join kill link ln logname ls md5sum mkdir mkfifo \\\n"
              , "  mknod mktemp mv nice nl nohup nproc numfmt od paste pathchk pinky pr \\\n"
              , "  printenv printf ptx pwd readlink realpath rm rmdir runcon seq sha1sum \\\n"
              , "  sha224sum sha256sum sha384sum sha512sum shred shuf sleep sort split stat \\\n"
              , "  stdbuf stty sum sync tac tail tee test timeout touch tr true truncate \\\n"
              , "  tsort tty uname unexpand uniq unlink uptime users vdir wc who whoami yes \\\n"
              , "  b2sum base32 base64\n"
              , "do\n"
              , "  if [ -f \"$coreutils/bin/${cmd}\" ]; then\n"
              , "    create_wrapper \"$cmd\" \"$coreutils/bin/${cmd}\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "create_wrapper \"tar\" \"$gnu_tar\"\n"
              , "create_wrapper \"gtar\" \"$gnu_tar\"\n"
              , "create_wrapper \"gzip\" \"$gzip\"\n"
              , "create_wrapper \"gunzip\" \"$gzip\"\n"
              , "create_wrapper \"zcat\" \"$gzip\"\n"
              , "create_wrapper \"xz\" \"$xz\"\n"
              , "for cmd in xzcat unxz lzma lzmadec lzcat; do\n"
              , "  create_wrapper \"$cmd\" \"$xz\"\n"
              , "done\n"
              , "create_wrapper \"zstd\" \"$zstd\"\n"
              , "for cmd in zstdcat unzstd zstdmt; do\n"
              , "  create_wrapper \"$cmd\" \"$zstd\"\n"
              , "done\n"
              , "create_wrapper \"sed\" \"$gnu_sed\"\n"
              , "create_wrapper \"grep\" \"$grep\"\n"
              , "create_wrapper \"egrep\" \"$grep\"\n"
              , "create_wrapper \"fgrep\" \"$grep\"\n"
              , "create_wrapper \"make\" \"$gnu_make\"\n"
              , "create_wrapper \"gmake\" \"$gnu_make\"\n"
              , "create_wrapper \"patch\" \"$gpatch\"\n"
              , "create_wrapper \"gpatch\" \"$gpatch\"\n"
              , "\n"
              , "for cmd in find xargs; do\n"
              , "  if [ -f \"$findutils/bin/$cmd\" ]; then\n"
              , "    create_wrapper \"$cmd\" \"$findutils/bin/$cmd\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "create_wrapper \"bzip2\" \"$bzip2\"\n"
              , "create_wrapper \"bunzip2\" \"$bzip2\"\n"
              , "create_wrapper \"bzcat\" \"$bzip2\"\n"
              , "create_wrapper \"unzip\" \"$unzip\"\n"
              , "\n"
              , "perl_env=\"export PERL5LIB=\\\"$perl/share/perl5/core_perl:$perl/lib/perl5/core_perl\\${PERL5LIB:+:}\\${PERL5LIB:-}\\\"\"\n"
              , "create_wrapper \"perl\" \"$perl/bin/perl\" \"$perl_env\"\n"
              , "create_wrapper \"awk\" \"$gawk\"\n"
              , "create_wrapper \"gawk\" \"$gawk\"\n"
              , "\n"
              , "for cmd in diff cmp diff3 sdiff; do\n"
              , "  if [ -f \"$diffutils/bin/$cmd\" ]; then\n"
              , "    create_wrapper \"$cmd\" \"$diffutils/bin/$cmd\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "create_wrapper \"m4\" \"$m4\"\n"
              , "bison_env=\"export BISON_PKGDATADIR=\\\"$bison/share/bison\\\"\n"
              , "export M4=\\\"$m4\\\"\"\n"
              , "create_wrapper \"bison\" \"$bison/bin/bison\" \"$bison_env\"\n"
              , "create_wrapper \"yacc\" \"$bison/bin/yacc\" \"$bison_env\"\n"
              , "\n"
              , "{\n"
              , "  echo \"# Bootstrap build tools setup script for Linux\"\n"
              , "  echo \"export PATH=\\\"$out/bin\\\"\"\n"
              , "  echo \"export SHELL=\\\"$out/bin/bash\\\"\"\n"
              , "  echo \"export CONFIG_SHELL=\\\"$out/bin/bash\\\"\"\n"
              , "  echo \"export PERL5LIB=\\\"$perl/share/perl5/core_perl:$perl/lib/perl5/core_perl\\${PERL5LIB:+:}\\${PERL5LIB:-}\\\"\"\n"
              , "  echo \"export BISON_PKGDATADIR=\\\"$bison/share/bison\\\"\"\n"
              , "  echo \"export M4=\\\"$m4\\\"\"\n"
              , "  echo \"hash -r 2>/dev/null || true\"\n"
              , "} > \"$out/setup-env.sh\"\n"
              , "chmod +x \"$out/setup-env.sh\"\n"
              , "\n"
              , "echo \"=== Bootstrap build tools created ===\"\n"
              , "echo \"Wrappers created in: $out/bin\"\n"
              , "echo \"Tool count: $(ls -1 \"$out/bin\" | wc -l)\"\n"
              , "\"$out/bin/bash\" --version | head -1 || true\n"
              , "\"$out/bin/tar\" --version | head -1 || true\n"
              , "\"$out/bin/make\" --version | head -1 || true\n"
              , "\"$out/bin/perl\" --version 2>&1 | head -2 | tail -1 || true\n"
              , "\n"
              , "for forbidden_tool in gcc g++ cc c++ cpp ld as ar ranlib readelf strip objdump objcopy nm; do\n"
              , "  if [ -e \"$out/bin/$forbidden_tool\" ]; then\n"
              , "    echo \"Unexpected compiler or binutils wrapper: $forbidden_tool\" >&2\n"
              , "    exit 1\n"
              , "  fi\n"
              , "done"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "4eriy5pgdzg4evjc6ohrqzxsk44lleaad57fyhk2hn74kco6v4ra-nodejs-22.22.3-source":
      { "id": "4eriy5pgdzg4evjc6ohrqzxsk44lleaad57fyhk2hn74kco6v4ra-nodejs-22.22.3-source"
      , "name": "nodejs-22.22.3-source"
      , "inputs": [
          { "brick": "lzon4va7lg4upjzht255nf47md7hgzlxh2pmoaazx32gzwpuy7fa-node-v22.22.3.tar.xz"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "pi47flk3wslxukcxfmqnxlpw7diebs2b2zzrjf6l6ptrrjnj64hq-bootstrap-build-tools"
          , "alias": "bootstrap"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$out/setup-env.sh\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "node_version"
          , "value": "v22.22.3"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "echo \"=== Installing Node.js ${node_version} source archive ===\"\n"
              , "cp \"$src\" \"$out\"\n"
              , "\n"
              , "echo \"=== Verifying Node.js ${node_version} source archive ===\"\n"
              , "tar -tf \"$out\" >/dev/null"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "fynes4jr5ntfmo2jjyaquumpfr4ucq35bbc5nmcge6o7bcgldoiq-binutils-cross":
      { "id": "fynes4jr5ntfmo2jjyaquumpfr4ucq35bbc5nmcge6o7bcgldoiq-binutils-cross"
      , "name": "binutils-cross"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "kunm4aanjegga2okph6bty3sklbipirbunbmraanvx2vakcuqdpa-binutils-2.44.tar.xz"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "ic3mcp6r2byudz4wwzrzs7ld3te3lmfdcopyerhhnjybz6b4gz5q-gcc"
          , "alias": "musl_gcc"
          , "transitive": "false"
          }
        , { "brick": "odzciqpr5fl5qqpdqnohs7qpqqwvahqodbydsv7er2ztrfnfhbuq-bootstrap-env"
          , "alias": "bootstrap_env"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$out/setup-env.sh\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "BUILD_JOBS all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "binutils_version"
          , "value": "2.44"
          }
        , { "name": "musl_interpreter"
          , "value": "ld-musl-x86_64.so.1"
          }
        , { "name": "target_triple"
          , "value": "x86_64-linux-gnu"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "jobs=\"${BUILD_JOBS:-$(nproc)}\"\n"
              , "\n"
              , "echo \"=== Extracting binutils ${binutils_version} ===\"\n"
              , "tar xf \"$src\"\n"
              , "cd \"binutils-${binutils_version}\"\n"
              , "# Bundled libtool probes hard-code /usr/bin/file; disable that host probe.\n"
              , "find . -name configure -type f -exec sed -i 's|/usr/bin/file|:|g' {} +\n"
              , "\n"
              , "echo \"=== Configuring binutils (cross, target=${target_triple}) ===\"\n"
              , "mkdir build && cd build\n"
              , "\n"
              , "# Use musl gcc with its own headers, avoiding system glibc headers\n"
              , "gcc_triple=\"$(${musl_gcc}/bin/gcc -dumpmachine)\"\n"
              , "gcc_ver=\"$(\"${musl_gcc}/bin/gcc\" -dumpfullversion 2>/dev/null || \"${musl_gcc}/bin/gcc\" -dumpversion)\"\n"
              , "host_include_flags=\"-nostdinc -isystem ${musl_gcc}/lib/gcc/${gcc_triple}/${gcc_ver}/include -isystem ${musl_gcc}/include\"\n"
              , "\n"
              , "host_link_flags=\"-static -no-pie\"\n"
              , "build_shell=\"$bootstrap_env/bin/bash\"\n"
              , "export CC=\"${musl_gcc}/bin/gcc -fno-lto ${host_link_flags}\"\n"
              , "export CXX=\"${musl_gcc}/bin/g++ -fno-lto ${host_link_flags}\"\n"
              , "export CPP=\"${musl_gcc}/bin/gcc -E ${host_include_flags}\"\n"
              , "export CXXCPP=\"${musl_gcc}/bin/g++ -E ${host_include_flags}\"\n"
              , "export CONFIG_SHELL=\"$build_shell\"\n"
              , "export SHELL=\"$build_shell\"\n"
              , "export AR=\"${musl_gcc}/bin/ar\"\n"
              , "export AS=\"${musl_gcc}/bin/as\"\n"
              , "export LD=\"${musl_gcc}/bin/ld\"\n"
              , "export NM=\"${musl_gcc}/bin/nm\"\n"
              , "export OBJCOPY=\"${musl_gcc}/bin/objcopy\"\n"
              , "export OBJDUMP=\"${musl_gcc}/bin/objdump\"\n"
              , "export RANLIB=\"${musl_gcc}/bin/ranlib\"\n"
              , "export READELF=\"${musl_gcc}/bin/readelf\"\n"
              , "export STRIP=\"${musl_gcc}/bin/strip\"\n"
              , "tool_shims=\"$PWD/rubble-build-tool-shims\"\n"
              , "mkdir -p \"$tool_shims\"\n"
              , "{\n"
              , "  printf '#!%s\\n' \"$build_shell\"\n"
              , "  printf '%s\\n' \\\n"
              , "    'out=' \\\n"
              , "    'while [ \"$#\" -gt 0 ]; do' \\\n"
              , "    '  case \"$1\" in' \\\n"
              , "    '    --output=*)' \\\n"
              , "    '      out=\"${1#--output=}\"' \\\n"
              , "    '      ;;' \\\n"
              , "    '    --output)' \\\n"
              , "    '      shift' \\\n"
              , "    '      out=\"${1:-}\"' \\\n"
              , "    '      ;;' \\\n"
              , "    '  esac' \\\n"
              , "    '  shift || break' \\\n"
              , "    'done' \\\n"
              , "    'if [ -n \"$out\" ]; then' \\\n"
              , "    '  : > \"$out\"' \\\n"
              , "    'fi' \\\n"
              , "    'exit 0'\n"
              , "} > \"$tool_shims/pod2man\"\n"
              , "chmod +x \"$tool_shims/pod2man\"\n"
              , "{\n"
              , "  printf '#!%s\\n' \"$build_shell\"\n"
              , "  printf '%s\\n' 'exit 0'\n"
              , "} > \"$tool_shims/ldconfig\"\n"
              , "chmod +x \"$tool_shims/ldconfig\"\n"
              , "export PATH=\"$tool_shims:$PATH\"\n"
              , "export PKG_CONFIG=false\n"
              , "export PKG_CONFIG_LIBDIR=/nonexistent\n"
              , "export MAKEINFO=true\n"
              , "export POD2MAN=\"$tool_shims/pod2man\"\n"
              , "export AM_UPDATE_INFO_DIR=no\n"
              , "true_tool=\"$bootstrap_env/bin/true\"\n"
              , "export ac_cv_path_LDCONFIG=\"$true_tool\"\n"
              , "export lt_cv_path_LDCONFIG=\"$true_tool\"\n"
              , "export CFLAGS=\"$host_include_flags\"\n"
              , "export CXXFLAGS=\"$CFLAGS\"\n"
              , "export CPPFLAGS=\"${host_include_flags}\"\n"
              , "export LDFLAGS=\"${host_link_flags}\"\n"
              , "\n"
              , "\"$build_shell\" ../configure \\\n"
              , "  --prefix=\"$out\" \\\n"
              , "  --target=\"${target_triple}\" \\\n"
              , "  --disable-multilib \\\n"
              , "  --disable-nls \\\n"
              , "  --disable-werror \\\n"
              , "  --disable-gprofng \\\n"
              , "  --without-debuginfod \\\n"
              , "  --disable-plugins \\\n"
              , "  --enable-deterministic-archives \\\n"
              , "  --with-sysroot=\"$out/${target_triple}\"\n"
              , "\n"
              , "echo \"=== Building binutils (jobs=$jobs) ===\"\n"
              , "make LDFLAGS=\"${LDFLAGS}\" -j \"$jobs\" SHELL=\"$build_shell\" MAKEINFO=true POD2MAN=\"$POD2MAN\" AM_UPDATE_INFO_DIR=no\n"
              , "\n"
              , "echo \"=== Installing ===\"\n"
              , "make LDFLAGS=\"${LDFLAGS}\" install SHELL=\"$build_shell\" MAKEINFO=true POD2MAN=\"$POD2MAN\" AM_UPDATE_INFO_DIR=no\n"
              , "\n"
              , "echo \"=== Removing build-only metadata and documentation ===\"\n"
              , "rm -rf \"$out/share/man\" \"$out/share/info\"\n"
              , "find \"$out\" -name \"*.la\" -type f -delete\n"
              , "\n"
              , "echo \"=== Stripping debug sections ===\"\n"
              , "while IFS= read -r -d '' file; do\n"
              , "  if \"$READELF\" -h \"$file\" >/dev/null 2>&1; then\n"
              , "    \"$STRIP\" --strip-debug \"$file\"\n"
              , "  fi\n"
              , "done < <(find \"$out\" -type f -print0)\n"
              , "\n"
              , "echo \"=== Binutils cross build complete ===\"\n"
              , "ls \"$out/bin/\" | head -20"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "d5tvykm2as237vj33qbianfaytq7w5nxflnubxsq7wlvmtykqvba-gcc-cross-stage1":
      { "id": "d5tvykm2as237vj33qbianfaytq7w5nxflnubxsq7wlvmtykqvba-gcc-cross-stage1"
