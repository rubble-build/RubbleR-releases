{ "id": "3o2777jqr5c2rgmgdzdej34k42qxdplnmxfhux4lpelluh5mq4cq-rubble-web-assets"
, "name": "rubble-web-assets"
, "platform": "x86_64-linux"
, "build_platform": "x86_64-linux"
, "opaque": true
, "inputs": [
    { "brick": "odzciqpr5fl5qqpdqnohs7qpqqwvahqodbydsv7er2ztrfnfhbuq-bootstrap-env"
    , "alias": "bootstrap"
    , "transitive": "false"
    , "hooks": {
        "pre-checkout": [
          { "shell": {
              "value": [
                "source \"$out/setup-env.sh\""
              ]
            , "format": "text"
            }
          }
        ]
      }
    }
  , { "brick": "hseqkp4htbof2oy5ft32zmuk6nrjwse7qhf2e7nlyfrrphs3sc5a-wasm-pack-0.15.0"
    , "transitive": "false"
