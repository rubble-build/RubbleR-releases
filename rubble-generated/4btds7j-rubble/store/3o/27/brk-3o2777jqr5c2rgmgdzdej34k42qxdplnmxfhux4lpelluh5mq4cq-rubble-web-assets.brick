        , { "name": "python_version"
          , "value": "3.13.13"
          }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "env" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "write_heredoc_file() {\n"
              , "  local target=\"$1\"\n"
              , "  local content\n"
              , "  IFS= read -r -d '' content || true\n"
              , "  builtin printf '%s' \"$content\" > \"$target\"\n"
              , "}\n"
              , "\n"
              , "jobs=\"${BUILD_JOBS:-$(nproc)}\"\n"
              , "case \"$jobs\" in\n"
              , "  ''|*[!0-9]*|0)\n"
              , "    echo \"BUILD_JOBS must be a positive integer, got: ${jobs:-<empty>}\" >&2\n"
              , "    exit 1\n"
              , "    ;;\n"
              , "esac\n"
              , "\n"
              , "echo \"=== Extracting Python ${python_version} ===\"\n"
              , "tar -xf \"$src\"\n"
              , "cd \"Python-${python_version}\"\n"
              , "\n"
              , "export HOME=\"$PWD/home\"\n"
              , "mkdir -p \"$HOME\"\n"
              , "export PKG_CONFIG=false\n"
              , "export PKG_CONFIG_LIBDIR=/nonexistent\n"
              , "export ac_cv_file__dev_ptmx=yes\n"
              , "export ac_cv_file__dev_ptc=no\n"
              , "runtime_sh=\"$bash/bin/sh\"\n"
              , "runtime_install=\"$coreutils/bin/install\"\n"
              , "runtime_mkdir=\"$coreutils/bin/mkdir\"\n"
              , "test -x \"$runtime_sh\"\n"
              , "test -x \"$runtime_install\"\n"
              , "test -x \"$runtime_mkdir\"\n"
              , "\n"
              , "echo \"=== Configuring Python ${python_version} ===\"\n"
              , "\"$CONFIG_SHELL\" ./configure \\\n"
              , "  --prefix=\"$out\" \\\n"
              , "  --without-ensurepip \\\n"
              , "  --disable-test-modules \\\n"
              , "  --disable-shared\n"
              , "\n"
              , "echo \"=== Building Python ${python_version} (jobs=$jobs) ===\"\n"
              , "make -j \"$jobs\" SHELL=\"$CONFIG_SHELL\"\n"
              , "\n"
              , "echo \"=== Installing Python ${python_version} ===\"\n"
              , "make install SHELL=\"$CONFIG_SHELL\"\n"
              , "\n"
              , "ln -sf \"python${python_major_minor}\" \"$out/bin/python3\"\n"
              , "ln -sf python3 \"$out/bin/python\"\n"
              , "rm -rf \\\n"
              , "  \"$out/share/man\" \\\n"
              , "  \"$out/lib/python${python_major_minor}/test\" \\\n"
              , "  \"$out/lib/python${python_major_minor}/turtledemo\"\n"
              , "\n"
              , "python_config_dir=$(find \"$out/lib/python${python_major_minor}\" -maxdepth 1 -type d -name \"config-${python_major_minor}-*\" -print -quit)\n"
              , "if [ -n \"$python_config_dir\" ]; then\n"
              , "  rm -f \"$python_config_dir/install-sh\" \"$python_config_dir/makesetup\"\n"
              , "  write_heredoc_file \"$out/bin/python${python_major_minor}-config\" <<EOF\n"
              , "#!$out/bin/python3\n"
              , "import runpy\n"
              , "runpy.run_path(\"$python_config_dir/python-config.py\", run_name=\"__main__\")\n"
              , "EOF\n"
              , "  chmod +x \"$out/bin/python${python_major_minor}-config\"\n"
              , "  ln -sf \"python${python_major_minor}-config\" \"$out/bin/python3-config\"\n"
              , "  ln -sf \"python${python_major_minor}-config\" \"$out/bin/python-config\"\n"
              , "fi\n"
              , "rm -f \"$out/lib/python${python_major_minor}/ctypes/macholib/fetch_macholib\"\n"
              , "\n"
              , "require_line_equals() {\n"
              , "  local file=\"$1\" expected=\"$2\" line\n"
              , "  while IFS= read -r line || [ -n \"$line\" ]; do\n"
              , "    if [ \"$line\" = \"$expected\" ]; then\n"
              , "      return 0\n"
              , "    fi\n"
              , "  done < \"$file\"\n"
              , "  echo \"Expected line not found in $file: $expected\" >&2\n"
              , "  exit 1\n"
              , "}\n"
              , "\n"
              , "require_file_contains() {\n"
              , "  local file=\"$1\" needle=\"$2\" line\n"
              , "  while IFS= read -r line || [ -n \"$line\" ]; do\n"
              , "    if [[ \"$line\" == *\"$needle\"* ]]; then\n"
              , "      return 0\n"
              , "    fi\n"
              , "  done < \"$file\"\n"
              , "  echo \"Expected text not found in $file: $needle\" >&2\n"
              , "  exit 1\n"
              , "}\n"
              , "\n"
              , "require_file_not_contains() {\n"
              , "  local file=\"$1\" needle=\"$2\" line\n"
              , "  while IFS= read -r line || [ -n \"$line\" ]; do\n"
              , "    if [[ \"$line\" == *\"$needle\"* ]]; then\n"
              , "      echo \"Unexpected text in $file: $needle\" >&2\n"
              , "      echo \"Offending line: $line\" >&2\n"
              , "      exit 1\n"
              , "    fi\n"
              , "  done < \"$file\"\n"
              , "}\n"
              , "\n"
              , "normalize_make_var() {\n"
              , "  local file=\"$1\" key=\"$2\" value=\"$3\" expected tab\n"
              , "  tab=\"$(printf '\\t')\"\n"
              , "  expected=\"${key}=${tab}${value}\"\n"
              , "  sed -i \"s|^${key}[[:space:]]*=.*|${expected}|\" \"$file\"\n"
              , "  require_line_equals \"$file\" \"$expected\"\n"
              , "}\n"
              , "\n"
              , "normalize_sysconfig_var() {\n"
              , "  local file=\"$1\" key=\"$2\" value=\"$3\" expected\n"
              , "  expected=\"    '${key}': '${value}',\"\n"
              , "  sed -i \"s|^[[:space:]]*'${key}': .*|${expected}|\" \"$file\"\n"
              , "  require_line_equals \"$file\" \"$expected\"\n"
              , "}\n"
              , "\n"
              , "check_public_python_config_file() {\n"
              , "  local file=\"$1\"\n"
              , "  require_file_not_contains \"$file\" \"bootstrap-build-tools\"\n"
              , "  require_file_not_contains \"$file\" \"/usr/bin/install\"\n"
              , "  require_file_not_contains \"$file\" \"/usr/bin/mkdir\"\n"
              , "  require_file_not_contains \"$file\" \"./install-sh -c -d\"\n"
              , "}\n"
              , "\n"
              , "echo \"=== Normalizing Python runtime build configuration ===\"\n"
              , "if [ -z \"$python_config_dir\" ] || [ ! -f \"$python_config_dir/Makefile\" ]; then\n"
              , "  echo \"Expected installed Python Makefile under $out/lib/python${python_major_minor}\" >&2\n"
              , "  exit 1\n"
              , "fi\n"
              , "python_sysconfig_data=$(find \"$out/lib/python${python_major_minor}\" -maxdepth 1 -type f -name \"_sysconfigdata_*.py\" -print -quit)\n"
              , "if [ -z \"$python_sysconfig_data\" ] || [ ! -f \"$python_sysconfig_data\" ]; then\n"
              , "  echo \"Expected installed Python sysconfig data under $out/lib/python${python_major_minor}\" >&2\n"
              , "  exit 1\n"
              , "fi\n"
              , "\n"
              , "normalize_make_var \"$python_config_dir/Makefile\" \"SHELL\" \"$runtime_sh -e\"\n"
              , "normalize_make_var \"$python_config_dir/Makefile\" \"INSTALL\" \"$runtime_install -c\"\n"
              , "normalize_make_var \"$python_config_dir/Makefile\" \"INSTALL_PROGRAM\" \"$runtime_install -c\"\n"
              , "normalize_make_var \"$python_config_dir/Makefile\" \"INSTALL_SCRIPT\" \"$runtime_install -c\"\n"
              , "normalize_make_var \"$python_config_dir/Makefile\" \"INSTALL_DATA\" \"$runtime_install -c -m 644\"\n"
              , "normalize_make_var \"$python_config_dir/Makefile\" \"INSTALL_SHARED\" \"$runtime_install -c -m 755\"\n"
              , "normalize_make_var \"$python_config_dir/Makefile\" \"MKDIR_P\" \"$runtime_mkdir -p\"\n"
              , "\n"
              , "normalize_sysconfig_var \"$python_sysconfig_data\" \"SHELL\" \"$runtime_sh -e\"\n"
              , "normalize_sysconfig_var \"$python_sysconfig_data\" \"INSTALL\" \"$runtime_install -c\"\n"
              , "normalize_sysconfig_var \"$python_sysconfig_data\" \"INSTALL_PROGRAM\" \"$runtime_install -c\"\n"
              , "normalize_sysconfig_var \"$python_sysconfig_data\" \"INSTALL_SCRIPT\" \"$runtime_install -c\"\n"
              , "normalize_sysconfig_var \"$python_sysconfig_data\" \"INSTALL_DATA\" \"$runtime_install -c -m 644\"\n"
              , "normalize_sysconfig_var \"$python_sysconfig_data\" \"INSTALL_SHARED\" \"$runtime_install -c -m 755\"\n"
              , "normalize_sysconfig_var \"$python_sysconfig_data\" \"MKDIR_P\" \"$runtime_mkdir -p\"\n"
              , "\n"
              , "check_public_python_config_file \"$python_config_dir/Makefile\"\n"
              , "check_public_python_config_file \"$python_sysconfig_data\"\n"
              , "\n"
              , "python_subprocess=\"$out/lib/python${python_major_minor}/subprocess.py\"\n"
              , "if [ -f \"$python_subprocess\" ]; then\n"
              , "  sed -i \"s|else '/bin/sh')|else '$runtime_sh')|\" \"$python_subprocess\"\n"
              , "  require_file_contains \"$python_subprocess\" \"else '$runtime_sh')\"\n"
              , "  require_file_not_contains \"$python_subprocess\" \"else '/bin/sh')\"\n"
              , "else\n"
              , "  echo \"Expected Python subprocess module at $python_subprocess\" >&2\n"
              , "  exit 1\n"
              , "fi\n"
              , "\n"
              , "echo \"=== Normalizing Python script shebangs ===\"\n"
              , "rubble_script_shebang_register \"$out/bin/python3\" python python3 \"python${python_major_minor}\" \"python${python_version}\"\n"
              , "rubble_script_shebang_register \"$bash/bin/bash\" sh bash\n"
              , "rubble_script_shebang_rewrite_all --strict --all \"$out\"\n"
              , "\n"
              , "write_heredoc_file \"$env\" <<EOF\n"
              , "set -euo pipefail\n"
              , "export PATH=\"$out/bin:\\${PATH}\"\n"
              , "export PYTHON=\"$out/bin/python3\"\n"
              , "export PYTHON3=\"$out/bin/python3\"\n"
              , "export PYTHONDONTWRITEBYTECODE=1\n"
              , "declare -p PATH PYTHON PYTHON3 PYTHONDONTWRITEBYTECODE\n"
              , "python3 --version\n"
              , "EOF\n"
              , "\n"
              , "echo \"=== Verifying Python ${python_version} ===\"\n"
              , "export PYTHONDONTWRITEBYTECODE=1\n"
              , "\"$out/bin/python3\" --version\n"
              , "RUBBLE_EXPECTED_SHELL=\"$runtime_sh -e\" \\\n"
              , "RUBBLE_EXPECTED_INSTALL=\"$runtime_install -c\" \\\n"
              , "RUBBLE_EXPECTED_INSTALL_DATA=\"$runtime_install -c -m 644\" \\\n"
              , "RUBBLE_EXPECTED_INSTALL_SHARED=\"$runtime_install -c -m 755\" \\\n"
              , "RUBBLE_EXPECTED_MKDIR_P=\"$runtime_mkdir -p\" \\\n"
              , "\"$out/bin/python3\" - <<'PY'\n"
              , "import bz2\n"
              , "import os\n"
              , "import pathlib\n"
              , "import subprocess\n"
              , "import sys\n"
              , "import sysconfig\n"
              , "\n"
              , "assert sys.version_info[:2] == (3, 13)\n"
              , "assert pathlib.Path(sys.executable).name.startswith(\"python3\")\n"
              , "assert sysconfig.get_config_var(\"CC\")\n"
              , "expected = {\n"
              , "    \"SHELL\": os.environ[\"RUBBLE_EXPECTED_SHELL\"],\n"
              , "    \"INSTALL\": os.environ[\"RUBBLE_EXPECTED_INSTALL\"],\n"
              , "    \"INSTALL_PROGRAM\": os.environ[\"RUBBLE_EXPECTED_INSTALL\"],\n"
              , "    \"INSTALL_SCRIPT\": os.environ[\"RUBBLE_EXPECTED_INSTALL\"],\n"
              , "    \"INSTALL_DATA\": os.environ[\"RUBBLE_EXPECTED_INSTALL_DATA\"],\n"
              , "    \"INSTALL_SHARED\": os.environ[\"RUBBLE_EXPECTED_INSTALL_SHARED\"],\n"
              , "    \"MKDIR_P\": os.environ[\"RUBBLE_EXPECTED_MKDIR_P\"],\n"
              , "}\n"
              , "for key, value in expected.items():\n"
              , "    actual = sysconfig.get_config_var(key)\n"
              , "    assert actual == value, f\"{key}: expected {value!r}, got {actual!r}\"\n"
              , "assert bz2.decompress(bz2.compress(b\"python bz2 helper ok\")) == b\"python bz2 helper ok\"\n"
              , "result = subprocess.run([sys.executable, \"-c\", \"print('python helper ok')\"], check=True, text=True, capture_output=True)\n"
              , "print(result.stdout.strip())\n"
              , "shell_result = subprocess.run(\"printf shell-helper-ok\", shell=True, check=True, text=True, capture_output=True)\n"
              , "assert shell_result.stdout == \"shell-helper-ok\"\n"
              , "print(shell_result.stdout)\n"
              , "print(\"prefix\", sys.prefix)\n"
              , "print(\"executable\", sys.executable)\n"
              , "PY\n"
              , "\n"
              , "python_bin=$(readlink -f \"$out/bin/python3\")\n"
              , "readelf_tool=\"$(dirname \"$CC\")/readelf\"\n"
              , "test -x \"$readelf_tool\"\n"
              , "ld_linux_candidates=(\"$gcc_runtime\"/lib/ld-linux-*.so.*)\n"
              , "expected_interpreter=\"${ld_linux_candidates[0]}\"\n"
              , "if [ ! -e \"$expected_interpreter\" ] || [ \"${#ld_linux_candidates[@]}\" -ne 1 ]; then\n"
              , "  echo \"Expected exactly one Rubble runtime interpreter under $gcc_runtime/lib\" >&2\n"
              , "  exit 1\n"
              , "fi\n"
              , "interpreter=$(\"$readelf_tool\" -l \"$python_bin\" | sed -n 's/.*Requesting program interpreter: \\(.*\\)]/\\1/p')\n"
              , "echo \"ELF interpreter: ${interpreter}\"\n"
              , "echo \"Expected ELF interpreter: ${expected_interpreter}\"\n"
              , "if [ \"$interpreter\" != \"$expected_interpreter\" ]; then\n"
              , "  echo \"Expected Python interpreter $expected_interpreter, got ${interpreter:-<empty>}\" >&2\n"
              , "  exit 1\n"
              , "fi\n"
              , "\n"
              , "python_rpath=$(\"$readelf_tool\" -d \"$python_bin\" | sed -n 's/.*\\(RPATH\\|RUNPATH\\).*: \\[\\(.*\\)\\]/\\2/p')\n"
              , "echo \"ELF RPATH/RUNPATH: ${python_rpath}\"\n"
              , "case \":$python_rpath:\" in\n"
              , "  *\":$gcc_runtime/lib:\"*) ;;\n"
              , "  *)\n"
              , "    echo \"Expected Python RPATH/RUNPATH to include $gcc_runtime/lib\" >&2\n"
              , "    exit 1\n"
              , "    ;;\n"
              , "esac\n"
              , "IFS=: read -r -a python_rpath_entries <<< \"$python_rpath\"\n"
              , "for python_rpath_entry in \"${python_rpath_entries[@]}\"; do\n"
              , "  case \"$python_rpath_entry\" in\n"
              , "    /home/*/.rubble/*|/usr|/usr/*|/lib|/lib/*|/lib64|/lib64/*)\n"
              , "      echo \"Unexpected host or user-store path in Python RPATH/RUNPATH: $python_rpath_entry\" >&2\n"
              , "      exit 1\n"
              , "    ;;\n"
              , "  esac\n"
              , "done\n"
              , "\n"
              , "chmod -R a-w \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
