        , { "brick": "cbi3fhmbxe5za4vfxlupx2wwtyrb5gk532gdlckzmg4ds4wtc33a-nodejs-22.22.3"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$env\""
                    ]
                  , "format": "text"
