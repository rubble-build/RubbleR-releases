          }
        , { "brick": "72mkfvxl5mmbm7vwb7lqf2zdm4fspzwzv2cmpnsrum2l4c77u5cq-coreutils"
          , "alias": "coreutils"
          , "transitive": "true"
          }
        , { "brick": "pi47flk3wslxukcxfmqnxlpw7diebs2b2zzrjf6l6ptrrjnj64hq-bootstrap-build-tools"
