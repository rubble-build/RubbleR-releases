      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "RUBBLE_SRC_LOCAL_PATHS all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "export HOME=\"$PWD/home\"\n"
              , "export npm_config_cache=\"$PWD/npm-cache\"\n"
              , "export npm_config_audit=false\n"
              , "export npm_config_fund=false\n"
              , "export npm_config_update_notifier=false\n"
              , "export npm_config_progress=false\n"
              , "export npm_config_ignore_scripts=true\n"
              , "mkdir -p \"$HOME\" \"$npm_config_cache\"\n"
              , "\n"
              , "cd rubble-web/ui\n"
              , "expected_package_manager=$(\"$NODE\" -p 'require(\"./package.json\").packageManager || \"\"')\n"
              , "case \"$expected_package_manager\" in\n"
              , "  npm@*)\n"
              , "    expected_npm_version=\"${expected_package_manager#npm@}\"\n"
              , "    ;;\n"
              , "  *)\n"
              , "    echo \"Expected packageManager to declare npm@<version>, got: ${expected_package_manager:-<empty>}\" >&2\n"
              , "    exit 1\n"
              , "    ;;\n"
              , "esac\n"
              , "actual_npm_version=$(\"$NPM\" --version)\n"
              , "if [[ \"$actual_npm_version\" != \"$expected_npm_version\" ]]; then\n"
              , "  echo \"npm version mismatch: packageManager=$expected_npm_version actual=$actual_npm_version\" >&2\n"
              , "  exit 1\n"
              , "fi\n"
              , "\n"
              , "\"$NPM\" ci --include=dev --ignore-scripts --no-audit --no-fund --cache \"$npm_config_cache\"\n"
              , "\n"
              , "test -x node_modules/.bin/tsc\n"
              , "test -x node_modules/.bin/vite\n"
              , "\n"
              , "mkdir -p \"$out\"\n"
              , "cp -a node_modules/. \"$out/\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  }
}
