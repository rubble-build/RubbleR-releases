              ]
            , "format": "text"
            }
          }
        ]
      }
    }
  , { "brick": "mv5kadbtt4oz54vjjvkdjm23pbfbdegu67h27noyb6bgcqaqhoiq-rust-web-wasm-toolchain"
    , "transitive": "false"
    , "after": [
