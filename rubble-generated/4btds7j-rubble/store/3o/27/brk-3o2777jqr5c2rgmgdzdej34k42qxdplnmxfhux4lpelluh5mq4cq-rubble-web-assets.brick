                    "value": [
                      "export PATH=\"$out/bin:$PATH\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "2zcsx4l6ph24tmaok5hwzpgr73kyxs3kxixfrxqodfw5ubmqhidq-linux-native-toolchain"
          , "transitive": "false"
          , "hooks": {
