  , "zkiff2cic77r6rxw3quhxg6gu4rznq4omwpz5tui7zwbvlqj6mbq-ld-musl.so":
      { "id": "zkiff2cic77r6rxw3quhxg6gu4rznq4omwpz5tui7zwbvlqj6mbq-ld-musl.so"
      , "name": "ld-musl.so"
      , "platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "rpxr23txqir7gm3jeg34or6v3x33tk66wsicortn5nabw7pgv4za-musl-1.2.5-r11.apk"
          , "alias": "src"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "musl_interpreter"
          , "value": "ld-musl-x86_64.so.1"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "echo \"Extracting musl interpreter...\"\n"
              , "tar -xzf \"$src\" 2>/dev/null || true\n"
              , "\n"
              , "cp -a \"lib/$musl_interpreter\" \"$out\"\n"
              , "\n"
              , "echo \"\"\n"
              , "echo \"=== musl interpreter ===\"\n"
              , "test -s \"$out\"\n"
              , "echo \"$out\"\n"
              , "ls -l \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "wqckb6fysqnzuzmnm3hrgnie52iiuwqibunb222ynntml7x5lxjq-zstd":
      { "id": "wqckb6fysqnzuzmnm3hrgnie52iiuwqibunb222ynntml7x5lxjq-zstd"
      , "name": "zstd"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "hl6djaj44qkp6rily6m7uf6lsksicuvyiukbsphwqzo7zhddpzna-zstd-libs-1.5.6-r2.apk"
          , "alias": "zstd_libs_apk"
          , "transitive": "false"
          }
        , { "brick": "gn35dmjju7ixfllbazzkcjuoxfqy5sbsv6g6ghmtlkm5boylcb2a-zstd-1.5.6-r2.apk"
          , "alias": "zstd_apk"
          , "transitive": "false"
          }
        , { "brick": "4z45nx65xw3y3yxdn5rw2qf5jwclaclnqqfhofeig6xotqxb7ajq-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "zkiff2cic77r6rxw3quhxg6gu4rznq4omwpz5tui7zwbvlqj6mbq-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        , { "name": "lib" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p zstd-extract zstdlibs-extract\n"
              , "tar -xzf \"$zstd_apk\" -C zstd-extract\n"
              , "tar -xzf \"$zstd_libs_apk\" -C zstdlibs-extract\n"
              , "\n"
              , "mkdir -p \"$lib\"\n"
              , "find zstdlibs-extract -name \"libzstd.so*\" -exec cp -a {} \"$lib/\" \\;\n"
              , "\n"
              , "cp zstd-extract/usr/bin/zstd \"$out\"\n"
              , "chmod +x \"$out\"\n"
              , "\"$patchelf\" --set-interpreter \"$ld_musl\" --set-rpath \"$lib\" \"$out\"\n"
              , "\n"
              , "# bin directory with symlinks for PATH integration\n"
              , "mkdir -p \"$bin\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/zstd\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/zstdcat\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/unzstd\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/zstdmt\"\n"
              , "\n"
              , "# Verify\n"
              , "echo \"\"\n"
              , "echo \"=== Verifying zstd installation ===\"\n"
              , "assert_needed() {\n"
              , "  elf=$1\n"
              , "  shift\n"
              , "  actual=$(\"$patchelf\" --print-needed \"$elf\" | LC_ALL=C sort)\n"
              , "  expected=$(printf '%s\\n' \"$@\" | LC_ALL=C sort)\n"
              , "  test \"$actual\" = \"$expected\"\n"
              , "}\n"
              , "\n"
              , "musl_soname=$(\"$patchelf\" --print-soname \"$ld_musl\")\n"
              , "case \"$musl_soname\" in\n"
              , "  libc.musl-*.so.1) ;;\n"
              , "  *) false ;;\n"
              , "esac\n"
              , "\n"
              , "test \"$(\"$patchelf\" --print-interpreter \"$out\")\" = \"$ld_musl\"\n"
              , "test \"$(\"$patchelf\" --print-rpath \"$out\")\" = \"$lib\"\n"
              , "assert_needed \"$out\" libzstd.so.1 \"$musl_soname\"\n"
              , "\n"
              , "test -L \"$lib/libzstd.so.1\"\n"
              , "libzstd_target=$(readlink \"$lib/libzstd.so.1\")\n"
              , "case \"$libzstd_target\" in\n"
              , "  \"\"|/*|*/*) false ;;\n"
              , "esac\n"
              , "libzstd_real=\"$lib/$libzstd_target\"\n"
              , "test -f \"$libzstd_real\"\n"
              , "test ! -L \"$libzstd_real\"\n"
              , "test \"$(\"$patchelf\" --print-soname \"$libzstd_real\")\" = libzstd.so.1\n"
              , "assert_needed \"$libzstd_real\" \"$musl_soname\"\n"
              , "\n"
              , "\"$ld_musl\" --library-path \"$lib\" \"$out\" --version"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "bckpkewd24sqpe6rkydj4yn3u2zzm2fpcukdzgimleqxusuefnyq-xz":
      { "id": "bckpkewd24sqpe6rkydj4yn3u2zzm2fpcukdzgimleqxusuefnyq-xz"
      , "name": "xz"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "2cr3miaqwsfbjz5dox46ivtiopgc6go2pymeqgeqlohjdercgi2q-xz-libs-5.8.3-r0.apk"
          , "alias": "xz_libs_apk"
          , "transitive": "false"
          }
        , { "brick": "y66xqjdfnmyt3m5hsbute7ucmeumlkm2bwhhlqp6is663jgjcx6a-xz-5.8.3-r0.apk"
          , "alias": "xz_apk"
          , "transitive": "false"
          }
        , { "brick": "4z45nx65xw3y3yxdn5rw2qf5jwclaclnqqfhofeig6xotqxb7ajq-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "zkiff2cic77r6rxw3quhxg6gu4rznq4omwpz5tui7zwbvlqj6mbq-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        , { "name": "lib" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "echo \"Extracting packages...\"\n"
              , "mkdir -p xz-extract xzlibs-extract\n"
              , "tar -xzf \"$xz_apk\" -C xz-extract 2>/dev/null || true\n"
              , "tar -xzf \"$xz_libs_apk\" -C xzlibs-extract 2>/dev/null || true\n"
              , "\n"
              , "# Copy liblzma shared libraries\n"
              , "mkdir -p \"$lib\"\n"
              , "find xzlibs-extract -name \"liblzma.so*\" -exec cp -a {} \"$lib/\" \\;\n"
              , "\n"
              , "# out is the xz binary itself\n"
              , "cp xz-extract/usr/bin/xz \"$out\"\n"
              , "chmod +x \"$out\"\n"
              , "\n"
              , "# Patch ELF binary\n"
              , "\"$patchelf\" --set-interpreter \"$ld_musl\" --set-rpath \"$lib\" \"$out\"\n"
              , "\n"
              , "# bin directory with symlinks for PATH integration\n"
              , "mkdir -p \"$bin\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/xz\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/unxz\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/xzcat\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/lzma\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/lzmadec\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/lzcat\"\n"
              , "\n"
              , "# Verify\n"
              , "echo \"\"\n"
              , "echo \"=== Verifying xz installation ===\"\n"
              , "\"$out\" --version | head -1 || true"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "bb3woz66hfzaf7nxyfp5ihp6vxai7te2ymga2i65rr4rqmaipiyq-unzip":
      { "id": "bb3woz66hfzaf7nxyfp5ihp6vxai7te2ymga2i65rr4rqmaipiyq-unzip"
