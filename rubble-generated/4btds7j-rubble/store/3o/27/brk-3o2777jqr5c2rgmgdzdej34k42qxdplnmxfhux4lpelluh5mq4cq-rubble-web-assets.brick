                "source \"$env\""
              ]
            , "format": "text"
            }
          }
        ]
      }
    }
  , { "brick": "jil63uldh5rtvpn3cgx6aofdnrjpzguabxjtbh7vpgtjobkrvjwq-rubble-web-assets.src-partial.patch"
    , "alias": "src"
    , "transitive": "false"
    , "hooks": {
        "post-checkout": [
          { "install-to": [
              { "output": "dir"
              , "dir": "./" }
            ]
          }
        , { "shell": {
              "value": [
                "( source \"${script}\" \"${dir}\" )"
              ]
            , "format": "text"
            }
          }
        ]
      }
    }
  , { "brick": "fmygahk5j3smbzx2qm2ywzls5bqlfiq4cyopw4wb7biwzc2ygl2a-rubble-deps-cache"
    , "alias": "deps_cache"
    , "transitive": "false"
    }
  , { "brick": "cbi3fhmbxe5za4vfxlupx2wwtyrb5gk532gdlckzmg4ds4wtc33a-nodejs-22.22.3"
    , "transitive": "false"
    , "after": [
        "bootstrap"
      ]
    , "hooks": {
        "pre-build": [
          { "shell": {
              "value": [
                "source \"$env\""
              ]
            , "format": "text"
            }
          }
        ]
      }
    }
  , { "brick": "6ltohnsz2vube6vjyzkgpm63uitpbekkkycn5rgb7em2mzx4al4q-rubble-web-node-modules"
    , "alias": "node_modules"
    , "transitive": "false"
    , "hooks": {
        "post-checkout": [
          { "install-to": [
              { "output": "out"
              , "dir": "./rubble-web/ui/node_modules/" }
            ]
          }
        ]
      }
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "RUBBLE_SRC_LOCAL_PATHS all_proxy http_proxy https_proxy no_proxy" }
  ]
, "var": [
    { "name": "lightningcss_binding"
    , "value": "lightningcss-linux-x64-gnu/lightningcss.linux-x64-gnu.node"
    }
  , { "name": "lightningcss_compat_binding"
    , "value": "lightningcss-linux-x64-gnu/lightningcss.linux-x64-gnu.node"
    }
  , { "name": "rolldown_binding_platform"
    , "value": "linux-x64-gnu"
    }
  , { "name": "wasm_pack_mode"
    , "value": "no-install"
    }
  ]
, "outputs": [
    { "name": "out" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "if [[ -n \"${deps_cache:-}\" ]]; then\n"
        , "  rm -rf vendor .cargo target\n"
        , "  cp -a \"${deps_cache}/vendor\" vendor\n"
        , "  cp -a \"${deps_cache}/.cargo\" .cargo\n"
        , "  cp -a \"${deps_cache}/target\" target\n"
        , "  cp -a \"${deps_cache}/Cargo.lock\" Cargo.lock\n"
        , "fi\n"
        , "\n"
        , "project_dir=\"$PWD\"\n"
        , "export HOME=\"$project_dir/home\"\n"
        , "export RUBBLE_RUNTIME_HOME=\"${RUBBLE_HOME}\"\n"
        , "export RUBBLE_RUNTIME_PATH_ENV=\"${bootstrap}/bin\"\n"
        , "export RUBBLE_RUNTIME_REQUIRED_BRICKS=\"\"\n"
        , "export CARGO_HOME=\"$project_dir/target/cargo_home\"\n"
        , "export OPENSSL_CONFIG_DIR=\"/rubble/openssl/ssl\"\n"
        , "export RUBBLE_WEB_HOST_RUSTFLAGS=\"${RUBBLE_WEB_HOST_RUSTFLAGS:-}\"\n"
        , "export RUBBLE_WEB_WASM_RUSTFLAGS=\"${RUBBLE_WEB_WASM_RUSTFLAGS:-}\"\n"
        , "# Keep this aligned with brick-deps-cache.yaml so copied Cargo artifacts remain reusable.\n"
        , "export RUSTFLAGS=\"${RUSTFLAGS:-} --cap-lints warn\"\n"
        , "export NAPI_RS_NATIVE_LIBRARY_PATH=\"$PWD/rubble-web/ui/node_modules/@rolldown/binding-${rolldown_binding_platform}/rolldown-binding.${rolldown_binding_platform}.node\"\n"
        , "test -s \"$NAPI_RS_NATIVE_LIBRARY_PATH\"\n"
        , "test -s \"$PWD/rubble-web/ui/node_modules/${lightningcss_binding}\"\n"
        , "if [[ \"$lightningcss_binding\" != \"$lightningcss_compat_binding\" ]]; then\n"
        , "  mkdir -p \"$(dirname \"$PWD/rubble-web/ui/node_modules/${lightningcss_compat_binding}\")\"\n"
        , "  cp -f \\\n"
        , "    \"$PWD/rubble-web/ui/node_modules/${lightningcss_binding}\" \\\n"
        , "    \"$PWD/rubble-web/ui/node_modules/${lightningcss_compat_binding}\"\n"
        , "fi\n"
        , "\n"
        , "rm -rf rubble-web/ui/public/wasm rubble-web/embed\n"
        , "mkdir -p rubble-web/ui/public/wasm\n"
        , "\n"
        , "launcher_suffix=\"\"\n"
        , "if [[ -n \"${MSYS2_ROOT:-}\" ]]; then\n"
        , "  launcher_suffix=\".exe\"\n"
        , "fi\n"
        , "isolated_cargo=\"target/rubble-isolated-bin/cargo${launcher_suffix}\"\n"
        , "if [[ ! -x \"$project_dir/$isolated_cargo\" ]]; then\n"
        , "  echo \"isolated Cargo launcher is missing: $project_dir/$isolated_cargo\"\n"
        , "  exit 1\n"
        , "fi\n"
        , "export CARGO=\"$isolated_cargo\"\n"
        , "export PATH=\"$project_dir/target/rubble-isolated-bin:$PATH\"\n"
        , "\n"
        , "wasm_pack_mode_args=()\n"
        , "if [[ -n \"${wasm_pack_mode:-}\" ]]; then\n"
        , "  wasm_pack_mode_args=(--mode \"$wasm_pack_mode\")\n"
        , "fi\n"
        , "\"$WASM_PACK\" build \"$project_dir\" \\\n"
        , "  \"${wasm_pack_mode_args[@]}\" \\\n"
        , "  --target web \\\n"
        , "  --out-dir rubble-web/ui/public/wasm \\\n"
        , "  --out-name rubble_core \\\n"
        , "  --no-default-features \\\n"
        , "  --features wasm\n"
        , "\n"
        , "cd rubble-web/ui\n"
        , "\"$NODE\" node_modules/typescript/bin/tsc -b\n"
        , "\"$NODE\" node_modules/vite/bin/vite.js build --outDir ../embed --emptyOutDir\n"
        , "rm -f \\\n"
        , "  ../embed/wasm/.gitignore \\\n"
        , "  ../embed/wasm/LICENSE \\\n"
        , "  ../embed/wasm/README.md \\\n"
        , "  ../embed/wasm/package.json \\\n"
        , "  ../embed/wasm/rubble_core.d.ts \\\n"
        , "  ../embed/wasm/rubble_core_bg.wasm.d.ts\n"
        , "perl -pi -e 's/[ \\t]+$//' \\\n"
        , "  ../embed/index.html \\\n"
        , "  ../embed/assets/index.css \\\n"
        , "  ../embed/assets/index.js \\\n"
        , "  ../embed/wasm/rubble_core.js\n"
        , "\"$NODE\" scripts/cache-bust-embed.mjs \\\n"
        , "  ../embed/index.html \\\n"
        , "  ../embed/assets/index.js \\\n"
        , "  ../embed/assets/index.css\n"
        , "cd ../..\n"
        , "\n"
        , "test -s rubble-web/embed/index.html\n"
        , "test -s rubble-web/embed/assets/index.css\n"
        , "test -s rubble-web/embed/assets/index.js\n"
        , "test -s rubble-web/embed/wasm/rubble_core.js\n"
        , "test -s rubble-web/embed/wasm/rubble_core_bg.wasm\n"
        , "\n"
        , "mkdir -p \"$out\"\n"
        , "cp -a rubble-web/embed/. \"$out/\""
        ]
      , "format": "text"
      }
    }
  ]
