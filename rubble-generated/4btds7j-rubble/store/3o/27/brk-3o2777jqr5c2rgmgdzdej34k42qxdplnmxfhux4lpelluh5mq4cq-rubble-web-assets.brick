      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "6fkbbg6pc4yfhgvgo5pvqnh3447niza2cjqxt27aibzytwyzdj7a-mpfr-4.1.0.tar.bz2"
          , "alias": "mpfr_src"
