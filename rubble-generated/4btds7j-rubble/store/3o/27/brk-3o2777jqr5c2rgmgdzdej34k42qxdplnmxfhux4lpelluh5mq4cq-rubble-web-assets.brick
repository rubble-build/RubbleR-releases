      { "id": "vaysgwzfbxgkqarrni4ntmw4vxkxaeuh77tz7ira6uvrj3bi7kcq-rsync"
      , "name": "rsync"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "inputs": [
          { "brick": "hl6djaj44qkp6rily6m7uf6lsksicuvyiukbsphwqzo7zhddpzna-zstd-libs-1.5.6-r2.apk"
          , "alias": "zstd_libs_apk"
          , "transitive": "false"
          }
        , { "brick": "4wqtammobxoyixq6mok6psj2mp6d3pjlgjjgooaxh3pqxhhwxf2a-zlib-1.3.2-r0.apk"
          , "alias": "zlib_apk"
          , "transitive": "false"
          }
        , { "brick": "xra3vn2xpcp2to2fr45jn67bz4ghvnz5jvjneqn4cjcaf46dnrma-rsync-3.4.3-r0.apk"
          , "alias": "rsync_apk"
          , "transitive": "false"
          }
        , { "brick": "ljxgs3o5vy4ctwwtmrawnn6r5gbfvqcor7loyeecc2v54wdsjp4q-popt-1.19-r4.apk"
          , "alias": "popt_apk"
          , "transitive": "false"
          }
        , { "brick": "4z45nx65xw3y3yxdn5rw2qf5jwclaclnqqfhofeig6xotqxb7ajq-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "dt7ie35vhkltqfhqewzqle62mip6tx7322pxe3nw5bza5m6sglcq-lz4-libs-1.10.0-r0.apk"
          , "alias": "lz4_libs_apk"
          , "transitive": "false"
          }
        , { "brick": "wtmzokrljm6qieuc3vreps4ox23fng4vvkukskjrenmcmxegxh2q-libxxhash-0.8.2-r2.apk"
          , "alias": "libxxhash_apk"
          , "transitive": "false"
          }
        , { "brick": "zkiff2cic77r6rxw3quhxg6gu4rznq4omwpz5tui7zwbvlqj6mbq-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "pbjeeclqm4u6qpcwajhwup422gxqlsxugtxchb3ehilwprktypna-acl-libs-2.3.2-r1.apk"
          , "alias": "acl_libs_apk"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "echo \"Extracting rsync package...\"\n"
              , "mkdir -p rsync-extract libs-extract\n"
              , "tar -xzf \"$rsync_apk\" -C rsync-extract\n"
              , "for apk in \"$acl_libs_apk\" \"$lz4_libs_apk\" \"$popt_apk\" \"$libxxhash_apk\" \"$zlib_apk\" \"$zstd_libs_apk\"; do\n"
              , "  tar -xzf \"$apk\" -C libs-extract\n"
              , "done\n"
              , "\n"
              , "mkdir -p \"$out/bin\" \"$out/lib\"\n"
              , "find libs-extract -name \"*.so*\" -type f -exec cp -a {} \"$out/lib/\" \\;\n"
              , "find libs-extract -name \"*.so*\" -type l -exec cp -a {} \"$out/lib/\" \\;\n"
              , "\n"
              , "cp rsync-extract/usr/bin/rsync \"$out/bin/rsync\"\n"
              , "chmod +x \"$out/bin/rsync\"\n"
              , "\"$patchelf\" --set-interpreter \"$ld_musl\" --set-rpath \"$out/lib\" \"$out/bin/rsync\"\n"
              , "\n"
              , "echo \"\"\n"
              , "echo \"=== Verifying rsync installation ===\"\n"
              , "rsync_version=\"$(\"$out/bin/rsync\" --version)\"\n"
              , "printf '%s\\n' \"${rsync_version%%$'\\n'*}\""
              ]
            , "format": "text"
            }
          }
        ]
      }
