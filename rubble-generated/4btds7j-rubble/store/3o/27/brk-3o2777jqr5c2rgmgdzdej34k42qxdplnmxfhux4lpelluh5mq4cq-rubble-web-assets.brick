          , "transitive": "false"
          }
        , { "brick": "ojuca6brtedwpgh2rphrf3th52tfvbpqkqqnddtxowcmsxy3u2mq-python3-3.12.14-r0.apk"
          , "alias": "python3_apk"
          , "transitive": "false"
