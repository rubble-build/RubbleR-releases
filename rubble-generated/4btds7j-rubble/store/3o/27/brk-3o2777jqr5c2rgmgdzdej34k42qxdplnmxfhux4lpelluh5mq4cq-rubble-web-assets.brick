        , "checksum": "sha256:8455dae44950d9dd8688e85d9dffdc6d01802962ab972ba3c4d30e7493f67feb"
        }
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
