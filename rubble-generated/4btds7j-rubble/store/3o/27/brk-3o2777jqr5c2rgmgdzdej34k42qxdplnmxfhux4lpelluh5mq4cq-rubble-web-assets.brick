          , "transitive": "false"
          }
        , { "brick": "apwv2emy6cpgfjhifot4on26vbuiigqxu2nabpoyf42xknawsowa-gmp-6.2.1.tar.bz2"
          , "alias": "gmp_src"
          , "transitive": "false"
          }
        , { "brick": "lkvwp2vgtnqksd4pvrkpdnnyohghv2t4eufxpfrczxeijtowkjba-gcc-14.2.0.tar.xz"
          , "alias": "gcc_src"
          , "transitive": "false"
          }
        , { "brick": "ic3mcp6r2byudz4wwzrzs7ld3te3lmfdcopyerhhnjybz6b4gz5q-gcc"
          , "alias": "musl_gcc"
          , "transitive": "false"
          }
        , { "brick": "bcijixntbfjfueijbqlib6knpsyc36k6jzcnlakihhimsazq2b7a-python3"
          , "alias": "python3"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "export PATH=\"$out/bin:$PATH\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "odzciqpr5fl5qqpdqnohs7qpqqwvahqodbydsv7er2ztrfnfhbuq-bootstrap-env"
          , "alias": "bootstrap_env"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$out/setup-env.sh\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "mi65hk5fk6kh6hh7rtv3dp2aff6z3zadlz3kqt6pc5thxhfas4xa-linux-headers"
          , "alias": "linux_headers"
          , "transitive": "false"
          }
        , { "brick": "fynes4jr5ntfmo2jjyaquumpfr4ucq35bbc5nmcge6o7bcgldoiq-binutils-cross"
          , "alias": "binutils_cross"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "BUILD_JOBS all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "gcc_version"
          , "value": "14.2.0"
          }
        , { "name": "target_triple"
          , "value": "x86_64-linux-gnu"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "jobs=\"${BUILD_JOBS:-$(nproc)}\"\n"
              , "\n"
              , "echo \"=== Extracting GCC ${gcc_version} ===\"\n"
              , "tar xf \"$gcc_src\"\n"
              , "cd \"gcc-${gcc_version}\"\n"
              , "\n"
              , "echo \"=== Extracting GCC prerequisites ===\"\n"
              , "for prereq in \"$gmp_src\" \"$mpfr_src\" \"$mpc_src\" \"$isl_src\"; do\n"
              , "  echo \"  Extracting $(basename \"$prereq\")...\"\n"
              , "  tar xf \"$prereq\"\n"
              , "done\n"
              , "ln -sf gmp-6.2.1 gmp\n"
              , "ln -sf mpfr-4.1.0 mpfr\n"
              , "ln -sf mpc-1.2.1 mpc\n"
              , "ln -sf isl-0.24 isl\n"
              , "\n"
              , "echo \"=== Configuring GCC cross stage1 (target=${target_triple}) ===\"\n"
              , "mkdir build && cd build\n"
              , "\n"
              , "# Host compiler setup - embed include paths in CC/CXX to ensure all\n"
              , "# sub-builds (GMP, MPFR, MPC, ISL) use musl headers, not system glibc\n"
              , "host_triple=\"$(${musl_gcc}/bin/gcc -dumpmachine)\"\n"
              , "gcc_ver=\"$(\"${musl_gcc}/bin/gcc\" -dumpversion)\"\n"
              , "musl_inc=\"-nostdinc -isystem ${musl_gcc}/lib/gcc/${host_triple}/${gcc_ver}/include -isystem ${musl_gcc}/include\"\n"
              , "cxx_inc=\"-isystem ${musl_gcc}/include/c++/${gcc_ver} -isystem ${musl_gcc}/include/c++/${gcc_ver}/${host_triple}\"\n"
              , "host_link_flags=\"-static -no-pie\"\n"
              , "export CC=\"${musl_gcc}/bin/gcc -fno-lto ${host_link_flags} ${musl_inc}\"\n"
              , "export CXX=\"${musl_gcc}/bin/g++ -fno-lto ${host_link_flags} -nostdinc ${cxx_inc} -isystem ${musl_gcc}/lib/gcc/${host_triple}/${gcc_ver}/include -isystem ${musl_gcc}/include\"\n"
              , "export CFLAGS=\"\"\n"
              , "export CXXFLAGS=\"\"\n"
              , "export LDFLAGS=\"${host_link_flags}\"\n"
              , "build_shell=\"$bootstrap_env/bin/bash\"\n"
              , "export CONFIG_SHELL=\"$build_shell\"\n"
              , "export SHELL=\"$build_shell\"\n"
              , "export MAKEINFO=true\n"
              , "\n"
              , "mkdir -p \"$PWD/bin-wrappers\"\n"
              , "{\n"
              , "  printf '#!%s\\n' \"$build_shell\"\n"
              , "  printf '%s\\n' \\\n"
              , "    'out=' \\\n"
              , "    'while [ \"$#\" -gt 0 ]; do' \\\n"
              , "    '  case \"$1\" in' \\\n"
              , "    '    --output=*) out=\"${1#--output=}\" ;;' \\\n"
              , "    '    --output) shift; out=\"${1:-}\" ;;' \\\n"
              , "    '  esac' \\\n"
              , "    '  shift || break' \\\n"
              , "    'done' \\\n"
              , "    'if [ -n \"$out\" ]; then : > \"$out\"; fi' \\\n"
              , "    'exit 0'\n"
              , "} > \"$PWD/bin-wrappers/pod2man\"\n"
              , "\n"
              , "# Wrap AR/RANLIB to strip --plugin args (liblto_plugin.so is a wrapper\n"
              , "# script that can't be dlopen'd by ar/ranlib)\n"
              , "printf '#!%s\\nargs=\"\"\\nskip_next=false\\nfor arg in \"$@\"; do\\n  if $skip_next; then skip_next=false; continue; fi\\n  case \"$arg\" in\\n    --plugin) skip_next=true ;;\\n    --plugin=*) ;;\\n    *) args=\"$args $arg\" ;;\\n  esac\\ndone\\nexec %s/bin/ar $args\\n' \"$build_shell\" \"${musl_gcc}\" > \"$PWD/bin-wrappers/ar\"\n"
              , "printf '#!%s\\nargs=\"\"\\nskip_next=false\\nfor arg in \"$@\"; do\\n  if $skip_next; then skip_next=false; continue; fi\\n  case \"$arg\" in\\n    --plugin) skip_next=true ;;\\n    --plugin=*) ;;\\n    *) args=\"$args $arg\" ;;\\n  esac\\ndone\\nexec %s/bin/ranlib $args\\n' \"$build_shell\" \"${musl_gcc}\" > \"$PWD/bin-wrappers/ranlib\"\n"
              , "chmod +x \"$PWD/bin-wrappers/ar\" \"$PWD/bin-wrappers/ranlib\" \"$PWD/bin-wrappers/pod2man\"\n"
              , "export AR=\"$PWD/bin-wrappers/ar\"\n"
              , "export RANLIB=\"$PWD/bin-wrappers/ranlib\"\n"
              , "export POD2MAN=\"$PWD/bin-wrappers/pod2man\"\n"
              , "export PATH=\"$PWD/bin-wrappers:${binutils_cross}/bin:$PATH\"\n"
              , "export AS_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-as\"\n"
              , "export LD_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-ld\"\n"
              , "export AR_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-ar\"\n"
              , "export RANLIB_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-ranlib\"\n"
              , "export NM_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-nm\"\n"
              , "export OBJCOPY_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-objcopy\"\n"
              , "export OBJDUMP_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-objdump\"\n"
              , "export READELF_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-readelf\"\n"
              , "export STRIP_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-strip\"\n"
              , "\n"
              , "# Target libgcc invokes target binutils by program name during nested\n"
              , "# makes, so expose the declared cross binutils explicitly.\n"
              , "export PATH=\"${binutils_cross}/bin:${PATH}\"\n"
              , "export AS_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-as\"\n"
              , "export LD_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-ld\"\n"
              , "export AR_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-ar\"\n"
              , "export RANLIB_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-ranlib\"\n"
              , "export NM_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-nm\"\n"
              , "export STRIP_FOR_TARGET=\"${binutils_cross}/bin/${target_triple}-strip\"\n"
              , "\n"
              , "# Assemble the target sysroot inside the runtime output. GCC records the\n"
              , "# configured sysroot in the installed compiler, so it must never point at the\n"
              , "# transient build directory.\n"
              , "sysroot=\"$out/${target_triple}\"\n"
              , "mkdir -p \"$sysroot/include\" \"$sysroot/usr/include\"\n"
              , "cp -a \"${linux_headers}/include/\"* \"$sysroot/include/\"\n"
              , "cp -a \"${linux_headers}/include/\"* \"$sysroot/usr/include/\"\n"
              , "\n"
              , "\"$build_shell\" ../configure \\\n"
              , "  --prefix=\"$out\" \\\n"
              , "  --build=\"${host_triple}\" \\\n"
              , "  --host=\"${host_triple}\" \\\n"
              , "  --target=\"${target_triple}\" \\\n"
              , "  --with-sysroot=\"$sysroot\" \\\n"
              , "  --with-local-prefix=\"$out\" \\\n"
              , "  --with-newlib \\\n"
              , "  --without-headers \\\n"
              , "  --enable-languages=c \\\n"
              , "  --disable-shared \\\n"
              , "  --disable-threads \\\n"
              , "  --disable-libssp \\\n"
              , "  --disable-libgomp \\\n"
              , "  --disable-libquadmath \\\n"
              , "  --disable-libatomic \\\n"
              , "  --disable-decimal-float \\\n"
              , "  --disable-multilib \\\n"
              , "  --disable-nls \\\n"
              , "  --disable-werror \\\n"
              , "  --disable-plugins \\\n"
              , "  --disable-lto \\\n"
              , "  --with-as=\"${binutils_cross}/bin/${target_triple}-as\" \\\n"
              , "  --with-ld=\"${binutils_cross}/bin/${target_triple}-ld\"\n"
              , "\n"
              , "echo \"=== Building GCC stage1 (jobs=$jobs) ===\"\n"
              , "make LDFLAGS=\"${LDFLAGS}\" -j \"$jobs\" SHELL=\"$build_shell\" MAKEINFO=true POD2MAN=\"$POD2MAN\" all-gcc all-target-libgcc\n"
              , "\n"
              , "echo \"=== Installing ===\"\n"
              , "make LDFLAGS=\"${LDFLAGS}\" SHELL=\"$build_shell\" MAKEINFO=true POD2MAN=\"$POD2MAN\" install-gcc install-target-libgcc\n"
              , "\n"
              , "echo \"=== Removing build-only documentation and install tools ===\"\n"
              , "rm -rf \\\n"
              , "  \"$out/share/man\" \\\n"
              , "  \"$out/share/info\" \\\n"
              , "  \"$out/lib/gcc/${target_triple}/${gcc_version}/install-tools\" \\\n"
              , "  \"$out/libexec/gcc/${target_triple}/${gcc_version}/install-tools\"\n"
              , "\n"
              , "echo \"=== Stripping debug sections ===\"\n"
              , "readelf_tool=\"${binutils_cross}/bin/${target_triple}-readelf\"\n"
              , "strip_tool=\"${binutils_cross}/bin/${target_triple}-strip\"\n"
              , "while IFS= read -r -d '' file; do\n"
              , "  if \"$readelf_tool\" -h \"$file\" >/dev/null 2>&1; then\n"
              , "    \"$strip_tool\" --strip-debug \"$file\"\n"
              , "  else\n"
              , "    case \"$file\" in\n"
              , "      *.a) \"$strip_tool\" --strip-debug \"$file\" 2>/dev/null || true ;;\n"
              , "    esac\n"
              , "  fi\n"
              , "done < <(find \"$out\" -type f -print0)\n"
              , "\n"
              , "echo \"=== GCC cross stage1 build complete ===\"\n"
              , "\"$out/bin/${target_triple}-gcc\" --version | head -1\n"
              , "ls \"$out/bin/\" | head -20"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "ph5ozx7mzihkfjgnnoh5mmknb24pn3wwrv2skspenco55ede67ua-glibc-headers":
      { "id": "ph5ozx7mzihkfjgnnoh5mmknb24pn3wwrv2skspenco55ede67ua-glibc-headers"
      , "name": "glibc-headers"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "r2zdfg556hdsebpb4sscmxl7y53r4bjcp3v4ux3ky6y2nzy6bs3a-glibc-2.40.tar.xz"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "ic3mcp6r2byudz4wwzrzs7ld3te3lmfdcopyerhhnjybz6b4gz5q-gcc"
          , "alias": "musl_gcc"
          , "transitive": "false"
          }
        , { "brick": "bcijixntbfjfueijbqlib6knpsyc36k6jzcnlakihhimsazq2b7a-python3"
          , "alias": "python3"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "export PATH=\"$out/bin:$PATH\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "odzciqpr5fl5qqpdqnohs7qpqqwvahqodbydsv7er2ztrfnfhbuq-bootstrap-env"
          , "alias": "bootstrap_env"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$out/setup-env.sh\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "mi65hk5fk6kh6hh7rtv3dp2aff6z3zadlz3kqt6pc5thxhfas4xa-linux-headers"
          , "alias": "linux_headers"
          , "transitive": "false"
          }
        , { "brick": "fynes4jr5ntfmo2jjyaquumpfr4ucq35bbc5nmcge6o7bcgldoiq-binutils-cross"
          , "alias": "binutils_cross"
          , "transitive": "false"
          }
        , { "brick": "d5tvykm2as237vj33qbianfaytq7w5nxflnubxsq7wlvmtykqvba-gcc-cross-stage1"
          , "alias": "gcc_stage1"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "BUILD_JOBS all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "glibc_version"
          , "value": "2.40"
          }
        , { "name": "kernel_arch"
          , "value": "x86"
          }
        , { "name": "target_triple"
          , "value": "x86_64-linux-gnu"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "jobs=\"${BUILD_JOBS:-$(nproc)}\"\n"
              , "\n"
              , "echo \"=== Extracting glibc ${glibc_version} ===\"\n"
              , "tar xf \"$src\"\n"
              , "cd \"glibc-${glibc_version}\"\n"
              , "\n"
              , "echo \"=== Configuring glibc headers (target=${target_triple}) ===\"\n"
              , "mkdir build && cd build\n"
              , "\n"
              , "# Use gcc-cross-stage1 as the target compiler\n"
              , "export CC=\"${gcc_stage1}/bin/${target_triple}-gcc\"\n"
              , "export CXX=\"${gcc_stage1}/bin/${target_triple}-gcc\"\n"
              , "export AR=\"${binutils_cross}/bin/${target_triple}-ar\"\n"
              , "export RANLIB=\"${binutils_cross}/bin/${target_triple}-ranlib\"\n"
              , "export LD=\"${binutils_cross}/bin/${target_triple}-ld\"\n"
              , "export PYTHON=\"${python3}/bin/python3\"\n"
              , "build_shell=\"$bootstrap_env/bin/bash\"\n"
              , "export CONFIG_SHELL=\"$build_shell\"\n"
              , "export SHELL=\"$build_shell\"\n"
              , "tool_shims=\"$PWD/rubble-build-tool-shims\"\n"
              , "mkdir -p \"$tool_shims\"\n"
              , "{\n"
              , "  printf '#!%s\\n' \"$build_shell\"\n"
              , "  printf '%s\\n' 'exit 0'\n"
              , "} > \"$tool_shims/install-info\"\n"
              , "chmod +x \"$tool_shims/install-info\"\n"
              , "export PATH=\"$tool_shims:$PATH\"\n"
              , "export MAKEINFO=:\n"
              , "export MSGFMT=:\n"
              , "export INSTALL_INFO=\"$tool_shims/install-info\"\n"
              , "\n"
              , "# Assemble sysroot with kernel headers\n"
              , "sysroot=\"$PWD/sysroot\"\n"
              , "mkdir -p \"$sysroot/usr/include\"\n"
              , "cp -a \"${linux_headers}/include/\"* \"$sysroot/usr/include/\"\n"
              , "\n"
              , "\"$build_shell\" ../configure \\\n"
              , "  --prefix=\"$out\" \\\n"
              , "  --build=\"$(${musl_gcc}/bin/gcc -dumpmachine)\" \\\n"
              , "  --host=\"${target_triple}\" \\\n"
              , "  --with-headers=\"${linux_headers}/include\" \\\n"
              , "  --disable-multilib \\\n"
              , "  --disable-werror \\\n"
              , "  libc_cv_forced_unwind=yes \\\n"
              , "  libc_cv_c_cleanup=yes\n"
              , "\n"
              , "echo \"=== Installing glibc headers ===\"\n"
              , "make install-headers DESTDIR=\"\" install_root=\"\" \\\n"
              , "  SHELL=\"$build_shell\" MAKEINFO=\"$MAKEINFO\" MSGFMT=\"$MSGFMT\" INSTALL_INFO=\"$INSTALL_INFO\"\n"
              , "\n"
              , "echo \"=== Building crt files ===\"\n"
              , "make -j \"$jobs\" csu/subdir_lib \\\n"
              , "  SHELL=\"$build_shell\" MAKEINFO=\"$MAKEINFO\" MSGFMT=\"$MSGFMT\" INSTALL_INFO=\"$INSTALL_INFO\"\n"
              , "\n"
              , "echo \"=== Installing crt files ===\"\n"
              , "install -d \"$out/lib\"\n"
              , "install csu/crt1.o csu/crti.o csu/crtn.o \"$out/lib/\"\n"
              , "\n"
              , "# Create stub libc.so for gcc to link against\n"
              , "\"${gcc_stage1}/bin/${target_triple}-gcc\" -nostdlib -nostartfiles -shared \\\n"
              , "  -x c /dev/null -o \"$out/lib/libc.so\"\n"
              , "\n"
              , "# Create stubs_h for glibc build system\n"
              , "touch \"$out/include/gnu/stubs.h\"\n"
              , "\n"
              , "echo \"=== Stripping debug sections ===\"\n"
              , "readelf_tool=\"${binutils_cross}/bin/${target_triple}-readelf\"\n"
              , "strip_tool=\"${binutils_cross}/bin/${target_triple}-strip\"\n"
              , "while IFS= read -r -d '' file; do\n"
              , "  if \"$readelf_tool\" -h \"$file\" >/dev/null 2>&1; then\n"
              , "    \"$strip_tool\" --strip-debug \"$file\"\n"
              , "  else\n"
              , "    case \"$file\" in\n"
              , "      *.a) \"$strip_tool\" --strip-debug \"$file\" 2>/dev/null || true ;;\n"
              , "    esac\n"
              , "  fi\n"
              , "done < <(find \"$out\" -type f -print0)\n"
              , "\n"
              , "echo \"=== glibc headers install complete ===\"\n"
              , "ls \"$out/include/\" | head -20\n"
              , "ls \"$out/lib/\" | head -10"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "ieiccbfk23gluoykfg3abnrgfvk3smgqjjizvy3txwjj6iyxsg2q-gcc-cross-stage2":
