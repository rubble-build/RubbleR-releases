{ "id": "2rsatquz5uzw7dilqg64g74l2vtvruaziu5jjhpcqjhmi4rw2cbq-bzip2"
, "name": "bzip2"
, "platform": "x86_64-linux"
, "rubble_home": "/var/lib/rubble"
, "inputs": [
    { "brick": "hdqxqr4vfc2rgc3rj5ywrpaykxqly77eix55tldf7wd7nqimpqfa-patchelf"
    , "alias": "patchelf"
    , "transitive": "false"
    }
  , { "brick": "z3xhjdr5it75lq5iwals4toaklhutksbdphbucgwhtgqhxz32k6q-ld-musl.so"
    , "alias": "ld_musl"
    , "transitive": "true"
    }
  , { "brick": "yenozywg5j7rikyirqweffk37of6kzkge34hwfauoczphjloixoq-bzip2-1.0.8-r6.apk"
    , "alias": "src"
    , "transitive": "false"
    }
  , { "brick": "5egteflbtlhbpl5lxsf77tssx5r2xozci62fdy42ah5ennedwyeq-musl-install-tools"
    , "alias": "musl_tools"
    , "transitive": "false"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  , { "name": "bin" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "tar -xzf \"$src\" 2>/dev/null || true\n"
        , "\"${musl_tools[install]}\" usr/bin/bzip2 \"$out\" \"$patchelf\" \"$ld_musl\"\n"
        , "\"${musl_tools[link_commands]}\" \"$out\" \"$bin\" bzip2 bunzip2 bzcat\n"
        , "\n"
        , "expected='rubble bzip2 probe'\n"
        , "printf '%s' \"$expected\" | \"$out\" -c > \"$TMP/bzip2-probe.bz2\"\n"
        , "actual=\"$(\"$bin/bunzip2\" -c \"$TMP/bzip2-probe.bz2\")\"\n"
        , "test \"$actual\" = \"$expected\"\n"
        , "rm -f \"$TMP/bzip2-probe.bz2\""
        ]
      , "format": "text"
      }
    }
  ]
, "inventory": {
