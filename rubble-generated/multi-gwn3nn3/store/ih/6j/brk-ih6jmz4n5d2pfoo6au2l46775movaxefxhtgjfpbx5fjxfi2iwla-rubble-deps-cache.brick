              "value": [
                "mkdir \"$dir\"\n"
              , "echo \"${brick[src::commit]}\" > \"${dir}/.rubble-deferred\"\n"
              , "\n"
              , "mkdir \"$archive\"\n"
              , "echo \"${brick[src::commit]}\" > \"${archive}/.rubble-deferred\"\n"
              , "\n"
              , "source \"${rubble_canonical_script[script]}\"\n"
              , "\n"
              , "printf -v __rubble_source_repo '%q' \"${brick[src::remote]}\"\n"
              , "printf -v __rubble_source_commit '%q' \"${brick[src::commit]}\"\n"
              , "printf -v __rubble_source_paths '%q' \"${brick[src::paths]}\"\n"
              , "(\n"
              , "rubble_canonical_script << __EOF_SCRIPT_207__\n"
              , "repo=${__rubble_source_repo}\n"
              , "commit=${__rubble_source_commit}\n"
              , "paths=${__rubble_source_paths}\n"
              , "gitRepoCredential=\"\"\n"
              , "src_archive=\"$archive\"\n"
              , "inner_path=\"\"\n"
              , "deferred_marker=\".rubble-deferred\"\n"
              , "\n"
              , "if [[ -z \"\\${repo:-}\" || -z \"\\${commit:-}\" ]]; then\n"
              , "    echo \"Error: Missing repo or commit information\" >&2\n"
              , "    exit 1\n"
              , "fi\n"
              , "\n"
              , "source \"${rubble_src_checkout}\" \"\\${1:-\\${dir}}\" \"\\${@:2}\"\n"
