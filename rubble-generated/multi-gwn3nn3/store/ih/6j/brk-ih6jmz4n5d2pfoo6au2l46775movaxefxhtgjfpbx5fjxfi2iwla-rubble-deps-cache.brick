{ "id": "ih6jmz4n5d2pfoo6au2l46775movaxefxhtgjfpbx5fjxfi2iwla-rubble-deps-cache"
, "name": "rubble-deps-cache"
, "platform": "aarch64-linux"
, "inputs": [
    { "brick": "otvk5dfabfdoiouphr55y37uwmcmgee4eed5jlejzqpuihkie3za-RubbleR.git.partial"
    , "alias": "src"
    , "transitive": "false"
    , "hooks": {
        "post-checkout": [
          { "install-to": [
              { "output": "dir"
              , "dir": "./" }
            ]
          }
        , { "shell": {
              "value": [
                "rubble-exec rm -f -- \"${TMP}/rubble-source.env\"\n"
              , "( source \"${script}\" \"${dir}\" --env-file \"${TMP}/rubble-source.env\" )\n"
              , "__rubble_import_source_environment \"${TMP}/rubble-source.env\""
              ]
            , "format": "text"
            }
          }
        ]
      }
    }
  , { "brick": "rmhssm54s5johitiyrmu5twpwyczednnx6nbe7qszlyknatkqxsq-rust-toolchain"
    , "transitive": "false"
    , "hooks": {
        "pre-build": [
          { "shell": {
              "value": [
                "source \"$env\""
              ]
            , "format": "text"
            }
          }
        ]
      }
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  ]
