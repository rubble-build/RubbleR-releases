          }
        , { "brick": "2nguimja3ijn67ppduw4iymx3l63awsvfm3aeolh4huxhrtlelzq-xz"
          , "alias": "xz"
          , "transitive": "true"
          }
        , { "brick": "47zokkngsfutphq4c75jyibgp4htgwdbxcrgh5ufuwkgilcj7gyq-unzip"
          , "alias": "unzip"
          , "transitive": "true"
          }
        , { "brick": "62pd2iqc5djuyptrefmfnoyqs2h7sixqjxbe4j7def3if3gwm2aa-m4"
          , "alias": "m4"
          , "transitive": "true"
          }
        , { "brick": "6v64oxmhrixfku2kgw6taolvksk3cur6mm3anu6lhbjirbgfggxa-gzip"
          , "alias": "gzip"
          , "transitive": "true"
          }
        , { "brick": "nfvskclt3cgimqtrw2eazstdf454q3p2r7hoevkjczb56ozzmtpq-gpatch"
          , "alias": "gpatch"
          , "transitive": "true"
          }
        , { "brick": "mg7bty4vjnnybn7lxd3p5q2g2hgzp6szy5r5j3r3u5n6irldveoa-gnu-sed"
          , "alias": "gnu_sed"
          , "transitive": "true"
          }
        , { "brick": "sz7scme2he4n477gpccq6kdizt6dbkntlfh3ddo67dypl7ksxtda-gnu-make"
          , "alias": "gnu_make"
          , "transitive": "true"
          }
        , { "brick": "d4oam742ndjdswucg5txv67tvctcjxom6yt2e26fii37al2wmzra-gawk"
          , "alias": "gawk"
          , "transitive": "true"
          }
        , { "brick": "xusxkpuh7w545vzs7pihbqmmndx52nymd5tqatmphbfm3l4zkziq-findutils"
          , "alias": "findutils"
          , "transitive": "true"
          }
        , { "brick": "ebznmwxxmhegjnbtc25szhhelhtux4cplgjscwjux4zxx7eekxea-diffutils"
          , "alias": "diffutils"
          , "transitive": "true"
          }
        , { "brick": "35lunc52cnmxhsxgrbztpvoejb6h2oewsxbihfsqsdo2bifm7kmq-perl"
          , "alias": "perl"
          , "transitive": "true"
          }
        , { "brick": "l4jt55j5qqsfscqsfwk2ckk7iyj2hrv2kjpqf66rjw3ilg2psx7q-grep"
          , "alias": "grep"
          , "transitive": "true"
          }
        , { "brick": "re6wlad2vnmfnf4nrcravillaiaut6pzebyaadwgkkgh5g7tuvka-git"
          , "alias": "git"
          , "transitive": "true"
          }
        , { "brick": "evcmryzqpefcunpqoyutqjscwvwtbvogsntb5n47lbpuaohw6m6q-gcc"
          , "alias": "gcc"
          , "transitive": "true"
          }
        , { "brick": "npt4pmjgvneqxtb3xvqge7ptntgjmjfz6vkendkmbfzspxpabvia-bzip2"
          , "alias": "bzip2"
          , "transitive": "true"
          }
        , { "brick": "i7omhhjzayh7bxlnhyvcs4274b2uaunsyh76pixjh7ixvnpcrp2a-bison"
          , "alias": "bison"
          , "transitive": "true"
          }
        , { "brick": "u6gpy6gfub4xlqrvjvqq4dtfafufxauxuste7lkmoc6vvpkuzp2q-gnu-tar"
          , "alias": "gnu_tar"
          , "transitive": "true"
          }
        , { "brick": "r2agl7x5h3nujgwasxf2d2vcopngkncwb6ronredz5n7o6va5s3a-coreutils"
          , "alias": "coreutils"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "bin" }
        , { "name": "env" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p \"$bin\"\n"
              , "\n"
              , "# === Bash ===\n"
              , "\"$write_wrappers\" aliases \"$bin\" \"${bash[bin]}/bash\" \"${bash[bin]}/bash\" bash sh\n"
              , "\n"
              , "# === Coreutils ===\n"
              , "# Create wrappers for all coreutils commands\n"
              , "\"$write_wrappers\" coreutils \"$bin\" \"${bash[bin]}/bash\" \"${coreutils[bin]}\"\n"
              , "\n"
              , "# === curl ===\n"
              , "# curl needs SSL_CERT_FILE to find CA certificates\n"
              , "curl_env=\"export SSL_CERT_FILE=\\\"$ca_certs\\\"\"\n"
              , "\"$write_wrappers\" single \"$bin/curl\" \"${bash[bin]}/bash\" \"$curl\" \"$curl_env\"\n"
              , "\n"
              , "# === Git ===\n"
              , "\"$write_wrappers\" single \"$bin/git\" \"${bash[bin]}/bash\" \"${git[bin]}/git\"\n"
              , "\n"
              , "# === GNU tar ===\n"
              , "\"$write_wrappers\" aliases \"$bin\" \"${bash[bin]}/bash\" \"$gnu_tar\" tar gtar\n"
              , "\n"
              , "# === gzip ===\n"
              , "\"$write_wrappers\" single \"$bin/gzip\" \"${bash[bin]}/bash\" \"${gzip[bin]}/gzip\"\n"
              , "\"$write_wrappers\" single \"$bin/gunzip\" \"${bash[bin]}/bash\" \"${gzip[bin]}/gunzip\"\n"
              , "\"$write_wrappers\" single \"$bin/zcat\" \"${bash[bin]}/bash\" \"${gzip[bin]}/zcat\"\n"
              , "\n"
              , "# === xz ===\n"
              , "\"$write_wrappers\" single \"$bin/xz\" \"${bash[bin]}/bash\" \"$xz\"\n"
              , "for cmd in xzcat unxz lzma lzmadec lzcat; do\n"
              , "  \"$write_wrappers\" single \"$bin/$cmd\" \"${bash[bin]}/bash\" \"${xz[bin]}/$cmd\"\n"
              , "done\n"
              , "\n"
              , "# === zstd ===\n"
              , "\"$write_wrappers\" single \"$bin/zstd\" \"${bash[bin]}/bash\" \"$zstd\"\n"
              , "for cmd in zstdcat unzstd zstdmt; do\n"
              , "  \"$write_wrappers\" single \"$bin/$cmd\" \"${bash[bin]}/bash\" \"${zstd[bin]}/$cmd\"\n"
              , "done\n"
              , "\n"
              , "# === GNU sed ===\n"
              , "\"$write_wrappers\" single \"$bin/sed\" \"${bash[bin]}/bash\" \"$gnu_sed\"\n"
              , "\n"
              , "# === grep ===\n"
              , "\"$write_wrappers\" single \"$bin/grep\" \"${bash[bin]}/bash\" \"${grep[bin]}/grep\"\n"
              , "\"$write_wrappers\" single \"$bin/egrep\" \"${bash[bin]}/bash\" \"${grep[bin]}/egrep\"\n"
              , "\"$write_wrappers\" single \"$bin/fgrep\" \"${bash[bin]}/bash\" \"${grep[bin]}/fgrep\"\n"
              , "\n"
              , "# === GNU make ===\n"
              , "\"$write_wrappers\" aliases \"$bin\" \"${bash[bin]}/bash\" \"$gnu_make\" make gmake\n"
              , "\n"
              , "# === gpatch ===\n"
              , "\"$write_wrappers\" aliases \"$bin\" \"${bash[bin]}/bash\" \"$gpatch\" patch gpatch\n"
              , "\n"
              , "# === findutils ===\n"
              , "for cmd in find xargs; do\n"
              , "  if [ -f \"${findutils[bin]}/$cmd\" ]; then\n"
              , "    \"$write_wrappers\" single \"$bin/$cmd\" \"${bash[bin]}/bash\" \"${findutils[bin]}/$cmd\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# === bzip2 ===\n"
              , "\"$write_wrappers\" single \"$bin/bzip2\" \"${bash[bin]}/bash\" \"${bzip2[bin]}/bzip2\"\n"
              , "\"$write_wrappers\" single \"$bin/bunzip2\" \"${bash[bin]}/bash\" \"${bzip2[bin]}/bunzip2\"\n"
              , "\"$write_wrappers\" single \"$bin/bzcat\" \"${bash[bin]}/bash\" \"${bzip2[bin]}/bzcat\"\n"
              , "\n"
              , "# === unzip ===\n"
              , "\"$write_wrappers\" single \"$bin/unzip\" \"${bash[bin]}/bash\" \"$unzip\"\n"
              , "\n"
              , "# === perl ===\n"
              , "perl_env=\"source \\\"${perl[env]}\\\"\"\n"
              , "\"$write_wrappers\" single \"$bin/perl\" \"${bash[bin]}/bash\" \"${perl[bin]}/perl\" \"$perl_env\"\n"
              , "\n"
              , "# === gawk ===\n"
              , "\"$write_wrappers\" aliases \"$bin\" \"${bash[bin]}/bash\" \"$gawk\" awk gawk\n"
              , "\n"
              , "# === diffutils ===\n"
              , "for cmd in diff cmp diff3 sdiff; do\n"
              , "  if [ -f \"${diffutils[bin]}/$cmd\" ]; then\n"
              , "    \"$write_wrappers\" single \"$bin/$cmd\" \"${bash[bin]}/bash\" \"${diffutils[bin]}/$cmd\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# === m4 ===\n"
              , "\"$write_wrappers\" single \"$bin/m4\" \"${bash[bin]}/bash\" \"$m4\"\n"
              , "\n"
              , "# === bison ===\n"
              , "bison_env=\"export BISON_PKGDATADIR=\\\"${bison[share]}/bison\\\"\n"
              , "export M4=\\\"$m4\\\"\"\n"
              , "\"$write_wrappers\" single \"$bin/bison\" \"${bash[bin]}/bash\" \"${bison[bin]}/bison\" \"$bison_env\"\n"
              , "\"$write_wrappers\" single \"$bin/yacc\" \"${bash[bin]}/bash\" \"${bison[bin]}/yacc\" \"$bison_env\"\n"
              , "\n"
              , "# === GCC toolchain ===\n"
              , "gcc_env=\"export LD_LIBRARY_PATH=\\\"${gcc[lib]}\\${LD_LIBRARY_PATH:+:}\\${LD_LIBRARY_PATH:-}\\\"\"\n"
              , "for cmd in gcc g++ cc cpp c89 c99; do\n"
              , "  if [ -f \"${gcc[bin]}/$cmd\" ]; then\n"
              , "    \"$write_wrappers\" single \"$bin/$cmd\" \"${bash[bin]}/bash\" \"${gcc[bin]}/$cmd\" \"$gcc_env\"\n"
              , "  fi\n"
              , "done\n"
              , "for cmd in as ld ar nm ranlib strip objdump objcopy readelf strings size; do\n"
              , "  if [ -f \"${gcc[bin]}/$cmd\" ]; then\n"
              , "    \"$write_wrappers\" single \"$bin/$cmd\" \"${bash[bin]}/bash\" \"${gcc[bin]}/$cmd\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# === Environment setup script ===\n"
              , "{\n"
              , "  echo \"# Bootstrap environment setup script for Linux\"\n"
              , "  echo \"# Source this file to set up environment variables for builds\"\n"
              , "  echo \"export PATH=\\\"$bin\\${PATH:+:}\\${PATH:-}\\\"\"\n"
              , "  echo \"export SSL_CERT_FILE=\\\"$ca_certs\\\"\"\n"
              , "  echo \"export CC=\\\"${gcc[bin]}/gcc\\\"\"\n"
              , "  echo \"export CXX=\\\"${gcc[bin]}/g++\\\"\"\n"
              , "  echo \"export AR=\\\"${gcc[bin]}/ar\\\"\"\n"
              , "  echo \"export RANLIB=\\\"${gcc[bin]}/ranlib\\\"\"\n"
              , "  echo \"source \\\"${perl[env]}\\\"\"\n"
              , "} > \"$env\"\n"
              , "\n"
              , "printf %s \"rubble wrapper probe\" | \"$bin/gzip\" -c > \"$TMP/wrapper-probe.gz\"\n"
              , "actual=\"$(\"$bin/gunzip\" -c \"$TMP/wrapper-probe.gz\")\"\n"
              , "test \"$actual\" = \"rubble wrapper probe\"\n"
              , "rm -f \"$TMP/wrapper-probe.gz\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "otvk5dfabfdoiouphr55y37uwmcmgee4eed5jlejzqpuihkie3za-RubbleR.git.partial":
      { "id": "otvk5dfabfdoiouphr55y37uwmcmgee4eed5jlejzqpuihkie3za-RubbleR.git.partial"
      , "name": "RubbleR.git.partial"
      , "src": {
          "repo": "https://github.com/chaifeng/RubbleR.git"
        , "commit": "b6036bca920a218c1a5692c55a709b7b829501a8"
        , "paths": [
            "./Cargo.lock"
          , "./Cargo.toml"
          , "./rubble_derive/Cargo.toml"
          , "./rust-toolchain.toml"
          ]
        }
      , "inputs": [
          { "brick": "6vx2ce7jcj6wfra4xg2ykz6htsdkuvhh7uxbyr4gzlwvf2mlriua-rubble-src-checkout"
          , "alias": "rubble_src_checkout"
          , "transitive": "true"
          }
        , { "brick": "4x2uexqjoqs5unyb4fxpdus3ctebmhvqnuruhalsl5rdwt3k6naa-rubble-canonical-script"
          , "alias": "rubble_canonical_script"
