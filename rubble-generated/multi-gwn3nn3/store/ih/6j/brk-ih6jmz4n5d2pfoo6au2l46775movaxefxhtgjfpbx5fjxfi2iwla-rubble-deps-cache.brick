  , "aqc3c2ahmtsuu36l7kwk4q27mc7dnxuylxzqusvu3fp7rcurg5kq-rust-std-1.94.0":
      { "id": "aqc3c2ahmtsuu36l7kwk4q27mc7dnxuylxzqusvu3fp7rcurg5kq-rust-std-1.94.0"
      , "name": "rust-std-1.94.0"
      , "platform": "aarch64-linux"
      , "inputs": [
          { "brick": "ay6kezqef2anhdm53akx7elc7ge7cmrhesutg3b6lzj2jolgnv2a-rust-std-1.94.0-aarch64-unknown-linux-gnu.tar.xz"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "cmdaozrcvaymmdfw3jodg7rrc4qwmaqyx6q3jj6u6nsie32hvdxq-publish-output-directory"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$script\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "lib" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "target_triple=\"${src[name]#*${name}-}\"\n"
              , "target_triple=\"${target_triple%%.*}\"\n"
              , "tar --strip-components=1 -Jxvf \"$src\"\n"
              , "mkdir -p \"$out/lib/rustlib/${target_triple}\"\n"
              , "mv rust-std-${target_triple}/lib/rustlib/${target_triple}/lib \"$out/lib/rustlib/${target_triple}/lib\""
              ]
            , "format": "text"
            }
          }
        , { "shell": {
              "value": [
                "publish_output_directory \"$out/lib\" \"$lib\""
              ]
            , "format": "text"
            }
          }
        ]
      }
