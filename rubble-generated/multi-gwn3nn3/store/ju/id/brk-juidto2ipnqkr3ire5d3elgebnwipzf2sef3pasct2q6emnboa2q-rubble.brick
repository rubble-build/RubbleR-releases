                "node_runtime_tree=\"${nodejs_runtime[out]}\"\n"
              , "python_bin=\"${python3[bin]}/python3\"\n"
              , "test -x \"$python_bin\"\n"
              , "mkdir -p \"$bin\"\n"
              , "for tool in node npm npx corepack; do\n"
              , "  test -x \"$node_runtime_tree/bin/$tool\"\n"
              , "  ln -s \"$node_runtime_tree/bin/$tool\" \"$bin/$tool\"\n"
              , "done\n"
              , "\n"
              , "\"${nodejs_tools[write_env]}\" \"$env\" \"$bin\" \"$python_bin\" \"$node_runtime_tree\" \"${bash[bin]}/bash\"\n"
              , "\n"
              , "\"${nodejs_tools[check_npm_shell]}\" \"$bin\" \"${bash[bin]}/bash\" \"$PWD/npm-script-probe\"\n"
              , "\n"
              , "python_executable=$(\"$python_bin\" -c 'import sys; print(sys.executable)')\n"
              , "case \"$python_executable\" in\n"
              , "  \"${python3[out]}/bin/\"*) ;;\n"
              , "  *) echo \"Python resolved outside its declared output: $python_executable\" >&2; exit 1 ;;\n"
              , "esac\n"
              , "\"${nodejs_tools[check_node_gyp_python]}\" \"$bin\" \"$node_runtime_tree\" \"$python_bin\" \"$python_executable\" \"$PWD/node-gyp-probe\""
              ]
            , "format": "text"
