        , { "brick": "hlyyiiz2oa4sx7bs7su5lml5p3czch55v6i2wwhk4agbfsa353cq-cargo-1.94.0"
          , "transitive": "true"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "export PATH=\"$bin:$PATH\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
