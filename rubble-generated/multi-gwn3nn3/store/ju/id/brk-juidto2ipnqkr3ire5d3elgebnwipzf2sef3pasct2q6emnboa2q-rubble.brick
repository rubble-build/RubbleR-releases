  , "2nwjk6y7a53lxi3iwzujxebrd3wp45eqr2sdhyc2c6xolptn3p3q-gnu-tar":
      { "id": "2nwjk6y7a53lxi3iwzujxebrd3wp45eqr2sdhyc2c6xolptn3p3q-gnu-tar"
      , "name": "gnu-tar"
      , "platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "rtjdny3tqwczthrggwpu26g2ifmdo6v7aleojn6g2qmimnohtx2a-tar-1.35-r2.apk"
          , "alias": "tar_apk"
          , "transitive": "false"
          }
        , { "brick": "hdqxqr4vfc2rgc3rj5ywrpaykxqly77eix55tldf7wd7nqimpqfa-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
