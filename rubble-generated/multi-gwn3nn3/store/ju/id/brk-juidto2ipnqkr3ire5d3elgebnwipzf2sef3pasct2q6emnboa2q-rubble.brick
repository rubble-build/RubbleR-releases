  , "55xetixujjheyadinutwkiasfonswpahyw32zvpumeuyldjwdf4q-rubble-web-node-modules":
      { "id": "55xetixujjheyadinutwkiasfonswpahyw32zvpumeuyldjwdf4q-rubble-web-node-modules"
      , "name": "rubble-web-node-modules"
      , "platform": "x86_64-linux"
      , "opaque": true
      , "inputs": [
          { "brick": "inakn65bjgy574fki4lz7ar4pgwugxvdjqqnierbkk3isic5spya-RubbleR.git.partial"
