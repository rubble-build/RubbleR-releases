          , "alias": "pcre2_apk"
          , "transitive": "false"
          }
        , { "brick": "hdqxqr4vfc2rgc3rj5ywrpaykxqly77eix55tldf7wd7nqimpqfa-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "z3xhjdr5it75lq5iwals4toaklhutksbdphbucgwhtgqhxz32k6q-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "c3s55lkr27hhdooe7wnsqioryihjeapnony7fjg3czqtayimmqpa-grep-3.11-r0.apk"
          , "alias": "grep_apk"
          , "transitive": "false"
          }
        , { "brick": "5egteflbtlhbpl5lxsf77tssx5r2xozci62fdy42ah5ennedwyeq-musl-install-tools"
          , "alias": "musl_tools"
          , "transitive": "false"
          }
        , { "brick": "tfjxrh45sf2nytjwmw6picosxhkrbtwiuke6d3wujuptb35jb55a-collect-shared-libraries"
          , "alias": "collect_libraries"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        , { "name": "lib" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p grep-extract pcre2-extract\n"
              , "tar -xzf \"$grep_apk\" -C grep-extract 2>/dev/null || true\n"
              , "tar -xzf \"$pcre2_apk\" -C pcre2-extract 2>/dev/null || true\n"
              , "\n"
              , "\"$collect_libraries\" \"$lib\" recursive ignore pcre2-extract\n"
              , "\"${musl_tools[install]}\" grep-extract/bin/grep \"$out\" \"$patchelf\" \"$ld_musl\" \"$lib\"\n"
              , "\"${musl_tools[link_commands]}\" \"$out\" \"$bin\" grep egrep fgrep\n"
              , "\n"
              , "printf 'rubble42\\n' > \"$TMP/grep-text\"\n"
              , "\"$out\" -Pq '^rubble\\d+$' \"$TMP/grep-text\"\n"
              , "\"$bin/grep\" -Iq . \"$TMP/grep-text\"\n"
              , "printf 'rubble\\0binary\\n' > \"$TMP/grep-binary\"\n"
              , "status=0\n"
              , "\"$out\" -Iq . \"$TMP/grep-binary\" || status=$?\n"
              , "test \"$status\" -eq 1\n"
              , "rm -f \"$TMP/grep-text\" \"$TMP/grep-binary\""
              ]
            , "format": "text"
            }
          }
        ]
      }
