          }
        , { "brick": "w7gterx6tkmti6wv733mqag4engf5xzrpvyrazpfjb7u7cvs7hla-node-v22.22.3-linux-x64.tar.xz"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "n7qbevbly56oq5vdzjm2bzhl77wjewdp4k5gmoimlbiv62nbv7pa-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "rm2p5eqnfc3sdxlpambep3k5j5tdustz4iwuhb2pdzy5mz5qkfqq-python3"
          , "alias": "python3"
          , "transitive": "true"
          }
        , { "brick": "vfthpdhrrixmo7ewqosxes2hbagrr4iuhtp3x5ax4vrohm65ynba-bootstrap-env"
          , "alias": "bootstrap"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$env\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "cwqgfsd3etn6cjqpyys6jv6v3xtif5qovlpujqolrd6kwhnevi5a-rubble-elf-runtime"
          , "alias": "runtime"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "ld_linux_name"
          , "value": "ld-linux-x86-64.so.2"
          }
        , { "name": "node_arch"
          , "value": "x64"
          }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        , { "name": "include" }
        , { "name": "lib" }
        , { "name": "share" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p \"$out\"\n"
              , "tar -xJf \"$src\" --strip-components=1 -C \"$out\"\n"
              , "# Preserve program-header order: sorting this upstream ARM64 ELF breaks startup.\n"
              , "\"$patchelf\" --no-sort --set-interpreter \"${runtime[lib]}/$ld_linux_name\" \\\n"
              , "  --force-rpath --set-rpath \"${runtime[lib]}\" \"$out/bin/node\"\n"
              , "\n"
              , "rubble_script_shebang_register \"$out/bin/node\" node\n"
              , "rubble_script_shebang_register \"${python3[bin]}/python3\" python python3\n"
              , "rubble_script_shebang_register \"${bash[bin]}/bash\" sh bash\n"
              , "set -o pipefail\n"
              , "rubble_script_shebang_find --all --print0 \"$out\" |\n"
              , "  while IFS= read -r -d '' installed_file; do\n"
              , "    case \"$installed_file\" in\n"
              , "      *.ps1)\n"
              , "        chmod -x \"$installed_file\"\n"
              , "        continue\n"
              , "        ;;\n"
              , "    esac\n"
              , "    rubble_script_shebang_rewrite_all --strict \"$installed_file\"\n"
              , "  done\n"
              , "\n"
              , "test \"$(\"$out/bin/node\" --version)\" = v22.22.3\n"
              , "test \"$(\"$out/bin/npm\" --version)\" = 10.9.8\n"
              , "test \"$(\"$out/bin/npx\" --version)\" = 10.9.8\n"
              , "test \"$(\"$out/bin/corepack\" --version)\" = 0.34.6\n"
              , "test \"$(\"$out/bin/node\" -p process.platform)\" = linux\n"
              , "test \"$(\"$out/bin/node\" -p process.arch)\" = \"$node_arch\"\n"
              , "test -s \"$out/include/node/node.h\"\n"
              , "test -s \"$out/include/node/config.gypi\"\n"
              , "test \"$(\"$patchelf\" --print-interpreter \"$out/bin/node\")\" = \"${runtime[lib]}/$ld_linux_name\"\n"
              , "test \"$(\"$patchelf\" --print-rpath \"$out/bin/node\")\" = \"${runtime[lib]}\"\n"
              , "needed_entries=$(\"$patchelf\" --print-needed \"$out/bin/node\")\n"
              , "while IFS= read -r needed; do\n"
              , "  test -f \"${runtime[lib]}/$needed\"\n"
              , "done <<< \"$needed_entries\"\n"
              , "\n"
              , "# process.execPath must remain directly executable, including in child processes.\n"
              , "\"$out/bin/node\" - \"$out/bin/node\" <<'JS'\n"
              , "const assert = require('node:assert/strict');\n"
              , "const { realpathSync } = require('node:fs');\n"
              , "const { execFileSync } = require('node:child_process');\n"
              , "assert.equal(realpathSync(process.execPath), realpathSync(process.argv[2]));\n"
              , "assert.equal(execFileSync(process.execPath, ['--version'], { encoding: 'utf8', env: {} }).trim(), 'v22.22.3');\n"
              , "JS"
              ]
            , "format": "text"
            }
          }
        , { "shell": {
              "value": [
                "publish_output_directory \"$out/bin\" \"$bin\"\n"
              , "publish_output_directory \"$out/lib\" \"$lib\"\n"
              , "publish_output_directory \"$out/include\" \"$include\"\n"
              , "publish_output_directory \"$out/share\" \"$share\""
              ]
            , "format": "text"
            }
          }
        ]
      }
