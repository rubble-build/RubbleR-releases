          , "alias": "libffi_apk"
          , "transitive": "false"
          }
        , { "brick": "7ktnbvp6fl2plw3a55esbljq2bcop6zzubnjwusospje6hknpepq-libexpat-2.8.4-r0.apk"
          , "alias": "libexpat_apk"
          , "transitive": "false"
          }
        , { "brick": "bqqueq4hb5vdjgdpm5xn2bpxiay234jhkblmh6d2yjdmd2ncxb2q-libcrypto3-3.3.7-r2.apk"
          , "alias": "libcrypto3_apk"
          , "transitive": "false"
          }
        , { "brick": "ivlvi6gy2ft3ha4xhyhznjq4ddnj2gje7icw3knjcb73ltiwrfqq-libbz2-1.0.8-r6.apk"
          , "alias": "libbz2_apk"
          , "transitive": "false"
          }
        , { "brick": "z3xhjdr5it75lq5iwals4toaklhutksbdphbucgwhtgqhxz32k6q-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "y5wlnu6yes4le6p335gxl52cnwerqwljbxo7micl3flp45e2q63a-gdbm-1.24-r0.apk"
          , "alias": "gdbm_apk"
          , "transitive": "false"
          }
        , { "brick": "n7qbevbly56oq5vdzjm2bzhl77wjewdp4k5gmoimlbiv62nbv7pa-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "m6heumzxckkxkwnnnud4ioxacrgidq4je3fm2zn7nqjzeg45rktq-normalize-python-runtime"
          , "alias": "normalize_python"
          , "transitive": "false"
          }
        , { "brick": "tfjxrh45sf2nytjwmw6picosxhkrbtwiuke6d3wujuptb35jb55a-collect-shared-libraries"
          , "alias": "collect_libraries"
          , "transitive": "false"
          }
        , { "brick": "4rml266dvj3lfnykptfshuossktxpdkis26uwp2ebjffjlgcmmra-coreutils"
          , "alias": "coreutils"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "musl_interpreter"
          , "value": "ld-musl-x86_64.so.1"
          }
        , { "name": "python_version"
          , "value": "3.12"
          }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        , { "name": "lib" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p \"$out/bin\" \"$out/lib\" \"$out/share\" extract\n"
              , "\n"
              , "for apk in \"$python3_apk\" \"$libbz2_apk\" \"$libcrypto3_apk\" \"$libssl3_apk\" \\\n"
              , "           \"$libexpat_apk\" \"$libffi_apk\" \"$gdbm_apk\" \"$xz_libs_apk\" \\\n"
              , "           \"$mpdecimal_apk\" \"$libncursesw_apk\" \"$libpanelw_apk\" \\\n"
              , "           \"$readline_apk\" \"$sqlite_libs_apk\" \"$zlib_apk\" \"$libgcc_apk\" \\\n"
              , "           \"$libstdcpp_apk\"; do\n"
              , "  tar -xzf \"$apk\" -C extract\n"
              , "done\n"
              , "\n"
              , "ln -sf \"$ld_musl\" \"$out/lib/$musl_interpreter\"\n"
              , "ln -sf \"$musl_interpreter\" \"$out/lib/libc.${musl_interpreter#ld-}\"\n"
              , "\n"
              , "for libdir in extract/lib extract/usr/lib; do\n"
              , "  if [ -d \"$libdir\" ]; then\n"
              , "    \"$collect_libraries\" \"$out/lib\" one-level strict \"$libdir\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "cp -a \"extract/usr/lib/python${python_version}\" \"$out/lib/\"\n"
              , "cp -a extract/usr/share/* \"$out/share/\" 2>/dev/null || true\n"
              , "cp \"extract/usr/bin/python${python_version}\" \"$out/bin/python${python_version}.bin\"\n"
              , "chmod +x \"$out/bin/python${python_version}.bin\"\n"
              , "\n"
              , "\"$patchelf\" --set-interpreter \"$ld_musl\" --set-rpath \"$out/lib\" \"$out/bin/python${python_version}.bin\"\n"
              , "find \"$out/lib\" -type f \\( -name \"*.so\" -o -name \"*.so.*\" \\) | while read -r elf_file; do\n"
              , "  chmod u+w \"$elf_file\" 2>/dev/null || true\n"
              , "  if \"$patchelf\" --print-rpath \"$elf_file\" >/dev/null 2>&1; then\n"
              , "    \"$patchelf\" --set-rpath \"$out/lib\" \"$elf_file\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "create_python_wrapper() {\n"
              , "  local wrapper_path=\"$1\"\n"
              , "  {\n"
              , "    printf '#!%s\\n' \"${bash[bin]}/bash\"\n"
              , "    printf 'PYTHON_HOME=\"%s\"\\n' \"$out\"\n"
              , "    printf 'export PYTHONHOME=\"$PYTHON_HOME\"\\n'\n"
              , "    printf 'export PYTHONPATH=\"$PYTHON_HOME/lib/python%s${PYTHONPATH:+:}${PYTHONPATH:-}\"\\n' \"$python_version\"\n"
              , "    printf 'export LD_LIBRARY_PATH=\"$PYTHON_HOME/lib${LD_LIBRARY_PATH:+:}${LD_LIBRARY_PATH:-}\"\\n'\n"
              , "    printf 'exec \"$PYTHON_HOME/bin/python%s.bin\" \"$@\"\\n' \"$python_version\"\n"
              , "  } > \"$wrapper_path\"\n"
              , "  chmod +x \"$wrapper_path\"\n"
              , "}\n"
              , "\n"
              , "create_python_wrapper \"$out/bin/python\"\n"
              , "create_python_wrapper \"$out/bin/python3\"\n"
              , "create_python_wrapper \"$out/bin/python${python_version}\"\n"
              , "\n"
              , "runtime_sh=\"${bash[bin]}/sh\"\n"
              , "runtime_install=\"${coreutils[bin]}/install\"\n"
              , "runtime_mkdir=\"${coreutils[bin]}/mkdir\"\n"
              , "test -x \"$runtime_sh\"\n"
              , "test -x \"$runtime_install\"\n"
              , "test -x \"$runtime_mkdir\"\n"
              , "\"$normalize_python\" \"$out\" \"$python_version\" \"$runtime_sh\" \"$runtime_install\" \"$runtime_mkdir\"\n"
              , "\n"
              , "rubble_script_shebang_register \"$out/bin/python3\" python python3 \"python${python_version}\"\n"
              , "rubble_script_shebang_register \"${bash[bin]}/bash\" sh bash\n"
              , "rubble_script_shebang_rewrite_all --strict \"$out\"\n"
              , "\n"
              , "RUBBLE_EXPECTED_SHELL=\"$runtime_sh -e\" \\\n"
              , "RUBBLE_EXPECTED_INSTALL=\"$runtime_install -c\" \\\n"
              , "RUBBLE_EXPECTED_INSTALL_DATA=\"$runtime_install -c -m 644\" \\\n"
              , "RUBBLE_EXPECTED_INSTALL_SHARED=\"$runtime_install -c -m 755\" \\\n"
              , "RUBBLE_EXPECTED_MKDIR_P=\"$runtime_mkdir -p\" \\\n"
              , "\"$out/bin/python3\" - <<'PY'\n"
              , "import bz2\n"
              , "import ctypes\n"
              , "import curses\n"
              , "import dbm.ndbm\n"
              , "import decimal\n"
              , "import hashlib\n"
              , "import lzma\n"
              , "import os\n"
              , "import readline\n"
              , "import sqlite3\n"
              , "import ssl\n"
              , "import subprocess\n"
              , "import sys\n"
              , "import sysconfig\n"
              , "import zlib\n"
              , "\n"
              , "expected = {\n"
              , "    \"SHELL\": os.environ[\"RUBBLE_EXPECTED_SHELL\"],\n"
              , "    \"INSTALL\": os.environ[\"RUBBLE_EXPECTED_INSTALL\"],\n"
              , "    \"INSTALL_PROGRAM\": os.environ[\"RUBBLE_EXPECTED_INSTALL\"],\n"
              , "    \"INSTALL_SCRIPT\": os.environ[\"RUBBLE_EXPECTED_INSTALL\"],\n"
              , "    \"INSTALL_DATA\": os.environ[\"RUBBLE_EXPECTED_INSTALL_DATA\"],\n"
              , "    \"INSTALL_SHARED\": os.environ[\"RUBBLE_EXPECTED_INSTALL_SHARED\"],\n"
              , "    \"MKDIR_P\": os.environ[\"RUBBLE_EXPECTED_MKDIR_P\"],\n"
              , "}\n"
              , "for key, value in expected.items():\n"
              , "    actual = sysconfig.get_config_var(key)\n"
              , "    assert actual == value, f\"{key}: expected {value!r}, got {actual!r}\"\n"
              , "shell_result = subprocess.run(\"printf shell-runtime-ok\", shell=True, check=True, text=True, capture_output=True)\n"
              , "assert shell_result.stdout == \"shell-runtime-ok\"\n"
              , "PY"
              ]
            , "format": "text"
            }
          }
        , { "shell": {
              "value": [
                "publish_output_directory \"$out/bin\" \"$bin\"\n"
              , "publish_output_directory \"$out/lib\" \"$lib\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "vfthpdhrrixmo7ewqosxes2hbagrr4iuhtp3x5ax4vrohm65ynba-bootstrap-env":
      { "id": "vfthpdhrrixmo7ewqosxes2hbagrr4iuhtp3x5ax4vrohm65ynba-bootstrap-env"
      , "name": "bootstrap-env"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "ovg7cu6kkazcpj32mrk53yc3kb2z2mrl4yd5yzrj3uytgwcanawa-curl"
          , "alias": "curl"
          , "transitive": "true"
          }
        , { "brick": "nyxvd2fuotdmxjktenzudif5x5zq2d5ohtbciy4t5ztyf7b7x2fq-ca-certificates.pem"
          , "alias": "ca_certs"
          , "transitive": "true"
          }
        , { "brick": "n7qbevbly56oq5vdzjm2bzhl77wjewdp4k5gmoimlbiv62nbv7pa-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "6xbcw7rsrgmctcyu25rzq64e42jggkhbuymzq2k4pfnyvv7a2hdq-write-exec-wrappers"
          , "alias": "write_wrappers"
          , "transitive": "false"
          }
        , { "brick": "sclybv3wsmgo7lnvjs4ywxykwvbpkwzeezn3l3sbg4f6xpksw63a-zstd"
          , "alias": "zstd"
          , "transitive": "true"
          }
        , { "brick": "7t7hvndnqng7fsb5phlfjcn7fnp2t53gucm7iaoownjbavgdimha-xz"
          , "alias": "xz"
          , "transitive": "true"
          }
        , { "brick": "mbg4lwvhanztnjrvjyh36j4j7ojysmtv2cjoshzw6xj5dzztiluq-unzip"
          , "alias": "unzip"
          , "transitive": "true"
          }
        , { "brick": "6prv4ap5h2cndbif6hlymbvxvg3p2g3qtpdl7vdmyiwyxxp65kfq-m4"
          , "alias": "m4"
          , "transitive": "true"
          }
        , { "brick": "jx55n3p7uiv65atde62sfdnrktfey2co5qtqasgnglrc4qytpgtq-gzip"
          , "alias": "gzip"
          , "transitive": "true"
          }
        , { "brick": "abax7ryl2uma2r3kh4v4srra3jnisjuuivmrvttb2cg35q7lrdgq-gpatch"
          , "alias": "gpatch"
          , "transitive": "true"
          }
        , { "brick": "exgdn46eagyxc5npgu2ktpyluirdd44myaua6gnfodk5ei35shxq-gnu-sed"
          , "alias": "gnu_sed"
          , "transitive": "true"
          }
        , { "brick": "k5zazg3iqlzgpeegvrj4ovmwfucggksuxzbuhl6kyduei2qq4xuq-gnu-make"
          , "alias": "gnu_make"
          , "transitive": "true"
          }
        , { "brick": "nx7a5qmymqncddkt6verfvnhlg64g2q2iupe3xoh2pianzay2ela-gawk"
          , "alias": "gawk"
          , "transitive": "true"
          }
        , { "brick": "catpfdrg7xd6pcsylgw2dzmolmqrqux6crkx64inuc42ioy4szfa-findutils"
          , "alias": "findutils"
          , "transitive": "true"
          }
        , { "brick": "klzkfeewgdals54pcgp3sytbcfc46yua4g3vq23ijqq4cou4almq-diffutils"
          , "alias": "diffutils"
          , "transitive": "true"
          }
        , { "brick": "rwceoiocqfcgioh4rb3u5w5k2kie6ntmoie2c3bwv6yexxrfgkxq-perl"
          , "alias": "perl"
          , "transitive": "true"
          }
        , { "brick": "3g4wslkvcdeh4prfpoamkoxdrefgts365qssdt5hsdlvxrqmze7a-grep"
          , "alias": "grep"
          , "transitive": "true"
          }
        , { "brick": "wxbpprly4rrpd6sqhki7cdf6pwaau5axfok4bzaehx2hpdvsudlq-git"
          , "alias": "git"
          , "transitive": "true"
          }
        , { "brick": "t4s5x7vx7ortfirmkczsv7ajjipmwf5sbggptpzkx6sude7mdweq-gcc"
          , "alias": "gcc"
          , "transitive": "true"
          }
        , { "brick": "2rsatquz5uzw7dilqg64g74l2vtvruaziu5jjhpcqjhmi4rw2cbq-bzip2"
          , "alias": "bzip2"
          , "transitive": "true"
          }
        , { "brick": "sro23mxtsmdqo6q6qnqjxue3aqpsmh44eskp6ftagjfnkxrfewuq-bison"
          , "alias": "bison"
          , "transitive": "true"
          }
        , { "brick": "2nwjk6y7a53lxi3iwzujxebrd3wp45eqr2sdhyc2c6xolptn3p3q-gnu-tar"
          , "alias": "gnu_tar"
          , "transitive": "true"
          }
        , { "brick": "4rml266dvj3lfnykptfshuossktxpdkis26uwp2ebjffjlgcmmra-coreutils"
          , "alias": "coreutils"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "bin" }
        , { "name": "env" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p \"$bin\"\n"
              , "\n"
              , "# === Bash ===\n"
              , "\"$write_wrappers\" aliases \"$bin\" \"${bash[bin]}/bash\" \"${bash[bin]}/bash\" bash sh\n"
              , "\n"
              , "# === Coreutils ===\n"
              , "# Create wrappers for all coreutils commands\n"
              , "\"$write_wrappers\" coreutils \"$bin\" \"${bash[bin]}/bash\" \"${coreutils[bin]}\"\n"
              , "\n"
              , "# === curl ===\n"
              , "# curl needs SSL_CERT_FILE to find CA certificates\n"
              , "curl_env=\"export SSL_CERT_FILE=\\\"$ca_certs\\\"\"\n"
              , "\"$write_wrappers\" single \"$bin/curl\" \"${bash[bin]}/bash\" \"$curl\" \"$curl_env\"\n"
              , "\n"
              , "# === Git ===\n"
              , "\"$write_wrappers\" single \"$bin/git\" \"${bash[bin]}/bash\" \"${git[bin]}/git\"\n"
              , "\n"
              , "# === GNU tar ===\n"
              , "\"$write_wrappers\" aliases \"$bin\" \"${bash[bin]}/bash\" \"$gnu_tar\" tar gtar\n"
              , "\n"
              , "# === gzip ===\n"
              , "\"$write_wrappers\" single \"$bin/gzip\" \"${bash[bin]}/bash\" \"${gzip[bin]}/gzip\"\n"
              , "\"$write_wrappers\" single \"$bin/gunzip\" \"${bash[bin]}/bash\" \"${gzip[bin]}/gunzip\"\n"
              , "\"$write_wrappers\" single \"$bin/zcat\" \"${bash[bin]}/bash\" \"${gzip[bin]}/zcat\"\n"
              , "\n"
              , "# === xz ===\n"
              , "\"$write_wrappers\" single \"$bin/xz\" \"${bash[bin]}/bash\" \"$xz\"\n"
              , "for cmd in xzcat unxz lzma lzmadec lzcat; do\n"
              , "  \"$write_wrappers\" single \"$bin/$cmd\" \"${bash[bin]}/bash\" \"${xz[bin]}/$cmd\"\n"
              , "done\n"
              , "\n"
              , "# === zstd ===\n"
              , "\"$write_wrappers\" single \"$bin/zstd\" \"${bash[bin]}/bash\" \"$zstd\"\n"
              , "for cmd in zstdcat unzstd zstdmt; do\n"
              , "  \"$write_wrappers\" single \"$bin/$cmd\" \"${bash[bin]}/bash\" \"${zstd[bin]}/$cmd\"\n"
              , "done\n"
              , "\n"
              , "# === GNU sed ===\n"
              , "\"$write_wrappers\" single \"$bin/sed\" \"${bash[bin]}/bash\" \"$gnu_sed\"\n"
              , "\n"
              , "# === grep ===\n"
              , "\"$write_wrappers\" single \"$bin/grep\" \"${bash[bin]}/bash\" \"${grep[bin]}/grep\"\n"
              , "\"$write_wrappers\" single \"$bin/egrep\" \"${bash[bin]}/bash\" \"${grep[bin]}/egrep\"\n"
              , "\"$write_wrappers\" single \"$bin/fgrep\" \"${bash[bin]}/bash\" \"${grep[bin]}/fgrep\"\n"
              , "\n"
              , "# === GNU make ===\n"
              , "\"$write_wrappers\" aliases \"$bin\" \"${bash[bin]}/bash\" \"$gnu_make\" make gmake\n"
              , "\n"
              , "# === gpatch ===\n"
              , "\"$write_wrappers\" aliases \"$bin\" \"${bash[bin]}/bash\" \"$gpatch\" patch gpatch\n"
              , "\n"
              , "# === findutils ===\n"
              , "for cmd in find xargs; do\n"
              , "  if [ -f \"${findutils[bin]}/$cmd\" ]; then\n"
              , "    \"$write_wrappers\" single \"$bin/$cmd\" \"${bash[bin]}/bash\" \"${findutils[bin]}/$cmd\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# === bzip2 ===\n"
              , "\"$write_wrappers\" single \"$bin/bzip2\" \"${bash[bin]}/bash\" \"${bzip2[bin]}/bzip2\"\n"
              , "\"$write_wrappers\" single \"$bin/bunzip2\" \"${bash[bin]}/bash\" \"${bzip2[bin]}/bunzip2\"\n"
              , "\"$write_wrappers\" single \"$bin/bzcat\" \"${bash[bin]}/bash\" \"${bzip2[bin]}/bzcat\"\n"
              , "\n"
              , "# === unzip ===\n"
              , "\"$write_wrappers\" single \"$bin/unzip\" \"${bash[bin]}/bash\" \"$unzip\"\n"
              , "\n"
              , "# === perl ===\n"
              , "perl_env=\"source \\\"${perl[env]}\\\"\"\n"
              , "\"$write_wrappers\" single \"$bin/perl\" \"${bash[bin]}/bash\" \"${perl[bin]}/perl\" \"$perl_env\"\n"
              , "\n"
              , "# === gawk ===\n"
              , "\"$write_wrappers\" aliases \"$bin\" \"${bash[bin]}/bash\" \"$gawk\" awk gawk\n"
              , "\n"
              , "# === diffutils ===\n"
              , "for cmd in diff cmp diff3 sdiff; do\n"
              , "  if [ -f \"${diffutils[bin]}/$cmd\" ]; then\n"
              , "    \"$write_wrappers\" single \"$bin/$cmd\" \"${bash[bin]}/bash\" \"${diffutils[bin]}/$cmd\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# === m4 ===\n"
              , "\"$write_wrappers\" single \"$bin/m4\" \"${bash[bin]}/bash\" \"$m4\"\n"
              , "\n"
              , "# === bison ===\n"
              , "bison_env=\"export BISON_PKGDATADIR=\\\"${bison[share]}/bison\\\"\n"
              , "export M4=\\\"$m4\\\"\"\n"
              , "\"$write_wrappers\" single \"$bin/bison\" \"${bash[bin]}/bash\" \"${bison[bin]}/bison\" \"$bison_env\"\n"
              , "\"$write_wrappers\" single \"$bin/yacc\" \"${bash[bin]}/bash\" \"${bison[bin]}/yacc\" \"$bison_env\"\n"
              , "\n"
              , "# === GCC toolchain ===\n"
              , "gcc_env=\"export LD_LIBRARY_PATH=\\\"${gcc[lib]}\\${LD_LIBRARY_PATH:+:}\\${LD_LIBRARY_PATH:-}\\\"\"\n"
              , "for cmd in gcc g++ cc cpp c89 c99; do\n"
              , "  if [ -f \"${gcc[bin]}/$cmd\" ]; then\n"
              , "    \"$write_wrappers\" single \"$bin/$cmd\" \"${bash[bin]}/bash\" \"${gcc[bin]}/$cmd\" \"$gcc_env\"\n"
              , "  fi\n"
              , "done\n"
              , "for cmd in as ld ar nm ranlib strip objdump objcopy readelf strings size; do\n"
              , "  if [ -f \"${gcc[bin]}/$cmd\" ]; then\n"
              , "    \"$write_wrappers\" single \"$bin/$cmd\" \"${bash[bin]}/bash\" \"${gcc[bin]}/$cmd\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# === Environment setup script ===\n"
              , "{\n"
              , "  echo \"# Bootstrap environment setup script for Linux\"\n"
              , "  echo \"# Source this file to set up environment variables for builds\"\n"
              , "  echo \"export PATH=\\\"$bin\\${PATH:+:}\\${PATH:-}\\\"\"\n"
              , "  echo \"export SSL_CERT_FILE=\\\"$ca_certs\\\"\"\n"
              , "  echo \"export CC=\\\"${gcc[bin]}/gcc\\\"\"\n"
              , "  echo \"export CXX=\\\"${gcc[bin]}/g++\\\"\"\n"
              , "  echo \"export AR=\\\"${gcc[bin]}/ar\\\"\"\n"
              , "  echo \"export RANLIB=\\\"${gcc[bin]}/ranlib\\\"\"\n"
              , "  echo \"source \\\"${perl[env]}\\\"\"\n"
              , "} > \"$env\"\n"
              , "\n"
              , "printf %s \"rubble wrapper probe\" | \"$bin/gzip\" -c > \"$TMP/wrapper-probe.gz\"\n"
              , "actual=\"$(\"$bin/gunzip\" -c \"$TMP/wrapper-probe.gz\")\"\n"
              , "test \"$actual\" = \"rubble wrapper probe\"\n"
              , "rm -f \"$TMP/wrapper-probe.gz\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "otvk5dfabfdoiouphr55y37uwmcmgee4eed5jlejzqpuihkie3za-RubbleR.git.partial":
      { "id": "otvk5dfabfdoiouphr55y37uwmcmgee4eed5jlejzqpuihkie3za-RubbleR.git.partial"
      , "name": "RubbleR.git.partial"
      , "src": {
          "repo": "https://github.com/chaifeng/RubbleR.git"
        , "commit": "b6036bca920a218c1a5692c55a709b7b829501a8"
        , "paths": [
            "./Cargo.lock"
          , "./Cargo.toml"
          , "./rubble_derive/Cargo.toml"
          , "./rust-toolchain.toml"
          ]
        }
      , "inputs": [
          { "brick": "6vx2ce7jcj6wfra4xg2ykz6htsdkuvhh7uxbyr4gzlwvf2mlriua-rubble-src-checkout"
          , "alias": "rubble_src_checkout"
          , "transitive": "true"
          }
        , { "brick": "4x2uexqjoqs5unyb4fxpdus3ctebmhvqnuruhalsl5rdwt3k6naa-rubble-canonical-script"
          , "alias": "rubble_canonical_script"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "RUBBLE_SRC_FETCH_MODE all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "__rubble_skip_src_split__"
          , "value": "true"
          }
        ]
      , "outputs": [
          { "name": "dir" }
        , { "name": "archive__impure__" }
        , { "name": "script" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir \"$dir\"\n"
              , "echo \"${brick[src::commit]}\" > \"${dir}/.rubble-deferred\"\n"
              , "\n"
              , "mkdir \"$archive\"\n"
              , "echo \"${brick[src::commit]}\" > \"${archive}/.rubble-deferred\"\n"
              , "\n"
              , "source \"${rubble_canonical_script[script]}\"\n"
              , "\n"
              , "printf -v __rubble_source_repo '%q' \"${brick[src::remote]}\"\n"
              , "printf -v __rubble_source_commit '%q' \"${brick[src::commit]}\"\n"
              , "printf -v __rubble_source_paths '%q' \"${brick[src::paths]}\"\n"
              , "(\n"
              , "rubble_canonical_script << __EOF_SCRIPT_207__\n"
              , "repo=${__rubble_source_repo}\n"
              , "commit=${__rubble_source_commit}\n"
              , "paths=${__rubble_source_paths}\n"
              , "gitRepoCredential=\"\"\n"
              , "src_archive=\"$archive\"\n"
              , "inner_path=\"\"\n"
              , "deferred_marker=\".rubble-deferred\"\n"
              , "\n"
              , "if [[ -z \"\\${repo:-}\" || -z \"\\${commit:-}\" ]]; then\n"
              , "    echo \"Error: Missing repo or commit information\" >&2\n"
              , "    exit 1\n"
              , "fi\n"
              , "\n"
              , "source \"${rubble_src_checkout}\" \"\\${1:-\\${dir}}\" \"\\${@:2}\"\n"
              , "__EOF_SCRIPT_207__\n"
              , ") > \"$script\"\n"
              , "__log_info \"${brick[id]:0:7}-${brick[name]}: source script generated path=${script}\""
              ]
            , "format": "text"
            }
          }
        ]
      }
