        , { "shell": {
              "value": [
                "project_dir=\"$PWD\"\n"
              , "mkdir -p \"$project_dir/target\"\n"
              , "export CARGO_HOME=\"$project_dir/target/cargo_home\"\n"
              , "\n"
              , "launcher_suffix=\"\"\n"
              , "if [[ -n \"${MSYS2_ROOT:-}\" ]]; then\n"
              , "  launcher_suffix=\".exe\"\n"
              , "fi\n"
              , "isolated_cargo_dir=\"$project_dir/target/rubble-isolated-bin\"\n"
              , "isolated_cargo=\"$isolated_cargo_dir/cargo${launcher_suffix}\"\n"
              , "launcher_test=\"$project_dir/.rubble-tools/cargo-launcher-test${launcher_suffix}\"\n"
              , "mkdir -p \"$isolated_cargo_dir\"\n"
              , "rustc --edition=2024 --test \"$project_dir/.rubble-tools/cargo-launcher.rs\" -o \"$launcher_test\"\n"
              , "\"$launcher_test\"\n"
              , "rustc --edition=2024 -C opt-level=3 \"$project_dir/.rubble-tools/cargo-launcher.rs\" -o \"$isolated_cargo\"\n"
              , "rm -f \"$launcher_test\"\n"
              , "\n"
              , "# Cargo always receives one explicit project config. The empty initial\n"
              , "# file is replaced with the vendored source configuration below.\n"
              , "mkdir -p \"$project_dir/.cargo\"\n"
              , ": > \"$project_dir/.cargo/config.toml\"\n"
              , "\n"
              , "# 2. Vendor all dependencies with versioned dirs\n"
              , "echo \"=== Vendoring dependencies ===\"\n"
              , "\"$isolated_cargo\" vendor \\\n"
              , "  --manifest-path \"$project_dir/Cargo.toml\" \\\n"
              , "  --versioned-dirs \"$project_dir/vendor\"\n"
              , "\n"
              , "# Normalize before Cargo fingerprints sources: RBL extraction restores\n"
              , "# regular-file mtimes to one second after the Unix epoch.\n"
              , "find \"$project_dir/vendor\" -type f -exec touch -m -d '@1' {} +\n"
              , "\n"
              , "# 3. Generate .cargo/config.toml with multi-version patch support\n"
              , "echo \"=== Generating .cargo/config.toml ===\"\n"
              , "mkdir -p .cargo\n"
              , "echo '[patch.crates-io]' > .cargo/config.toml\n"
              , "\n"
              , "for dir in vendor/*/; do\n"
              , "  dir_name=$(basename \"$dir\")\n"
              , "  # Get package name and version from Cargo.toml\n"
              , "  pkg_name=$(grep -m1 '^name' \"$dir/Cargo.toml\" | sed 's/.*\"\\(.*\\)\".*/\\1/')\n"
              , "  pkg_version=$(grep -m1 '^version' \"$dir/Cargo.toml\" | sed 's/.*\"\\(.*\\)\".*/\\1/')\n"
              , "\n"
              , "  if [[ -n \"$pkg_name\" && -n \"$pkg_version\" ]]; then\n"
              , "    # Use unique key: package_name_version (replace . and - with _)\n"
              , "    key_name=$(echo \"${pkg_name}_${pkg_version}\" | tr '.-' '_')\n"
              , "    echo \"\\\"${key_name}\\\" = { path = \\\"vendor/${dir_name}\\\", package = \\\"${pkg_name}\\\", version = \\\"=${pkg_version}\\\" }\" >> .cargo/config.toml\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "echo \"Generated config.toml entries: $(wc -l < .cargo/config.toml)\"\n"
              , "\n"
              , "# 4. Build dependencies using skeleton project\n"
              , "echo \"=== Building dependencies ===\"\n"
              , "\n"
              , "export OPENSSL_CONFIG_DIR=\"/rubble/openssl/ssl\"\n"
              , "export LIBZ_SYS_STATIC=1\n"
              , "# Cap lints to warn level for vendored crates (path deps don't get cap-lints=allow)\n"
              , "# This prevents Rust version upgrades from breaking builds due to new deny lints.\n"
              , "# Do not add build-path remaps here; Cargo fingerprints RUSTFLAGS and cache reuse depends on this staying stable.\n"
              , "export RUSTFLAGS=\"${RUSTFLAGS:-} --cap-lints warn\"\n"
              , "\"$isolated_cargo\" build \\\n"
              , "  --manifest-path \"$project_dir/Cargo.toml\" \\\n"
              , "  --release -j1\n"
              , "\n"
              , "# 5. Remove skeleton project artifacts, keep dependency artifacts\n"
              , "echo \"=== Cleaning project-specific artifacts ===\"\n"
              , "find target -path \"*/release/.fingerprint/rubble-*\" -exec rm -rf {} + 2>/dev/null || true\n"
              , "find target -path \"*/release/.fingerprint/rubble_derive-*\" -exec rm -rf {} + 2>/dev/null || true\n"
              , "find target -path \"*/release/deps/*rubble*\" -delete 2>/dev/null || true\n"
              , "find target -path \"*/release/rubble*\" -not -path \"*/deps/*\" -delete 2>/dev/null || true\n"
              , "find target -path \"*/release/librubble*\" -not -path \"*/deps/*\" -not -path \"*rubble_derive*\" -delete 2>/dev/null || true\n"
              , "\n"
              , "# 6. Remove crates with hardcoded native lib paths that become stale when cached\n"
              , "# These crates store absolute paths to vendor directories in their output files,\n"
              , "# which break when the cache is copied to a different build location.\n"
              , "echo \"=== Removing crates with hardcoded native paths ===\"\n"
              , "for pattern in windows_x86_64_gnu winapi-x86_64-pc-windows-gnu windows_aarch64_gnullvm; do\n"
              , "  find target -path \"*/release/build/${pattern}-*\" -exec rm -rf {} + 2>/dev/null || true\n"
              , "  find target -path \"*/release/.fingerprint/${pattern}-*\" -exec rm -rf {} + 2>/dev/null || true\n"
              , "done\n"
              , "\n"
              , "# 6. Output\n"
              , "echo \"=== Copying to output ===\"\n"
              , "mkdir -p \"$out\"\n"
              , "cp -a vendor \"$out/\"\n"
              , "cp -a target \"$out/\"\n"
              , "cp -a .cargo \"$out/\"\n"
              , "cp Cargo.lock \"$out/\"\n"
              , "\n"
              , "echo \"=== Output size ===\"\n"
              , "du -sh \"$out\"/*"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "f4kctu2x45xjvktknpp7soicl6epvx5dy4vtdrxagpbkhp44rkaa-bun-1.4.3":
      { "id": "f4kctu2x45xjvktknpp7soicl6epvx5dy4vtdrxagpbkhp44rkaa-bun-1.4.3"
      , "name": "bun-1.4.3"
      , "platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "cmdaozrcvaymmdfw3jodg7rrc4qwmaqyx6q3jj6u6nsie32hvdxq-publish-output-directory"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$script\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "hdqxqr4vfc2rgc3rj5ywrpaykxqly77eix55tldf7wd7nqimpqfa-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "nkbc5fhuwgawyucceat7l2bt62mdkmrygtjkwf6uoayzdrenokvq-bun-linux-x64.zip"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "vfthpdhrrixmo7ewqosxes2hbagrr4iuhtp3x5ax4vrohm65ynba-bootstrap-env"
          , "alias": "bootstrap"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$env\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "cwqgfsd3etn6cjqpyys6jv6v3xtif5qovlpujqolrd6kwhnevi5a-rubble-elf-runtime"
          , "alias": "elf_runtime"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "archive_dir"
          , "value": "bun-linux-x64"
          }
        , { "name": "binary_name"
          , "value": "bun"
          }
        , { "name": "loader_name"
          , "value": "ld-linux-x86-64.so.2"
          }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p unpacked \"$out/bin\"\n"
              , "unzip -q \"$src\" -d unpacked\n"
              , "cp \"unpacked/$archive_dir/$binary_name\" \"$out/bin/$binary_name\"\n"
              , "chmod 755 \"$out/bin/$binary_name\"\n"
              , "binary=\"$out/bin/$binary_name\"\n"
              , "loader=\"${elf_runtime[lib]}/$loader_name\"\n"
              , "test -x \"$loader\"\n"
              , "\"$patchelf\" --no-sort --set-interpreter \"$loader\" --force-rpath --set-rpath \"${elf_runtime[lib]}\" \"$binary\"\n"
              , "\n"
              , "# Patchelf 0.18.0 can move .gnu.version_d without updating DT_VERDEF.\n"
              , "# Repair that pointer from the ELF metadata after relocation.\n"
              , "# Reproducer: https://github.com/can1357/oh-my-pi/issues/9881\n"
              , "\"${bootstrap[bin]}/perl\" - \"$binary\" <<'PERL'\n"
              , "use strict;\n"
              , "use warnings;\n"
              , "open my $elf, '+<', $ARGV[0] or die \"open Bun ELF: $!\\n\";\n"
              , "binmode $elf;\n"
              , "sub read_at {\n"
              , "    my ($offset, $length) = @_;\n"
              , "    seek($elf, $offset, 0) or die \"seek Bun ELF: $!\\n\";\n"
              , "    my $buffer;\n"
              , "    read($elf, $buffer, $length) == $length or die \"short Bun ELF read\\n\";\n"
              , "    return $buffer;\n"
              , "}\n"
              , "my $header = read_at(0, 64);\n"
              , "substr($header, 0, 6) eq \"\\x7fELF\\x02\\x01\" or die \"expected ELF64 little endian\\n\";\n"
              , "my $section_offset = unpack('Q<', substr($header, 40, 8));\n"
              , "my ($section_size, $section_count) = unpack('S<S<', substr($header, 58, 4));\n"
              , "$section_size == 64 && $section_count > 0 or die \"unsupported Bun ELF sections\\n\";\n"
              , "my ($version_address, $dynamic_offset, $dynamic_size);\n"
              , "for my $index (0 .. $section_count - 1) {\n"
              , "    my $section = read_at($section_offset + $index * $section_size, $section_size);\n"
              , "    my ($type, $address, $offset, $size) = unpack('x4 L< x8 Q<Q<Q<', $section);\n"
              , "    if ($type == 0x6ffffffd) {\n"
              , "        !defined $version_address && $size > 0 or die \"ambiguous Bun version definitions\\n\";\n"
              , "        $version_address = $address;\n"
              , "    }\n"
              , "    if ($type == 6) {\n"
              , "        !defined $dynamic_offset or die \"ambiguous Bun dynamic table\\n\";\n"
              , "        ($dynamic_offset, $dynamic_size) = ($offset, $size);\n"
              , "    }\n"
              , "}\n"
              , "defined $dynamic_offset && $dynamic_size % 16 == 0 or die \"missing Bun dynamic table\\n\";\n"
              , "my ($version_slot, $previous_value, $terminated);\n"
              , "for (my $offset = $dynamic_offset; $offset < $dynamic_offset + $dynamic_size; $offset += 16) {\n"
              , "    my ($tag, $value) = unpack('Q<Q<', read_at($offset, 16));\n"
              , "    if ($tag == 0) { $terminated = 1; last; }\n"
              , "    next unless $tag == 0x6ffffffc;\n"
              , "    !defined $version_slot or die \"ambiguous Bun DT_VERDEF\\n\";\n"
              , "    ($version_slot, $previous_value) = ($offset + 8, $value);\n"
              , "}\n"
              , "$terminated or die \"unterminated Bun dynamic table\\n\";\n"
              , "exit 0 if !defined $version_address && !defined $version_slot;\n"
              , "defined $version_address && defined $version_slot or die \"incomplete Bun version metadata\\n\";\n"
              , "if ($previous_value != $version_address) {\n"
              , "    seek($elf, $version_slot, 0) or die \"seek Bun DT_VERDEF: $!\\n\";\n"
              , "    print {$elf} pack('Q<', $version_address) or die \"write Bun DT_VERDEF: $!\\n\";\n"
              , "    printf \"Bun DT_VERDEF: 0x%x -> 0x%x\\n\", $previous_value, $version_address;\n"
              , "}\n"
              , "close $elf or die \"close Bun ELF: $!\\n\";\n"
              , "PERL\n"
              , "\n"
              , "[[ \"$(\"$patchelf\" --print-interpreter \"$binary\")\" == \"$loader\" ]]\n"
              , "[[ \"$(\"$patchelf\" --print-rpath \"$binary\")\" == \"${elf_runtime[lib]}\" ]]\n"
              , "dynamic_tags=\"$(\"${bootstrap[bin]}/readelf\" -d \"$binary\")\"\n"
              , "[[ \"$dynamic_tags\" == *\"(RPATH)\"* && \"$dynamic_tags\" != *\"(RUNPATH)\"* ]]\n"
              , "\"${bootstrap[bin]}/readelf\" --version-info \"$binary\" > /dev/null\n"
              , "needed_entries=\"$(\"$patchelf\" --print-needed \"$binary\")\"\n"
              , "while IFS= read -r needed; do\n"
              , "  if [[ ! -f \"${elf_runtime[lib]}/$needed\" ]]; then\n"
              , "    echo \"Missing Bun runtime dependency: $needed\" >&2\n"
              , "    exit 1\n"
              , "  fi\n"
              , "done <<< \"$needed_entries\"\n"
              , "\n"
              , "actual_version=$(\"$binary\" --version)\n"
              , "[[ \"$actual_version\" == \"1.4.3\" ]]\n"
              , "env -i \"$binary\" -e '\n"
              , "  const fs = require(\"node:fs\");\n"
              , "  const {execFileSync} = require(\"node:child_process\");\n"
              , "  if (fs.realpathSync(process.execPath) !== fs.realpathSync(process.argv.at(-1))) {\n"
              , "    throw new Error(\"Bun process.execPath does not identify its executable\");\n"
              , "  }\n"
              , "  if (execFileSync(process.execPath, [\"--version\"], {env: {}}).toString().trim() !== \"1.4.3\") {\n"
              , "    throw new Error(\"Bun self-spawn failed\");\n"
              , "  }\n"
              , "' \"$binary\""
              ]
            , "format": "text"
            }
          }
        , { "shell": {
              "value": [
                "publish_output_directory \"$out/bin\" \"$bin\""
              ]
            , "format": "text"
            }
          }
        ]
      }
