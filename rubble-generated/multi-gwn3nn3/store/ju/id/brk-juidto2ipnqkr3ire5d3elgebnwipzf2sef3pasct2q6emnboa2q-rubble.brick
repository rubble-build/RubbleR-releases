  , "sclybv3wsmgo7lnvjs4ywxykwvbpkwzeezn3l3sbg4f6xpksw63a-zstd":
      { "id": "sclybv3wsmgo7lnvjs4ywxykwvbpkwzeezn3l3sbg4f6xpksw63a-zstd"
      , "name": "zstd"
      , "platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "hl6djaj44qkp6rily6m7uf6lsksicuvyiukbsphwqzo7zhddpzna-zstd-libs-1.5.6-r2.apk"
          , "alias": "zstd_libs_apk"
          , "transitive": "false"
          }
        , { "brick": "gn35dmjju7ixfllbazzkcjuoxfqy5sbsv6g6ghmtlkm5boylcb2a-zstd-1.5.6-r2.apk"
          , "alias": "zstd_apk"
          , "transitive": "false"
          }
        , { "brick": "hdqxqr4vfc2rgc3rj5ywrpaykxqly77eix55tldf7wd7nqimpqfa-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "z3xhjdr5it75lq5iwals4toaklhutksbdphbucgwhtgqhxz32k6q-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "5egteflbtlhbpl5lxsf77tssx5r2xozci62fdy42ah5ennedwyeq-musl-install-tools"
          , "alias": "musl_tools"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        , { "name": "lib" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p zstd-extract zstdlibs-extract\n"
              , "tar -xzf \"$zstd_apk\" -C zstd-extract\n"
              , "tar -xzf \"$zstd_libs_apk\" -C zstdlibs-extract\n"
              , "\n"
              , "mkdir -p \"$lib\"\n"
              , "find zstdlibs-extract -name \"libzstd.so*\" -exec cp -a {} \"$lib/\" \\;\n"
              , "\n"
              , "\"${musl_tools[install]}\" zstd-extract/usr/bin/zstd \"$out\" \"$patchelf\" \"$ld_musl\" \"$lib\"\n"
              , "\"${musl_tools[link_commands]}\" \"$out\" \"$bin\" zstd zstdcat unzstd zstdmt\n"
              , "\n"
              , "# Verify\n"
              , "assert_needed() {\n"
              , "  elf=$1\n"
              , "  shift\n"
              , "  actual=$(\"$patchelf\" --print-needed \"$elf\" | LC_ALL=C sort)\n"
              , "  expected=$(printf '%s\\n' \"$@\" | LC_ALL=C sort)\n"
              , "  test \"$actual\" = \"$expected\"\n"
              , "}\n"
              , "\n"
              , "musl_soname=$(\"$patchelf\" --print-soname \"$ld_musl\")\n"
              , "case \"$musl_soname\" in\n"
              , "  libc.musl-*.so.1) ;;\n"
              , "  *) false ;;\n"
              , "esac\n"
              , "\n"
              , "test \"$(\"$patchelf\" --print-interpreter \"$out\")\" = \"$ld_musl\"\n"
              , "test \"$(\"$patchelf\" --print-rpath \"$out\")\" = \"$lib\"\n"
              , "assert_needed \"$out\" libzstd.so.1 \"$musl_soname\"\n"
              , "\n"
              , "test -L \"$lib/libzstd.so.1\"\n"
              , "libzstd_target=$(readlink \"$lib/libzstd.so.1\")\n"
              , "case \"$libzstd_target\" in\n"
              , "  \"\"|/*|*/*) false ;;\n"
              , "esac\n"
              , "libzstd_real=\"$lib/$libzstd_target\"\n"
              , "test -f \"$libzstd_real\"\n"
              , "test ! -L \"$libzstd_real\"\n"
              , "test \"$(\"$patchelf\" --print-soname \"$libzstd_real\")\" = libzstd.so.1\n"
              , "assert_needed \"$libzstd_real\" \"$musl_soname\"\n"
              , "\n"
              , "printf '%s' 'rubble zstd probe' | \"$out\" --compress --stdout > \"$TMP/probe.zst\"\n"
              , "actual=\"$(\"$bin/unzstd\" --stdout \"$TMP/probe.zst\")\"\n"
              , "test \"$actual\" = 'rubble zstd probe'\n"
              , "rm -f \"$TMP/probe.zst\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "7t7hvndnqng7fsb5phlfjcn7fnp2t53gucm7iaoownjbavgdimha-xz":
      { "id": "7t7hvndnqng7fsb5phlfjcn7fnp2t53gucm7iaoownjbavgdimha-xz"
      , "name": "xz"
      , "platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "nws6zlpln3tj2nmcg2rgeg6oz734dmzdwollxgmfencuocanafpq-xz-libs-5.8.4-r0.apk"
          , "alias": "xz_libs_apk"
          , "transitive": "false"
          }
        , { "brick": "4i46vt6ng6p5fw7a6n2tia2bak57bfbdxoiotymi5opsmw2655vq-xz-5.8.4-r0.apk"
          , "alias": "xz_apk"
          , "transitive": "false"
          }
        , { "brick": "hdqxqr4vfc2rgc3rj5ywrpaykxqly77eix55tldf7wd7nqimpqfa-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "z3xhjdr5it75lq5iwals4toaklhutksbdphbucgwhtgqhxz32k6q-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "5egteflbtlhbpl5lxsf77tssx5r2xozci62fdy42ah5ennedwyeq-musl-install-tools"
          , "alias": "musl_tools"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        , { "name": "lib" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p xz-extract xzlibs-extract\n"
              , "tar -xzf \"$xz_apk\" -C xz-extract 2>/dev/null || true\n"
              , "tar -xzf \"$xz_libs_apk\" -C xzlibs-extract 2>/dev/null || true\n"
              , "\n"
              , "# Copy liblzma shared libraries\n"
              , "mkdir -p \"$lib\"\n"
              , "find xzlibs-extract -name \"liblzma.so*\" -exec cp -a {} \"$lib/\" \\;\n"
              , "\n"
              , "# out is the xz binary itself\n"
              , "\"${musl_tools[install]}\" xz-extract/usr/bin/xz \"$out\" \"$patchelf\" \"$ld_musl\" \"$lib\"\n"
              , "\"${musl_tools[link_commands]}\" \"$out\" \"$bin\" xz unxz xzcat lzma lzmadec lzcat\n"
              , "\n"
              , "printf '%s' 'rubble xz probe' | \"$out\" -c > \"$TMP/probe.xz\"\n"
              , "actual=\"$(\"$bin/unxz\" -c \"$TMP/probe.xz\")\"\n"
              , "test \"$actual\" = 'rubble xz probe'\n"
              , "rm -f \"$TMP/probe.xz\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "mbg4lwvhanztnjrvjyh36j4j7ojysmtv2cjoshzw6xj5dzztiluq-unzip":
      { "id": "mbg4lwvhanztnjrvjyh36j4j7ojysmtv2cjoshzw6xj5dzztiluq-unzip"
