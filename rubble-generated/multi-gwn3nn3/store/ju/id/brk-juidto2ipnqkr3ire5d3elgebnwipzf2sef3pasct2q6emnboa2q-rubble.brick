  , "jomf52m6ijsokfau3fyyvgd7elhgiiavaic5tzdw6lhugeziyhna-wasm-pack-0.15.0":
      { "id": "jomf52m6ijsokfau3fyyvgd7elhgiiavaic5tzdw6lhugeziyhna-wasm-pack-0.15.0"
      , "name": "wasm-pack-0.15.0"
      , "platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "4mtrsm6btbhfrahkgwn4ss2s2vcmwa5frmg7ndtsnh7bjgjm2hpa-wasm-pack-v0.15.0-x86_64-unknown-linux-musl.tar.gz"
          , "alias": "src"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "bin" }
        , { "name": "env" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar -xzf \"$src\"\n"
              , "wasm_pack_bin=$(find . -type f -name wasm-pack | head -n 1)\n"
              , "if [[ -z \"$wasm_pack_bin\" ]]; then\n"
              , "  echo \"wasm-pack binary not found in release archive\"\n"
              , "  exit 1\n"
              , "fi\n"
              , "\n"
              , "mkdir -p \"$bin\"\n"
              , "cp \"$wasm_pack_bin\" \"$bin/wasm-pack\"\n"
              , "chmod +x \"$bin/wasm-pack\"\n"
              , "\n"
              , "while IFS= builtin read -r __rubble_output_line; do\n"
              , "  builtin printf '%s\\n' \"$__rubble_output_line\"\n"
              , "done > \"$env\" <<EOF\n"
              , "export PATH=\"$bin:\\${PATH}\"\n"
              , "export WASM_PACK=\"$bin/wasm-pack\"\n"
              , "EOF\n"
              , "builtin unset __rubble_output_line"
              ]
            , "format": "text"
            }
          }
        ]
      }
