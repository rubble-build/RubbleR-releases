  , "7ngde34g6fsmdbt57au7543vtzv75pt7ff3xnmx5a6oubzevfoba-glibc-runtime-support":
      { "id": "7ngde34g6fsmdbt57au7543vtzv75pt7ff3xnmx5a6oubzevfoba-glibc-runtime-support"
      , "name": "glibc-runtime-support"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "4rml266dvj3lfnykptfshuossktxpdkis26uwp2ebjffjlgcmmra-coreutils"
          , "alias": "coreutils"
          , "transitive": "false"
          }
        , { "brick": "g2qqoxqlhdq4m5ptlml7rg4j2sjvm5kcal5xohzpvcxxpaxx63za-RubbleR.git.partial"
          , "alias": "src"
          , "transitive": "false"
          , "hooks": {
              "post-checkout": [
                { "install-to": [
                    { "output": "dir"
                    , "dir": "./" }
                  ]
                }
              , { "shell": {
                    "value": [
                      "rubble-exec rm -f -- \"${TMP}/rubble-source.env\"\n"
                    , "( source \"${script}\" \"${dir}\" --env-file \"${TMP}/rubble-source.env\" )\n"
                    , "__rubble_import_source_environment \"${TMP}/rubble-source.env\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "\"${coreutils[bin]}/mkdir\" -p \"$out\"\n"
              , "for file in initialize.c build-initializer.bash probe.c external-nss.c \\\n"
              , "  external-gconv.c passwd-namespace.c audit.bash README.md; do\n"
              , "  \"${coreutils[bin]}/cp\" \"scripts/glibc-runtime-support/$file\" \"$out/$file\"\n"
              , "done"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "tiydotxjz7qewbo5ed3zp2qubvbtinrxxikbmtjjybfk763ytxda-gcc-glibc":
      { "id": "tiydotxjz7qewbo5ed3zp2qubvbtinrxxikbmtjjybfk763ytxda-gcc-glibc"
      , "name": "gcc-glibc"
      , "platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "scofokclgi3ex4hzrtnmlf6lpkcpmii52orptjcupfmikihi6kxq-zlib1g_1.3.dfsg_really1.3.1-1_b1_amd64.deb"
          , "alias": "zlib1g_deb"
          , "transitive": "false"
          }
        , { "brick": "cmdaozrcvaymmdfw3jodg7rrc4qwmaqyx6q3jj6u6nsie32hvdxq-publish-output-directory"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$script\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "hdqxqr4vfc2rgc3rj5ywrpaykxqly77eix55tldf7wd7nqimpqfa-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "eay2yd76jtq2n72kafauwkofupanezwq2muobm7bjlf6mfojk4ma-linux-libc-dev_6.12.86-1_all.deb"
          , "alias": "linux_libc_dev_deb"
          , "transitive": "false"
          }
        , { "brick": "hy7vvf7hx76tdededuy6vbt2zjw2rzd2papv6r7qm2m52vhchfna-libzstd1_1.5.7_dfsg-1_amd64.deb"
          , "alias": "libzstd1_deb"
          , "transitive": "false"
          }
        , { "brick": "7buusvdtjbv3krfq34tglkiqz2x356bf2xwow5pmosrsliurop6a-libubsan1_14.2.0-19_amd64.deb"
          , "alias": "libubsan1_deb"
          , "transitive": "false"
          }
        , { "brick": "b2i5h3ipeqiico2oxqfkrpcrqndt5dys43nm7qrq5hh3e5n4gqpq-libtsan2_14.2.0-19_amd64.deb"
          , "alias": "libtsan2_deb"
          , "transitive": "false"
          }
        , { "brick": "eo66u6nzusdktuggisxpvr7qmzxvwr4lxwlclvsre4irq6krhcoq-libstdc__6_14.2.0-19_amd64.deb"
          , "alias": "libstdcpp6_deb"
          , "transitive": "false"
          }
        , { "brick": "p5uktxyamskabu2gk3grichqlqinop3payt7ptqw6d4srcvsaz5a-libstdc__-14-dev_14.2.0-19_amd64.deb"
          , "alias": "libstdcpp_dev_deb"
          , "transitive": "false"
          }
        , { "brick": "3rg7zno4crltlhtuwp3k5izvvdj2c6smqkw74ebwsrfv2o6grtna-libsframe1_2.44-3_amd64.deb"
          , "alias": "libsframe1_deb"
          , "transitive": "false"
          }
        , { "brick": "iqruyywvdmkzsmzzmu7rmrnp6fqgg7e2na76j3ty3skevyvcbu4q-libquadmath0_14.2.0-19_amd64.deb"
          , "alias": "libquadmath0_deb"
          , "transitive": "false"
          }
        , { "brick": "4rgcrtd62az4jvrpnqi7mo4lmi6jkafzaizl5renuatipxrg3soa-libmpfr6_4.2.2-1_amd64.deb"
          , "alias": "libmpfr6_deb"
          , "transitive": "false"
          }
        , { "brick": "wo6vgn55jsmxeqnkavm4rcompkku3ssc2xyxdc4nrbbcx5ggc2ea-libmpc3_1.3.1-1_b3_amd64.deb"
          , "alias": "libmpc3_deb"
          , "transitive": "false"
          }
        , { "brick": "7b5qkq7h725rlzwyjms32eiu6becwobfozmdtl3nmob3t75vmiuq-liblsan0_14.2.0-19_amd64.deb"
          , "alias": "liblsan0_deb"
          , "transitive": "false"
          }
        , { "brick": "ngfmqg7sdtevod5fupkehkz7ngg7lb4zc6hfheixgvduoprmea4a-libjansson4_2.14-2_b3_amd64.deb"
          , "alias": "libjansson4_deb"
          , "transitive": "false"
          }
        , { "brick": "2khe7fyham7ciybnkxksiegiv56edsph55lu6pvdrik6sznbr3sa-libitm1_14.2.0-19_amd64.deb"
          , "alias": "libitm1_deb"
          , "transitive": "false"
          }
        , { "brick": "smglbxy2qltuw55ubbydcyhowlyzyzpmmwhii6rttwdgrcn6yhwa-libisl23_0.27-1_amd64.deb"
          , "alias": "libisl23_deb"
          , "transitive": "false"
          }
        , { "brick": "soyqxtymcfjf74xui3ydngvt6so3orqonn4dzhh2gpwgcp2q6gna-libhwasan0_14.2.0-19_amd64.deb"
          , "alias": "libhwasan0_deb"
          , "transitive": "false"
          }
        , { "brick": "5cl2d3x6sk6fpzz2vyvzamieqdptlqxbsijlye75apvhdjupzhfq-libgomp1_14.2.0-19_amd64.deb"
          , "alias": "libgomp1_deb"
          , "transitive": "false"
          }
        , { "brick": "ry7dxugonx43nz5l7zqafhnyf7g44osnmhejuhlt4x3bhh6x4lya-libgmp10_6.3.0_dfsg-3_amd64.deb"
          , "alias": "libgmp10_deb"
          , "transitive": "false"
          }
        , { "brick": "w34r6xbrp5naxtwy4i2yjuqgwtocs272gmp3wpl6jzg7tchrtjra-libgcc-s1_14.2.0-19_amd64.deb"
          , "alias": "libgcc_s1_deb"
          , "transitive": "false"
          }
        , { "brick": "c2pb6bog4hbnzghhl2bdm4jrrqnq5e5oxiobkywqsl7p7igdtfva-libgcc-14-dev_14.2.0-19_amd64.deb"
          , "alias": "libgcc_dev_deb"
          , "transitive": "false"
          }
        , { "brick": "c27nqfizbqju23t62gn5fz5at7aiszoc2jdo7rca33boiwj4rrwq-libctf0_2.44-3_amd64.deb"
          , "alias": "libctf0_deb"
          , "transitive": "false"
          }
        , { "brick": "y2gczfciw3klma4mkheml5yh6gpkn4mnakp5qr5vsjygqqy33paa-libctf-nobfd0_2.44-3_amd64.deb"
          , "alias": "libctf_nobfd0_deb"
          , "transitive": "false"
          }
        , { "brick": "txb64vqfae7aa5nhycodgois76zpayaio6xopelsmuan5mnhhzzq-libcc1-0_14.2.0-19_amd64.deb"
          , "alias": "libcc1_0_deb"
          , "transitive": "false"
          }
        , { "brick": "p64ubkpmkkadsqqhidffg25atg2wgfinaacychgsfyt3outqqtdq-libc6_2.41-12_deb13u3_amd64.deb"
          , "alias": "libc6_deb"
          , "transitive": "false"
          }
        , { "brick": "3lwxgkj4bfhbzzcj2f4ouooyvkjr2hnt4bixwahhr3jmry6lnmwq-libc6-dev_2.41-12_deb13u3_amd64.deb"
          , "alias": "libc6_dev_deb"
          , "transitive": "false"
          }
        , { "brick": "r2rl2pbw7edcma3xcpjbnfmj5xa2l5ltff3xr3tyxxpfej5udu5a-libbinutils_2.44-3_amd64.deb"
          , "alias": "libbinutils_deb"
          , "transitive": "false"
          }
        , { "brick": "fyjvlznpum5cwh7apldb3sv4skrbahxa5uekyqo2eqwrcm2tzuxq-libatomic1_14.2.0-19_amd64.deb"
          , "alias": "libatomic1_deb"
          , "transitive": "false"
          }
        , { "brick": "6mnzlup57yva4f25swep426asen4gktqclnqldiusl5pv2ejz22q-libasan8_14.2.0-19_amd64.deb"
          , "alias": "libasan8_deb"
          , "transitive": "false"
          }
        , { "brick": "evtymdmzbmwvbqahpv3jn3fct73m5qstjmh54f2o7msjks7krita-gcc-14-x86-64-linux-gnu_14.2.0-19_amd64.deb"
          , "alias": "gcc_deb"
          , "transitive": "false"
          }
        , { "brick": "unxlmwftoohd5ub6hgpvylolxd6zjczt462o5jf6zyb2nmexflpa-gcc-14-base_14.2.0-19_amd64.deb"
          , "alias": "gcc_base_deb"
          , "transitive": "false"
          }
        , { "brick": "ihkb436hgrr2ikz2jd4v5enxpqhklppqp6s5usbutl4q6fqxs3ja-g__-14-x86-64-linux-gnu_14.2.0-19_amd64.deb"
          , "alias": "gpp_deb"
          , "transitive": "false"
          }
        , { "brick": "rr24d5jtgkkrifatmbdolj2lttqqu6g5h35w3qe536jpenad2e6q-cpp-14-x86-64-linux-gnu_14.2.0-19_amd64.deb"
          , "alias": "cpp_deb"
          , "transitive": "false"
          }
        , { "brick": "5s2guvzpcv5iov3rog7fjz2t5oa3idprxh4z7lst5ipo2mlpo2mq-binutils-x86-64-linux-gnu_2.44-3_amd64.deb"
          , "alias": "binutils_deb"
          , "transitive": "false"
          }
        , { "brick": "luy4bjnugq4iyxf653mduencnzaptaunhu4mph7pdata3houha5q-binutils-common_2.44-3_amd64.deb"
          , "alias": "binutils_common_deb"
          , "transitive": "false"
          }
        , { "brick": "n7qbevbly56oq5vdzjm2bzhl77wjewdp4k5gmoimlbiv62nbv7pa-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "vfthpdhrrixmo7ewqosxes2hbagrr4iuhtp3x5ax4vrohm65ynba-bootstrap-env"
          , "alias": "bootstrap"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$env\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "7ngde34g6fsmdbt57au7543vtzv75pt7ff3xnmx5a6oubzevfoba-glibc-runtime-support"
          , "alias": "glibc_support"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "gnu_triple"
          , "value": "x86_64-linux-gnu"
          }
        , { "name": "ld_linux_dir"
          , "value": "lib64"
          }
        , { "name": "ld_linux_name"
          , "value": "ld-linux-x86-64.so.2"
          }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        , { "name": "include" }
        , { "name": "lib" }
        , { "name": "libexec" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "staging=\"$PWD/staging\"\n"
              , "mkdir -p \"$out/bin\" \"$out/lib\" \"$out/$ld_linux_dir\" \"$out/include\" \\\n"
              , "         \"$out/libexec/gcc/${gnu_triple}/14\" \\\n"
              , "         \"$out/lib/gcc/${gnu_triple}/14\" \\\n"
              , "         \"$staging\"\n"
              , "\n"
              , "extract_deb() {\n"
              , "  local deb=\"$1\"\n"
              , "  local tmp=\"$PWD/extract_tmp\"\n"
              , "  rm -rf \"$tmp\" && mkdir -p \"$tmp\"\n"
              , "  (\n"
              , "    cd \"$tmp\"\n"
              , "    ar x \"$deb\"\n"
              , "    for data in data.tar.*; do\n"
              , "      tar xf \"$data\" -C \"$staging\"\n"
              , "    done\n"
              , "  )\n"
              , "  rm -rf \"$tmp\"\n"
              , "}\n"
              , "\n"
              , "for deb in \"$gcc_deb\" \"$cpp_deb\" \"$gpp_deb\" \"$gcc_base_deb\" \\\n"
              , "           \"$libgcc_dev_deb\" \"$libgcc_s1_deb\" \"$libstdcpp6_deb\" \\\n"
              , "           \"$libstdcpp_dev_deb\" \"$binutils_deb\" \"$binutils_common_deb\" \\\n"
              , "           \"$libbinutils_deb\" \"$libctf0_deb\" \"$libctf_nobfd0_deb\" \\\n"
              , "           \"$libsframe1_deb\" \"$libjansson4_deb\" \"$libc6_deb\" \\\n"
              , "           \"$libc6_dev_deb\" \"$linux_libc_dev_deb\" \"$libgmp10_deb\" \\\n"
              , "           \"$libisl23_deb\" \"$libmpc3_deb\" \"$libmpfr6_deb\" \\\n"
              , "           \"$libzstd1_deb\" \"$zlib1g_deb\" \\\n"
              , "           \"$libgomp1_deb\" \"$libitm1_deb\" \"$libatomic1_deb\" \\\n"
              , "           \"$libasan8_deb\" \"$liblsan0_deb\" \"$libtsan2_deb\" \\\n"
              , "           \"$libubsan1_deb\" \"$libhwasan0_deb\" \"$libcc1_0_deb\"; do\n"
              , "  extract_deb \"$deb\"\n"
              , "done\n"
              , "\n"
              , "if [ -n \"${libquadmath0_deb:-}\" ]; then\n"
              , "  extract_deb \"$libquadmath0_deb\"\n"
              , "fi\n"
              , "\n"
              , "# --- GCC compiler binaries ---\n"
              , "cp \"$staging/usr/bin/${gnu_triple}-gcc-14\" \"$out/bin/gcc\"\n"
              , "cp \"$staging/usr/bin/${gnu_triple}-gcc-ar-14\" \"$out/bin/gcc-ar\"\n"
              , "cp \"$staging/usr/bin/${gnu_triple}-gcc-nm-14\" \"$out/bin/gcc-nm\"\n"
              , "cp \"$staging/usr/bin/${gnu_triple}-gcc-ranlib-14\" \"$out/bin/gcc-ranlib\"\n"
              , "ln -s gcc \"$out/bin/cc\"\n"
              , "# G++\n"
              , "cp \"$staging/usr/bin/${gnu_triple}-g++-14\" \"$out/bin/g++\"\n"
              , "ln -s g++ \"$out/bin/c++\"\n"
              , "\n"
              , "# --- Binutils ---\n"
              , "for tool in ar as ld ld.bfd nm objcopy objdump ranlib readelf size \\\n"
              , "            strings strip addr2line c++filt elfedit gprof; do\n"
              , "  src_bin=\"$staging/usr/bin/${gnu_triple}-${tool}\"\n"
              , "  if [ -f \"$src_bin\" ]; then\n"
              , "    cp \"$src_bin\" \"$out/bin/$tool\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# --- GCC internal executables (cc1, cc1plus, collect2, lto-wrapper) ---\n"
              , "gcc_libexec=\"$staging/usr/libexec/gcc/${gnu_triple}/14\"\n"
              , "for f in cc1 cc1plus collect2 lto-wrapper lto1; do\n"
              , "  if [ -f \"$gcc_libexec/$f\" ]; then\n"
              , "    cp \"$gcc_libexec/$f\" \"$out/libexec/gcc/${gnu_triple}/14/\"\n"
              , "  fi\n"
              , "done\n"
              , "# LTO plugin\n"
              , "for f in \"$gcc_libexec\"/liblto_plugin.so*; do\n"
              , "  [ -e \"$f\" ] && cp -a \"$f\" \"$out/libexec/gcc/${gnu_triple}/14/\"\n"
              , "done\n"
              , "\n"
              , "# --- GCC lib directory (crt objects, libgcc, specs) ---\n"
              , "gcc_lib=\"$staging/usr/lib/gcc/${gnu_triple}/14\"\n"
              , "if [ -d \"$gcc_lib\" ]; then\n"
              , "  cp -a \"$gcc_lib\"/*.o \"$out/lib/gcc/${gnu_triple}/14/\" 2>/dev/null || true\n"
              , "  cp -a \"$gcc_lib\"/*.a \"$out/lib/gcc/${gnu_triple}/14/\" 2>/dev/null || true\n"
              , "  cp -a \"$gcc_lib\"/*.so* \"$out/lib/gcc/${gnu_triple}/14/\" 2>/dev/null || true\n"
              , "  cp -a \"$gcc_lib\"/*.spec \"$out/lib/gcc/${gnu_triple}/14/\" 2>/dev/null || true\n"
              , "  # GCC internal headers (stddef.h, stdarg.h, etc.)\n"
              , "  [ -d \"$gcc_lib/include\" ] && cp -a \"$gcc_lib/include\" \"$out/lib/gcc/${gnu_triple}/14/\"\n"
              , "  [ -d \"$gcc_lib/include-fixed\" ] && cp -a \"$gcc_lib/include-fixed\" \"$out/lib/gcc/${gnu_triple}/14/\"\n"
              , "fi\n"
              , "\n"
              , "# --- Shared libraries ---\n"
              , "for libdir in \"$staging/usr/lib/${gnu_triple}\" \"$staging/lib/${gnu_triple}\"; do\n"
              , "  if [ -d \"$libdir\" ]; then\n"
              , "    find \"$libdir\" -maxdepth 1 \\( -name \"*.so*\" -o -name \"*.a\" -o -name \"*.o\" \\) \\\n"
              , "      -exec cp -a {} \"$out/lib/\" \\;\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# glibc loads encoding modules at runtime; retain the complete declared tree.\n"
              , "cp -a \"$staging/usr/lib/${gnu_triple}/gconv\" \"$out/lib/\"\n"
              , "\n"
              , "# libstdc++ dev files (headers)\n"
              , "if [ -d \"$staging/usr/include/c++/14\" ]; then\n"
              , "  mkdir -p \"$out/include/c++/14\"\n"
              , "  cp -a \"$staging/usr/include/c++/14/\"* \"$out/include/c++/14/\"\n"
              , "fi\n"
              , "mkdir -p \"$out/include/c++/14/${gnu_triple}\"\n"
              , "cp -a \"$staging/usr/include/${gnu_triple}/c++/14/.\" \"$out/include/c++/14/${gnu_triple}/\"\n"
              , "\n"
              , "# Debian's GCC linker symlinks refer to its multiarch library directory.\n"
              , "# The assembled prefix places those runtime libraries directly under lib/.\n"
              , "for link in \"$out/lib/gcc/${gnu_triple}/14/\"*.so; do\n"
              , "  [ -L \"$link\" ] || continue\n"
              , "  case \"$(readlink \"$link\")\" in\n"
              , "    \"../../../${gnu_triple}/\"*)\n"
              , "      soname=$(basename \"$(readlink \"$link\")\")\n"
              , "      test -f \"$out/lib/$soname\"\n"
              , "      ln -sf \"../../../$soname\" \"$link\"\n"
              , "      ;;\n"
              , "    *) test -e \"$link\" ;;\n"
              , "  esac\n"
              , "done\n"
              , "\n"
              , "# --- glibc dynamic linker ---\n"
              , "# For x86_64: linker is in lib64/, symlink to ../lib/\n"
              , "# For aarch64: linker is in lib/, no symlink needed\n"
              , "if [ \"$ld_linux_dir\" != \"lib\" ]; then\n"
              , "  ln -sf \"../lib/${ld_linux_name}\" \"$out/${ld_linux_dir}/${ld_linux_name}\"\n"
              , "fi\n"
              , "\n"
              , "# --- glibc crt objects ---\n"
              , "for crt in \"$staging/usr/lib/${gnu_triple}\"/*.o; do\n"
              , "  [ -f \"$crt\" ] && cp -a \"$crt\" \"$out/lib/\"\n"
              , "done\n"
              , "\n"
              , "# --- System headers ---\n"
              , "# glibc headers\n"
              , "if [ -d \"$staging/usr/include\" ]; then\n"
              , "  # Copy everything except c++ (already handled above)\n"
              , "  find \"$staging/usr/include\" -maxdepth 1 -not -name \"c++\" -not -path \"$staging/usr/include\" \\\n"
              , "    -exec cp -a {} \"$out/include/\" \\;\n"
              , "fi\n"
              , "# Multiarch glibc headers (bits/, gnu/, sys/, etc.)\n"
              , "if [ -d \"$staging/usr/include/${gnu_triple}\" ]; then\n"
              , "  find \"$staging/usr/include/${gnu_triple}\" -mindepth 1 -maxdepth 1 -not -name c++ \\\n"
              , "    -exec cp -a {} \"$out/include/\" \\;\n"
              , "fi\n"
              , "# linux-libc-dev UAPI headers (symlink targets for asm/ headers)\n"
              , "if [ -d \"$staging/usr/lib/linux\" ]; then\n"
              , "  cp -a \"$staging/usr/lib/linux\" \"$out/lib/\"\n"
              , "fi\n"
              , "# Fix asm/ symlinks: Debian layout is usr/include/{triple}/asm/ (3 levels to usr/)\n"
              , "# but we flatten into include/asm/ (2 levels to $out), so adjust ../../../ to ../../\n"
              , "if [ -d \"$out/include/asm\" ]; then\n"
              , "  find \"$out/include/asm\" -type l | while read -r lnk; do\n"
              , "    target=\"$(readlink \"$lnk\")\"\n"
              , "    case \"$target\" in\n"
              , "      ../../../*) ln -sf \"../../${target#../../../}\" \"$lnk\" ;;\n"
              , "    esac\n"
              , "  done\n"
              , "fi\n"
              , "\n"
              , "# === Patchelf binaries ===\n"
              , "# Preserve program-header order when relocating large GCC executables.\n"
              , "# Wrappers do not make a host interpreter in an executable .real file safe.\n"
              , "ld_interp=\"$out/lib/${ld_linux_name}\"\n"
              , "rpath=\"$out/lib:$out/lib/gcc/${gnu_triple}/14\"\n"
              , "\n"
              , "is_elf() {\n"
              , "  [ \"$(LC_ALL=C head -c 4 \"$1\")\" = \"$(printf '\\177ELF')\" ]\n"
              , "}\n"
              , "\n"
              , "# Relocate every executable, including the internal compiler and LTO tools.\n"
              , "for bin in \"$out/bin\"/* \"$out/libexec/gcc/${gnu_triple}/14\"/*; do\n"
              , "  [ -f \"$bin\" ] || continue\n"
              , "  if \"$patchelf\" --print-interpreter \"$bin\" >/dev/null 2>&1; then\n"
              , "    \"$patchelf\" --no-sort --set-interpreter \"$ld_interp\" --set-rpath \"$rpath\" \"$bin\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# Relocate shared libraries and the complete gconv module closure.\n"
              , "find \"$out/lib\" -name \"*.so*\" -type f | while read -r so; do\n"
              , "  case \"$(basename \"$so\")\" in\n"
              , "    ld-linux*|ld-*.so*) continue ;;\n"
              , "  esac\n"
              , "  if is_elf \"$so\"; then\n"
              , "    library_rpath=\"$rpath\"\n"
              , "    case \"$so\" in\n"
              , "      \"$out/lib/gconv/\"*) library_rpath=\"\\$ORIGIN:$rpath\" ;;\n"
              , "    esac\n"
              , "    if \"$patchelf\" --print-interpreter \"$so\" >/dev/null 2>&1; then\n"
              , "      \"$patchelf\" --no-sort --set-interpreter \"$ld_interp\" --set-rpath \"$library_rpath\" \"$so\"\n"
              , "    else\n"
              , "      \"$patchelf\" --no-sort --set-rpath \"$library_rpath\" \"$so\"\n"
              , "    fi\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# === Wrapper scripts for gcc/g++/cpp and internal tools ===\n"
              , "# ELF interpreter/RUNPATH already supply defaults; preserve caller overrides.\n"
              , "create_wrapper() {\n"
              , "  local wrapper=\"$1\" real_bin=\"$2\" extra_args=\"${3:-}\"\n"
              , "  printf '#!%s\\nexec \"%s\" %s\"$@\"\\n' \\\n"
              , "    \"${bash[bin]}/bash\" \"$real_bin\" \"$extra_args\" > \"$wrapper\"\n"
              , "  chmod +x \"$wrapper\"\n"
              , "}\n"
              , "\n"
              , "for tool in gcc g++ cc c++; do\n"
              , "  real=\"$out/bin/$tool\"\n"
              , "  [ -f \"$real\" ] || [ -L \"$real\" ] || continue\n"
              , "  # If symlink (e.g. cc -> gcc), re-target to the .real binary\n"
              , "  if [ -L \"$real\" ]; then\n"
              , "    target=\"$(readlink \"$real\")\"\n"
              , "    rm \"$real\"\n"
              , "    ln -s \"${target}.real\" \"$out/bin/${tool}.real\"\n"
              , "  else\n"
              , "    mv \"$real\" \"$out/bin/${tool}.real\"\n"
              , "  fi\n"
              , "  create_wrapper \"$real\" \"$out/bin/${tool}.real\"\n"
              , "done\n"
              , "# cpp: invoke gcc.real -E\n"
              , "rm -f \"$out/bin/cpp\"\n"
              , "create_wrapper \"$out/bin/cpp\" \"$out/bin/gcc.real\" \"-E \"\n"
              , "\n"
              , "# Keep the same entrypoint layout for internal GCC executables.\n"
              , "for f in cc1 cc1plus collect2 lto-wrapper lto1; do\n"
              , "  real=\"$out/libexec/gcc/${gnu_triple}/14/$f\"\n"
              , "  [ -f \"$real\" ] || continue\n"
              , "  mv \"$real\" \"${real}.real\"\n"
              , "  create_wrapper \"$real\" \"${real}.real\"\n"
              , "done\n"
              , "\n"
              , "# Symlink bundled binutils (ld, as, etc.) into libexec so collect2 can find them\n"
              , "for tool in ld as nm ar ranlib objcopy objdump strip; do\n"
              , "  if [ -f \"$out/bin/$tool\" ] && [ ! -e \"$out/libexec/gcc/${gnu_triple}/14/$tool\" ]; then\n"
              , "    ln -s \"$out/bin/$tool\" \"$out/libexec/gcc/${gnu_triple}/14/$tool\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# === Create GCC specs to use bundled paths ===\n"
              , "gcc_specs=\"$out/lib/gcc/${gnu_triple}/14/specs\"\n"
              , "\"$out/bin/gcc\" -dumpspecs > \"$gcc_specs\"\n"
              , "# Patch the dynamic linker path in specs\n"
              , "# Use exact path match to avoid greedy .* destroying nested spec conditionals\n"
              , "sed -i \"s|/${ld_linux_dir}/${ld_linux_name}|$out/lib/${ld_linux_name}|g\" \"$gcc_specs\"\n"
              , "# AArch64 spells the native loader with optional ABI/endian spec fragments.\n"
              , "sed -i 's|/lib/ld-linux-aarch64%{mbig-endian:_be}%{mabi=ilp32:_ilp32}.so.1|'\"$ld_interp\"'|g' \"$gcc_specs\"\n"
              , "sed -i \"s|/usr/lib/${gnu_triple}/||g; s|/lib/${gnu_triple}/||g\" \"$gcc_specs\"\n"
              , "# Direct rustc calls do not read RUSTFLAGS; compiler defaults must pair the\n"
              , "# bundled loader with its libraries even without the environment facade.\n"
              , "sed -i \"/^\\\\*link:$/ { n; s|^|-rpath $out/lib |; }\" \"$gcc_specs\"\n"
              , "\n"
              , "# === Fix linker scripts to use bundled paths ===\n"
              , "# Debian linker scripts (libc.so, libm.so) contain absolute paths like\n"
              , "# /lib/aarch64-linux-gnu/libc.so.6 which don't exist in non-Debian systems.\n"
              , "# Rewrite them to reference our bundled libraries.\n"
              , "find \"$out/lib\" -maxdepth 1 -name \"*.so\" -type f | while read -r script; do\n"
              , "  if head -1 \"$script\" | grep -q \"GNU ld script\\|/\\*\"; then\n"
              , "    sed -i \"s|/usr/lib/${gnu_triple}/||g; s|/lib/${gnu_triple}/||g; s|/${ld_linux_dir}/${ld_linux_name}|$out/lib/${ld_linux_name}|g\" \"$script\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# NSS retains normal name lookup through the relocated libc RUNPATH.\n"
              , "\n"
              , "# Build with this provider's own ABI inputs. Shared code contains no binary\n"
              , "# or compiler dependency; Debian-specific relocation remains here.\n"
              , "source \"$glibc_support/build-initializer.bash\"\n"
              , "glibc_runtime_build_initializer \"$glibc_support/initialize.c\" \\\n"
              , "  \"$out/lib/librubble-glibc-paths.so\" \"$out/bin/gcc\" \\\n"
              , "  -B\"$out/lib/gcc/${gnu_triple}/14\" \\\n"
              , "  -nostdinc -isystem \"$out/lib/gcc/${gnu_triple}/14/include\" -isystem \"$out/include\" \\\n"
              , "  -L\"$out/lib\" -L\"$out/lib/gcc/${gnu_triple}/14\"\n"
              , "\"$patchelf\" --no-sort --set-rpath '$ORIGIN' \"$out/lib/librubble-glibc-paths.so\"\n"
              , "\n"
              , "# Disable the compiled host gconv directory/cache. The initializer supplies\n"
              , "# our local default after any caller-configured GCONV_PATH entries.\n"
              , "# These fixed-version, NUL-terminated data strings\n"
              , "# are replaced in place; reject different upstream layouts instead of\n"
              , "# silently patching an unknown binary. /dev/null cannot contain modules.\n"
              , "perl - \"$out/lib/libc.so.6\" \"$gnu_triple\" <<'EOF'\n"
              , "use strict;\n"
              , "use warnings;\n"
              , "my ($path, $triple) = @ARGV;\n"
              , "open my $input, '<:raw', $path or die \"$path: $!\";\n"
              , "local $/;\n"
              , "my $data = <$input>;\n"
              , "close $input or die \"$path: $!\";\n"
              , "my $size = length $data;\n"
              , "for my $replacement (\n"
              , "  [\"/usr/lib/$triple/gconv/gconv-modules.cache\\0\", \"/dev/null/gconv-cache\\0\"],\n"
              , "  [\"/usr/lib/$triple/gconv\\0\", \"/dev/null/gconv\\0\"],\n"
              , ") {\n"
              , "  my ($old, $new) = @$replacement;\n"
              , "  my $offset = index($data, $old);\n"
              , "  die \"Expected one glibc path pattern: $old\" if $offset < 0 || rindex($data, $old) != $offset;\n"
              , "  die \"glibc replacement does not fit\" if length($new) > length($old);\n"
              , "  my $padded = $new . \"\\0\" x (length($old) - length($new));\n"
              , "  substr($data, $offset, length($old), $padded);\n"
              , "  die \"glibc replacement failed\" if index($data, $old) >= 0 || substr($data, $offset, length($padded)) ne $padded;\n"
              , "}\n"
              , "die \"glibc size changed\" if length($data) != $size;\n"
              , "open my $output, '>:raw', $path or die \"$path: $!\";\n"
              , "print {$output} $data or die \"$path: $!\";\n"
              , "close $output or die \"$path: $!\";\n"
              , "EOF\n"
              , "\"$patchelf\" --no-sort --add-needed '$ORIGIN/librubble-glibc-paths.so' \"$out/lib/libc.so.6\"\n"
              , "\n"
              , "# === Verification ===\n"
              , "\n"
              , "test \"$(readlink -f \"$(\"$out/bin/gcc\" -print-prog-name=cc1)\")\" = \"$out/libexec/gcc/${gnu_triple}/14/cc1\"\n"
              , "\n"
              , "test_source=\"${TMP}/test_gcc_glibc.c\"\n"
              , "test_binary=\"${TMP}/test_gcc_glibc\"\n"
              , "printf '#include <stdio.h>\\nint main() { printf(\"Hello!\\\\n\"); return 0; }\\n' > \"$test_source\"\n"
              , "\"$out/bin/gcc\" -B\"$out/lib/gcc/${gnu_triple}/14\" \\\n"
              , "  -nostdinc -isystem \"$out/lib/gcc/${gnu_triple}/14/include\" -isystem \"$out/include\" \\\n"
              , "  -L\"$out/lib\" -L\"$out/lib/gcc/${gnu_triple}/14\" \\\n"
              , "  \"$test_source\" -o \"$test_binary\"\n"
              , "\"$test_binary\" >/dev/null\n"
              , "test \"$(\"$patchelf\" --print-interpreter \"$test_binary\")\" = \"$ld_interp\"\n"
              , "test \"$(\"$patchelf\" --print-rpath \"$test_binary\")\" = \"$out/lib\"\n"
              , "\n"
              , "printf '#include <iostream>\\n#include <vector>\\nint main() { std::vector<int> v{14}; std::cout << v.at(0) << \"\\\\n\"; }\\n' > \"$test_source.cpp\"\n"
              , "\"$out/bin/g++\" -B\"$out/lib/gcc/${gnu_triple}/14\" \\\n"
              , "  -nostdinc -nostdinc++ \\\n"
              , "  -isystem \"$out/include/c++/14\" -isystem \"$out/include/c++/14/${gnu_triple}\" \\\n"
              , "  -isystem \"$out/lib/gcc/${gnu_triple}/14/include\" -isystem \"$out/include\" \\\n"
              , "  -L\"$out/lib\" -L\"$out/lib/gcc/${gnu_triple}/14\" \\\n"
              , "  -flto \"$test_source.cpp\" -o \"$test_binary.cpp\"\n"
              , "test \"$(\"$test_binary.cpp\")\" = 14\n"
              , "test \"$(\"$patchelf\" --print-interpreter \"$test_binary.cpp\")\" = \"$ld_interp\"\n"
              , "for tool in cc1 cc1plus collect2 lto-wrapper lto1; do\n"
              , "  test \"$(\"$patchelf\" --print-interpreter \"$out/libexec/gcc/${gnu_triple}/14/$tool.real\")\" = \"$ld_interp\"\n"
              , "  test \"$(\"$patchelf\" --print-rpath \"$out/libexec/gcc/${gnu_triple}/14/$tool.real\")\" = \"$rpath\"\n"
              , "done\n"
              , "rm -f \"$test_source.cpp\" \"$test_binary.cpp\"\n"
              , "rm -f \"$test_source\" \"$test_binary\"\n"
              , "\n"
              , "# Behavior, including glibc's dynamic module paths, is a shared contract.\n"
              , "source \"$glibc_support/audit.bash\"\n"
              , "declare -A glibc_runtime_tools=()\n"
              , "for tool in env mkdir realpath sha256sum uname; do\n"
              , "  glibc_runtime_tools[$tool]=\"${bootstrap[bin]}/$tool\"\n"
              , "done\n"
              , "glibc_runtime_tool() { local tool=$1; shift; \"${glibc_runtime_tools[$tool]}\" \"$@\"; }\n"
              , "glibc_runtime_audit \"$glibc_support\" \\\n"
              , "  --target \"$out\" --allow-output \"$out\" \\\n"
              , "  --loader \"$out/lib/$ld_linux_name\" --library-dir \"$out/lib\" \\\n"
              , "  --nss-module \"$out/lib/libnss_hesiod.so.2\" \\\n"
              , "  --nss-module \"$out/lib/libnss_dns.so.2\" \\\n"
              , "  --cc \"$out/bin/gcc\" --compiler-path \"$out/bin\" \\\n"
              , "  --cc-arg \"-B$out/lib/gcc/$gnu_triple/14\" \\\n"
              , "  --cc-arg -nostdinc --cc-arg -isystem --cc-arg \"$out/lib/gcc/$gnu_triple/14/include\" \\\n"
              , "  --cc-arg -isystem --cc-arg \"$out/include\" \\\n"
              , "  --cc-arg \"-L$out/lib\" --cc-arg \"-L$out/lib/gcc/$gnu_triple/14\" \\\n"
              , "  --patchelf \"$patchelf\" --output-dir \"$TMP/glibc-runtime-audit\""
              ]
            , "format": "text"
            }
          }
        , { "shell": {
              "value": [
                "publish_output_directory \"$out/bin\" \"$bin\"\n"
              , "publish_output_directory \"$out/lib\" \"$lib\"\n"
              , "publish_output_directory \"$out/include\" \"$include\"\n"
              , "publish_output_directory \"$out/libexec\" \"$libexec\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "bkncl44cp7kg232ksgrqecd4odxplznwl76mocihjtlnz7oty6ea-rustc-1.94.0":
      { "id": "bkncl44cp7kg232ksgrqecd4odxplznwl76mocihjtlnz7oty6ea-rustc-1.94.0"
      , "name": "rustc-1.94.0"
      , "platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "p35fui5viqtrg47hzy5wwvgkewwbtgsqytapgqav4jzy4w5vud4a-rustc-1.94.0-x86_64-unknown-linux-gnu.tar.xz"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "gpd75vrjncv57fv3fzdfuoagqwgyqjwuizvdth2pdg7hv2q4lv5a-rubble-script-shebang"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$script\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "cmdaozrcvaymmdfw3jodg7rrc4qwmaqyx6q3jj6u6nsie32hvdxq-publish-output-directory"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$script\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "k26asjxkagaobt6oxlqt5ncp6k4mv6lz4szgbtddqpzjrwg65ncq-rust-std-1.94.0"
          , "alias": "rust_std"
          , "transitive": "false"
          }
        , { "brick": "hdqxqr4vfc2rgc3rj5ywrpaykxqly77eix55tldf7wd7nqimpqfa-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "n7qbevbly56oq5vdzjm2bzhl77wjewdp4k5gmoimlbiv62nbv7pa-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "tiydotxjz7qewbo5ed3zp2qubvbtinrxxikbmtjjybfk763ytxda-gcc-glibc"
          , "alias": "gcc_glibc"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        , { "name": "lib" }
        , { "name": "libexec" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar --strip-components=1 -Jxvf \"$src\"\n"
              , "mkdir -pv \"$out\"\n"
              , "mv rustc/bin \"$out\"\n"
              , "mv rustc/libexec \"$out\"\n"
              , "mv rustc/lib \"$out\"\n"
              , "\n"
              , "# Install rust-std into sysroot so rustc can find std for host compilation\n"
              , "for target_dir in \"${rust_std[out]}\"/lib/rustlib/*/lib; do\n"
              , "  target=$(basename \"$(dirname \"$target_dir\")\")\n"
              , "  mkdir -p \"$out/lib/rustlib/$target\"\n"
              , "  cp -a \"$target_dir\" \"$out/lib/rustlib/$target/\"\n"
              , "done\n"
              , "\n"
              , "# On Linux, patchelf ELF binaries to use store's glibc dynamic linker\n"
              , "if [ -n \"${gcc_glibc:-}\" ]; then\n"
              , "  rubble_script_shebang_register \"${bash[bin]}/bash\" sh bash\n"
              , "\n"
              , "  shebang_scripts=()\n"
              , "  for script in \"$out/bin/rust-gdb\" \"$out/bin/rust-gdbgui\" \"$out/bin/rust-lldb\"; do\n"
              , "    [ -f \"$script\" ] || continue\n"
              , "    shebang_scripts+=(\"$script\")\n"
              , "  done\n"
              , "  if ((${#shebang_scripts[@]} > 0)); then\n"
              , "    rubble_script_shebang_rewrite_all --strict \"${shebang_scripts[@]}\"\n"
              , "  fi\n"
              , "\n"
              , "  ld_linux=$(echo \"${gcc_glibc[lib]}\"/ld-linux-*.so.* | awk '{print $1}')\n"
              , "  lib_path=\"${gcc_glibc[lib]}:$out/lib\"\n"
              , "\n"
              , "  # Patch executables (set interpreter + rpath)\n"
              , "  find \"$out/bin\" \"$out/libexec\" \"$out/lib/rustlib\" -type f 2>/dev/null | while read -r f; do\n"
              , "    \"${gcc_glibc[bin]}/readelf\" -l \"$f\" 2>/dev/null | grep -q \"INTERP\" || continue\n"
              , "    \"$patchelf\" --set-interpreter \"$ld_linux\" --set-rpath \"$lib_path\" \"$f\"\n"
              , "  done\n"
              , "\n"
              , "  # Patch shared libraries (set rpath so transitive deps resolve)\n"
              , "  find \"$out/lib\" -name '*.so*' -type f 2>/dev/null | while read -r f; do\n"
              , "    \"${gcc_glibc[bin]}/readelf\" -h \"$f\" 2>/dev/null | grep -q \"DYN\" || continue\n"
              , "    \"$patchelf\" --set-rpath \"$lib_path\" \"$f\"\n"
              , "  done\n"
              , "fi"
              ]
            , "format": "text"
            }
          }
        , { "shell": {
              "value": [
                "publish_output_directory \"$out/bin\" \"$bin\"\n"
              , "publish_output_directory \"$out/lib\" \"$lib\"\n"
              , "publish_output_directory \"$out/libexec\" \"$libexec\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "cwqgfsd3etn6cjqpyys6jv6v3xtif5qovlpujqolrd6kwhnevi5a-rubble-elf-runtime":
      { "id": "cwqgfsd3etn6cjqpyys6jv6v3xtif5qovlpujqolrd6kwhnevi5a-rubble-elf-runtime"
      , "name": "rubble-elf-runtime"
      , "platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "cmdaozrcvaymmdfw3jodg7rrc4qwmaqyx6q3jj6u6nsie32hvdxq-publish-output-directory"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$script\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "hdqxqr4vfc2rgc3rj5ywrpaykxqly77eix55tldf7wd7nqimpqfa-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "vfthpdhrrixmo7ewqosxes2hbagrr4iuhtp3x5ax4vrohm65ynba-bootstrap-env"
          , "alias": "bootstrap"
          , "transitive": "false"
          }
        , { "brick": "7ngde34g6fsmdbt57au7543vtzv75pt7ff3xnmx5a6oubzevfoba-glibc-runtime-support"
          , "alias": "glibc_support"
          , "transitive": "false"
          }
        , { "brick": "tiydotxjz7qewbo5ed3zp2qubvbtinrxxikbmtjjybfk763ytxda-gcc-glibc"
          , "alias": "gcc_glibc"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "ld_linux_name"
          , "value": "ld-linux-x86-64.so.2"
          }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "lib" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p \"$out/lib\"\n"
              , "\n"
              , "# Copy only the runtime surface, including the C++ runtime used by Node.\n"
              , "# Preserve relative SONAME links without carrying compiler-library paths.\n"
              , "copy_runtime_library() {\n"
              , "  local soname=\"$1\" target\n"
              , "  while [ -L \"${gcc_glibc[out]}/lib/$soname\" ]; do\n"
              , "    cp -a \"${gcc_glibc[out]}/lib/$soname\" \"$out/lib/\"\n"
              , "    target=$(readlink \"${gcc_glibc[out]}/lib/$soname\")\n"
              , "    case \"$target\" in\n"
              , "      ''|*/*)\n"
              , "        echo \"Expected a relative runtime library filename: $soname -> $target\" >&2\n"
              , "        exit 1\n"
              , "        ;;\n"
              , "    esac\n"
              , "    soname=\"$target\"\n"
              , "  done\n"
              , "  cp -a \"${gcc_glibc[out]}/lib/$soname\" \"$out/lib/\"\n"
              , "}\n"
              , "\n"
              , "for soname in \"$ld_linux_name\" libc.so.6 libm.so.6 libdl.so.2 \\\n"
              , "  libpthread.so.0 librt.so.1 libresolv.so.2 libutil.so.1 \\\n"
              , "  libgcc_s.so.1 libstdc++.so.6 libz.so.1 librubble-glibc-paths.so \\\n"
              , "  libnss_compat.so.2 libnss_dns.so.2 libnss_files.so.2 libnss_hesiod.so.2; do\n"
              , "  copy_runtime_library \"$soname\"\n"
              , "done\n"
              , "if [ -f \"${gcc_glibc[out]}/lib/libmvec.so.1\" ]; then\n"
              , "  copy_runtime_library libmvec.so.1\n"
              , "fi\n"
              , "cp -a \"${gcc_glibc[out]}/lib/gconv\" \"$out/lib/\"\n"
              , "\n"
              , "runtime_search_path() {\n"
              , "  case \"$1\" in\n"
              , "    \"$out/lib/gconv/\"*) printf '%s' \"\\$ORIGIN:$out/lib\" ;;\n"
              , "    *) printf '%s' \"$out/lib\" ;;\n"
              , "  esac\n"
              , "}\n"
              , "\n"
              , "while IFS= read -r -d '' elf_file; do\n"
              , "  [ \"$(basename \"$elf_file\")\" != \"$ld_linux_name\" ] || continue\n"
              , "  if \"$patchelf\" --print-interpreter \"$elf_file\" >/dev/null 2>&1; then\n"
              , "    \"$patchelf\" --no-sort --set-interpreter \"$out/lib/$ld_linux_name\" \"$elf_file\"\n"
              , "  fi\n"
              , "  \"$patchelf\" --no-sort --set-rpath \"$(runtime_search_path \"$elf_file\")\" \"$elf_file\"\n"
              , "done < <(find \"$out/lib\" -type f -name '*.so*' -print0)\n"
              , "\n"
              , "while IFS= read -r -d '' elf_file; do\n"
              , "  if ! needed_entries=\"$(\"$patchelf\" --print-needed \"$elf_file\")\"; then\n"
              , "    echo \"Expected an ELF runtime object: $elf_file\" >&2\n"
              , "    exit 1\n"
              , "  fi\n"
              , "\n"
              , "  if [[ -n \"$needed_entries\" ]]; then\n"
              , "    while IFS= read -r needed; do\n"
              , "      # libc locates its path initializer relative to itself after copying.\n"
              , "      resolved_needed=\"$needed\"\n"
              , "      case \"$needed\" in\n"
              , "        '$ORIGIN/librubble-glibc-paths.so') resolved_needed=librubble-glibc-paths.so ;;\n"
              , "        */*) echo \"Unexpected runtime dependency path: $needed\" >&2; exit 1 ;;\n"
              , "      esac\n"
              , "      if [[ ! -e \"$out/lib/$resolved_needed\" && ! -e \"$(dirname \"$elf_file\")/$resolved_needed\" ]]; then\n"
              , "        echo \"Missing runtime dependency for $elf_file: $needed\" >&2\n"
              , "        exit 1\n"
              , "      fi\n"
              , "    done <<< \"$needed_entries\"\n"
              , "  fi\n"
              , "\n"
              , "  if ! runtime_path=\"$(\"$patchelf\" --print-rpath \"$elf_file\")\"; then\n"
              , "    echo \"Failed to inspect the runtime search path: $elf_file\" >&2\n"
              , "    exit 1\n"
              , "  fi\n"
              , "  if [[ -n \"$runtime_path\" && \"$runtime_path\" != \"$(runtime_search_path \"$elf_file\")\" ]]; then\n"
              , "    echo \"Unexpected runtime search path for $elf_file: $runtime_path\" >&2\n"
              , "    exit 1\n"
              , "  fi\n"
              , "done < <(find \"$out/lib\" -type f -name '*.so*' -print0)\n"
              , "\n"
              , "# Audit the copied runtime through the same implementation as its provider.\n"
              , "source \"$glibc_support/audit.bash\"\n"
              , "declare -A glibc_runtime_tools=()\n"
              , "for tool in env mkdir realpath sha256sum uname; do\n"
              , "  glibc_runtime_tools[$tool]=\"${bootstrap[bin]}/$tool\"\n"
              , "done\n"
              , "glibc_runtime_tool() { local tool=$1; shift; \"${glibc_runtime_tools[$tool]}\" \"$@\"; }\n"
              , "gnu_triple=$(\"${gcc_glibc[bin]}/gcc\" -dumpmachine)\n"
              , "glibc_runtime_audit \"$glibc_support\" \\\n"
              , "  --target \"$out\" --allow-output \"$out\" \\\n"
              , "  --loader \"$out/lib/$ld_linux_name\" --library-dir \"$out/lib\" \\\n"
              , "  --nss-module \"$out/lib/libnss_hesiod.so.2\" \\\n"
              , "  --nss-module \"$out/lib/libnss_dns.so.2\" \\\n"
              , "  --cc \"${gcc_glibc[bin]}/gcc\" --compiler-path \"${gcc_glibc[bin]}\" \\\n"
              , "  --cc-arg \"-B${gcc_glibc[lib]}/gcc/$gnu_triple/14\" \\\n"
              , "  --cc-arg -nostdinc --cc-arg -isystem --cc-arg \"${gcc_glibc[lib]}/gcc/$gnu_triple/14/include\" \\\n"
              , "  --cc-arg -isystem --cc-arg \"${gcc_glibc[include]}\" \\\n"
              , "  --cc-arg \"-L${gcc_glibc[lib]}\" --cc-arg \"-L${gcc_glibc[lib]}/gcc/$gnu_triple/14\" \\\n"
              , "  --patchelf \"$patchelf\" --output-dir \"$TMP/glibc-runtime-audit\""
              ]
            , "format": "text"
            }
          }
        , { "shell": {
              "value": [
                "publish_output_directory \"$out/lib\" \"$lib\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "wpkpambmtcqapunqsckghyers4sj6gyv2zi6xdgrlvxxpujstwzq-nodejs-runtime":
      { "id": "wpkpambmtcqapunqsckghyers4sj6gyv2zi6xdgrlvxxpujstwzq-nodejs-runtime"
      , "name": "nodejs-runtime"
      , "platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
