          }
        ]
      }
  , "cndex52rgwiybhxcbkpry2isc55dz3hrc5lblmzr3xyeilghixda-patchelf":
      { "id": "cndex52rgwiybhxcbkpry2isc55dz3hrc5lblmzr3xyeilghixda-patchelf"
      , "name": "patchelf"
      , "platform": "aarch64-linux"
      , "inputs": [
          { "brick": "qbrlu376mq3m5jhng65mdeobdbrpjzv3thrthfrpvoam77zovt3q-patchelf-0.18.0-aarch64.tar.gz"
          , "alias": "src"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "bin" }
        , { "name": "share" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar -xvf \"$src\"\n"
              , "mv bin/patchelf \"$bin\"\n"
              , "mv share \"$share\"\n"
              , "\"$bin\" --version"
              ]
            , "format": "text"
            }
          }
        ]
      }
