          , "transitive": "false"
          }
        , { "brick": "yb6tefhslyriibghffdurwb2wvapj6x3xizoboao2doaj7v7xgda-libcc1-0_14.2.0-19_arm64.deb"
          , "alias": "libcc1_0_deb"
          , "transitive": "false"
          }
        , { "brick": "odlzblejigvixnek4zw3qpf6kdmpduizlfdol6phkrwrrltm3kdq-libc6_2.41-12_deb13u3_arm64.deb"
          , "alias": "libc6_deb"
          , "transitive": "false"
          }
        , { "brick": "lb7vuv6w3fr43o73swpjgwfuwdhyi7l2xskuuisw3eaekunxv3ia-libc6-dev_2.41-12_deb13u3_arm64.deb"
          , "alias": "libc6_dev_deb"
          , "transitive": "false"
          }
        , { "brick": "3pwyzin2s6znyulfwpta6mbiky3ksdwnmvi4k4oblrddcyccpbkq-libbinutils_2.44-3_arm64.deb"
          , "alias": "libbinutils_deb"
          , "transitive": "false"
          }
        , { "brick": "wx522xces6aeljkz5y55o6kdkgi6zgyvebi63xgqxclodxabs56q-libatomic1_14.2.0-19_arm64.deb"
          , "alias": "libatomic1_deb"
          , "transitive": "false"
          }
        , { "brick": "fbxgu4t24gr47iq2yhyaygays2hvcmyidx4tkwjmlx52pttyr6yq-libasan8_14.2.0-19_arm64.deb"
          , "alias": "libasan8_deb"
          , "transitive": "false"
          }
        , { "brick": "rgdskue4seruek4fxopdeftkm4uf7jxa7nxjyqkhkj5yak2ebc4a-gcc-14-base_14.2.0-19_arm64.deb"
          , "alias": "gcc_base_deb"
          , "transitive": "false"
          }
        , { "brick": "q66xooc3uyetlxp6565oyihya5babf4sn3opal27qo6em5wjkuca-gcc-14-aarch64-linux-gnu_14.2.0-19_arm64.deb"
          , "alias": "gcc_deb"
          , "transitive": "false"
          }
        , { "brick": "mgvpjsbz7sujl5qdndfmqhtclpxfhlytkeyidejyjfez5jloit7a-g__-14-aarch64-linux-gnu_14.2.0-19_arm64.deb"
          , "alias": "gpp_deb"
          , "transitive": "false"
          }
        , { "brick": "nwjntcya5bc7tfxrl5i22jo3v2rnlixwjc6ri3r4kwupxtwlaqsa-cpp-14-aarch64-linux-gnu_14.2.0-19_arm64.deb"
          , "alias": "cpp_deb"
          , "transitive": "false"
          }
        , { "brick": "4gbejr52ozzofmznelc52fgic4nsoasxjr6i4phtf6utztaoz6la-binutils-common_2.44-3_arm64.deb"
          , "alias": "binutils_common_deb"
          , "transitive": "false"
          }
        , { "brick": "ecxkum7thkjwggmltz3jlz67amewczlvf6ybucueqawsamou6t4a-binutils-aarch64-linux-gnu_2.44-3_arm64.deb"
          , "alias": "binutils_deb"
          , "transitive": "false"
          }
        , { "brick": "yecbppbe2hram3gythftkgn6mwelxq6l42vejdrjy3czbotcwmoq-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "a7ud4y2emz4jysev4e5p275gywgintjlenar2fsfrjokko6cdclq-bootstrap-env"
          , "alias": "bootstrap"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$out/setup-env.sh\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "ra7m4lfeba77ju6dmzwc5ha7gqhk5s6oc4gcutc2hshvc5mj53ea-glibc-runtime-support"
          , "alias": "glibc_support"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "gnu_triple"
          , "value": "aarch64-linux-gnu"
          }
        , { "name": "ld_linux_dir"
          , "value": "lib"
          }
        , { "name": "ld_linux_name"
          , "value": "ld-linux-aarch64.so.1"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "staging=\"$PWD/staging\"\n"
              , "mkdir -p \"$out/bin\" \"$out/lib\" \"$out/$ld_linux_dir\" \"$out/include\" \\\n"
              , "         \"$out/libexec/gcc/${gnu_triple}/14\" \\\n"
              , "         \"$out/lib/gcc/${gnu_triple}/14\" \\\n"
              , "         \"$staging\"\n"
              , "\n"
              , "extract_deb() {\n"
              , "  local deb=\"$1\"\n"
              , "  local tmp=\"$PWD/extract_tmp\"\n"
              , "  rm -rf \"$tmp\" && mkdir -p \"$tmp\"\n"
              , "  (\n"
              , "    cd \"$tmp\"\n"
              , "    ar x \"$deb\"\n"
              , "    for data in data.tar.*; do\n"
              , "      tar xf \"$data\" -C \"$staging\"\n"
              , "    done\n"
              , "  )\n"
              , "  rm -rf \"$tmp\"\n"
              , "}\n"
              , "\n"
              , "echo \"=== Extracting Debian packages ===\"\n"
              , "for deb in \"$gcc_deb\" \"$cpp_deb\" \"$gpp_deb\" \"$gcc_base_deb\" \\\n"
              , "           \"$libgcc_dev_deb\" \"$libgcc_s1_deb\" \"$libstdcpp6_deb\" \\\n"
              , "           \"$libstdcpp_dev_deb\" \"$binutils_deb\" \"$binutils_common_deb\" \\\n"
              , "           \"$libbinutils_deb\" \"$libctf0_deb\" \"$libctf_nobfd0_deb\" \\\n"
              , "           \"$libsframe1_deb\" \"$libjansson4_deb\" \"$libc6_deb\" \\\n"
              , "           \"$libc6_dev_deb\" \"$linux_libc_dev_deb\" \"$libgmp10_deb\" \\\n"
              , "           \"$libisl23_deb\" \"$libmpc3_deb\" \"$libmpfr6_deb\" \\\n"
              , "           \"$libzstd1_deb\" \"$zlib1g_deb\" \\\n"
              , "           \"$libgomp1_deb\" \"$libitm1_deb\" \"$libatomic1_deb\" \\\n"
              , "           \"$libasan8_deb\" \"$liblsan0_deb\" \"$libtsan2_deb\" \\\n"
              , "           \"$libubsan1_deb\" \"$libhwasan0_deb\" \"$libcc1_0_deb\"; do\n"
              , "  echo \"  Extracting $(basename \"$deb\")...\"\n"
              , "  extract_deb \"$deb\"\n"
              , "done\n"
              , "\n"
              , "if [ -n \"${libquadmath0_deb:-}\" ]; then\n"
              , "  extract_deb \"$libquadmath0_deb\"\n"
              , "fi\n"
              , "\n"
              , "echo \"=== Assembling toolchain ===\"\n"
              , "\n"
              , "# --- GCC compiler binaries ---\n"
              , "cp \"$staging/usr/bin/${gnu_triple}-gcc-14\" \"$out/bin/gcc\"\n"
              , "cp \"$staging/usr/bin/${gnu_triple}-gcc-ar-14\" \"$out/bin/gcc-ar\"\n"
              , "cp \"$staging/usr/bin/${gnu_triple}-gcc-nm-14\" \"$out/bin/gcc-nm\"\n"
              , "cp \"$staging/usr/bin/${gnu_triple}-gcc-ranlib-14\" \"$out/bin/gcc-ranlib\"\n"
              , "ln -s gcc \"$out/bin/cc\"\n"
              , "# G++\n"
              , "cp \"$staging/usr/bin/${gnu_triple}-g++-14\" \"$out/bin/g++\"\n"
              , "ln -s g++ \"$out/bin/c++\"\n"
              , "\n"
              , "# --- Binutils ---\n"
              , "for tool in ar as ld ld.bfd nm objcopy objdump ranlib readelf size \\\n"
              , "            strings strip addr2line c++filt elfedit gprof; do\n"
              , "  src_bin=\"$staging/usr/bin/${gnu_triple}-${tool}\"\n"
              , "  if [ -f \"$src_bin\" ]; then\n"
              , "    cp \"$src_bin\" \"$out/bin/$tool\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# --- GCC internal executables (cc1, cc1plus, collect2, lto-wrapper) ---\n"
              , "gcc_libexec=\"$staging/usr/libexec/gcc/${gnu_triple}/14\"\n"
              , "for f in cc1 cc1plus collect2 lto-wrapper lto1; do\n"
              , "  if [ -f \"$gcc_libexec/$f\" ]; then\n"
              , "    cp \"$gcc_libexec/$f\" \"$out/libexec/gcc/${gnu_triple}/14/\"\n"
              , "  fi\n"
              , "done\n"
              , "# LTO plugin\n"
              , "for f in \"$gcc_libexec\"/liblto_plugin.so*; do\n"
              , "  [ -e \"$f\" ] && cp -a \"$f\" \"$out/libexec/gcc/${gnu_triple}/14/\"\n"
              , "done\n"
              , "\n"
              , "# --- GCC lib directory (crt objects, libgcc, specs) ---\n"
              , "gcc_lib=\"$staging/usr/lib/gcc/${gnu_triple}/14\"\n"
              , "if [ -d \"$gcc_lib\" ]; then\n"
              , "  cp -a \"$gcc_lib\"/*.o \"$out/lib/gcc/${gnu_triple}/14/\" 2>/dev/null || true\n"
              , "  cp -a \"$gcc_lib\"/*.a \"$out/lib/gcc/${gnu_triple}/14/\" 2>/dev/null || true\n"
              , "  cp -a \"$gcc_lib\"/*.so* \"$out/lib/gcc/${gnu_triple}/14/\" 2>/dev/null || true\n"
              , "  cp -a \"$gcc_lib\"/*.spec \"$out/lib/gcc/${gnu_triple}/14/\" 2>/dev/null || true\n"
              , "  # GCC internal headers (stddef.h, stdarg.h, etc.)\n"
              , "  [ -d \"$gcc_lib/include\" ] && cp -a \"$gcc_lib/include\" \"$out/lib/gcc/${gnu_triple}/14/\"\n"
              , "  [ -d \"$gcc_lib/include-fixed\" ] && cp -a \"$gcc_lib/include-fixed\" \"$out/lib/gcc/${gnu_triple}/14/\"\n"
              , "fi\n"
              , "\n"
              , "# --- Shared libraries ---\n"
              , "for libdir in \"$staging/usr/lib/${gnu_triple}\" \"$staging/lib/${gnu_triple}\"; do\n"
              , "  if [ -d \"$libdir\" ]; then\n"
              , "    find \"$libdir\" -maxdepth 1 \\( -name \"*.so*\" -o -name \"*.a\" -o -name \"*.o\" \\) \\\n"
              , "      -exec cp -a {} \"$out/lib/\" \\;\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# glibc loads encoding modules at runtime; retain the complete declared tree.\n"
              , "cp -a \"$staging/usr/lib/${gnu_triple}/gconv\" \"$out/lib/\"\n"
              , "\n"
              , "# libstdc++ dev files (headers)\n"
              , "if [ -d \"$staging/usr/include/c++/14\" ]; then\n"
              , "  mkdir -p \"$out/include/c++/14\"\n"
              , "  cp -a \"$staging/usr/include/c++/14/\"* \"$out/include/c++/14/\"\n"
              , "fi\n"
              , "mkdir -p \"$out/include/c++/14/${gnu_triple}\"\n"
              , "cp -a \"$staging/usr/include/${gnu_triple}/c++/14/.\" \"$out/include/c++/14/${gnu_triple}/\"\n"
              , "\n"
              , "# Debian's GCC linker symlinks refer to its multiarch library directory.\n"
              , "# The assembled prefix places those runtime libraries directly under lib/.\n"
              , "for link in \"$out/lib/gcc/${gnu_triple}/14/\"*.so; do\n"
              , "  [ -L \"$link\" ] || continue\n"
              , "  case \"$(readlink \"$link\")\" in\n"
              , "    \"../../../${gnu_triple}/\"*)\n"
              , "      soname=$(basename \"$(readlink \"$link\")\")\n"
              , "      test -f \"$out/lib/$soname\"\n"
              , "      ln -sf \"../../../$soname\" \"$link\"\n"
              , "      ;;\n"
              , "    *) test -e \"$link\" ;;\n"
              , "  esac\n"
              , "done\n"
              , "\n"
              , "# --- glibc dynamic linker ---\n"
              , "# For x86_64: linker is in lib64/, symlink to ../lib/\n"
              , "# For aarch64: linker is in lib/, no symlink needed\n"
              , "if [ \"$ld_linux_dir\" != \"lib\" ]; then\n"
              , "  ln -sf \"../lib/${ld_linux_name}\" \"$out/${ld_linux_dir}/${ld_linux_name}\"\n"
              , "fi\n"
              , "\n"
              , "# --- glibc crt objects ---\n"
              , "for crt in \"$staging/usr/lib/${gnu_triple}\"/*.o; do\n"
              , "  [ -f \"$crt\" ] && cp -a \"$crt\" \"$out/lib/\"\n"
              , "done\n"
              , "\n"
              , "# --- System headers ---\n"
              , "# glibc headers\n"
              , "if [ -d \"$staging/usr/include\" ]; then\n"
              , "  # Copy everything except c++ (already handled above)\n"
              , "  find \"$staging/usr/include\" -maxdepth 1 -not -name \"c++\" -not -path \"$staging/usr/include\" \\\n"
              , "    -exec cp -a {} \"$out/include/\" \\;\n"
              , "fi\n"
              , "# Multiarch glibc headers (bits/, gnu/, sys/, etc.)\n"
              , "if [ -d \"$staging/usr/include/${gnu_triple}\" ]; then\n"
              , "  find \"$staging/usr/include/${gnu_triple}\" -mindepth 1 -maxdepth 1 -not -name c++ \\\n"
              , "    -exec cp -a {} \"$out/include/\" \\;\n"
              , "fi\n"
              , "# linux-libc-dev UAPI headers (symlink targets for asm/ headers)\n"
              , "if [ -d \"$staging/usr/lib/linux\" ]; then\n"
              , "  cp -a \"$staging/usr/lib/linux\" \"$out/lib/\"\n"
              , "fi\n"
              , "# Fix asm/ symlinks: Debian layout is usr/include/{triple}/asm/ (3 levels to usr/)\n"
              , "# but we flatten into include/asm/ (2 levels to $out), so adjust ../../../ to ../../\n"
              , "if [ -d \"$out/include/asm\" ]; then\n"
              , "  find \"$out/include/asm\" -type l | while read -r lnk; do\n"
              , "    target=\"$(readlink \"$lnk\")\"\n"
              , "    case \"$target\" in\n"
              , "      ../../../*) ln -sf \"../../${target#../../../}\" \"$lnk\" ;;\n"
              , "    esac\n"
              , "  done\n"
              , "fi\n"
              , "\n"
              , "# === Patchelf binaries ===\n"
              , "# Preserve program-header order when relocating large GCC executables.\n"
              , "# Wrappers do not make a host interpreter in an executable .real file safe.\n"
              , "echo \"=== Patching ELF binaries ===\"\n"
              , "ld_interp=\"$out/lib/${ld_linux_name}\"\n"
              , "rpath=\"$out/lib:$out/lib/gcc/${gnu_triple}/14\"\n"
              , "\n"
              , "is_elf() {\n"
              , "  [ \"$(LC_ALL=C head -c 4 \"$1\")\" = \"$(printf '\\177ELF')\" ]\n"
              , "}\n"
              , "\n"
              , "# Relocate every executable, including the internal compiler and LTO tools.\n"
              , "for bin in \"$out/bin\"/* \"$out/libexec/gcc/${gnu_triple}/14\"/*; do\n"
              , "  [ -f \"$bin\" ] || continue\n"
              , "  if \"$patchelf\" --print-interpreter \"$bin\" >/dev/null 2>&1; then\n"
              , "    echo \"  Patching: $(basename \"$bin\")\"\n"
              , "    \"$patchelf\" --no-sort --set-interpreter \"$ld_interp\" --set-rpath \"$rpath\" \"$bin\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# Relocate shared libraries and the complete gconv module closure.\n"
              , "find \"$out/lib\" -name \"*.so*\" -type f | while read -r so; do\n"
              , "  case \"$(basename \"$so\")\" in\n"
              , "    ld-linux*|ld-*.so*) continue ;;\n"
              , "  esac\n"
              , "  if is_elf \"$so\"; then\n"
              , "    library_rpath=\"$rpath\"\n"
              , "    case \"$so\" in\n"
              , "      \"$out/lib/gconv/\"*) library_rpath=\"\\$ORIGIN:$rpath\" ;;\n"
              , "    esac\n"
              , "    if \"$patchelf\" --print-interpreter \"$so\" >/dev/null 2>&1; then\n"
              , "      \"$patchelf\" --no-sort --set-interpreter \"$ld_interp\" --set-rpath \"$library_rpath\" \"$so\"\n"
              , "    else\n"
              , "      \"$patchelf\" --no-sort --set-rpath \"$library_rpath\" \"$so\"\n"
              , "    fi\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# === Wrapper scripts for gcc/g++/cpp and internal tools ===\n"
              , "# Keep the existing compiler entry points and explicit bundled-loader setup.\n"
              , "create_wrapper() {\n"
              , "  local wrapper=\"$1\" real_bin=\"$2\" extra_args=\"${3:-}\"\n"
              , "  printf '#!%s/bin/bash\\nexport LD_LIBRARY_PATH=\"%s:${LD_LIBRARY_PATH:-}\"\\nexec \"%s\" --library-path \"%s\" \"%s\" %s\"$@\"\\n' \\\n"
              , "    \"$bash\" \"$out/lib\" \"$ld_interp\" \"$out/lib:$out/lib/gcc/${gnu_triple}/14\" \\\n"
              , "    \"$real_bin\" \"$extra_args\" > \"$wrapper\"\n"
              , "  chmod +x \"$wrapper\"\n"
              , "}\n"
              , "\n"
              , "for tool in gcc g++ cc c++; do\n"
              , "  real=\"$out/bin/$tool\"\n"
              , "  [ -f \"$real\" ] || [ -L \"$real\" ] || continue\n"
              , "  # If symlink (e.g. cc -> gcc), re-target to the .real binary\n"
              , "  if [ -L \"$real\" ]; then\n"
              , "    target=\"$(readlink \"$real\")\"\n"
              , "    rm \"$real\"\n"
              , "    ln -s \"${target}.real\" \"$out/bin/${tool}.real\"\n"
              , "  else\n"
              , "    mv \"$real\" \"$out/bin/${tool}.real\"\n"
              , "  fi\n"
              , "  create_wrapper \"$real\" \"$out/bin/${tool}.real\"\n"
              , "done\n"
              , "# cpp: invoke gcc.real -E\n"
              , "rm -f \"$out/bin/cpp\"\n"
              , "create_wrapper \"$out/bin/cpp\" \"$out/bin/gcc.real\" \"-E \"\n"
              , "\n"
              , "# Wrap internal GCC executables (cc1, cc1plus, collect2, lto-wrapper)\n"
              , "# so they also run with the bundled ld-linux and glibc.\n"
              , "for f in cc1 cc1plus collect2 lto-wrapper lto1; do\n"
              , "  real=\"$out/libexec/gcc/${gnu_triple}/14/$f\"\n"
              , "  [ -f \"$real\" ] || continue\n"
              , "  mv \"$real\" \"${real}.real\"\n"
              , "  create_wrapper \"$real\" \"${real}.real\"\n"
              , "done\n"
              , "\n"
              , "# Symlink bundled binutils (ld, as, etc.) into libexec so collect2 can find them\n"
              , "for tool in ld as nm ar ranlib objcopy objdump strip; do\n"
              , "  if [ -f \"$out/bin/$tool\" ] && [ ! -e \"$out/libexec/gcc/${gnu_triple}/14/$tool\" ]; then\n"
              , "    ln -s \"$out/bin/$tool\" \"$out/libexec/gcc/${gnu_triple}/14/$tool\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# === Create GCC specs to use bundled paths ===\n"
              , "gcc_specs=\"$out/lib/gcc/${gnu_triple}/14/specs\"\n"
              , "\"$out/bin/gcc\" -dumpspecs > \"$gcc_specs\"\n"
              , "# Patch the dynamic linker path in specs\n"
              , "# Use exact path match to avoid greedy .* destroying nested spec conditionals\n"
              , "sed -i \"s|/${ld_linux_dir}/${ld_linux_name}|$out/lib/${ld_linux_name}|g\" \"$gcc_specs\"\n"
              , "# AArch64 spells the native loader with optional ABI/endian spec fragments.\n"
              , "sed -i 's|/lib/ld-linux-aarch64%{mbig-endian:_be}%{mabi=ilp32:_ilp32}.so.1|'\"$ld_interp\"'|g' \"$gcc_specs\"\n"
              , "sed -i \"s|/usr/lib/${gnu_triple}/||g; s|/lib/${gnu_triple}/||g\" \"$gcc_specs\"\n"
              , "# Direct rustc calls do not read RUSTFLAGS; compiler defaults must pair the\n"
              , "# bundled loader with its libraries even without the environment facade.\n"
              , "sed -i \"/^\\\\*link:$/ { n; s|^|-rpath $out/lib |; }\" \"$gcc_specs\"\n"
              , "\n"
              , "# === Fix linker scripts to use bundled paths ===\n"
              , "# Debian linker scripts (libc.so, libm.so) contain absolute paths like\n"
              , "# /lib/aarch64-linux-gnu/libc.so.6 which don't exist in non-Debian systems.\n"
              , "# Rewrite them to reference our bundled libraries.\n"
              , "find \"$out/lib\" -maxdepth 1 -name \"*.so\" -type f | while read -r script; do\n"
              , "  if head -1 \"$script\" | grep -q \"GNU ld script\\|/\\*\"; then\n"
              , "    sed -i \"s|/usr/lib/${gnu_triple}/||g; s|/lib/${gnu_triple}/||g; s|/${ld_linux_dir}/${ld_linux_name}|$out/lib/${ld_linux_name}|g\" \"$script\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# NSS has no module-directory setting. Use an explicit libc-relative path\n"
              , "# so an unavailable service cannot fall through to the host loader cache.\n"
              , "for service in compat dns files hesiod; do\n"
              , "  test -f \"$out/lib/libnss_${service}.so.2\"\n"
              , "  ln -s \"libnss_${service}.so.2\" \"$out/lib/${service}.2\"\n"
              , "done\n"
              , "\n"
              , "# Build with this provider's own ABI inputs. Shared code contains no binary\n"
              , "# or compiler dependency; Debian-specific relocation remains here.\n"
              , "source \"$glibc_support/build-initializer.bash\"\n"
              , "glibc_runtime_build_initializer \"$glibc_support/initialize.c\" \\\n"
              , "  \"$out/lib/librubble-glibc-paths.so\" \"$out/bin/gcc\" \\\n"
              , "  -B\"$out/lib/gcc/${gnu_triple}/14\" \\\n"
              , "  -nostdinc -isystem \"$out/lib/gcc/${gnu_triple}/14/include\" -isystem \"$out/include\" \\\n"
              , "  -L\"$out/lib\" -L\"$out/lib/gcc/${gnu_triple}/14\"\n"
              , "\"$patchelf\" --no-sort --set-rpath '$ORIGIN' \"$out/lib/librubble-glibc-paths.so\"\n"
              , "\n"
              , "# GCONV_PATH appends glibc's compiled default directory. Disable that host\n"
              , "# directory/cache as well. These fixed-version, NUL-terminated data strings\n"
              , "# are replaced in place; reject different upstream layouts instead of\n"
              , "# silently patching an unknown binary. /dev/null cannot contain modules.\n"
              , "perl - \"$out/lib/libc.so.6\" \"$gnu_triple\" <<'EOF'\n"
              , "use strict;\n"
              , "use warnings;\n"
              , "my ($path, $triple) = @ARGV;\n"
              , "open my $input, '<:raw', $path or die \"$path: $!\";\n"
              , "local $/;\n"
              , "my $data = <$input>;\n"
              , "close $input or die \"$path: $!\";\n"
              , "my $size = length $data;\n"
              , "for my $replacement (\n"
              , "  [\"libnss_%s.so%s\\0\", '$ORIGIN/%s%s' . \"\\0\"],\n"
              , "  [\"/usr/lib/$triple/gconv/gconv-modules.cache\\0\", \"/dev/null/gconv-cache\\0\"],\n"
              , "  [\"/usr/lib/$triple/gconv\\0\", \"/dev/null/gconv\\0\"],\n"
              , ") {\n"
              , "  my ($old, $new) = @$replacement;\n"
              , "  my $offset = index($data, $old);\n"
              , "  die \"Expected one glibc path pattern: $old\" if $offset < 0 || rindex($data, $old) != $offset;\n"
              , "  die \"glibc replacement does not fit\" if length($new) > length($old);\n"
              , "  my $padded = $new . \"\\0\" x (length($old) - length($new));\n"
              , "  substr($data, $offset, length($old), $padded);\n"
              , "  die \"glibc replacement failed\" if index($data, $old) >= 0 || substr($data, $offset, length($padded)) ne $padded;\n"
              , "}\n"
              , "die \"glibc size changed\" if length($data) != $size;\n"
              , "open my $output, '>:raw', $path or die \"$path: $!\";\n"
              , "print {$output} $data or die \"$path: $!\";\n"
              , "close $output or die \"$path: $!\";\n"
              , "EOF\n"
              , "\"$patchelf\" --no-sort --add-needed '$ORIGIN/librubble-glibc-paths.so' \"$out/lib/libc.so.6\"\n"
              , "\n"
              , "# === Verification ===\n"
              , "echo \"\"\n"
              , "echo \"=== GCC (glibc) toolchain assembled ===\"\n"
              , "\"$out/bin/gcc\" --version\n"
              , "\n"
              , "echo \"Testing gcc can find cc1...\"\n"
              , "\"$out/bin/gcc\" -print-search-dirs\n"
              , "test \"$(readlink -f \"$(\"$out/bin/gcc\" -print-prog-name=cc1)\")\" = \"$out/libexec/gcc/${gnu_triple}/14/cc1\"\n"
              , "\n"
              , "echo \"Testing C compilation...\"\n"
              , "test_source=\"${TMP}/test_gcc_glibc.c\"\n"
              , "test_binary=\"${TMP}/test_gcc_glibc\"\n"
              , "printf '#include <stdio.h>\\nint main() { printf(\"Hello!\\\\n\"); return 0; }\\n' > \"$test_source\"\n"
              , "\"$out/bin/gcc\" -B\"$out/lib/gcc/${gnu_triple}/14\" \\\n"
              , "  -nostdinc -isystem \"$out/lib/gcc/${gnu_triple}/14/include\" -isystem \"$out/include\" \\\n"
              , "  -L\"$out/lib\" -L\"$out/lib/gcc/${gnu_triple}/14\" \\\n"
              , "  \"$test_source\" -o \"$test_binary\"\n"
              , "\"$test_binary\"\n"
              , "test \"$(\"$patchelf\" --print-interpreter \"$test_binary\")\" = \"$ld_interp\"\n"
              , "test \"$(\"$patchelf\" --print-rpath \"$test_binary\")\" = \"$out/lib\"\n"
              , "\n"
              , "echo \"Testing C++ compilation and runtime libraries...\"\n"
              , "printf '#include <iostream>\\n#include <vector>\\nint main() { std::vector<int> v{14}; std::cout << v.at(0) << \"\\\\n\"; }\\n' > \"$test_source.cpp\"\n"
              , "\"$out/bin/g++\" -B\"$out/lib/gcc/${gnu_triple}/14\" \\\n"
              , "  -nostdinc -nostdinc++ \\\n"
              , "  -isystem \"$out/include/c++/14\" -isystem \"$out/include/c++/14/${gnu_triple}\" \\\n"
              , "  -isystem \"$out/lib/gcc/${gnu_triple}/14/include\" -isystem \"$out/include\" \\\n"
              , "  -L\"$out/lib\" -L\"$out/lib/gcc/${gnu_triple}/14\" \\\n"
              , "  -flto \"$test_source.cpp\" -o \"$test_binary.cpp\"\n"
              , "test \"$(\"$test_binary.cpp\")\" = 14\n"
              , "test \"$(\"$patchelf\" --print-interpreter \"$test_binary.cpp\")\" = \"$ld_interp\"\n"
              , "for tool in cc1 cc1plus collect2 lto-wrapper lto1; do\n"
              , "  test \"$(\"$patchelf\" --print-interpreter \"$out/libexec/gcc/${gnu_triple}/14/$tool.real\")\" = \"$ld_interp\"\n"
              , "  test \"$(\"$patchelf\" --print-rpath \"$out/libexec/gcc/${gnu_triple}/14/$tool.real\")\" = \"$rpath\"\n"
              , "done\n"
              , "rm -f \"$test_source.cpp\" \"$test_binary.cpp\"\n"
              , "rm -f \"$test_source\" \"$test_binary\"\n"
              , "\n"
              , "echo \"\"\n"
              , "echo \"Key binaries:\"\n"
              , "ls -la \"$out/bin/gcc\" \"$out/bin/g++\" \"$out/bin/ld\" \"$out/bin/ar\"\n"
              , "readlink -f \"$out/lib/${ld_linux_name}\" || ls -la \"$out/lib/\"*ld-linux*\n"
              , "\n"
              , "# Behavior, including glibc's dynamic module paths, is a shared contract.\n"
              , "source \"$glibc_support/audit.bash\"\n"
              , "declare -A glibc_runtime_tools=()\n"
              , "for tool in env mkdir realpath sha256sum uname; do\n"
              , "  glibc_runtime_tools[$tool]=\"$bootstrap/bin/$tool\"\n"
              , "done\n"
              , "glibc_runtime_tool() { local tool=$1; shift; \"${glibc_runtime_tools[$tool]}\" \"$@\"; }\n"
              , "glibc_runtime_audit \"$glibc_support\" \\\n"
              , "  --target \"$out\" --allow-output \"$out\" \\\n"
              , "  --loader \"$out/lib/$ld_linux_name\" --library-dir \"$out/lib\" \\\n"
              , "  --nss-module \"$out/lib/libnss_hesiod.so.2\" \\\n"
              , "  --nss-module \"$out/lib/libnss_dns.so.2\" \\\n"
              , "  --cc \"$out/bin/gcc\" --compiler-path \"$out/bin\" \\\n"
              , "  --cc-arg \"-B$out/lib/gcc/$gnu_triple/14\" \\\n"
              , "  --cc-arg -nostdinc --cc-arg -isystem --cc-arg \"$out/lib/gcc/$gnu_triple/14/include\" \\\n"
              , "  --cc-arg -isystem --cc-arg \"$out/include\" \\\n"
              , "  --cc-arg \"-L$out/lib\" --cc-arg \"-L$out/lib/gcc/$gnu_triple/14\" \\\n"
              , "  --patchelf \"$patchelf\" --output-dir \"$TMP/glibc-runtime-audit\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  }
}
