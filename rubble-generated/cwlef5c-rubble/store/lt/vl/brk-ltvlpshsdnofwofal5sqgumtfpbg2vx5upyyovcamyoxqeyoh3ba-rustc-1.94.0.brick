  , "pc6egjgq2ba3z3wnas2zd4lygye7s6qa34rdem6tqt2oxizk3kfa-gawk":
      { "id": "pc6egjgq2ba3z3wnas2zd4lygye7s6qa34rdem6tqt2oxizk3kfa-gawk"
      , "name": "gawk"
      , "platform": "aarch64-linux"
      , "build_platform": "aarch64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "cndex52rgwiybhxcbkpry2isc55dz3hrc5lblmzr3xyeilghixda-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "65xn763kfhf7ye2ax5rr3hjotrij3qjagkddvfhqarwrt2a7mnha-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "5td6qvq3hkwnfc5vqh6lcuv5xlk5yh26d2esafb7byxkpwl6klua-gawk-5.3.1-r0.apk"
          , "alias": "src"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "echo \"Extracting gawk package...\"\n"
              , "tar -xzf \"$src\" 2>/dev/null || true\n"
              , "\n"
              , "# out is the gawk binary itself\n"
              , "cp usr/bin/gawk \"$out\"\n"
              , "chmod +x \"$out\"\n"
              , "\n"
              , "# Patch ELF binary to use musl interpreter from runtime home\n"
              , "\"$patchelf\" --set-interpreter \"$ld_musl\" \"$out\"\n"
              , "\n"
              , "# bin directory with symlinks for PATH integration\n"
              , "mkdir -p \"$bin\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/gawk\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/awk\"\n"
              , "\n"
              , "# Verify\n"
              , "echo \"\"\n"
              , "echo \"=== Verifying GNU gawk installation ===\"\n"
              , "\"$out\" --version | { head -1; cat > /dev/null; }"
              ]
            , "format": "text"
            }
          }
        ]
      }
