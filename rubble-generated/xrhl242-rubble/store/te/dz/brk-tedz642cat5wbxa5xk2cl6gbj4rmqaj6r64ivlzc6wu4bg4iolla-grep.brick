{ "id": "tedz642cat5wbxa5xk2cl6gbj4rmqaj6r64ivlzc6wu4bg4iolla-grep"
, "name": "grep"
, "platform": "aarch64-linux"
, "build_platform": "aarch64-linux"
, "rubble_home": "/var/lib/rubble"
, "inputs": [
    { "brick": "esiyaxnxz3qbqhmjp3kjdfummyfpbmzr6eoub362jjpavkrlzyiq-pcre2-10.43-r0.apk"
    , "alias": "pcre2_apk"
    , "transitive": "false"
    }
  , { "brick": "cndex52rgwiybhxcbkpry2isc55dz3hrc5lblmzr3xyeilghixda-patchelf"
    , "alias": "patchelf"
    , "transitive": "false"
    }
  , { "brick": "65xn763kfhf7ye2ax5rr3hjotrij3qjagkddvfhqarwrt2a7mnha-ld-musl.so"
    , "alias": "ld_musl"
    , "transitive": "true"
    }
  , { "brick": "ja2gawpefozngsdbmzs5n2a66ujesjats2qcq7homnixclj6iqrq-grep-3.11-r0.apk"
    , "alias": "grep_apk"
    , "transitive": "false"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  , { "name": "bin" }
  , { "name": "lib" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "echo \"Extracting packages...\"\n"
        , "mkdir -p grep-extract pcre2-extract\n"
        , "tar -xzf \"$grep_apk\" -C grep-extract 2>/dev/null || true\n"
        , "tar -xzf \"$pcre2_apk\" -C pcre2-extract 2>/dev/null || true\n"
        , "\n"
        , "# Copy pcre2 shared libraries\n"
        , "mkdir -p \"$lib\"\n"
        , "find pcre2-extract -name \"*.so*\" -type f -exec cp -a {} \"$lib/\" \\; 2>/dev/null || true\n"
        , "find pcre2-extract -name \"*.so*\" -type l -exec cp -a {} \"$lib/\" \\; 2>/dev/null || true\n"
        , "\n"
        , "# out is the grep binary itself\n"
        , "cp grep-extract/bin/grep \"$out\"\n"
        , "chmod +x \"$out\"\n"
        , "\n"
        , "# Patch ELF binary to use musl interpreter from runtime home\n"
        , "\"$patchelf\" --set-interpreter \"$ld_musl\" --set-rpath \"$lib\" \"$out\"\n"
        , "\n"
        , "# bin directory with symlinks for PATH integration\n"
        , "mkdir -p \"$bin\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/grep\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/egrep\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/fgrep\"\n"
        , "\n"
        , "# Verify\n"
        , "echo \"\"\n"
        , "echo \"=== Verifying GNU grep installation ===\"\n"
        , "\"$out\" --version 2>&1 | head -1 || true"
        ]
      , "format": "text"
      }
    }
  ]
, "inventory": {
    "esiyaxnxz3qbqhmjp3kjdfummyfpbmzr6eoub362jjpavkrlzyiq-pcre2-10.43-r0.apk":
      { "id": "esiyaxnxz3qbqhmjp3kjdfummyfpbmzr6eoub362jjpavkrlzyiq-pcre2-10.43-r0.apk"
