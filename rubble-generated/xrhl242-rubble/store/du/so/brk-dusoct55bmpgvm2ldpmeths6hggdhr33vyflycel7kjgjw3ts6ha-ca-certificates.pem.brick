{ "id": "dusoct55bmpgvm2ldpmeths6hggdhr33vyflycel7kjgjw3ts6ha-ca-certificates.pem"
, "name": "ca-certificates.pem"
, "platform": "aarch64-linux"
, "rubble_home": "/var/lib/rubble"
, "inputs": [
    { "brick": "mf2zom7awa7olgagfl3ruhqhflotm3vdkxcrpruwdsofqnugvraa-ca-certificates-bundle-20260413-r0.apk"
    , "alias": "src"
    , "transitive": "false"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "echo \"Extracting CA certificates...\"\n"
        , "tar -xzf \"$src\" 2>/dev/null || true\n"
        , "\n"
        , "cp etc/ssl/certs/ca-certificates.crt \"$out\"\n"
        , "\n"
        , "echo \"\"\n"
        , "echo \"=== CA certificates ===\"\n"
        , "wc -l < \"$out\""
        ]
      , "format": "text"
      }
    }
  ]
, "inventory": {
    "mf2zom7awa7olgagfl3ruhqhflotm3vdkxcrpruwdsofqnugvraa-ca-certificates-bundle-20260413-r0.apk":
      { "id": "mf2zom7awa7olgagfl3ruhqhflotm3vdkxcrpruwdsofqnugvraa-ca-certificates-bundle-20260413-r0.apk"
      , "name": "ca-certificates-bundle-20260413-r0.apk"
      , "src": {
          "url": "https://dl-cdn.alpinelinux.org/alpine/v3.21/main/aarch64/ca-certificates-bundle-20260413-r0.apk"
        , "checksum": "sha256:a32594a90a2667703eec3e11162c2945d4cd89c9aff7bb556240bfd9be5cd6b2"
        }
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "__rubble_skip_src_split__"
          , "value": "true"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "cp -ar \"$src\" \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  }
}
