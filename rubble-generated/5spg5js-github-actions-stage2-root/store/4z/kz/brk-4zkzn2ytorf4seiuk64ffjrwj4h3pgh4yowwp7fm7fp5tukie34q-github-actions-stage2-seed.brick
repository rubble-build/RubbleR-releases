{ "id": "4zkzn2ytorf4seiuk64ffjrwj4h3pgh4yowwp7fm7fp5tukie34q-github-actions-stage2-seed"
, "name": "github-actions-stage2-seed"
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "printf 'seed\\n' > \"$out\""
        ]
      , "format": "text"
      }
    }
  ]
}
