  , "e36cngjqwawgbxg2kjpzk4j2oetoiqgauw3mvvnv576ah46xmsfq-sqlite-libs-3.48.0-r4.apk":
      { "id": "e36cngjqwawgbxg2kjpzk4j2oetoiqgauw3mvvnv576ah46xmsfq-sqlite-libs-3.48.0-r4.apk"
      , "name": "sqlite-libs-3.48.0-r4.apk"
