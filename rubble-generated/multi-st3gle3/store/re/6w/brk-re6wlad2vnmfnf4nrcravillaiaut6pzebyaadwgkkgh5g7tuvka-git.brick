{ "id": "re6wlad2vnmfnf4nrcravillaiaut6pzebyaadwgkkgh5g7tuvka-git"
, "name": "git"
, "platform": "aarch64-linux"
, "rubble_home": "/var/lib/rubble"
, "inputs": [
    { "brick": "5vexncx3cian4rymupdaft3bwnvswvrzp6pcxohuilbll3lii53a-zstd-libs-1.5.6-r2.apk"
    , "alias": "zstd_libs_apk"
    , "transitive": "false"
    }
  , { "brick": "txmznhwijz6pz7m652w5pqqlymsnvboo2rsvqqwp7jprcfm6cw4a-zlib-1.3.2-r1.apk"
    , "alias": "zlib_apk"
    , "transitive": "false"
    }
  , { "brick": "gpd75vrjncv57fv3fzdfuoagqwgyqjwuizvdth2pdg7hv2q4lv5a-rubble-script-shebang"
    , "transitive": "false"
