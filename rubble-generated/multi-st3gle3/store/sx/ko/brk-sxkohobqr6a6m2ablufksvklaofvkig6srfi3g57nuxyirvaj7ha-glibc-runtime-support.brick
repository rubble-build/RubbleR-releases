  , "4rml266dvj3lfnykptfshuossktxpdkis26uwp2ebjffjlgcmmra-coreutils":
      { "id": "4rml266dvj3lfnykptfshuossktxpdkis26uwp2ebjffjlgcmmra-coreutils"
      , "name": "coreutils"
      , "platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "2dmy2py5hdqkwaqkgx42iababq4z232di4ts36pnm5esucm3ywma-utmps-libs-0.1.2.3-r2.apk"
          , "alias": "utmps_libs_apk"
          , "transitive": "false"
          }
        , { "brick": "lkdcyamlgiacwnr5imp3lw4ieiybrpiqccyf5sxnatnjwd5b3mqa-skalibs-libs-2.14.3.0-r0.apk"
          , "alias": "skalibs_libs_apk"
          , "transitive": "false"
          }
        , { "brick": "cmdaozrcvaymmdfw3jodg7rrc4qwmaqyx6q3jj6u6nsie32hvdxq-publish-output-directory"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$script\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "hdqxqr4vfc2rgc3rj5ywrpaykxqly77eix55tldf7wd7nqimpqfa-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "bqqueq4hb5vdjgdpm5xn2bpxiay234jhkblmh6d2yjdmd2ncxb2q-libcrypto3-3.3.7-r2.apk"
          , "alias": "libcrypto_apk"
          , "transitive": "false"
          }
        , { "brick": "g5kws3kqcm624hn6iai7emgexyefsmvzne6vkkjepjynecaixwka-libattr-2.5.2-r2.apk"
          , "alias": "libattr_apk"
          , "transitive": "false"
          }
        , { "brick": "z3xhjdr5it75lq5iwals4toaklhutksbdphbucgwhtgqhxz32k6q-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "6togc2j5xih6r5lrdoyn445oyyknfdytk6vcg5hrfsgc2hlgk6pq-coreutils-sha512sum-9.5-r2.apk"
          , "alias": "coreutils_sha512sum_apk"
          , "transitive": "false"
          }
        , { "brick": "el5x6jtrgmj2ur2yrzw322uhsjmbhn5yrocuvgpacoemkg64pvnq-coreutils-fmt-9.5-r2.apk"
          , "alias": "coreutils_fmt_apk"
          , "transitive": "false"
          }
        , { "brick": "lbqljp2qnjc3lqq3z4cfzjji23m4ifkssgngl2fjn4ko44ymiyoa-coreutils-env-9.5-r2.apk"
          , "alias": "coreutils_env_apk"
          , "transitive": "false"
          }
        , { "brick": "ml6kgq7lqo3ixjammk6mzn4rikciq3cz72gvsczixoig3lafebua-coreutils-9.5-r2.apk"
          , "alias": "coreutils_apk"
          , "transitive": "false"
          }
        , { "brick": "tfjxrh45sf2nytjwmw6picosxhkrbtwiuke6d3wujuptb35jb55a-collect-shared-libraries"
          , "alias": "collect_libraries"
          , "transitive": "false"
          }
        , { "brick": "pbjeeclqm4u6qpcwajhwup422gxqlsxugtxchb3ehilwprktypna-acl-libs-2.3.2-r1.apk"
          , "alias": "acl_libs_apk"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        , { "name": "lib" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p \"$out/bin\" \"$out/lib\" extract\n"
              , "\n"
              , "for apk in \"$coreutils_apk\" \"$coreutils_env_apk\" \"$coreutils_fmt_apk\" \\\n"
              , "           \"$coreutils_sha512sum_apk\" \"$acl_libs_apk\" \"$libattr_apk\" \\\n"
              , "           \"$utmps_libs_apk\" \"$skalibs_libs_apk\" \"$libcrypto_apk\"; do\n"
              , "  tar -xzf \"$apk\" -C extract 2>/dev/null || true\n"
              , "done\n"
              , "\n"
              , "# Copy shared libraries (acl, attr, utmps, skalibs, libcrypto)\n"
              , "\"$collect_libraries\" \"$out/lib\" recursive ignore extract\n"
              , "\n"
              , "# Copy the multicall binary\n"
              , "cp extract/usr/bin/coreutils \"$out/bin/coreutils\"\n"
              , "chmod +x \"$out/bin/coreutils\"\n"
              , "\n"
              , "# Copy sub-package binaries (env, fmt, sha512sum are separate ELF binaries)\n"
              , "for cmd in env fmt sha512sum; do\n"
              , "  if [ -f \"extract/usr/bin/$cmd\" ] && [ ! -L \"extract/usr/bin/$cmd\" ]; then\n"
              , "    cp \"extract/usr/bin/$cmd\" \"$out/bin/${cmd}\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# Patch ELF binaries to use musl interpreter from runtime home\n"
              , "for f in \"$out/bin/\"*; do\n"
              , "  if [ -f \"$f\" ] && [ ! -L \"$f\" ]; then\n"
              , "    if \"$patchelf\" --print-interpreter \"$f\" >/dev/null 2>&1; then\n"
              , "      \"$patchelf\" --set-interpreter \"$ld_musl\" --set-rpath \"$out/lib\" \"$f\"\n"
              , "    fi\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# Create symlinks for all coreutils commands pointing to the multicall binary\n"
              , "for cmd in \\\n"
              , "  base64 basename basenc b2sum base32 cat chcon chgrp chmod chown chroot \\\n"
              , "  cksum comm cp csplit cut date dd df dir dircolors dirname du echo \\\n"
              , "  expand expr factor false fold head hostid id install join kill link \\\n"
              , "  ln logname ls md5sum mkdir mkfifo mknod mktemp mv nice nl nohup \\\n"
              , "  nproc numfmt od paste pathchk pinky pr printenv printf ptx pwd \\\n"
              , "  readlink realpath rm rmdir runcon seq sha1sum sha224sum sha256sum \\\n"
              , "  sha384sum shred shuf sleep sort split stat stdbuf stty sum \\\n"
              , "  sync tac tail tee test timeout touch tr true truncate tsort tty \\\n"
              , "  uname unexpand uniq unlink uptime users vdir wc who whoami yes\n"
              , "do\n"
              , "  if [ ! -e \"$out/bin/$cmd\" ]; then\n"
              , "    ln -s coreutils \"$out/bin/$cmd\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "printf 'b\\0a\\0' | \"$out/bin/sort\" -z > \"$TMP/sorted\"\n"
              , "mapfile -d '' -t values < \"$TMP/sorted\"\n"
              , "test \"${#values[@]}\" -eq 2\n"
              , "test \"${values[0]}\" = a\n"
              , "test \"${values[1]}\" = b\n"
              , "rm -f \"$TMP/sorted\""
              ]
            , "format": "text"
            }
          }
        , { "shell": {
              "value": [
                "publish_output_directory \"$out/bin\" \"$bin\"\n"
              , "publish_output_directory \"$out/lib\" \"$lib\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "x7qxtfi2npyewp64xdyhckglv5hrtv2qiahanhiw5vjsyqh7hxlq-RubbleR.git.partial":
      { "id": "x7qxtfi2npyewp64xdyhckglv5hrtv2qiahanhiw5vjsyqh7hxlq-RubbleR.git.partial"
      , "name": "RubbleR.git.partial"
      , "src": {
          "repo": "https://github.com/chaifeng/RubbleR.git"
        , "commit": "f60ff1343894323ca009ed60576963110393c7c3"
        , "paths": [
            "./scripts/glibc-runtime-support/"
          ]
        }
      , "inputs": [
          { "brick": "bylu3g6upxzxamnew7hetpin3g47bzrxbhej2ejmeoeh57kg3jia-rubble-src-checkout"
          , "alias": "rubble_src_checkout"
          , "transitive": "true"
          }
        , { "brick": "4x2uexqjoqs5unyb4fxpdus3ctebmhvqnuruhalsl5rdwt3k6naa-rubble-canonical-script"
          , "alias": "rubble_canonical_script"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "RUBBLE_SRC_FETCH_MODE all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "__rubble_skip_src_split__"
          , "value": "true"
          }
        ]
      , "outputs": [
          { "name": "dir" }
        , { "name": "archive__impure__" }
        , { "name": "script" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -v \"$dir\"\n"
              , "echo \"${brick[src::commit]}\" > \"${dir}/.rubble-deferred\"\n"
              , "\n"
              , "mkdir -v \"$archive\"\n"
              , "echo \"${brick[src::commit]}\" > \"${archive}/.rubble-deferred\"\n"
              , "\n"
              , "source \"${rubble_canonical_script[script]}\"\n"
              , "\n"
              , "printf -v __rubble_source_repo '%q' \"${brick[src::remote]}\"\n"
              , "printf -v __rubble_source_commit '%q' \"${brick[src::commit]}\"\n"
              , "printf -v __rubble_source_paths '%q' \"${brick[src::paths]}\"\n"
              , "rubble_canonical_script << __EOF_SCRIPT_207__ | tee \"$script\"\n"
              , "set -x\n"
              , "\n"
              , "repo=${__rubble_source_repo}\n"
              , "commit=${__rubble_source_commit}\n"
              , "paths=${__rubble_source_paths}\n"
              , "gitRepoCredential=\"\"\n"
              , "src_archive=\"$archive\"\n"
              , "inner_path=\"\"\n"
              , "deferred_marker=\".rubble-deferred\"\n"
              , "\n"
              , "if [[ -z \"\\${repo:-}\" || -z \"\\${commit:-}\" ]]; then\n"
              , "    echo \"Error: Missing repo or commit information\" >&2\n"
              , "    exit 1\n"
              , "fi\n"
              , "\n"
              , "source \"${rubble_src_checkout}\" \"\\${1:-\\${dir}}\"\n"
              , "__EOF_SCRIPT_207__"
              ]
            , "format": "text"
            }
          }
        ]
      }
  }
}
