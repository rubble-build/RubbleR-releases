{ "id": "n6475wvske6j4dxfuhhbk6gplesuoo6c3tzd2p4bk5cciypjdqna-ca-certificates.pem"
, "name": "ca-certificates.pem"
, "platform": "x86_64-linux"
, "rubble_home": "/var/lib/rubble"
, "inputs": [
    { "brick": "kinr2ibs6py4vcjwsdsh6fawg2nbzzyj6vptydryyosyxaijodeq-ca-certificates-bundle-20260413-r0.apk"
    , "alias": "src"
    , "transitive": "false"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "echo \"Extracting CA certificates...\"\n"
        , "tar -xzf \"$src\" 2>/dev/null || true\n"
        , "\n"
        , "cp etc/ssl/certs/ca-certificates.crt \"$out\"\n"
        , "\n"
        , "echo \"\"\n"
        , "echo \"=== CA certificates ===\"\n"
        , "wc -l < \"$out\""
        ]
      , "format": "text"
      }
    }
  ]
, "inventory": {
    "kinr2ibs6py4vcjwsdsh6fawg2nbzzyj6vptydryyosyxaijodeq-ca-certificates-bundle-20260413-r0.apk":
      { "id": "kinr2ibs6py4vcjwsdsh6fawg2nbzzyj6vptydryyosyxaijodeq-ca-certificates-bundle-20260413-r0.apk"
      , "name": "ca-certificates-bundle-20260413-r0.apk"
      , "src": {
          "url": "https://dl-cdn.alpinelinux.org/alpine/v3.21/main/x86_64/ca-certificates-bundle-20260413-r0.apk"
        , "checksum": "sha256:79bcf4fd3818e37cb7760033abb82387042c15cd7675f814d4c25e95d6ff24aa"
        }
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "__rubble_skip_src_split__"
          , "value": "true"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "cp -ar \"$src\" \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  }
}
