    , "alias": "patchelf"
    , "transitive": "false"
    }
  , { "brick": "3sb5itkqd6r7oxf5jlyiwmezzwtf7wd5ef5lhlzp5obo44jnr3ha-musl-dev-1.2.5-r11.apk"
    , "alias": "musl_dev_apk"
    , "transitive": "false"
    }
  , { "brick": "cq5rf2c3o57f72h3wxj4aav6a3a6dvq4jdgbq4wqj27du7n73gma-mpfr4-4.2.1-r0.apk"
    , "alias": "mpfr_apk"
