              , "\n"
              , "cp -a \"lib/$musl_interpreter\" \"$out\"\n"
              , "\n"
              , "echo \"\"\n"
              , "echo \"=== musl interpreter ===\"\n"
              , "test -s \"$out\"\n"
              , "echo \"$out\"\n"
              , "ls -l \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "cca6hpdxtvtjn3hkbljrizdlu2cpldgeodds67hxlcf2nhclfc5a-m4":
      { "id": "cca6hpdxtvtjn3hkbljrizdlu2cpldgeodds67hxlcf2nhclfc5a-m4"
      , "name": "m4"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "teieaxxyjdoyw4gqby5r4ywgrstjp3t6ui4dxasa6j7ba34arziq-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "worm5jasvkdhvnlzzohf5oauc7lqf6dvcl63d5owgyl3cxnyq2ka-m4-1.4.19-r3.apk"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "zkiff2cic77r6rxw3quhxg6gu4rznq4omwpz5tui7zwbvlqj6mbq-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "echo \"Extracting m4 package...\"\n"
              , "tar -xzf \"$src\" 2>/dev/null || true\n"
              , "\n"
              , "# out is the m4 binary itself\n"
              , "cp usr/bin/m4 \"$out\"\n"
              , "chmod +x \"$out\"\n"
              , "\n"
              , "# Patch ELF binary to use musl interpreter from runtime home\n"
              , "\"$patchelf\" --set-interpreter \"$ld_musl\" \"$out\"\n"
              , "\n"
              , "# bin directory with symlink for PATH integration\n"
              , "mkdir -p \"$bin\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/m4\"\n"
              , "\n"
              , "# Verify\n"
              , "echo \"\"\n"
              , "echo \"=== Verifying GNU m4 installation ===\"\n"
              , "\"$out\" --version | { head -1; cat > /dev/null; }"
              ]
            , "format": "text"
            }
          }
        ]
      }
