{ "id": "vjkfcfgkm77x6m2ulurl7euwz2rnspl5pijijlqq5wmu4fcyn6la-unzip"
, "name": "unzip"
, "platform": "x86_64-linux"
, "build_platform": "x86_64-linux"
, "rubble_home": "/var/lib/rubble"
, "inputs": [
    { "brick": "7umiran6fdfmpi7d6wrjpaw2ezhzoksyxq4khdyf3pvexwt7sbba-unzip-6.0-r15.apk"
    , "alias": "src"
    , "transitive": "false"
    }
  , { "brick": "teieaxxyjdoyw4gqby5r4ywgrstjp3t6ui4dxasa6j7ba34arziq-patchelf"
    , "alias": "patchelf"
    , "transitive": "false"
    }
  , { "brick": "zkiff2cic77r6rxw3quhxg6gu4rznq4omwpz5tui7zwbvlqj6mbq-ld-musl.so"
    , "alias": "ld_musl"
    , "transitive": "true"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  , { "name": "bin" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "tar -xzf \"$src\" 2>/dev/null || true\n"
        , "\n"
        , "# out is the unzip binary itself\n"
        , "cp usr/bin/unzip \"$out\"\n"
        , "chmod +x \"$out\"\n"
        , "\n"
        , "# Patch ELF binary to use musl interpreter from runtime home\n"
        , "\"$patchelf\" --set-interpreter \"$ld_musl\" \"$out\"\n"
        , "\n"
        , "# bin directory with symlink for PATH integration\n"
        , "mkdir -p \"$bin\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/unzip\"\n"
        , "\n"
        , "# Verify\n"
        , "echo \"\"\n"
        , "echo \"=== Verifying unzip installation ===\"\n"
        , "\"$out\" -v 2>&1 | head -1 || true"
        ]
      , "format": "text"
      }
    }
  ]
, "inventory": {
    "7umiran6fdfmpi7d6wrjpaw2ezhzoksyxq4khdyf3pvexwt7sbba-unzip-6.0-r15.apk":
      { "id": "7umiran6fdfmpi7d6wrjpaw2ezhzoksyxq4khdyf3pvexwt7sbba-unzip-6.0-r15.apk"
      , "name": "unzip-6.0-r15.apk"
      , "src": {
          "url": "https://dl-cdn.alpinelinux.org/alpine/v3.21/main/x86_64/unzip-6.0-r15.apk"
        , "checksum": "sha256:c830df207dd09ee0370f4c5e12f39ae018a0a7daa95f3316e4d79bd0fbfa75c9"
        }
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "__rubble_skip_src_split__"
          , "value": "true"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "cp -ar \"$src\" \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
