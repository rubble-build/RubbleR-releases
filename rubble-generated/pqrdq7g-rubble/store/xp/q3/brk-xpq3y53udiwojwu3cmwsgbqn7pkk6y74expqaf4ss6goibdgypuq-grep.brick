  , "teieaxxyjdoyw4gqby5r4ywgrstjp3t6ui4dxasa6j7ba34arziq-patchelf":
      { "id": "teieaxxyjdoyw4gqby5r4ywgrstjp3t6ui4dxasa6j7ba34arziq-patchelf"
      , "name": "patchelf"
      , "platform": "x86_64-linux"
      , "inputs": [
          { "brick": "srku7z24wv4w4tgv6eu4fa6qbu5agbdkyenupgctdee7bxpivfaq-patchelf-0.18.0-x86_64.tar.gz"
          , "alias": "src"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "bin" }
        , { "name": "share" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar -xvf \"$src\"\n"
              , "mv bin/patchelf \"$bin\"\n"
              , "mv share \"$share\"\n"
              , "\"$bin\" --version"
              ]
            , "format": "text"
            }
          }
        ]
      }
