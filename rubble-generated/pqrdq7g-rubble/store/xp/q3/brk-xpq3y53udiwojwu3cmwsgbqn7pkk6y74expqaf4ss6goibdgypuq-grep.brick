{ "id": "xpq3y53udiwojwu3cmwsgbqn7pkk6y74expqaf4ss6goibdgypuq-grep"
, "name": "grep"
, "platform": "x86_64-linux"
, "build_platform": "x86_64-linux"
, "rubble_home": "/var/lib/rubble"
, "inputs": [
    { "brick": "4wgosppvhjnle5yycvfbbhegkyo2lud5migy65e2r7cdpemghvvq-pcre2-10.43-r0.apk"
    , "alias": "pcre2_apk"
    , "transitive": "false"
    }
  , { "brick": "teieaxxyjdoyw4gqby5r4ywgrstjp3t6ui4dxasa6j7ba34arziq-patchelf"
    , "alias": "patchelf"
    , "transitive": "false"
    }
  , { "brick": "zkiff2cic77r6rxw3quhxg6gu4rznq4omwpz5tui7zwbvlqj6mbq-ld-musl.so"
    , "alias": "ld_musl"
    , "transitive": "true"
    }
  , { "brick": "c3s55lkr27hhdooe7wnsqioryihjeapnony7fjg3czqtayimmqpa-grep-3.11-r0.apk"
    , "alias": "grep_apk"
    , "transitive": "false"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  , { "name": "bin" }
  , { "name": "lib" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "echo \"Extracting packages...\"\n"
        , "mkdir -p grep-extract pcre2-extract\n"
        , "tar -xzf \"$grep_apk\" -C grep-extract 2>/dev/null || true\n"
        , "tar -xzf \"$pcre2_apk\" -C pcre2-extract 2>/dev/null || true\n"
        , "\n"
        , "# Copy pcre2 shared libraries\n"
        , "mkdir -p \"$lib\"\n"
        , "find pcre2-extract -name \"*.so*\" -type f -exec cp -a {} \"$lib/\" \\; 2>/dev/null || true\n"
        , "find pcre2-extract -name \"*.so*\" -type l -exec cp -a {} \"$lib/\" \\; 2>/dev/null || true\n"
        , "\n"
        , "# out is the grep binary itself\n"
        , "cp grep-extract/bin/grep \"$out\"\n"
        , "chmod +x \"$out\"\n"
        , "\n"
        , "# Patch ELF binary to use musl interpreter from runtime home\n"
        , "\"$patchelf\" --set-interpreter \"$ld_musl\" --set-rpath \"$lib\" \"$out\"\n"
        , "\n"
        , "# bin directory with symlinks for PATH integration\n"
        , "mkdir -p \"$bin\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/grep\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/egrep\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/fgrep\"\n"
        , "\n"
        , "# Verify\n"
        , "echo \"\"\n"
        , "echo \"=== Verifying GNU grep installation ===\"\n"
        , "\"$out\" --version 2>&1 | head -1 || true"
        ]
      , "format": "text"
      }
    }
  ]
, "inventory": {
    "4wgosppvhjnle5yycvfbbhegkyo2lud5migy65e2r7cdpemghvvq-pcre2-10.43-r0.apk":
      { "id": "4wgosppvhjnle5yycvfbbhegkyo2lud5migy65e2r7cdpemghvvq-pcre2-10.43-r0.apk"
      , "name": "pcre2-10.43-r0.apk"
