{ "id": "jg4xyjlng4u4wq5madqqhtpqs5ftgbyd6i5sf35v7e5zxe5zqdga-perl"
, "name": "perl"
, "platform": "aarch64-linux"
, "rubble_home": "/var/lib/rubble"
, "inputs": [
    { "brick": "txmznhwijz6pz7m652w5pqqlymsnvboo2rsvqqwp7jprcfm6cw4a-zlib-1.3.2-r1.apk"
    , "alias": "zlib_apk"
    , "transitive": "false"
    }
  , { "brick": "cmdaozrcvaymmdfw3jodg7rrc4qwmaqyx6q3jj6u6nsie32hvdxq-publish-output-directory"
    , "transitive": "false"
    , "hooks": {
        "pre-build": [
          { "shell": {
              "value": [
                "source \"$script\""
              ]
            , "format": "text"
            }
          }
        ]
      }
    }
  , { "brick": "5zqzbtecxd2bwjpypfrcgfmzvuqihlmabhg5jtqztyhjc656maja-perl-5.40.4-r0.apk"
    , "alias": "perl_apk"
    , "transitive": "false"
    }
  , { "brick": "7275gbi26p7nwzbzemzdy6p5g2bg34i7k4itgjgkpamfuygljyta-patchelf"
    , "alias": "patchelf"
    , "transitive": "false"
    }
  , { "brick": "mvw4balnruevggsruaxcd7m3dye6dlbrsjshobcplnic3svvd4rq-ld-musl.so"
    , "alias": "ld_musl"
    , "transitive": "true"
    }
  , { "brick": "7gaiswvomctprmbv5i6dhxav3urpsmceezmwy52qv42yok44lygq-bash"
    , "alias": "bash"
    , "transitive": "true"
    }
  , { "brick": "defmfedonkfkblaqtfzjs7kvoq2u5k53xo3zzl43it7q634ax7ja-collect-shared-libraries"
    , "alias": "collect_libraries"
    , "transitive": "false"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  , { "name": "bin" }
  , { "name": "env" }
  , { "name": "lib" }
  , { "name": "share" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "mkdir -p \"$out\"/{bin,lib,share}\n"
        , "\n"
        , "# Extract all APK packages into current directory\n"
        , "for apk in \"$perl_apk\" \"$zlib_apk\"; do\n"
        , "  tar -xzf \"$apk\" 2>/dev/null || true\n"
        , "done\n"
        , "\n"
        , "# Copy package-level shared libraries. Perl extension modules are copied\n"
        , "# below with their directory layout preserved.\n"
        , "for lib_dir in ./lib ./usr/lib; do\n"
        , "  [ -d \"$lib_dir\" ] || continue\n"
        , "  \"$collect_libraries\" \"$out/lib\" one-level strict \"$lib_dir\"\n"
        , "done\n"
        , "\n"
        , "# Copy perl binary\n"
        , "cp usr/bin/perl \"$out/bin/perl.bin\"\n"
        , "chmod +x \"$out/bin/perl.bin\"\n"
        , "\n"
        , "# Copy perl libs and modules\n"
        , "cp -a usr/lib/perl* \"$out/lib/\" 2>/dev/null || true\n"
        , "cp -a usr/share/perl* \"$out/share/\" 2>/dev/null || true\n"
        , "if [ -f \"$out/lib/perl5/core_perl/CORE/libperl.so\" ]; then\n"
        , "  cp -a \"$out/lib/perl5/core_perl/CORE/libperl.so\" \"$out/lib/libperl.so\"\n"
        , "fi\n"
        , "\n"
        , "# Patch perl binary to use ld-musl interpreter\n"
        , "\"$patchelf\" --set-interpreter \"$ld_musl\" --set-rpath \"$out/lib\" \"$out/bin/perl.bin\"\n"
        , "\n"
        , "# Patch shared objects\n"
        , "find \"$out/lib\" -name \"*.so*\" -type f | while read -r so; do\n"
        , "  chmod u+w \"$so\" 2>/dev/null || true\n"
        , "  \"$patchelf\" --set-rpath \"$out/lib\" \"$so\" 2>/dev/null || true\n"
        , "done\n"
        , "\n"
        , "cat > \"$env\" <<ENV\n"
        , "export PERL5LIB=\"$out/share/perl5/core_perl:$out/lib/perl5/core_perl\\${PERL5LIB:+:}\\${PERL5LIB:-}\"\n"
        , "ENV\n"
        , "\n"
        , "# Create wrapper that sets up PERL5LIB\n"
        , "# OpenSSL Configure sets PERL to perl.real path, so both names must work\n"
        , "create_perl_wrapper() {\n"
        , "  local wrapper_path=\"$1\"\n"
        , "  cat > \"$wrapper_path\" << WRAPPER\n"
        , "#!${bash[bin]}/bash\n"
        , "# Perl wrapper - sets up PERL5LIB\n"
        , "source \"$env\"\n"
        , "exec \"$out/bin/perl.bin\" \"\\$@\"\n"
        , "WRAPPER\n"
        , "  chmod +x \"$wrapper_path\"\n"
        , "}\n"
        , "\n"
        , "create_perl_wrapper \"$out/bin/perl\"\n"
        , "create_perl_wrapper \"$out/bin/perl.real\"\n"
        , "\n"
        , "for command in perl perl.real; do\n"
        , "  \"$out/bin/$command\" -MFile::Spec -e 'exit(File::Spec->catfile(\"rubble\", \"probe\") eq \"rubble/probe\" ? 0 : 1)'\n"
        , "done"
        ]
      , "format": "text"
      }
    }
  , { "shell": {
        "value": [
          "publish_output_directory \"$out/bin\" \"$bin\"\n"
        , "publish_output_directory \"$out/lib\" \"$lib\"\n"
        , "publish_output_directory \"$out/share\" \"$share\""
        ]
      , "format": "text"
      }
    }
  ]
