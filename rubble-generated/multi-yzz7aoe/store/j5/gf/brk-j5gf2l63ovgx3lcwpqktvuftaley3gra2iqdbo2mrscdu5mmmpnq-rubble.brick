        , { "brick": "sbp2cshyiejko2u3bh7yyrbnmudme6jmrk3ai2577nndvbmj5qvq-bootstrap-env"
          , "alias": "bootstrap"
          , "transitive": "false"
          , "hooks": {
              "pre-checkout": [
                { "shell": {
                    "value": [
                      "source \"$env\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "RUBBLE_SRC_FETCH_MODE all_proxy http_proxy https_proxy no_proxy" }
