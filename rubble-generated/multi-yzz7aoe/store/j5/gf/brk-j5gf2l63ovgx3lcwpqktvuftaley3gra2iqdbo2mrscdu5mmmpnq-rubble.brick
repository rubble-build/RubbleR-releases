              "value": [
                "target_triple=\"${src[name]#*${name}-}\"\n"
              , "target_triple=\"${target_triple%%.*}\"\n"
              , "tar --strip-components=1 -Jxvf \"$src\"\n"
              , "mkdir -p \"$out/lib/rustlib/${target_triple}\"\n"
              , "mv rust-std-${target_triple}/lib/rustlib/${target_triple}/lib \"$out/lib/rustlib/${target_triple}/lib\""
              ]
            , "format": "text"
            }
          }
        , { "shell": {
              "value": [
                "publish_output_directory \"$out/lib\" \"$lib\""
              ]
            , "format": "text"
            }
          }
        ]
      }
