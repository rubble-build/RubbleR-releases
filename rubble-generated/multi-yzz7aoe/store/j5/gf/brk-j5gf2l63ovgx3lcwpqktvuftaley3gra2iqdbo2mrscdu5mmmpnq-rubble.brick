      , "opaque": true
      , "inputs": [
          { "brick": "o4tslxh2uwmqgfv6heppd5d4xitkk6jpu773b5ok4dojf4pfzlia-write-native-toolchain-env"
          , "alias": "write_toolchain_env"
          , "transitive": "false"
