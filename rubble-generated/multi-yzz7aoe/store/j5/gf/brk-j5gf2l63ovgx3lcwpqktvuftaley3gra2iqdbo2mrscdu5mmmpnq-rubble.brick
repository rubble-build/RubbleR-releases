      { "id": "tacnuufbmsgvjjdv35jnlei72ofv46gglzsjzt76wnp6nf7qphdq-binaryen-117"
      , "name": "binaryen-117"
      , "platform": "aarch64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
