  , "hsdfhn2s3nbslevufmmcn6kbnfj6mhfk7j3pfo6arxghhl7lzkva-gzip":
      { "id": "hsdfhn2s3nbslevufmmcn6kbnfj6mhfk7j3pfo6arxghhl7lzkva-gzip"
      , "name": "gzip"
      , "platform": "aarch64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "7275gbi26p7nwzbzemzdy6p5g2bg34i7k4itgjgkpamfuygljyta-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "mvw4balnruevggsruaxcd7m3dye6dlbrsjshobcplnic3svvd4rq-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "wsjd6bhyeay7o42k276g7ep5plfqmlqubqztlvbu5aw7rjjeuq2a-gzip-1.13-r1.apk"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "7gaiswvomctprmbv5i6dhxav3urpsmceezmwy52qv42yok44lygq-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "tyqosp4fpdd7pjacveojot6m2g5ls3hqljfqp4qerplz2kuwcvua-musl-install-tools"
          , "alias": "musl_tools"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar -xzf \"$src\" 2>/dev/null || true\n"
              , "\"${musl_tools[install]}\" bin/gzip \"$out\" \"$patchelf\" \"$ld_musl\"\n"
              , "\"${musl_tools[link_commands]}\" \"$out\" \"$bin\" gzip\n"
              , "for command in gunzip zcat; do\n"
              , "  mode=--decompress\n"
              , "  if [ \"$command\" = zcat ]; then mode='--decompress --stdout'; fi\n"
              , "  printf '#!%s\\nexec \"%s\" %s \"$@\"\\n' \"${bash[bin]}/bash\" \"$out\" \"$mode\" > \"$bin/$command\"\n"
              , "  chmod +x \"$bin/$command\"\n"
              , "done\n"
              , "\n"
              , "printf '%s' 'rubble gzip probe' | \"$out\" -c > \"$TMP/probe.gz\"\n"
              , "actual=\"$(\"$bin/gunzip\" -c \"$TMP/probe.gz\")\"\n"
              , "test \"$actual\" = 'rubble gzip probe'\n"
              , "actual=\"$(\"$bin/zcat\" \"$TMP/probe.gz\")\"\n"
              , "test \"$actual\" = 'rubble gzip probe'\n"
              , "rm -f \"$TMP/probe.gz\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "c3xqnrandkmibb3fmyqvmmmdu6rs6474gsucktlplld3rafroq5q-gpatch":
      { "id": "c3xqnrandkmibb3fmyqvmmmdu6rs6474gsucktlplld3rafroq5q-gpatch"
      , "name": "gpatch"
      , "platform": "aarch64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "7275gbi26p7nwzbzemzdy6p5g2bg34i7k4itgjgkpamfuygljyta-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "adykhpm55qerngmtx6ke7csou4r73gh5lnubblp7jj6ro4oeyxna-patch-2.7.6-r10.apk"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "mvw4balnruevggsruaxcd7m3dye6dlbrsjshobcplnic3svvd4rq-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "tyqosp4fpdd7pjacveojot6m2g5ls3hqljfqp4qerplz2kuwcvua-musl-install-tools"
          , "alias": "musl_tools"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar -xzf \"$src\" 2>/dev/null || true\n"
              , "\"${musl_tools[install]}\" usr/bin/patch \"$out\" \"$patchelf\" \"$ld_musl\"\n"
              , "\"${musl_tools[link_commands]}\" \"$out\" \"$bin\" patch gpatch\n"
              , "\n"
              , "printf 'before\\n' > \"$TMP/patch-probe\"\n"
              , "\"$out\" --batch --forward --silent \"$TMP/patch-probe\" <<'PATCH'\n"
              , "--- before\n"
              , "+++ after\n"
              , "@@ -1 +1 @@\n"
              , "-before\n"
              , "+after\n"
              , "PATCH\n"
              , "test \"$(cat \"$TMP/patch-probe\")\" = after\n"
              , "rm -f \"$TMP/patch-probe\""
              ]
            , "format": "text"
            }
          }
        ]
      }
