  , "si6nyn5fdb3ti7j4mrkcpn3ilq2irsteztsfw2kfd24nd7qmrx4a-findutils":
      { "id": "si6nyn5fdb3ti7j4mrkcpn3ilq2irsteztsfw2kfd24nd7qmrx4a-findutils"
      , "name": "findutils"
      , "platform": "aarch64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "7275gbi26p7nwzbzemzdy6p5g2bg34i7k4itgjgkpamfuygljyta-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "mvw4balnruevggsruaxcd7m3dye6dlbrsjshobcplnic3svvd4rq-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "m5lnpllbzm555r5zuagxbaoqomumjvcwyoq7xdkffysmdvteelwa-findutils-4.10.0-r0.apk"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "tyqosp4fpdd7pjacveojot6m2g5ls3hqljfqp4qerplz2kuwcvua-musl-install-tools"
          , "alias": "musl_tools"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "bin" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar -xzf \"$src\" 2>/dev/null || true\n"
              , "\n"
              , "mkdir -p \"$bin\"\n"
              , "\n"
              , "# Copy and patch find and xargs binaries\n"
              , "for cmd in find xargs; do\n"
              , "  if [ -f \"usr/bin/$cmd\" ]; then\n"
              , "    \"${musl_tools[install]}\" \"usr/bin/$cmd\" \"$bin/$cmd\" \"$patchelf\" \"$ld_musl\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "mkdir -p \"$TMP/find-probe\"\n"
              , "touch \"$TMP/find-probe/name with spaces\"\n"
              , "\"$bin/find\" -- \"$TMP/find-probe\" -type f -print0 > \"$TMP/found\"\n"
              , "actual=\"$(\"$bin/xargs\" -0 -r printf '%s\\n' < \"$TMP/found\")\"\n"
              , "test \"$actual\" = \"$TMP/find-probe/name with spaces\"\n"
              , "rm -rf \"$TMP/find-probe\" \"$TMP/found\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "zgptfa36kfu3onwxjxeqkaekqliwbsazdezeyj6kzyebldtz4oca-diffutils":
      { "id": "zgptfa36kfu3onwxjxeqkaekqliwbsazdezeyj6kzyebldtz4oca-diffutils"
      , "name": "diffutils"
      , "platform": "aarch64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "7275gbi26p7nwzbzemzdy6p5g2bg34i7k4itgjgkpamfuygljyta-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "mvw4balnruevggsruaxcd7m3dye6dlbrsjshobcplnic3svvd4rq-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "qvxcj4lj5jj5mbgvpcfw5svnfaljwbkil7ghzzofovoqehagqava-diffutils-3.10-r0.apk"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "tyqosp4fpdd7pjacveojot6m2g5ls3hqljfqp4qerplz2kuwcvua-musl-install-tools"
          , "alias": "musl_tools"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "bin" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar -xzf \"$src\" 2>/dev/null || true\n"
              , "\n"
              , "mkdir -p \"$bin\"\n"
              , "\n"
              , "# Copy and patch diffutils binaries\n"
              , "for cmd in diff cmp diff3 sdiff; do\n"
              , "  if [ -f \"usr/bin/$cmd\" ]; then\n"
              , "    \"${musl_tools[install]}\" \"usr/bin/$cmd\" \"$bin/$cmd\" \"$patchelf\" \"$ld_musl\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "printf 'before\\n' > \"$TMP/diff-before\"\n"
              , "printf 'after\\n' > \"$TMP/diff-after\"\n"
              , "status=0\n"
              , "\"$bin/diff\" --unified=0 --label before --label after \"$TMP/diff-before\" \"$TMP/diff-after\" > \"$TMP/diff-result\" || status=$?\n"
              , "test \"$status\" -eq 1\n"
              , "test \"$(cat \"$TMP/diff-result\")\" = $'--- before\\n+++ after\\n@@ -1 +1 @@\\n-before\\n+after'\n"
              , "rm -f \"$TMP/diff-before\" \"$TMP/diff-after\" \"$TMP/diff-result\""
              ]
            , "format": "text"
            }
          }
        ]
      }
