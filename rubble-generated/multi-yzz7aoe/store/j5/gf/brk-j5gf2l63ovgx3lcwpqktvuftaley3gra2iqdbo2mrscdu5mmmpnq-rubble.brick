          , "value": "ld-linux-aarch64.so.1"
          }
        ]
      , "outputs": [
          { "name": "env" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "\"$write_toolchain_env\" \"$env\" \"${gcc[bin]}\" \"${gcc[lib]}\" \"${gcc[include]}\" \"${perl[bin]}\" \"${perl[env]}\" \"$gnu_triple\" \"$gcc_version\" \"$ld_linux_name\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "uyjsp4ouuc5rwiwdnqimjbiittyoyvx5vzdamkdqenaf4fazaj4q-cargo-1.94.0":
      { "id": "uyjsp4ouuc5rwiwdnqimjbiittyoyvx5vzdamkdqenaf4fazaj4q-cargo-1.94.0"
      , "name": "cargo-1.94.0"
      , "platform": "aarch64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "7275gbi26p7nwzbzemzdy6p5g2bg34i7k4itgjgkpamfuygljyta-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "km24gkz4zqqu7uqftehftqfd26smur3oitfkvhpv35pqsc5llvca-cargo-1.94.0-aarch64-unknown-linux-gnu.tar.xz"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "sb64ioyugaehkllixkmpaka2hdzbubj3yiepjnya65eyzamkmpda-gcc-glibc"
          , "alias": "gcc_glibc"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "bin" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar --strip-components=1 -Jxvf \"$src\"\n"
              , "mv cargo/bin \"$bin\"\n"
              , "\n"
              , "# On Linux, patchelf ELF binaries to use store's glibc dynamic linker\n"
              , "if [ -n \"${gcc_glibc:-}\" ]; then\n"
              , "  ld_linux=$(echo \"${gcc_glibc[lib]}\"/ld-linux-*.so.* | awk '{print $1}')\n"
              , "  for f in \"$bin\"/*; do\n"
              , "    [ -f \"$f\" ] && [ ! -L \"$f\" ] || continue\n"
              , "    \"${gcc_glibc[bin]}/readelf\" -l \"$f\" 2>/dev/null | grep -q \"INTERP\" || continue\n"
              , "    \"$patchelf\" --set-interpreter \"$ld_linux\" --set-rpath \"${gcc_glibc[lib]}\" \"$f\"\n"
              , "  done\n"
              , "fi"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "7ef7xmxyhyofo2jq4qz52u73byxo4p6jjnr2mtuy7d2hjidvrifq-rust-web-wasm-toolchain":
      { "id": "7ef7xmxyhyofo2jq4qz52u73byxo4p6jjnr2mtuy7d2hjidvrifq-rust-web-wasm-toolchain"
      , "name": "rust-web-wasm-toolchain"
      , "platform": "aarch64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "gpd75vrjncv57fv3fzdfuoagqwgyqjwuizvdth2pdg7hv2q4lv5a-rubble-script-shebang"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$script\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "cmdaozrcvaymmdfw3jodg7rrc4qwmaqyx6q3jj6u6nsie32hvdxq-publish-output-directory"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$script\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "yigmijc5ij3rpsaberwyafdvndneutsn76xdruhwjcug2zlebmqq-rust-std-1.94.0-wasm32-unknown-unknown"
          , "alias": "rust_std_wasm"
          , "transitive": "false"
          }
        , { "brick": "7gaiswvomctprmbv5i6dhxav3urpsmceezmwy52qv42yok44lygq-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "wdyz3is2b6mebmuvspxovh65zqtb7etghgqare6skzmkwr3uzewa-rustc-1.94.0"
          , "alias": "rustc"
          , "transitive": "true"
          }
        , { "brick": "iaiiy6yxl2oc4o2ptmxc2yne2xfkig6dohqlc2vzwccr7vbuuv3a-llvm-tools-1.94.0"
          , "alias": "rust_llvm_tools"
          , "transitive": "true"
          }
        , { "brick": "7u5doswc6jpjyxiiu2m7wgdgzzr76bhwplzdwyiio3de2qxgsj7q-linux-native-toolchain"
          , "transitive": "true"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$env\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "uyjsp4ouuc5rwiwdnqimjbiittyoyvx5vzdamkdqenaf4fazaj4q-cargo-1.94.0"
          , "alias": "cargo"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "host_triple"
          , "value": "aarch64-unknown-linux-gnu"
          }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        , { "name": "env" }
        , { "name": "lib" }
        , { "name": "libexec" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "cargo_commands=\"${cargo[bin]}\"\n"
              , "llvm_commands=\"${rust_llvm_tools[bin]}\""
              ]
            , "format": "text"
            }
          }
        , { "shell": {
              "value": [
                "write_heredoc_file() {\n"
              , "  local target=\"$1\"\n"
              , "  local content\n"
              , "  IFS= read -r -d '' content || true\n"
              , "  builtin printf '%s' \"$content\" > \"$target\"\n"
              , "}\n"
              , "\n"
              , "rm -rf \"$out\"\n"
              , "mkdir -p \"$out\"\n"
              , "\n"
              , "cp -a \"${rustc[out]}/bin\" \"$out/\"\n"
              , "cp -a \"${rustc[out]}/lib\" \"$out/\"\n"
              , "cp -a \"${rustc[out]}/libexec\" \"$out/\"\n"
              , "mkdir -p \"$out/lib/rustlib/wasm32-unknown-unknown\"\n"
              , "cp -a \"${rust_std_wasm[out]}/lib/rustlib/wasm32-unknown-unknown/lib\" \"$out/lib/rustlib/wasm32-unknown-unknown/\"\n"
              , "\n"
              , "is_windows_host=false\n"
              , "if [[ \"$host_triple\" == *windows* ]]; then\n"
              , "  is_windows_host=true\n"
              , "fi\n"
              , "if $is_windows_host; then\n"
              , "  mkdir -p \"$out/lib/rustlib/${host_triple}/lib/self-contained\"\n"
              , "  cp -a \"$rust_mingw_lib/rustlib/${host_triple}/lib/self-contained/.\" \"$out/lib/rustlib/${host_triple}/lib/self-contained/\"\n"
              , "  windows_library_path=\"$(realpath \"$rust_mingw_lib/rustlib/${host_triple}/lib/self-contained\")\"\n"
              , "else\n"
              , "  windows_library_path=\"\"\n"
              , "fi\n"
              , "\n"
              , "real_rustc=\"$out/bin/rustc-real\"\n"
              , "if $is_windows_host; then\n"
              , "  real_rustc=\"$out/bin/rustc.exe\"\n"
              , "else\n"
              , "  mv \"$out/bin/rustc\" \"$real_rustc\"\n"
              , "fi\n"
              , "\n"
              , "if $is_windows_host; then\n"
              , "  if [[ -z \"${RUBBLE_WEB_WRAPPER_BASH:-}\" ]]; then\n"
              , "    echo \"RUBBLE_WEB_WRAPPER_BASH must point to the store Bash for Windows web builds\"\n"
              , "    exit 1\n"
              , "  fi\n"
              , "  rustc_wrapper_bash=\"$RUBBLE_WEB_WRAPPER_BASH\"\n"
              , "  pathext_env='export PATHEXT=\".COM;.EXE;.BAT;.CMD\"'\n"
              , "  library_path_env=\"export LIBRARY_PATH=\\\"$windows_library_path\\${LIBRARY_PATH:+:}\\${LIBRARY_PATH:-}\\\"\"\n"
              , "else\n"
              , "  rustc_wrapper_bash=\"${bash[bin]}/bash\"\n"
              , "  pathext_env=\"\"\n"
              , "  library_path_env='export LIBRARY_PATH=\"${LIBRARY_PATH:-}\"'\n"
              , "fi\n"
              , "\n"
              , "if ! $is_windows_host; then\n"
              , "  rubble_script_shebang_register \"$rustc_wrapper_bash\" sh bash\n"
              , "  shebang_scripts=()\n"
              , "  for script in \"$out/bin/rust-gdb\" \"$out/bin/rust-gdbgui\" \"$out/bin/rust-lldb\"; do\n"
              , "    [ -f \"$script\" ] || continue\n"
              , "    shebang_scripts+=(\"$script\")\n"
              , "  done\n"
              , "  if ((${#shebang_scripts[@]} > 0)); then\n"
              , "    rubble_script_shebang_rewrite_all --strict \"${shebang_scripts[@]}\"\n"
              , "  fi\n"
              , "fi\n"
              , "\n"
              , "host_rustflags=\"${RUSTFLAGS:-}\"\n"
              , "host_rustflags=\"${host_rustflags:+${host_rustflags} }--cap-lints warn\"\n"
              , "wasm_rustflags=\"--cap-lints warn\"\n"
              , "global_rustflags=\"\"\n"
              , "if $is_windows_host; then\n"
              , "  global_rustflags=\"$wasm_rustflags\"\n"
              , "fi\n"
              , "host_triple_env=\"$(printf '%s' \"$host_triple\" | tr '[:lower:]-' '[:upper:]_')\"\n"
              , "cargo_target_rustflags_env=\"\"\n"
              , "cargo_target_rustflags_declare=\"\"\n"
              , "if $is_windows_host; then\n"
              , "  cargo_target_rustflags_env=\"export CARGO_TARGET_${host_triple_env}_RUSTFLAGS=\\\"$host_rustflags\\\"\n"
              , "export CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUSTFLAGS=\\\"$wasm_rustflags\\\"\"\n"
              , "  cargo_target_rustflags_declare=\"CARGO_TARGET_${host_triple_env}_RUSTFLAGS CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUSTFLAGS\"\n"
              , "fi\n"
              , "\n"
              , "rustc_env_path=\"$out/bin/rustc\"\n"
              , "rustdoc_env_path=\"$out/bin/rustdoc\"\n"
              , "if ! $is_windows_host; then\n"
              , "  write_heredoc_file \"$out/bin/rustc\" <<EOF\n"
              , "#!$rustc_wrapper_bash\n"
              , "set -euo pipefail\n"
              , "\n"
              , "real_rustc=\"$real_rustc\"\n"
              , "sysroot=\"$out\"\n"
              , "\n"
              , "export LD_LIBRARY_PATH=\"\\$sysroot/lib\\${LD_LIBRARY_PATH:+:}\\${LD_LIBRARY_PATH:-}\"\n"
              , "\n"
              , "if [[ \"\\${1:-}\" == \"--print\" && \"\\${2:-}\" == \"sysroot\" ]]; then\n"
              , "  printf '%s\\n' \"\\$sysroot\"\n"
              , "  exit 0\n"
              , "fi\n"
              , "\n"
              , "case \"\\${1:-}\" in\n"
              , "  -V|--version|-vV)\n"
              , "    exec \"\\$real_rustc\" \"\\$@\"\n"
              , "    ;;\n"
              , "esac\n"
              , "\n"
              , "is_wasm=false\n"
              , "is_compile=false\n"
              , "next_is_target=false\n"
              , "for arg in \"\\$@\"; do\n"
              , "  if [[ \"\\$next_is_target\" == \"true\" ]]; then\n"
              , "    if [[ \"\\$arg\" == \"wasm32-unknown-unknown\" ]]; then\n"
              , "      is_wasm=true\n"
              , "    fi\n"
              , "    next_is_target=false\n"
              , "    continue\n"
              , "  fi\n"
              , "\n"
              , "  case \"\\$arg\" in\n"
              , "    --target)\n"
              , "      next_is_target=true\n"
              , "      ;;\n"
              , "    --target=wasm32-unknown-unknown)\n"
              , "      is_wasm=true\n"
              , "      ;;\n"
              , "    --crate-name|*.rs)\n"
              , "      is_compile=true\n"
              , "      ;;\n"
              , "  esac\n"
              , "done\n"
              , "\n"
              , "extra_args=(--sysroot \"\\$sysroot\")\n"
              , "if [[ \"\\$is_compile\" == \"true\" ]]; then\n"
              , "  if [[ \"\\$is_wasm\" == \"true\" ]]; then\n"
              , "    read -r -a rustflags <<< \"\\${RUBBLE_WEB_WASM_RUSTFLAGS:-}\"\n"
              , "  else\n"
              , "    read -r -a rustflags <<< \"\\${RUBBLE_WEB_HOST_RUSTFLAGS:-}\"\n"
              , "  fi\n"
              , "  extra_args+=(\"\\${rustflags[@]}\")\n"
              , "fi\n"
              , "\n"
              , "exec \"\\$real_rustc\" \"\\$@\" \"\\${extra_args[@]}\"\n"
              , "EOF\n"
              , "  chmod +x \"$out/bin/rustc\"\n"
              , "fi\n"
              , "\n"
              , "if $is_windows_host; then\n"
              , "  rustc_env_path=\"$(realpath \"$out/bin/rustc.exe\")\"\n"
              , "  rustdoc_env_path=\"$(realpath \"$out/bin/rustdoc.exe\")\"\n"
              , "fi\n"
              , "windows_tool_path_prefix=\"\"\n"
              , "if $is_windows_host; then\n"
              , "  IFS=':' read -r -a current_path_entries <<< \"$PATH\"\n"
              , "  for path_entry in \"${current_path_entries[@]}\"; do\n"
              , "    case \"$path_entry\" in\n"
              , "      */out-*-gcc/bin|*/rustlib/x86_64-pc-windows-gnu/bin/self-contained)\n"
              , "        windows_tool_path_prefix=\"${windows_tool_path_prefix}${path_entry}:\"\n"
              , "        ;;\n"
              , "    esac\n"
              , "  done\n"
              , "fi\n"
              , "\n"
              , "while IFS= builtin read -r __rubble_output_line; do\n"
              , "  builtin printf '%s\\n' \"$__rubble_output_line\"\n"
              , "done > \"$env\" <<EOF\n"
              , "export PATH=\"$out/bin:${cargo_commands}:${llvm_commands}:$windows_tool_path_prefix\\${PATH}\"\n"
              , "export LD_LIBRARY_PATH=\"$out/lib\\${LD_LIBRARY_PATH:+:}\\${LD_LIBRARY_PATH:-}\"\n"
              , "$library_path_env\n"
              , "export RUSTC=\"$rustc_env_path\"\n"
              , "export RUSTDOC=\"$rustdoc_env_path\"\n"
              , "export RUSTFLAGS=\"$global_rustflags\"\n"
              , "$cargo_target_rustflags_env\n"
              , "export RUBBLE_WEB_HOST_RUSTFLAGS=\"$host_rustflags\"\n"
              , "export RUBBLE_WEB_WASM_RUSTFLAGS=\"$wasm_rustflags\"\n"
              , "export SDKROOT=\"${SDKROOT:-}\"\n"
              , "export CC=\"${CC:-}\"\n"
              , "export CXX=\"${CXX:-}\"\n"
              , "$pathext_env\n"
              , "export AR=\"${AR:-}\"\n"
              , "export RANLIB=\"${RANLIB:-}\"\n"
              , "export NM=\"${NM:-}\"\n"
              , "export LD=\"${LD:-}\"\n"
              , "export LDFLAGS=\"${LDFLAGS:-}\"\n"
              , "export CFLAGS=\"${CFLAGS:-}\"\n"
              , "export CXXFLAGS=\"${CXXFLAGS:-}\"\n"
              , "export C_INCLUDE_PATH=\"${C_INCLUDE_PATH:-}\"\n"
              , "export CPLUS_INCLUDE_PATH=\"${CPLUS_INCLUDE_PATH:-}\"\n"
              , "export PKG_CONFIG_LIBDIR=\"${PKG_CONFIG_LIBDIR:-}\"\n"
              , "export PERL5LIB=\"${PERL5LIB:-}\"\n"
              , "declare -p PATH LD_LIBRARY_PATH LIBRARY_PATH RUSTC RUSTDOC RUSTFLAGS $cargo_target_rustflags_declare RUBBLE_WEB_HOST_RUSTFLAGS RUBBLE_WEB_WASM_RUSTFLAGS\n"
              , "if [[ -n \"${PATHEXT:-}\" ]]; then\n"
              , "  declare -p PATHEXT\n"
              , "fi\n"
              , "cargo --version\n"
              , "rustc -vV\n"
              , "EOF\n"
              , "builtin unset __rubble_output_line\n"
              , "\n"
              , "export PATH=\"$out/bin:${cargo_commands}:${llvm_commands}:${PATH}\"\n"
              , "export LD_LIBRARY_PATH=\"$out/lib${LD_LIBRARY_PATH:+:}${LD_LIBRARY_PATH:-}\"\n"
              , "if [[ -n \"$windows_library_path\" ]]; then\n"
              , "  export LIBRARY_PATH=\"$windows_library_path${LIBRARY_PATH:+:}${LIBRARY_PATH:-}\"\n"
              , "fi\n"
              , "export RUSTC=\"$rustc_env_path\"\n"
              , "export RUSTFLAGS=\"$global_rustflags\"\n"
              , "if $is_windows_host; then\n"
              , "  export PATHEXT=\".COM;.EXE;.BAT;.CMD\"\n"
              , "  export \"CARGO_TARGET_${host_triple_env}_RUSTFLAGS=$host_rustflags\"\n"
              , "  export CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUSTFLAGS=\"$wasm_rustflags\"\n"
              , "fi\n"
              , "export RUBBLE_WEB_HOST_RUSTFLAGS=\"$host_rustflags\"\n"
              , "export RUBBLE_WEB_WASM_RUSTFLAGS=\"$wasm_rustflags\"\n"
              , "\n"
              , "\"${cargo_commands}/cargo\" --version\n"
              , "\"$rustc_env_path\" -vV\n"
              , "sysroot=\"$(\"$rustc_env_path\" --print sysroot)\"\n"
              , "expected_sysroot=\"$out\"\n"
              , "if $is_windows_host; then\n"
              , "  sysroot=\"${sysroot//\\\\//}\"\n"
              , "  expected_sysroot=\"$(realpath \"$out\")\"\n"
              , "fi\n"
              , "test \"$sysroot\" = \"$expected_sysroot\"\n"
              , "test -d \"$sysroot/lib/rustlib/${host_triple}/lib\"\n"
              , "test -d \"$sysroot/lib/rustlib/wasm32-unknown-unknown/lib\"\n"
              , "target_libdir=\"$(\"$rustc_env_path\" --print target-libdir --target wasm32-unknown-unknown)\"\n"
              , "if $is_windows_host; then\n"
              , "  target_libdir=\"${target_libdir//\\\\//}\"\n"
              , "fi\n"
              , "test -d \"$target_libdir\"\n"
              , "\n"
              , "printf 'fn main() { println!(\"host probe\"); }\\n' > host-probe.rs\n"
              , "host_probe=\"./host-probe\"\n"
              , "if $is_windows_host; then\n"
              , "  host_probe=\"./host-probe.exe\"\n"
              , "fi\n"
              , "if $is_windows_host; then\n"
              , "  read -r -a host_probe_flags <<< \"$host_rustflags\"\n"
              , "  \"$rustc_env_path\" host-probe.rs -o \"$host_probe\" \"${host_probe_flags[@]}\"\n"
              , "else\n"
              , "  \"$out/bin/rustc\" host-probe.rs -o \"$host_probe\"\n"
              , "fi\n"
              , "\"$host_probe\"\n"
              , "dynamic_linker=\"$(printf '%s\\n' \"${LDFLAGS:-}\" | sed -n 's/.*--dynamic-linker=\\([^ ]*\\).*/\\1/p')\"\n"
              , "if [[ -n \"$dynamic_linker\" ]]; then\n"
              , "  readelf -l host-probe | grep -F \"$dynamic_linker\"\n"
              , "fi\n"
              , "\n"
              , "printf '#[no_mangle]\\npub extern \"C\" fn probe() -> i32 { 7 }\\n' > wasm-probe.rs\n"
              , "if $is_windows_host; then\n"
              , "  read -r -a wasm_probe_flags <<< \"$wasm_rustflags\"\n"
              , "  \"$rustc_env_path\" --target wasm32-unknown-unknown --crate-type cdylib wasm-probe.rs -o wasm-probe.wasm \"${wasm_probe_flags[@]}\"\n"
              , "else\n"
              , "  \"$out/bin/rustc\" --target wasm32-unknown-unknown --crate-type cdylib wasm-probe.rs -o wasm-probe.wasm\n"
              , "fi\n"
              , "test -s wasm-probe.wasm"
              ]
            , "format": "text"
            }
          }
        , { "shell": {
              "value": [
                "publish_output_directory \"$out/bin\" \"$bin\"\n"
              , "publish_output_directory \"$out/lib\" \"$lib\"\n"
              , "publish_output_directory \"$out/libexec\" \"$libexec\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "invn6jkeaqldpcy2drks3numpfd2akhcn3hj7w7mjzjfffsq6nca-rust-toolchain":
      { "id": "invn6jkeaqldpcy2drks3numpfd2akhcn3hj7w7mjzjfffsq6nca-rust-toolchain"
      , "name": "rust-toolchain"
