              , "\"$out\" -E -i 's/[0-9]+/-gnu/' \"$TMP/sed-probe\"\n"
              , "test \"$(cat \"$TMP/sed-probe\")\" = rubble-gnu\n"
              , "rm -f \"$TMP/sed-probe\""
