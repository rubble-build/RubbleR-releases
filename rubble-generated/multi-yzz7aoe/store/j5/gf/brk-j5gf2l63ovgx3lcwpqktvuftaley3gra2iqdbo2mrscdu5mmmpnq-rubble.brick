  , "ygoaz524fbxylyorentj3kdcspsb7r5g4qau6goj5gbboocuupsq-glibc-runtime-support":
      { "id": "ygoaz524fbxylyorentj3kdcspsb7r5g4qau6goj5gbboocuupsq-glibc-runtime-support"
      , "name": "glibc-runtime-support"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "gshefcluy6kkjh2fphz6a4ef2opbn4ggm4tp6t5becfcg4tx5kxq-coreutils"
          , "alias": "coreutils"
          , "transitive": "false"
          }
        , { "brick": "x7qxtfi2npyewp64xdyhckglv5hrtv2qiahanhiw5vjsyqh7hxlq-RubbleR.git.partial"
          , "alias": "src"
          , "transitive": "false"
          , "hooks": {
              "post-checkout": [
                { "install-to": [
                    { "output": "dir"
                    , "dir": "./" }
                  ]
                }
              , { "shell": {
                    "value": [
                      "( source \"${script}\" \"${dir}\" )"
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "\"${coreutils[bin]}/mkdir\" -p \"$out\"\n"
              , "for file in initialize.c build-initializer.bash probe.c external-nss.c \\\n"
              , "  external-gconv.c passwd-namespace.c audit.bash README.md; do\n"
              , "  \"${coreutils[bin]}/cp\" \"scripts/glibc-runtime-support/$file\" \"$out/$file\"\n"
              , "done"
              ]
            , "format": "text"
            }
          }
        ]
      }
