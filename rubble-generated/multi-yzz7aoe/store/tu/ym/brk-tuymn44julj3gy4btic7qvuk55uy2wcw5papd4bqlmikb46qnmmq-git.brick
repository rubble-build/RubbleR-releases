, "name": "git"
, "platform": "x86_64-linux"
, "rubble_home": "/var/lib/rubble"
, "inputs": [
    { "brick": "hl6djaj44qkp6rily6m7uf6lsksicuvyiukbsphwqzo7zhddpzna-zstd-libs-1.5.6-r2.apk"
    , "alias": "zstd_libs_apk"
    , "transitive": "false"
    }
  , { "brick": "2zylpggqvy5wrqoxp22pstx4hls2mcr4otvvtmov5ghmw4hoz7za-zlib-1.3.2-r1.apk"
    , "alias": "zlib_apk"
    , "transitive": "false"
    }
  , { "brick": "gpd75vrjncv57fv3fzdfuoagqwgyqjwuizvdth2pdg7hv2q4lv5a-rubble-script-shebang"
    , "transitive": "false"
