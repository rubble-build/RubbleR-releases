  , "7cgcknjw7tfxmmgdwdyruyfvun4ofgydjrznqbedl25f7snxox7a-patchelf":
      { "id": "7cgcknjw7tfxmmgdwdyruyfvun4ofgydjrznqbedl25f7snxox7a-patchelf"
      , "name": "patchelf"
      , "platform": "x86_64-linux"
      , "inputs": [
          { "brick": "srku7z24wv4w4tgv6eu4fa6qbu5agbdkyenupgctdee7bxpivfaq-patchelf-0.18.0-x86_64.tar.gz"
          , "alias": "src"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        , { "name": "share" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar -xvf \"$src\"\n"
              , "mv bin/patchelf \"$out\"\n"
              , "mkdir -p \"$bin\"\n"
              , "ln -s \"$out\" \"$bin/patchelf\"\n"
              , "mv share \"$share\"\n"
              , "\"$out\" --version"
              ]
            , "format": "text"
            }
          }
        ]
      }
