  , { "brick": "4wgosppvhjnle5yycvfbbhegkyo2lud5migy65e2r7cdpemghvvq-pcre2-10.43-r0.apk"
    , "alias": "pcre2_apk"
    , "transitive": "false"
    }
  , { "brick": "7cgcknjw7tfxmmgdwdyruyfvun4ofgydjrznqbedl25f7snxox7a-patchelf"
    , "alias": "patchelf"
    , "transitive": "false"
    }
  , { "brick": "riuewubniwiboir5fq3jjufegmdvpfusk2fp25gcllfzgwstcwfa-nghttp2-libs-1.69.0-r0.apk"
    , "alias": "nghttp2_apk"
    , "transitive": "false"
    }
  , { "brick": "mi6ohmutnclicttozbnjjmgo5r6nutdophs5rgp6kru2gg7tqxqq-libunistring-1.2-r0.apk"
    , "alias": "libunistring_apk"
    , "transitive": "false"
    }
  , { "brick": "3lojfc4csi3u4upmameltz6l45ti2jk5uiw2rnf2ui7g7z523odq-libssl3-3.3.7-r2.apk"
    , "alias": "libssl_apk"
    , "transitive": "false"
    }
  , { "brick": "t6xqfwfwlrrilozolb4u3zqjqyvl4ak7wbq5j6hxpicb3ycidfpa-libpsl-0.21.5-r3.apk"
    , "alias": "libpsl_apk"
    , "transitive": "false"
    }
  , { "brick": "qahczze2w5oyaxj5ledbeizlod4hco54ydowp6zvk4wryzwpqu2q-libidn2-2.3.7-r0.apk"
    , "alias": "libidn2_apk"
    , "transitive": "false"
    }
  , { "brick": "7ktnbvp6fl2plw3a55esbljq2bcop6zzubnjwusospje6hknpepq-libexpat-2.8.4-r0.apk"
    , "alias": "libexpat_apk"
    , "transitive": "false"
    }
  , { "brick": "77wn4qjjc5t6dj7mhudt2agj5mzd6q6d4xeucta7zjc6vj44pmqq-libcurl-8.14.1-r2.apk"
    , "alias": "libcurl_apk"
    , "transitive": "false"
    }
  , { "brick": "bqqueq4hb5vdjgdpm5xn2bpxiay234jhkblmh6d2yjdmd2ncxb2q-libcrypto3-3.3.7-r2.apk"
    , "alias": "libcrypto_apk"
    , "transitive": "false"
    }
  , { "brick": "z3xhjdr5it75lq5iwals4toaklhutksbdphbucgwhtgqhxz32k6q-ld-musl.so"
    , "alias": "ld_musl"
    , "transitive": "true"
    }
  , { "brick": "7wdydh7iziyaiskuhw2qb242fvaq4rin2kprwubf7fmvooc6iopa-git-2.47.3-r0.apk"
    , "alias": "git_apk"
    , "transitive": "false"
    }
  , { "brick": "nyxvd2fuotdmxjktenzudif5x5zq2d5ohtbciy4t5ztyf7b7x2fq-ca-certificates.pem"
    , "alias": "ca_certs"
    , "transitive": "true"
    }
  , { "brick": "gnh47phed75uwi3vbxi5scokhxo64p5gcafwkkjx6oowdevwnhga-c-ares-1.34.8-r0.apk"
    , "alias": "cares_apk"
    , "transitive": "false"
    }
  , { "brick": "3bgoeaauj5s4emyhwccwfwtbft5cxf5jdpbw3cfm3cm73edir6gq-brotli-libs-1.1.0-r2.apk"
    , "alias": "brotli_apk"
    , "transitive": "false"
    }
  , { "brick": "n7qbevbly56oq5vdzjm2bzhl77wjewdp4k5gmoimlbiv62nbv7pa-bash"
    , "alias": "bash"
    , "transitive": "true"
    }
  , { "brick": "tfjxrh45sf2nytjwmw6picosxhkrbtwiuke6d3wujuptb35jb55a-collect-shared-libraries"
    , "alias": "collect_libraries"
    , "transitive": "false"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  , { "name": "bin" }
  , { "name": "lib" }
  , { "name": "libexec" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "mkdir -p \"$out/bin\" \"$out/lib\" \"$out/libexec\" extract\n"
        , "\n"
        , "for apk in \"$git_apk\" \"$pcre2_apk\" \"$zlib_apk\" \"$libexpat_apk\" \\\n"
        , "           \"$libcurl_apk\" \"$cares_apk\" \"$libidn2_apk\" \"$libpsl_apk\" \\\n"
        , "           \"$brotli_apk\" \"$nghttp2_apk\" \"$libunistring_apk\" \\\n"
        , "           \"$libcrypto_apk\" \"$libssl_apk\" \"$zstd_libs_apk\"; do\n"
        , "  tar -xzf \"$apk\" -C extract 2>/dev/null || true\n"
        , "done\n"
        , "\n"
        , "# Copy all shared libraries\n"
        , "\"$collect_libraries\" \"$out/lib\" recursive ignore extract\n"
        , "\n"
        , "# Copy git binaries — rename the main binary so we can create a wrapper\n"
        , "cp extract/usr/bin/git \"$out/bin/git.real\"\n"
        , "for f in extract/usr/bin/git-*; do\n"
        , "  [ -f \"$f\" ] && cp -a \"$f\" \"$out/bin/\"\n"
        , "done\n"
        , "\n"
        , "# Copy git-core with proper handling of symlinks\n"
        , "mkdir -p \"$out/libexec/git-core\"\n"
        , "for f in extract/usr/libexec/git-core/*; do\n"
        , "  if [ -f \"$f\" ] && [ ! -L \"$f\" ]; then\n"
        , "    cp -a \"$f\" \"$out/libexec/git-core/\"\n"
        , "  elif [ -L \"$f\" ]; then\n"
        , "    target=$(readlink \"$f\")\n"
        , "    name=$(basename \"$f\")\n"
        , "    if [ \"$target\" = \"../../bin/git\" ]; then\n"
        , "      ln -sf \"../../bin/git.real\" \"$out/libexec/git-core/$name\"\n"
        , "    else\n"
        , "      cp -a \"$f\" \"$out/libexec/git-core/\"\n"
        , "    fi\n"
        , "  fi\n"
        , "done\n"
        , "\n"
        , "# Update symlinks in bin/ that point to git\n"
        , "for f in \"$out/bin/\"*; do\n"
        , "  if [ -L \"$f\" ]; then\n"
        , "    target=$(readlink \"$f\")\n"
        , "    if [ \"$target\" = \"git\" ]; then\n"
        , "      ln -sf \"git.real\" \"$f\"\n"
        , "    fi\n"
        , "  fi\n"
        , "done\n"
        , "\n"
        , "# Patch all ELF binaries to use musl interpreter from runtime home\n"
        , "for dir in \"$out/bin\" \"$out/libexec/git-core\"; do\n"
        , "  for elf_file in \"$dir/\"*; do\n"
        , "    [ -f \"$elf_file\" ] && [ ! -L \"$elf_file\" ] || continue\n"
        , "    if \"$patchelf\" --print-interpreter \"$elf_file\" >/dev/null 2>&1; then\n"
        , "      \"$patchelf\" --set-interpreter \"$ld_musl\" --set-rpath \"$out/lib\" \"$elf_file\" 2>/dev/null || true\n"
        , "    fi\n"
        , "  done\n"
        , "done\n"
        , "\n"
        , "rubble_script_shebang_register \"${bash[bin]}/bash\" sh bash\n"
        , "rubble_script_shebang_rewrite_all --strict --all \"$out/libexec/git-core\"\n"
        , "\n"
        , "# Create wrapper script for GIT_EXEC_PATH and SSL_CERT_FILE\n"
        , "printf '%s\\n' \"#!${bash[bin]}/bash\" > \"$out/bin/git\"\n"
        , "printf '%s\\n' \"SCRIPT_DIR=\\\"$out\\\"\" >> \"$out/bin/git\"\n"
        , "printf 'export SSL_CERT_FILE=\"${SSL_CERT_FILE:-%s}\"\\n' \"$ca_certs\" >> \"$out/bin/git\"\n"
        , "printf 'export GIT_SSL_CAINFO=\"${GIT_SSL_CAINFO:-%s}\"\\n' \"$ca_certs\" >> \"$out/bin/git\"\n"
        , "printf '%s\\n' 'export GIT_EXEC_PATH=\"$SCRIPT_DIR/libexec/git-core\"' >> \"$out/bin/git\"\n"
        , "printf '%s\\n' 'exec \"$SCRIPT_DIR/bin/git.real\" \"$@\"' >> \"$out/bin/git\"\n"
        , "chmod +x \"$out/bin/git\"\n"
        , "\n"
        , "(\n"
        , "  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES\n"
        , "  export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null\n"
        , "  \"$out/bin/git\" init --quiet --template= \"$TMP/git-probe\"\n"
        , "  object=\"$(printf '%s' 'rubble git probe' | \"$out/bin/git\" -C \"$TMP/git-probe\" hash-object -w --stdin)\"\n"
        , "  actual=\"$(\"$out/bin/git\" -C \"$TMP/git-probe\" cat-file blob \"$object\")\"\n"
        , "  test \"$actual\" = 'rubble git probe'\n"
        , ")\n"
        , "rm -rf \"$TMP/git-probe\""
        ]
      , "format": "text"
      }
    }
  , { "shell": {
        "value": [
          "publish_output_directory \"$out/bin\" \"$bin\"\n"
        , "publish_output_directory \"$out/lib\" \"$lib\"\n"
        , "publish_output_directory \"$out/libexec\" \"$libexec\""
        ]
      , "format": "text"
      }
    }
  ]
