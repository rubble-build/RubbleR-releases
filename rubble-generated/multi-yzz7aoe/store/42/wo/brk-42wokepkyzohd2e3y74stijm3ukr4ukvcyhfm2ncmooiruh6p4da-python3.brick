  , "7275gbi26p7nwzbzemzdy6p5g2bg34i7k4itgjgkpamfuygljyta-patchelf":
      { "id": "7275gbi26p7nwzbzemzdy6p5g2bg34i7k4itgjgkpamfuygljyta-patchelf"
      , "name": "patchelf"
      , "platform": "aarch64-linux"
      , "inputs": [
          { "brick": "qbrlu376mq3m5jhng65mdeobdbrpjzv3thrthfrpvoam77zovt3q-patchelf-0.18.0-aarch64.tar.gz"
          , "alias": "src"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        , { "name": "share" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar -xvf \"$src\"\n"
              , "mv bin/patchelf \"$out\"\n"
              , "mkdir -p \"$bin\"\n"
              , "ln -s \"$out\" \"$bin/patchelf\"\n"
              , "mv share \"$share\"\n"
              , "\"$out\" --version"
              ]
            , "format": "text"
            }
          }
        ]
      }
