          , "value": "5.2.015"
          }
        ]
      , "outputs": [
          { "name": "bin" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p \"$bin\"\n"
              , "cp \"$src\" \"$bin/bash\"\n"
              , "chmod +x \"$bin/bash\"\n"
              , "ln -s bash \"$bin/sh\"\n"
              , "\"$bin/bash\" -euo pipefail -c 'declare -A probe=([key]=value); [[ ${probe[key]} = value ]]'"
              ]
            , "format": "text"
