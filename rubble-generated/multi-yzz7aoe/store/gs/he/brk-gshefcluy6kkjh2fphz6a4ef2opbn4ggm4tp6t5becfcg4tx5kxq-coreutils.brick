      , "name": "bash"
      , "platform": "aarch64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "g3fxen4ug3f3g34imdsefwplwd3ulzn75tn5uxd5jqe7t23bzyna-bash-linux-aarch64"
          , "alias": "src"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
