{ "id": "uddv6krsdvnxc7tfxwgucpbilghbnae23heo74anfah5rxvhhvxa-glibc-runtime-support"
, "name": "glibc-runtime-support"
, "rubble_home": "/var/lib/rubble"
, "opaque": true
, "inputs": [
    { "brick": "mrv3skvefohwhqxqk3loonbdoqonymgrvgcggyajysjlj44rvo6q-coreutils"
    , "alias": "coreutils"
    , "transitive": "false"
    }
  , { "brick": "65tk5pseuj37atpxc7fyjfylydn4es5jaedcsl7pnrgji7rro7zq-RubbleR.git.partial"
    , "alias": "src"
    , "transitive": "false"
    , "hooks": {
        "post-checkout": [
          { "install-to": [
              { "output": "dir"
              , "dir": "./" }
            ]
          }
        , { "shell": {
              "value": [
                "rubble-exec rm -f -- \"${TMP}/rubble-source.env\"\n"
              , "( source \"${script}\" \"${dir}\" --env-file \"${TMP}/rubble-source.env\" )\n"
              , "__rubble_import_source_environment \"${TMP}/rubble-source.env\""
              ]
            , "format": "text"
            }
          }
        ]
      }
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "\"${coreutils[bin]}/mkdir\" -p \"$out\"\n"
        , "for file in initialize.c build-initializer.bash probe.c external-nss.c \\\n"
        , "  external-gconv.c passwd-namespace.c audit.bash README.md; do\n"
        , "  \"${coreutils[bin]}/cp\" \"scripts/glibc-runtime-support/$file\" \"$out/$file\"\n"
        , "done"
        ]
      , "format": "text"
      }
    }
  ]
, "inventory": {
    "2dmy2py5hdqkwaqkgx42iababq4z232di4ts36pnm5esucm3ywma-utmps-libs-0.1.2.3-r2.apk":
      { "id": "2dmy2py5hdqkwaqkgx42iababq4z232di4ts36pnm5esucm3ywma-utmps-libs-0.1.2.3-r2.apk"
