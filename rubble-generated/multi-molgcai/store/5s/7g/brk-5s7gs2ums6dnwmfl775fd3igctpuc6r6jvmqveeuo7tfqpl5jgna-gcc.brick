      { "id": "6o4wm66qnadsqlllvxr5j7elb4cbrtze23xd2cjolcomfpvpmhcq-rubble-script-shebang"
      , "name": "rubble-script-shebang"
      , "rubble_home": "/var/lib/rubble"
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "script" }
        , { "name": "features" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "\"${rubble:?missing rubble executable}\" -q output cat \"rubble://abi/inventory/rubble-script-shebang/hash:2ullkj3cxcjjrmpw4mno7owpfoajfw6zcrs4xfumt7fis52j6bpq\" script > \"$script\""
              ]
            , "format": "text"
            }
          }
        , { "write": {
          "output": "features"
        , "template": "{content}"
        , "values": {
            "content": {
            "checksum": "sha256:ebe6abf29157510d71932d9f90e4eebc15f5823995f803fe559695313f798704"
            , "value": [
              "KLUv/WTmCXUpAPpFzAsp4M6mbTMITbbXRKB6Fj8bKbbwQzz3IpmDt/jNkwfIRwo3CUQwxliEmRfGAKkAqQCo4"
