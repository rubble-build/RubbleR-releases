  , "nqezvr7gvu4qzj2ite3o6mk64b5foml47t6vrs2j37pggzdvnvgq-gnu-sed":
      { "id": "nqezvr7gvu4qzj2ite3o6mk64b5foml47t6vrs2j37pggzdvnvgq-gnu-sed"
      , "name": "gnu-sed"
      , "platform": "aarch64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "isxo3o4skm7vtiqyhakx4x4uxrw7hnycm3ldwp43grskdhxl3qxq-sed-4.9-r2.apk"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "dhzowymraqoa262lv45rzgrpjrqdedusoctmkao7qctbpck3qiva-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "x6m3rqymxcy5i664gnpmwk7ucihlqh6ycfty4kbsjtg7mmfvb6eq-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "tyqosp4fpdd7pjacveojot6m2g5ls3hqljfqp4qerplz2kuwcvua-musl-install-tools"
          , "alias": "musl_tools"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar -xzf \"$src\" 2>/dev/null || true\n"
              , "\"${musl_tools[install]}\" bin/sed \"$out\" \"$patchelf\" \"$ld_musl\"\n"
              , "\"${musl_tools[link_commands]}\" \"$out\" \"$bin\" sed\n"
              , "\n"
              , "printf 'rubble42\\n' > \"$TMP/sed-probe\"\n"
              , "\"$out\" -E -i 's/[0-9]+/-gnu/' \"$TMP/sed-probe\"\n"
              , "test \"$(cat \"$TMP/sed-probe\")\" = rubble-gnu\n"
              , "rm -f \"$TMP/sed-probe\""
              ]
            , "format": "text"
            }
          }
        ]
      }
