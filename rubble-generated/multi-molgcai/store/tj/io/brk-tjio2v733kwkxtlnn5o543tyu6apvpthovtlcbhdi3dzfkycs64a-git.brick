    }
  , { "brick": "faqk22fjqryqxjx6pkufmb2mttau3gwuv2qu6roi3d4melszcu7q-libunistring-1.2-r0.apk"
    , "alias": "libunistring_apk"
    , "transitive": "false"
    }
  , { "brick": "p6eqluqrei7jxrpnr2nogcmndvhzkr37f2j47nrfkscrbtnpy64q-libssl3-3.3.7-r2.apk"
    , "alias": "libssl_apk"
    , "transitive": "false"
    }
  , { "brick": "77pafwgzhgk3kbtyd3i5bnikedwfoif6mfaibfesmfc655t35naq-libpsl-0.21.5-r3.apk"
    , "alias": "libpsl_apk"
    , "transitive": "false"
    }
  , { "brick": "s3pvvtqxrdzleije623ea64covxuywd4s6akx2d5lpxokyytr4ea-libidn2-2.3.7-r0.apk"
    , "alias": "libidn2_apk"
    , "transitive": "false"
    }
  , { "brick": "jdtcafj4hys4txg5vxmtvui2dl5sovyb5lontwbsxlieat3mlila-libexpat-2.10.0-r0.apk"
    , "alias": "libexpat_apk"
    , "transitive": "false"
    }
  , { "brick": "p5rxp6x26yjm6b5t2lf3kco5u2w2zko2k3ma5odcrnnmsixwhj6a-libcurl-8.14.1-r3.apk"
    , "alias": "libcurl_apk"
    , "transitive": "false"
    }
  , { "brick": "dvrllqig4vloxhgyjrmpzimbvdcatflu5xsgnfnhez77trxhzbaa-libcrypto3-3.3.7-r2.apk"
    , "alias": "libcrypto_apk"
    , "transitive": "false"
    }
  , { "brick": "x6m3rqymxcy5i664gnpmwk7ucihlqh6ycfty4kbsjtg7mmfvb6eq-ld-musl.so"
    , "alias": "ld_musl"
    , "transitive": "true"
    }
  , { "brick": "qg3g2dinqfibxj3dkbjqgp6q4vhezm2w5ayy7ibamcbqov7sunuq-git-2.47.3-r0.apk"
    , "alias": "git_apk"
    , "transitive": "false"
    }
  , { "brick": "pvvzoxgx7z6mmjnme5ravamtm5ce2mbexhvimkyopjclasv4dhpq-ca-certificates.pem"
    , "alias": "ca_certs"
    , "transitive": "true"
    }
  , { "brick": "kcxminepu2ywfwal6sveazxuz3b5emokjvaje5k6edxumr4ncr7q-c-ares-1.34.9-r0.apk"
    , "alias": "cares_apk"
    , "transitive": "false"
    }
  , { "brick": "cc25q3jglva6ayeaiegjq7f52i5fe3w3j2navr35izea4kmwayaq-brotli-libs-1.1.1-r0.apk"
    , "alias": "brotli_apk"
    , "transitive": "false"
    }
  , { "brick": "7gaiswvomctprmbv5i6dhxav3urpsmceezmwy52qv42yok44lygq-bash"
    , "alias": "bash"
    , "transitive": "true"
    }
  , { "brick": "nqezvr7gvu4qzj2ite3o6mk64b5foml47t6vrs2j37pggzdvnvgq-gnu-sed"
    , "alias": "gnu_sed"
    , "transitive": "true"
    }
  , { "brick": "defmfedonkfkblaqtfzjs7kvoq2u5k53xo3zzl43it7q634ax7ja-collect-shared-libraries"
    , "alias": "collect_libraries"
    , "transitive": "false"
    }
  , { "brick": "3wm4cdhbw7rufcah5dges6g3jzapjyjpwtravjh5rclsluy3vgaq-coreutils"
    , "alias": "coreutils"
    , "transitive": "true"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  , { "name": "bin" }
  , { "name": "lib" }
  , { "name": "libexec" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "mkdir -p \"$out/bin\" \"$out/lib\" \"$out/libexec\" extract\n"
        , "\n"
        , "for apk in \"$git_apk\" \"$pcre2_apk\" \"$zlib_apk\" \"$libexpat_apk\" \\\n"
        , "           \"$libcurl_apk\" \"$cares_apk\" \"$libidn2_apk\" \"$libpsl_apk\" \\\n"
        , "           \"$brotli_apk\" \"$nghttp2_apk\" \"$libunistring_apk\" \\\n"
        , "           \"$libcrypto_apk\" \"$libssl_apk\" \"$zstd_libs_apk\"; do\n"
        , "  tar -xzf \"$apk\" -C extract 2>/dev/null || true\n"
        , "done\n"
        , "\n"
        , "# Copy all shared libraries\n"
        , "\"$collect_libraries\" \"$out/lib\" recursive ignore extract\n"
        , "\n"
        , "# Copy git binaries — rename the main binary so we can create a wrapper\n"
        , "cp extract/usr/bin/git \"$out/bin/git.real\"\n"
        , "for f in extract/usr/bin/git-*; do\n"
        , "  [ -f \"$f\" ] && cp -a \"$f\" \"$out/bin/\"\n"
        , "done\n"
        , "\n"
        , "# Copy git-core with proper handling of symlinks\n"
        , "mkdir -p \"$out/libexec/git-core\"\n"
        , "for f in extract/usr/libexec/git-core/*; do\n"
        , "  if [ -f \"$f\" ] && [ ! -L \"$f\" ]; then\n"
        , "    cp -a \"$f\" \"$out/libexec/git-core/\"\n"
        , "  elif [ -L \"$f\" ]; then\n"
        , "    target=$(readlink \"$f\")\n"
        , "    name=$(basename \"$f\")\n"
        , "    if [ \"$target\" = \"../../bin/git\" ]; then\n"
        , "      ln -sf \"../../bin/git.real\" \"$out/libexec/git-core/$name\"\n"
        , "    else\n"
        , "      cp -a \"$f\" \"$out/libexec/git-core/\"\n"
        , "    fi\n"
        , "  fi\n"
        , "done\n"
        , "\n"
        , "# Update symlinks in bin/ that point to git\n"
        , "for f in \"$out/bin/\"*; do\n"
        , "  if [ -L \"$f\" ]; then\n"
        , "    target=$(readlink \"$f\")\n"
        , "    if [ \"$target\" = \"git\" ]; then\n"
        , "      ln -sf \"git.real\" \"$f\"\n"
        , "    fi\n"
        , "  fi\n"
        , "done\n"
        , "\n"
        , "# Patch all ELF binaries to use musl interpreter from runtime home\n"
        , "for dir in \"$out/bin\" \"$out/libexec/git-core\"; do\n"
        , "  for elf_file in \"$dir/\"*; do\n"
        , "    [ -f \"$elf_file\" ] && [ ! -L \"$elf_file\" ] || continue\n"
        , "    if \"$patchelf\" --print-interpreter \"$elf_file\" >/dev/null 2>&1; then\n"
        , "      \"$patchelf\" --set-interpreter \"$ld_musl\" --set-rpath \"$out/lib\" \"$elf_file\"\n"
        , "    fi\n"
        , "  done\n"
        , "done\n"
        , "\n"
        , "rubble_script_shebang_register \"${bash[bin]}/bash\" sh bash\n"
        , "rubble_script_shebang_rewrite_all --strict --all \"$out/libexec/git-core\"\n"
        , "\n"
        , "# Bind runtime helpers and retain caller PATH additions and certificate settings.\n"
        , "{\n"
        , "  printf '%s\\n' \"#!${bash[bin]}/bash\"\n"
        , "  printf 'SCRIPT_DIR=%q\\n' \"$out\"\n"
        , "  printf 'CA_CERTS=%q\\n' \"$ca_certs\"\n"
        , "  printf 'RUNTIME_PATH=%q\\n' \"${bash[bin]}:${coreutils[bin]}:${gnu_sed[bin]}\"\n"
        , "  printf '%s\\n' 'export PATH=\"$RUNTIME_PATH${PATH:+:$PATH}\"' \\\n"
        , "    'export SSL_CERT_FILE=\"${SSL_CERT_FILE:-$CA_CERTS}\"' \\\n"
        , "    'export GIT_SSL_CAINFO=\"${GIT_SSL_CAINFO:-$CA_CERTS}\"' \\\n"
        , "    'export GIT_EXEC_PATH=\"$SCRIPT_DIR/libexec/git-core\"' \\\n"
        , "    'exec \"$SCRIPT_DIR/bin/git.real\" \"$@\"'\n"
        , "} > \"$out/bin/git\"\n"
        , "chmod +x \"$out/bin/git\"\n"
        , "\n"
        , "(\n"
        , "  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES\n"
        , "  export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null\n"
        , "  \"$out/bin/git\" init --quiet --template= \"$TMP/git-probe\"\n"
        , "  object=\"$(printf '%s' 'rubble git probe' | \"$out/bin/git\" -C \"$TMP/git-probe\" hash-object -w --stdin)\"\n"
        , "  actual=\"$(\"$out/bin/git\" -C \"$TMP/git-probe\" cat-file blob \"$object\")\"\n"
        , "  test \"$actual\" = 'rubble git probe'\n"
        , "  PATH= \"$out/bin/git\" -C \"$TMP/git-probe\" submodule status\n"
        , ")\n"
        , "rm -rf \"$TMP/git-probe\""
        ]
      , "format": "text"
      }
    }
  , { "shell": {
        "value": [
          "publish_output_directory \"$out/bin\" \"$bin\"\n"
        , "publish_output_directory \"$out/lib\" \"$lib\"\n"
        , "publish_output_directory \"$out/libexec\" \"$libexec\""
        ]
      , "format": "text"
      }
    }
  ]
