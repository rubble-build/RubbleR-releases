  , "yecbppbe2hram3gythftkgn6mwelxq6l42vejdrjy3czbotcwmoq-bash":
      { "id": "yecbppbe2hram3gythftkgn6mwelxq6l42vejdrjy3czbotcwmoq-bash"
      , "name": "bash"
      , "platform": "aarch64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "g3fxen4ug3f3g34imdsefwplwd3ulzn75tn5uxd5jqe7t23bzyna-bash-linux-aarch64"
          , "alias": "src"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "version"
          , "value": "5.2.015"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p \"$out/bin\"\n"
              , "\n"
              , "# Copy bash binary (src is the downloaded file directly)\n"
              , "cp -v \"$src\" \"$out/bin/bash\"\n"
              , "chmod +x \"$out/bin/bash\"\n"
              , "\n"
              , "# Create sh symlink\n"
              , "ln -s bash \"$out/bin/sh\"\n"
              , "\n"
              , "# Verify\n"
              , "echo \"\"\n"
              , "echo \"=== Verifying bash installation ===\"\n"
              , "\"$out/bin/bash\" --version\n"
              , "test -x \"$out/bin/bash\"\n"
              , "\"$out/bin/bash\" -c 'echo bash runtime check'"
              ]
            , "format": "text"
            }
          }
        ]
      }
