          { "shell": {
              "value": [
                "tar -xvf \"$src\"\n"
              , "mv bin/patchelf \"$bin\"\n"
              , "mv share \"$share\"\n"
              , "\"$bin\" --version"
              ]
            , "format": "text"
            }
          }
        ]
      }
