              , "\n"
              , "# Copy bash binary (src is the downloaded file directly)\n"
              , "cp -v \"$src\" \"$out/bin/bash\"\n"
              , "chmod +x \"$out/bin/bash\"\n"
              , "\n"
              , "# Create sh symlink\n"
              , "ln -s bash \"$out/bin/sh\"\n"
              , "\n"
              , "# Verify\n"
              , "echo \"\"\n"
              , "echo \"=== Verifying bash installation ===\"\n"
              , "\"$out/bin/bash\" --version\n"
              , "test -x \"$out/bin/bash\"\n"
              , "\"$out/bin/bash\" -c 'echo bash runtime check'"
              ]
            , "format": "text"
