{ "id": "xp4ng2csk5hs2jlwyfptf7imm4gd3jifcoxvhghuz7b7qf5nidla-findutils"
, "name": "findutils"
, "platform": "aarch64-linux"
, "build_platform": "aarch64-linux"
, "rubble_home": "/var/lib/rubble"
, "inputs": [
    { "brick": "cndex52rgwiybhxcbkpry2isc55dz3hrc5lblmzr3xyeilghixda-patchelf"
    , "alias": "patchelf"
    , "transitive": "false"
    }
  , { "brick": "65xn763kfhf7ye2ax5rr3hjotrij3qjagkddvfhqarwrt2a7mnha-ld-musl.so"
    , "alias": "ld_musl"
    , "transitive": "true"
    }
  , { "brick": "m5lnpllbzm555r5zuagxbaoqomumjvcwyoq7xdkffysmdvteelwa-findutils-4.10.0-r0.apk"
    , "alias": "src"
    , "transitive": "false"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "echo \"Extracting findutils package...\"\n"
        , "tar -xzf \"$src\" 2>/dev/null || true\n"
        , "\n"
        , "mkdir -p \"$out/bin\"\n"
        , "\n"
        , "# Copy and patch find and xargs binaries\n"
        , "for cmd in find xargs; do\n"
        , "  if [ -f \"usr/bin/$cmd\" ]; then\n"
        , "    cp \"usr/bin/$cmd\" \"$out/bin/$cmd\"\n"
        , "    chmod +x \"$out/bin/$cmd\"\n"
        , "    \"$patchelf\" --set-interpreter \"$ld_musl\" \"$out/bin/$cmd\"\n"
        , "  fi\n"
        , "done\n"
        , "\n"
        , "# Verify\n"
        , "echo \"\"\n"
        , "echo \"=== Verifying GNU findutils installation ===\"\n"
        , "\"$out/bin/find\" --version | head -1 || true\n"
        , "\"$out/bin/xargs\" --version | head -1 || true"
        ]
      , "format": "text"
      }
    }
  ]
, "inventory": {
    "qbrlu376mq3m5jhng65mdeobdbrpjzv3thrthfrpvoam77zovt3q-patchelf-0.18.0-aarch64.tar.gz":
      { "id": "qbrlu376mq3m5jhng65mdeobdbrpjzv3thrthfrpvoam77zovt3q-patchelf-0.18.0-aarch64.tar.gz"
      , "name": "patchelf-0.18.0-aarch64.tar.gz"
      , "src": {
          "url": "https://github.com/NixOS/patchelf/releases/download/0.18.0/patchelf-0.18.0-aarch64.tar.gz"
        , "checksum": "sha256:ae13e2effe077e829be759182396b931d8f85cfb9cfe9d49385516ea367ef7b2"
        }
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "__rubble_skip_src_split__"
          , "value": "true"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "cp -ar \"$src\" \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "cndex52rgwiybhxcbkpry2isc55dz3hrc5lblmzr3xyeilghixda-patchelf":
