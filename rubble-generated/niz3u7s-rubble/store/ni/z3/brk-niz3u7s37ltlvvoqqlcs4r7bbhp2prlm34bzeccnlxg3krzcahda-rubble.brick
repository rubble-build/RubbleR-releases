      }
        , { "shell": {
              "value": [
                "project_dir=\"$PWD\"\n"
              , "mkdir -p \"$project_dir/target\"\n"
              , "export CARGO_HOME=\"$project_dir/target/cargo_home\"\n"
              , "\n"
              , "launcher_suffix=\"\"\n"
              , "if [[ -n \"${MSYS2_ROOT:-}\" ]]; then\n"
              , "  launcher_suffix=\".exe\"\n"
              , "fi\n"
              , "isolated_cargo_dir=\"$project_dir/target/rubble-isolated-bin\"\n"
              , "isolated_cargo=\"$isolated_cargo_dir/cargo${launcher_suffix}\"\n"
              , "launcher_test=\"$project_dir/.rubble-tools/cargo-launcher-test${launcher_suffix}\"\n"
              , "mkdir -p \"$isolated_cargo_dir\"\n"
              , "rustc --edition=2024 --test \"$project_dir/.rubble-tools/cargo-launcher.rs\" -o \"$launcher_test\"\n"
              , "\"$launcher_test\"\n"
              , "rustc --edition=2024 -C opt-level=3 \"$project_dir/.rubble-tools/cargo-launcher.rs\" -o \"$isolated_cargo\"\n"
              , "rm -f \"$launcher_test\"\n"
              , "\n"
              , "# Cargo always receives one explicit project config. The empty initial\n"
              , "# file is replaced with the vendored source configuration below.\n"
              , "mkdir -p \"$project_dir/.cargo\"\n"
              , ": > \"$project_dir/.cargo/config.toml\"\n"
              , "\n"
              , "# 2. Vendor all dependencies with versioned dirs\n"
              , "echo \"=== Vendoring dependencies ===\"\n"
              , "\"$isolated_cargo\" vendor \\\n"
              , "  --manifest-path \"$project_dir/Cargo.toml\" \\\n"
              , "  --versioned-dirs \"$project_dir/vendor\"\n"
              , "\n"
              , "# 3. Generate .cargo/config.toml with multi-version patch support\n"
              , "echo \"=== Generating .cargo/config.toml ===\"\n"
              , "mkdir -p .cargo\n"
              , "echo '[patch.crates-io]' > .cargo/config.toml\n"
              , "\n"
              , "for dir in vendor/*/; do\n"
              , "  dir_name=$(basename \"$dir\")\n"
              , "  # Get package name and version from Cargo.toml\n"
              , "  pkg_name=$(grep -m1 '^name' \"$dir/Cargo.toml\" | sed 's/.*\"\\(.*\\)\".*/\\1/')\n"
              , "  pkg_version=$(grep -m1 '^version' \"$dir/Cargo.toml\" | sed 's/.*\"\\(.*\\)\".*/\\1/')\n"
              , "\n"
              , "  if [[ -n \"$pkg_name\" && -n \"$pkg_version\" ]]; then\n"
              , "    # Use unique key: package_name_version (replace . and - with _)\n"
              , "    key_name=$(echo \"${pkg_name}_${pkg_version}\" | tr '.-' '_')\n"
              , "    echo \"\\\"${key_name}\\\" = { path = \\\"vendor/${dir_name}\\\", package = \\\"${pkg_name}\\\", version = \\\"=${pkg_version}\\\" }\" >> .cargo/config.toml\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "echo \"Generated config.toml entries: $(wc -l < .cargo/config.toml)\"\n"
              , "\n"
              , "# 4. Build dependencies using skeleton project\n"
              , "echo \"=== Building dependencies ===\"\n"
              , "\n"
              , "export OPENSSL_CONFIG_DIR=\"/rubble/openssl/ssl\"\n"
              , "# Cap lints to warn level for vendored crates (path deps don't get cap-lints=allow)\n"
              , "# This prevents Rust version upgrades from breaking builds due to new deny lints.\n"
              , "# Do not add build-path remaps here; Cargo fingerprints RUSTFLAGS and cache reuse depends on this staying stable.\n"
              , "export RUSTFLAGS=\"${RUSTFLAGS:-} --cap-lints warn\"\n"
              , "\"$isolated_cargo\" build \\\n"
              , "  --manifest-path \"$project_dir/Cargo.toml\" \\\n"
              , "  --release -j1\n"
              , "\n"
              , "# 5. Remove skeleton project artifacts, keep dependency artifacts\n"
              , "echo \"=== Cleaning project-specific artifacts ===\"\n"
              , "find target -path \"*/release/.fingerprint/rubble-*\" -exec rm -rf {} + 2>/dev/null || true\n"
              , "find target -path \"*/release/.fingerprint/rubble_derive-*\" -exec rm -rf {} + 2>/dev/null || true\n"
              , "find target -path \"*/release/deps/*rubble*\" -delete 2>/dev/null || true\n"
              , "find target -path \"*/release/rubble*\" -not -path \"*/deps/*\" -delete 2>/dev/null || true\n"
              , "find target -path \"*/release/librubble*\" -not -path \"*/deps/*\" -not -path \"*rubble_derive*\" -delete 2>/dev/null || true\n"
              , "\n"
              , "# 6. Remove crates with hardcoded native lib paths that become stale when cached\n"
              , "# These crates store absolute paths to vendor directories in their output files,\n"
              , "# which break when the cache is copied to a different build location.\n"
              , "echo \"=== Removing crates with hardcoded native paths ===\"\n"
              , "for pattern in windows_x86_64_gnu winapi-x86_64-pc-windows-gnu windows_aarch64_gnullvm; do\n"
              , "  find target -path \"*/release/build/${pattern}-*\" -exec rm -rf {} + 2>/dev/null || true\n"
              , "  find target -path \"*/release/.fingerprint/${pattern}-*\" -exec rm -rf {} + 2>/dev/null || true\n"
              , "done\n"
              , "\n"
              , "# 6. Output\n"
              , "echo \"=== Copying to output ===\"\n"
              , "mkdir -p \"$out\"\n"
              , "cp -a vendor \"$out/\"\n"
              , "cp -a target \"$out/\"\n"
              , "cp -a .cargo \"$out/\"\n"
              , "cp Cargo.lock \"$out/\"\n"
              , "\n"
              , "echo \"=== Output size ===\"\n"
              , "du -sh \"$out\"/*"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "regoxzdjco6l24wacxv6igyyaqk7nfks2okct3g7rcat33gzh7ba-rubble-web-assets":
      { "id": "regoxzdjco6l24wacxv6igyyaqk7nfks2okct3g7rcat33gzh7ba-rubble-web-assets"
