        , { "brick": "iqruyywvdmkzsmzzmu7rmrnp6fqgg7e2na76j3ty3skevyvcbu4q-libquadmath0_14.2.0-19_amd64.deb"
          , "alias": "libquadmath0_deb"
          , "transitive": "false"
          }
        , { "brick": "4rgcrtd62az4jvrpnqi7mo4lmi6jkafzaizl5renuatipxrg3soa-libmpfr6_4.2.2-1_amd64.deb"
          , "alias": "libmpfr6_deb"
          , "transitive": "false"
          }
        , { "brick": "wo6vgn55jsmxeqnkavm4rcompkku3ssc2xyxdc4nrbbcx5ggc2ea-libmpc3_1.3.1-1_b3_amd64.deb"
          , "alias": "libmpc3_deb"
          , "transitive": "false"
          }
        , { "brick": "7b5qkq7h725rlzwyjms32eiu6becwobfozmdtl3nmob3t75vmiuq-liblsan0_14.2.0-19_amd64.deb"
          , "alias": "liblsan0_deb"
          , "transitive": "false"
          }
        , { "brick": "ngfmqg7sdtevod5fupkehkz7ngg7lb4zc6hfheixgvduoprmea4a-libjansson4_2.14-2_b3_amd64.deb"
          , "alias": "libjansson4_deb"
          , "transitive": "false"
          }
        , { "brick": "2khe7fyham7ciybnkxksiegiv56edsph55lu6pvdrik6sznbr3sa-libitm1_14.2.0-19_amd64.deb"
          , "alias": "libitm1_deb"
          , "transitive": "false"
          }
        , { "brick": "smglbxy2qltuw55ubbydcyhowlyzyzpmmwhii6rttwdgrcn6yhwa-libisl23_0.27-1_amd64.deb"
          , "alias": "libisl23_deb"
          , "transitive": "false"
          }
        , { "brick": "soyqxtymcfjf74xui3ydngvt6so3orqonn4dzhh2gpwgcp2q6gna-libhwasan0_14.2.0-19_amd64.deb"
          , "alias": "libhwasan0_deb"
          , "transitive": "false"
          }
        , { "brick": "5cl2d3x6sk6fpzz2vyvzamieqdptlqxbsijlye75apvhdjupzhfq-libgomp1_14.2.0-19_amd64.deb"
          , "alias": "libgomp1_deb"
          , "transitive": "false"
          }
        , { "brick": "ry7dxugonx43nz5l7zqafhnyf7g44osnmhejuhlt4x3bhh6x4lya-libgmp10_6.3.0_dfsg-3_amd64.deb"
          , "alias": "libgmp10_deb"
          , "transitive": "false"
          }
        , { "brick": "w34r6xbrp5naxtwy4i2yjuqgwtocs272gmp3wpl6jzg7tchrtjra-libgcc-s1_14.2.0-19_amd64.deb"
          , "alias": "libgcc_s1_deb"
          , "transitive": "false"
          }
        , { "brick": "c2pb6bog4hbnzghhl2bdm4jrrqnq5e5oxiobkywqsl7p7igdtfva-libgcc-14-dev_14.2.0-19_amd64.deb"
          , "alias": "libgcc_dev_deb"
          , "transitive": "false"
          }
        , { "brick": "c27nqfizbqju23t62gn5fz5at7aiszoc2jdo7rca33boiwj4rrwq-libctf0_2.44-3_amd64.deb"
          , "alias": "libctf0_deb"
          , "transitive": "false"
          }
        , { "brick": "y2gczfciw3klma4mkheml5yh6gpkn4mnakp5qr5vsjygqqy33paa-libctf-nobfd0_2.44-3_amd64.deb"
          , "alias": "libctf_nobfd0_deb"
          , "transitive": "false"
          }
        , { "brick": "txb64vqfae7aa5nhycodgois76zpayaio6xopelsmuan5mnhhzzq-libcc1-0_14.2.0-19_amd64.deb"
          , "alias": "libcc1_0_deb"
          , "transitive": "false"
          }
        , { "brick": "p64ubkpmkkadsqqhidffg25atg2wgfinaacychgsfyt3outqqtdq-libc6_2.41-12_deb13u3_amd64.deb"
          , "alias": "libc6_deb"
          , "transitive": "false"
          }
        , { "brick": "3lwxgkj4bfhbzzcj2f4ouooyvkjr2hnt4bixwahhr3jmry6lnmwq-libc6-dev_2.41-12_deb13u3_amd64.deb"
          , "alias": "libc6_dev_deb"
          , "transitive": "false"
          }
        , { "brick": "r2rl2pbw7edcma3xcpjbnfmj5xa2l5ltff3xr3tyxxpfej5udu5a-libbinutils_2.44-3_amd64.deb"
          , "alias": "libbinutils_deb"
          , "transitive": "false"
          }
        , { "brick": "fyjvlznpum5cwh7apldb3sv4skrbahxa5uekyqo2eqwrcm2tzuxq-libatomic1_14.2.0-19_amd64.deb"
          , "alias": "libatomic1_deb"
          , "transitive": "false"
          }
        , { "brick": "6mnzlup57yva4f25swep426asen4gktqclnqldiusl5pv2ejz22q-libasan8_14.2.0-19_amd64.deb"
          , "alias": "libasan8_deb"
          , "transitive": "false"
          }
        , { "brick": "evtymdmzbmwvbqahpv3jn3fct73m5qstjmh54f2o7msjks7krita-gcc-14-x86-64-linux-gnu_14.2.0-19_amd64.deb"
          , "alias": "gcc_deb"
          , "transitive": "false"
          }
        , { "brick": "unxlmwftoohd5ub6hgpvylolxd6zjczt462o5jf6zyb2nmexflpa-gcc-14-base_14.2.0-19_amd64.deb"
          , "alias": "gcc_base_deb"
          , "transitive": "false"
          }
        , { "brick": "ihkb436hgrr2ikz2jd4v5enxpqhklppqp6s5usbutl4q6fqxs3ja-g__-14-x86-64-linux-gnu_14.2.0-19_amd64.deb"
          , "alias": "gpp_deb"
          , "transitive": "false"
          }
        , { "brick": "rr24d5jtgkkrifatmbdolj2lttqqu6g5h35w3qe536jpenad2e6q-cpp-14-x86-64-linux-gnu_14.2.0-19_amd64.deb"
          , "alias": "cpp_deb"
          , "transitive": "false"
          }
        , { "brick": "5s2guvzpcv5iov3rog7fjz2t5oa3idprxh4z7lst5ipo2mlpo2mq-binutils-x86-64-linux-gnu_2.44-3_amd64.deb"
          , "alias": "binutils_deb"
          , "transitive": "false"
          }
        , { "brick": "luy4bjnugq4iyxf653mduencnzaptaunhu4mph7pdata3houha5q-binutils-common_2.44-3_amd64.deb"
          , "alias": "binutils_common_deb"
          , "transitive": "false"
          }
        , { "brick": "bxchorbehgapcopsqwo7w5zwjgenujywlkkytlnad3dvy5hpqc5q-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "46lfnhiwl7xwedh2m5nqmsiz53zc3vcpqiox4v4mctm56nzwlz6a-bootstrap-env"
          , "alias": "bootstrap"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$out/setup-env.sh\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "jollno6o4uloupgitupgjbfxgunhmm5hx3hdhvl7kbmw47dj4dpq-glibc-runtime-support"
          , "alias": "glibc_support"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "gnu_triple"
          , "value": "x86_64-linux-gnu"
          }
        , { "name": "ld_linux_dir"
          , "value": "lib64"
          }
        , { "name": "ld_linux_name"
          , "value": "ld-linux-x86-64.so.2"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "staging=\"$PWD/staging\"\n"
              , "mkdir -p \"$out/bin\" \"$out/lib\" \"$out/$ld_linux_dir\" \"$out/include\" \\\n"
              , "         \"$out/libexec/gcc/${gnu_triple}/14\" \\\n"
              , "         \"$out/lib/gcc/${gnu_triple}/14\" \\\n"
              , "         \"$staging\"\n"
              , "\n"
              , "extract_deb() {\n"
              , "  local deb=\"$1\"\n"
              , "  local tmp=\"$PWD/extract_tmp\"\n"
              , "  rm -rf \"$tmp\" && mkdir -p \"$tmp\"\n"
              , "  (\n"
              , "    cd \"$tmp\"\n"
              , "    ar x \"$deb\"\n"
              , "    for data in data.tar.*; do\n"
              , "      tar xf \"$data\" -C \"$staging\"\n"
              , "    done\n"
              , "  )\n"
              , "  rm -rf \"$tmp\"\n"
              , "}\n"
              , "\n"
              , "echo \"=== Extracting Debian packages ===\"\n"
              , "for deb in \"$gcc_deb\" \"$cpp_deb\" \"$gpp_deb\" \"$gcc_base_deb\" \\\n"
              , "           \"$libgcc_dev_deb\" \"$libgcc_s1_deb\" \"$libstdcpp6_deb\" \\\n"
              , "           \"$libstdcpp_dev_deb\" \"$binutils_deb\" \"$binutils_common_deb\" \\\n"
              , "           \"$libbinutils_deb\" \"$libctf0_deb\" \"$libctf_nobfd0_deb\" \\\n"
              , "           \"$libsframe1_deb\" \"$libjansson4_deb\" \"$libc6_deb\" \\\n"
              , "           \"$libc6_dev_deb\" \"$linux_libc_dev_deb\" \"$libgmp10_deb\" \\\n"
              , "           \"$libisl23_deb\" \"$libmpc3_deb\" \"$libmpfr6_deb\" \\\n"
              , "           \"$libzstd1_deb\" \"$zlib1g_deb\" \\\n"
              , "           \"$libgomp1_deb\" \"$libitm1_deb\" \"$libatomic1_deb\" \\\n"
              , "           \"$libasan8_deb\" \"$liblsan0_deb\" \"$libtsan2_deb\" \\\n"
              , "           \"$libubsan1_deb\" \"$libhwasan0_deb\" \"$libcc1_0_deb\"; do\n"
              , "  echo \"  Extracting $(basename \"$deb\")...\"\n"
              , "  extract_deb \"$deb\"\n"
              , "done\n"
              , "\n"
              , "if [ -n \"${libquadmath0_deb:-}\" ]; then\n"
              , "  extract_deb \"$libquadmath0_deb\"\n"
              , "fi\n"
              , "\n"
              , "echo \"=== Assembling toolchain ===\"\n"
              , "\n"
              , "# --- GCC compiler binaries ---\n"
              , "cp \"$staging/usr/bin/${gnu_triple}-gcc-14\" \"$out/bin/gcc\"\n"
              , "cp \"$staging/usr/bin/${gnu_triple}-gcc-ar-14\" \"$out/bin/gcc-ar\"\n"
              , "cp \"$staging/usr/bin/${gnu_triple}-gcc-nm-14\" \"$out/bin/gcc-nm\"\n"
              , "cp \"$staging/usr/bin/${gnu_triple}-gcc-ranlib-14\" \"$out/bin/gcc-ranlib\"\n"
              , "ln -s gcc \"$out/bin/cc\"\n"
              , "# G++\n"
              , "cp \"$staging/usr/bin/${gnu_triple}-g++-14\" \"$out/bin/g++\"\n"
              , "ln -s g++ \"$out/bin/c++\"\n"
              , "\n"
              , "# --- Binutils ---\n"
              , "for tool in ar as ld ld.bfd nm objcopy objdump ranlib readelf size \\\n"
              , "            strings strip addr2line c++filt elfedit gprof; do\n"
              , "  src_bin=\"$staging/usr/bin/${gnu_triple}-${tool}\"\n"
              , "  if [ -f \"$src_bin\" ]; then\n"
              , "    cp \"$src_bin\" \"$out/bin/$tool\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# --- GCC internal executables (cc1, cc1plus, collect2, lto-wrapper) ---\n"
              , "gcc_libexec=\"$staging/usr/libexec/gcc/${gnu_triple}/14\"\n"
              , "for f in cc1 cc1plus collect2 lto-wrapper lto1; do\n"
              , "  if [ -f \"$gcc_libexec/$f\" ]; then\n"
              , "    cp \"$gcc_libexec/$f\" \"$out/libexec/gcc/${gnu_triple}/14/\"\n"
              , "  fi\n"
              , "done\n"
              , "# LTO plugin\n"
              , "for f in \"$gcc_libexec\"/liblto_plugin.so*; do\n"
              , "  [ -e \"$f\" ] && cp -a \"$f\" \"$out/libexec/gcc/${gnu_triple}/14/\"\n"
              , "done\n"
              , "\n"
              , "# --- GCC lib directory (crt objects, libgcc, specs) ---\n"
              , "gcc_lib=\"$staging/usr/lib/gcc/${gnu_triple}/14\"\n"
              , "if [ -d \"$gcc_lib\" ]; then\n"
              , "  cp -a \"$gcc_lib\"/*.o \"$out/lib/gcc/${gnu_triple}/14/\" 2>/dev/null || true\n"
              , "  cp -a \"$gcc_lib\"/*.a \"$out/lib/gcc/${gnu_triple}/14/\" 2>/dev/null || true\n"
              , "  cp -a \"$gcc_lib\"/*.so* \"$out/lib/gcc/${gnu_triple}/14/\" 2>/dev/null || true\n"
              , "  cp -a \"$gcc_lib\"/*.spec \"$out/lib/gcc/${gnu_triple}/14/\" 2>/dev/null || true\n"
              , "  # GCC internal headers (stddef.h, stdarg.h, etc.)\n"
              , "  [ -d \"$gcc_lib/include\" ] && cp -a \"$gcc_lib/include\" \"$out/lib/gcc/${gnu_triple}/14/\"\n"
              , "  [ -d \"$gcc_lib/include-fixed\" ] && cp -a \"$gcc_lib/include-fixed\" \"$out/lib/gcc/${gnu_triple}/14/\"\n"
              , "fi\n"
              , "\n"
              , "# --- Shared libraries ---\n"
              , "for libdir in \"$staging/usr/lib/${gnu_triple}\" \"$staging/lib/${gnu_triple}\"; do\n"
              , "  if [ -d \"$libdir\" ]; then\n"
              , "    find \"$libdir\" -maxdepth 1 \\( -name \"*.so*\" -o -name \"*.a\" -o -name \"*.o\" \\) \\\n"
              , "      -exec cp -a {} \"$out/lib/\" \\;\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# glibc loads encoding modules at runtime; retain the complete declared tree.\n"
              , "cp -a \"$staging/usr/lib/${gnu_triple}/gconv\" \"$out/lib/\"\n"
              , "\n"
              , "# libstdc++ dev files (headers)\n"
              , "if [ -d \"$staging/usr/include/c++/14\" ]; then\n"
              , "  mkdir -p \"$out/include/c++/14\"\n"
              , "  cp -a \"$staging/usr/include/c++/14/\"* \"$out/include/c++/14/\"\n"
              , "fi\n"
              , "mkdir -p \"$out/include/c++/14/${gnu_triple}\"\n"
              , "cp -a \"$staging/usr/include/${gnu_triple}/c++/14/.\" \"$out/include/c++/14/${gnu_triple}/\"\n"
              , "\n"
              , "# Debian's GCC linker symlinks refer to its multiarch library directory.\n"
              , "# The assembled prefix places those runtime libraries directly under lib/.\n"
              , "for link in \"$out/lib/gcc/${gnu_triple}/14/\"*.so; do\n"
              , "  [ -L \"$link\" ] || continue\n"
              , "  case \"$(readlink \"$link\")\" in\n"
              , "    \"../../../${gnu_triple}/\"*)\n"
              , "      soname=$(basename \"$(readlink \"$link\")\")\n"
              , "      test -f \"$out/lib/$soname\"\n"
              , "      ln -sf \"../../../$soname\" \"$link\"\n"
              , "      ;;\n"
              , "    *) test -e \"$link\" ;;\n"
              , "  esac\n"
              , "done\n"
              , "\n"
              , "# --- glibc dynamic linker ---\n"
              , "# For x86_64: linker is in lib64/, symlink to ../lib/\n"
              , "# For aarch64: linker is in lib/, no symlink needed\n"
              , "if [ \"$ld_linux_dir\" != \"lib\" ]; then\n"
              , "  ln -sf \"../lib/${ld_linux_name}\" \"$out/${ld_linux_dir}/${ld_linux_name}\"\n"
              , "fi\n"
              , "\n"
              , "# --- glibc crt objects ---\n"
              , "for crt in \"$staging/usr/lib/${gnu_triple}\"/*.o; do\n"
              , "  [ -f \"$crt\" ] && cp -a \"$crt\" \"$out/lib/\"\n"
              , "done\n"
              , "\n"
              , "# --- System headers ---\n"
              , "# glibc headers\n"
              , "if [ -d \"$staging/usr/include\" ]; then\n"
              , "  # Copy everything except c++ (already handled above)\n"
              , "  find \"$staging/usr/include\" -maxdepth 1 -not -name \"c++\" -not -path \"$staging/usr/include\" \\\n"
              , "    -exec cp -a {} \"$out/include/\" \\;\n"
              , "fi\n"
              , "# Multiarch glibc headers (bits/, gnu/, sys/, etc.)\n"
              , "if [ -d \"$staging/usr/include/${gnu_triple}\" ]; then\n"
              , "  find \"$staging/usr/include/${gnu_triple}\" -mindepth 1 -maxdepth 1 -not -name c++ \\\n"
              , "    -exec cp -a {} \"$out/include/\" \\;\n"
              , "fi\n"
              , "# linux-libc-dev UAPI headers (symlink targets for asm/ headers)\n"
              , "if [ -d \"$staging/usr/lib/linux\" ]; then\n"
              , "  cp -a \"$staging/usr/lib/linux\" \"$out/lib/\"\n"
              , "fi\n"
              , "# Fix asm/ symlinks: Debian layout is usr/include/{triple}/asm/ (3 levels to usr/)\n"
              , "# but we flatten into include/asm/ (2 levels to $out), so adjust ../../../ to ../../\n"
              , "if [ -d \"$out/include/asm\" ]; then\n"
              , "  find \"$out/include/asm\" -type l | while read -r lnk; do\n"
              , "    target=\"$(readlink \"$lnk\")\"\n"
              , "    case \"$target\" in\n"
              , "      ../../../*) ln -sf \"../../${target#../../../}\" \"$lnk\" ;;\n"
              , "    esac\n"
              , "  done\n"
              , "fi\n"
              , "\n"
              , "# === Patchelf binaries ===\n"
              , "# Preserve program-header order when relocating large GCC executables.\n"
              , "# Wrappers do not make a host interpreter in an executable .real file safe.\n"
              , "echo \"=== Patching ELF binaries ===\"\n"
              , "ld_interp=\"$out/lib/${ld_linux_name}\"\n"
              , "rpath=\"$out/lib:$out/lib/gcc/${gnu_triple}/14\"\n"
              , "\n"
              , "is_elf() {\n"
              , "  [ \"$(LC_ALL=C head -c 4 \"$1\")\" = \"$(printf '\\177ELF')\" ]\n"
              , "}\n"
              , "\n"
              , "# Relocate every executable, including the internal compiler and LTO tools.\n"
              , "for bin in \"$out/bin\"/* \"$out/libexec/gcc/${gnu_triple}/14\"/*; do\n"
              , "  [ -f \"$bin\" ] || continue\n"
              , "  if \"$patchelf\" --print-interpreter \"$bin\" >/dev/null 2>&1; then\n"
              , "    echo \"  Patching: $(basename \"$bin\")\"\n"
              , "    \"$patchelf\" --no-sort --set-interpreter \"$ld_interp\" --set-rpath \"$rpath\" \"$bin\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# Relocate shared libraries and the complete gconv module closure.\n"
              , "find \"$out/lib\" -name \"*.so*\" -type f | while read -r so; do\n"
              , "  case \"$(basename \"$so\")\" in\n"
              , "    ld-linux*|ld-*.so*) continue ;;\n"
              , "  esac\n"
              , "  if is_elf \"$so\"; then\n"
              , "    library_rpath=\"$rpath\"\n"
              , "    case \"$so\" in\n"
              , "      \"$out/lib/gconv/\"*) library_rpath=\"\\$ORIGIN:$rpath\" ;;\n"
              , "    esac\n"
              , "    if \"$patchelf\" --print-interpreter \"$so\" >/dev/null 2>&1; then\n"
              , "      \"$patchelf\" --no-sort --set-interpreter \"$ld_interp\" --set-rpath \"$library_rpath\" \"$so\"\n"
              , "    else\n"
              , "      \"$patchelf\" --no-sort --set-rpath \"$library_rpath\" \"$so\"\n"
              , "    fi\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# === Wrapper scripts for gcc/g++/cpp and internal tools ===\n"
              , "# Keep the existing compiler entry points and explicit bundled-loader setup.\n"
              , "create_wrapper() {\n"
              , "  local wrapper=\"$1\" real_bin=\"$2\" extra_args=\"${3:-}\"\n"
              , "  printf '#!%s/bin/bash\\nexport LD_LIBRARY_PATH=\"%s:${LD_LIBRARY_PATH:-}\"\\nexec \"%s\" --library-path \"%s\" \"%s\" %s\"$@\"\\n' \\\n"
              , "    \"$bash\" \"$out/lib\" \"$ld_interp\" \"$out/lib:$out/lib/gcc/${gnu_triple}/14\" \\\n"
              , "    \"$real_bin\" \"$extra_args\" > \"$wrapper\"\n"
              , "  chmod +x \"$wrapper\"\n"
              , "}\n"
              , "\n"
              , "for tool in gcc g++ cc c++; do\n"
              , "  real=\"$out/bin/$tool\"\n"
              , "  [ -f \"$real\" ] || [ -L \"$real\" ] || continue\n"
              , "  # If symlink (e.g. cc -> gcc), re-target to the .real binary\n"
              , "  if [ -L \"$real\" ]; then\n"
              , "    target=\"$(readlink \"$real\")\"\n"
              , "    rm \"$real\"\n"
              , "    ln -s \"${target}.real\" \"$out/bin/${tool}.real\"\n"
              , "  else\n"
              , "    mv \"$real\" \"$out/bin/${tool}.real\"\n"
              , "  fi\n"
              , "  create_wrapper \"$real\" \"$out/bin/${tool}.real\"\n"
              , "done\n"
              , "# cpp: invoke gcc.real -E\n"
              , "rm -f \"$out/bin/cpp\"\n"
              , "create_wrapper \"$out/bin/cpp\" \"$out/bin/gcc.real\" \"-E \"\n"
              , "\n"
              , "# Wrap internal GCC executables (cc1, cc1plus, collect2, lto-wrapper)\n"
              , "# so they also run with the bundled ld-linux and glibc.\n"
              , "for f in cc1 cc1plus collect2 lto-wrapper lto1; do\n"
              , "  real=\"$out/libexec/gcc/${gnu_triple}/14/$f\"\n"
              , "  [ -f \"$real\" ] || continue\n"
              , "  mv \"$real\" \"${real}.real\"\n"
              , "  create_wrapper \"$real\" \"${real}.real\"\n"
              , "done\n"
              , "\n"
              , "# Symlink bundled binutils (ld, as, etc.) into libexec so collect2 can find them\n"
              , "for tool in ld as nm ar ranlib objcopy objdump strip; do\n"
              , "  if [ -f \"$out/bin/$tool\" ] && [ ! -e \"$out/libexec/gcc/${gnu_triple}/14/$tool\" ]; then\n"
              , "    ln -s \"$out/bin/$tool\" \"$out/libexec/gcc/${gnu_triple}/14/$tool\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# === Create GCC specs to use bundled paths ===\n"
              , "gcc_specs=\"$out/lib/gcc/${gnu_triple}/14/specs\"\n"
              , "\"$out/bin/gcc\" -dumpspecs > \"$gcc_specs\"\n"
              , "# Patch the dynamic linker path in specs\n"
              , "# Use exact path match to avoid greedy .* destroying nested spec conditionals\n"
              , "sed -i \"s|/${ld_linux_dir}/${ld_linux_name}|$out/lib/${ld_linux_name}|g\" \"$gcc_specs\"\n"
              , "# AArch64 spells the native loader with optional ABI/endian spec fragments.\n"
              , "sed -i 's|/lib/ld-linux-aarch64%{mbig-endian:_be}%{mabi=ilp32:_ilp32}.so.1|'\"$ld_interp\"'|g' \"$gcc_specs\"\n"
              , "sed -i \"s|/usr/lib/${gnu_triple}/||g; s|/lib/${gnu_triple}/||g\" \"$gcc_specs\"\n"
              , "# Direct rustc calls do not read RUSTFLAGS; compiler defaults must pair the\n"
              , "# bundled loader with its libraries even without the environment facade.\n"
              , "sed -i \"/^\\\\*link:$/ { n; s|^|-rpath $out/lib |; }\" \"$gcc_specs\"\n"
              , "\n"
              , "# === Fix linker scripts to use bundled paths ===\n"
              , "# Debian linker scripts (libc.so, libm.so) contain absolute paths like\n"
              , "# /lib/aarch64-linux-gnu/libc.so.6 which don't exist in non-Debian systems.\n"
              , "# Rewrite them to reference our bundled libraries.\n"
              , "find \"$out/lib\" -maxdepth 1 -name \"*.so\" -type f | while read -r script; do\n"
              , "  if head -1 \"$script\" | grep -q \"GNU ld script\\|/\\*\"; then\n"
              , "    sed -i \"s|/usr/lib/${gnu_triple}/||g; s|/lib/${gnu_triple}/||g; s|/${ld_linux_dir}/${ld_linux_name}|$out/lib/${ld_linux_name}|g\" \"$script\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# NSS has no module-directory setting. Use an explicit libc-relative path\n"
              , "# so an unavailable service cannot fall through to the host loader cache.\n"
              , "for service in compat dns files hesiod; do\n"
              , "  test -f \"$out/lib/libnss_${service}.so.2\"\n"
              , "  ln -s \"libnss_${service}.so.2\" \"$out/lib/${service}.2\"\n"
              , "done\n"
              , "\n"
              , "# Build with this provider's own ABI inputs. Shared code contains no binary\n"
              , "# or compiler dependency; Debian-specific relocation remains here.\n"
              , "source \"$glibc_support/build-initializer.bash\"\n"
              , "glibc_runtime_build_initializer \"$glibc_support/initialize.c\" \\\n"
              , "  \"$out/lib/librubble-glibc-paths.so\" \"$out/bin/gcc\" \\\n"
              , "  -B\"$out/lib/gcc/${gnu_triple}/14\" \\\n"
              , "  -nostdinc -isystem \"$out/lib/gcc/${gnu_triple}/14/include\" -isystem \"$out/include\" \\\n"
              , "  -L\"$out/lib\" -L\"$out/lib/gcc/${gnu_triple}/14\"\n"
              , "\"$patchelf\" --no-sort --set-rpath '$ORIGIN' \"$out/lib/librubble-glibc-paths.so\"\n"
              , "\n"
              , "# GCONV_PATH appends glibc's compiled default directory. Disable that host\n"
              , "# directory/cache as well. These fixed-version, NUL-terminated data strings\n"
              , "# are replaced in place; reject different upstream layouts instead of\n"
              , "# silently patching an unknown binary. /dev/null cannot contain modules.\n"
              , "perl - \"$out/lib/libc.so.6\" \"$gnu_triple\" <<'EOF'\n"
              , "use strict;\n"
              , "use warnings;\n"
              , "my ($path, $triple) = @ARGV;\n"
              , "open my $input, '<:raw', $path or die \"$path: $!\";\n"
              , "local $/;\n"
              , "my $data = <$input>;\n"
              , "close $input or die \"$path: $!\";\n"
              , "my $size = length $data;\n"
              , "for my $replacement (\n"
              , "  [\"libnss_%s.so%s\\0\", '$ORIGIN/%s%s' . \"\\0\"],\n"
              , "  [\"/usr/lib/$triple/gconv/gconv-modules.cache\\0\", \"/dev/null/gconv-cache\\0\"],\n"
              , "  [\"/usr/lib/$triple/gconv\\0\", \"/dev/null/gconv\\0\"],\n"
              , ") {\n"
              , "  my ($old, $new) = @$replacement;\n"
              , "  my $offset = index($data, $old);\n"
              , "  die \"Expected one glibc path pattern: $old\" if $offset < 0 || rindex($data, $old) != $offset;\n"
              , "  die \"glibc replacement does not fit\" if length($new) > length($old);\n"
              , "  my $padded = $new . \"\\0\" x (length($old) - length($new));\n"
              , "  substr($data, $offset, length($old), $padded);\n"
              , "  die \"glibc replacement failed\" if index($data, $old) >= 0 || substr($data, $offset, length($padded)) ne $padded;\n"
              , "}\n"
              , "die \"glibc size changed\" if length($data) != $size;\n"
              , "open my $output, '>:raw', $path or die \"$path: $!\";\n"
              , "print {$output} $data or die \"$path: $!\";\n"
              , "close $output or die \"$path: $!\";\n"
              , "EOF\n"
              , "\"$patchelf\" --no-sort --add-needed '$ORIGIN/librubble-glibc-paths.so' \"$out/lib/libc.so.6\"\n"
              , "\n"
              , "# === Verification ===\n"
              , "echo \"\"\n"
              , "echo \"=== GCC (glibc) toolchain assembled ===\"\n"
              , "\"$out/bin/gcc\" --version\n"
              , "\n"
              , "echo \"Testing gcc can find cc1...\"\n"
              , "\"$out/bin/gcc\" -print-search-dirs\n"
              , "test \"$(readlink -f \"$(\"$out/bin/gcc\" -print-prog-name=cc1)\")\" = \"$out/libexec/gcc/${gnu_triple}/14/cc1\"\n"
              , "\n"
              , "echo \"Testing C compilation...\"\n"
              , "test_source=\"${TMP}/test_gcc_glibc.c\"\n"
              , "test_binary=\"${TMP}/test_gcc_glibc\"\n"
              , "printf '#include <stdio.h>\\nint main() { printf(\"Hello!\\\\n\"); return 0; }\\n' > \"$test_source\"\n"
              , "\"$out/bin/gcc\" -B\"$out/lib/gcc/${gnu_triple}/14\" \\\n"
              , "  -nostdinc -isystem \"$out/lib/gcc/${gnu_triple}/14/include\" -isystem \"$out/include\" \\\n"
              , "  -L\"$out/lib\" -L\"$out/lib/gcc/${gnu_triple}/14\" \\\n"
              , "  \"$test_source\" -o \"$test_binary\"\n"
              , "\"$test_binary\"\n"
              , "test \"$(\"$patchelf\" --print-interpreter \"$test_binary\")\" = \"$ld_interp\"\n"
              , "test \"$(\"$patchelf\" --print-rpath \"$test_binary\")\" = \"$out/lib\"\n"
              , "\n"
              , "echo \"Testing C++ compilation and runtime libraries...\"\n"
              , "printf '#include <iostream>\\n#include <vector>\\nint main() { std::vector<int> v{14}; std::cout << v.at(0) << \"\\\\n\"; }\\n' > \"$test_source.cpp\"\n"
              , "\"$out/bin/g++\" -B\"$out/lib/gcc/${gnu_triple}/14\" \\\n"
              , "  -nostdinc -nostdinc++ \\\n"
              , "  -isystem \"$out/include/c++/14\" -isystem \"$out/include/c++/14/${gnu_triple}\" \\\n"
              , "  -isystem \"$out/lib/gcc/${gnu_triple}/14/include\" -isystem \"$out/include\" \\\n"
              , "  -L\"$out/lib\" -L\"$out/lib/gcc/${gnu_triple}/14\" \\\n"
              , "  -flto \"$test_source.cpp\" -o \"$test_binary.cpp\"\n"
              , "test \"$(\"$test_binary.cpp\")\" = 14\n"
              , "test \"$(\"$patchelf\" --print-interpreter \"$test_binary.cpp\")\" = \"$ld_interp\"\n"
              , "for tool in cc1 cc1plus collect2 lto-wrapper lto1; do\n"
              , "  test \"$(\"$patchelf\" --print-interpreter \"$out/libexec/gcc/${gnu_triple}/14/$tool.real\")\" = \"$ld_interp\"\n"
              , "  test \"$(\"$patchelf\" --print-rpath \"$out/libexec/gcc/${gnu_triple}/14/$tool.real\")\" = \"$rpath\"\n"
              , "done\n"
              , "rm -f \"$test_source.cpp\" \"$test_binary.cpp\"\n"
              , "rm -f \"$test_source\" \"$test_binary\"\n"
              , "\n"
              , "echo \"\"\n"
              , "echo \"Key binaries:\"\n"
              , "ls -la \"$out/bin/gcc\" \"$out/bin/g++\" \"$out/bin/ld\" \"$out/bin/ar\"\n"
              , "readlink -f \"$out/lib/${ld_linux_name}\" || ls -la \"$out/lib/\"*ld-linux*\n"
              , "\n"
              , "# Behavior, including glibc's dynamic module paths, is a shared contract.\n"
              , "source \"$glibc_support/audit.bash\"\n"
              , "declare -A glibc_runtime_tools=()\n"
              , "for tool in env mkdir realpath sha256sum uname; do\n"
              , "  glibc_runtime_tools[$tool]=\"$bootstrap/bin/$tool\"\n"
              , "done\n"
              , "glibc_runtime_tool() { local tool=$1; shift; \"${glibc_runtime_tools[$tool]}\" \"$@\"; }\n"
              , "glibc_runtime_audit \"$glibc_support\" \\\n"
              , "  --target \"$out\" --allow-output \"$out\" \\\n"
              , "  --loader \"$out/lib/$ld_linux_name\" --library-dir \"$out/lib\" \\\n"
              , "  --nss-module \"$out/lib/libnss_hesiod.so.2\" \\\n"
              , "  --nss-module \"$out/lib/libnss_dns.so.2\" \\\n"
              , "  --cc \"$out/bin/gcc\" --compiler-path \"$out/bin\" \\\n"
              , "  --cc-arg \"-B$out/lib/gcc/$gnu_triple/14\" \\\n"
              , "  --cc-arg -nostdinc --cc-arg -isystem --cc-arg \"$out/lib/gcc/$gnu_triple/14/include\" \\\n"
              , "  --cc-arg -isystem --cc-arg \"$out/include\" \\\n"
              , "  --cc-arg \"-L$out/lib\" --cc-arg \"-L$out/lib/gcc/$gnu_triple/14\" \\\n"
              , "  --patchelf \"$patchelf\" --output-dir \"$TMP/glibc-runtime-audit\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "qaoants4nlzfxkjtirk4cu46xcdrqruorswdaacf6znn3io6tl6q-rustc-1.94.0":
      { "id": "qaoants4nlzfxkjtirk4cu46xcdrqruorswdaacf6znn3io6tl6q-rustc-1.94.0"
      , "name": "rustc-1.94.0"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "p35fui5viqtrg47hzy5wwvgkewwbtgsqytapgqav4jzy4w5vud4a-rustc-1.94.0-x86_64-unknown-linux-gnu.tar.xz"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "c5mx6r24inu4xhdgcdtdjpfflxamue4idrmbz4koxqv6frtuwjwq-rust-std-1.94.0"
          , "alias": "rust_std"
          , "transitive": "false"
          }
        , { "brick": "ztbwuqmg77pfi6tzkoy4asfmpiy22x6lugzprlhhhvjldam36n4q-rubble-script-shebang"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$script\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "teieaxxyjdoyw4gqby5r4ywgrstjp3t6ui4dxasa6j7ba34arziq-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "bxchorbehgapcopsqwo7w5zwjgenujywlkkytlnad3dvy5hpqc5q-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "doyhpmodramzk3rtng3a7it2nzmwko6uxm67xkypeyjeph5jv3za-gcc-glibc"
          , "alias": "gcc_glibc"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar --strip-components=1 -Jxvf \"$src\"\n"
              , "mkdir -pv \"$out\"\n"
              , "mv rustc/bin \"$out\"\n"
              , "mv rustc/libexec \"$out\"\n"
              , "mv rustc/lib \"$out\"\n"
              , "\n"
              , "# Install rust-std into sysroot so rustc can find std for host compilation\n"
              , "for target_dir in \"$rust_std\"/lib/rustlib/*/lib; do\n"
              , "  target=$(basename \"$(dirname \"$target_dir\")\")\n"
              , "  mkdir -p \"$out/lib/rustlib/$target\"\n"
              , "  cp -a \"$target_dir\" \"$out/lib/rustlib/$target/\"\n"
              , "done\n"
              , "\n"
              , "# On Linux, patchelf ELF binaries to use store's glibc dynamic linker\n"
              , "if [ -n \"${gcc_glibc:-}\" ]; then\n"
              , "  rubble_script_shebang_register \"$bash/bin/bash\" sh bash\n"
              , "\n"
              , "  shebang_scripts=()\n"
              , "  for script in \"$out/bin/rust-gdb\" \"$out/bin/rust-gdbgui\" \"$out/bin/rust-lldb\"; do\n"
              , "    [ -f \"$script\" ] || continue\n"
              , "    shebang_scripts+=(\"$script\")\n"
              , "  done\n"
              , "  if ((${#shebang_scripts[@]} > 0)); then\n"
              , "    rubble_script_shebang_rewrite_all --strict \"${shebang_scripts[@]}\"\n"
              , "  fi\n"
              , "\n"
              , "  ld_linux=$(echo \"$gcc_glibc\"/lib/ld-linux-*.so.* | awk '{print $1}')\n"
              , "  lib_path=\"$gcc_glibc/lib:$out/lib\"\n"
              , "\n"
              , "  # Patch executables (set interpreter + rpath)\n"
              , "  find \"$out/bin\" \"$out/libexec\" \"$out/lib/rustlib\" -type f 2>/dev/null | while read -r f; do\n"
              , "    \"$gcc_glibc/bin/readelf\" -l \"$f\" 2>/dev/null | grep -q \"INTERP\" || continue\n"
              , "    \"$patchelf\" --set-interpreter \"$ld_linux\" --set-rpath \"$lib_path\" \"$f\"\n"
              , "  done\n"
              , "\n"
              , "  # Patch shared libraries (set rpath so transitive deps resolve)\n"
              , "  find \"$out/lib\" -name '*.so*' -type f 2>/dev/null | while read -r f; do\n"
              , "    \"$gcc_glibc/bin/readelf\" -h \"$f\" 2>/dev/null | grep -q \"DYN\" || continue\n"
              , "    \"$patchelf\" --set-rpath \"$lib_path\" \"$f\"\n"
              , "  done\n"
              , "fi"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "st7kemdq4iesmpfx4kbo4q2b3rtuoelmqtgfzzrpzs7hukebga5q-rubble-elf-runtime":
      { "id": "st7kemdq4iesmpfx4kbo4q2b3rtuoelmqtgfzzrpzs7hukebga5q-rubble-elf-runtime"
      , "name": "rubble-elf-runtime"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "teieaxxyjdoyw4gqby5r4ywgrstjp3t6ui4dxasa6j7ba34arziq-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "46lfnhiwl7xwedh2m5nqmsiz53zc3vcpqiox4v4mctm56nzwlz6a-bootstrap-env"
          , "alias": "bootstrap"
          , "transitive": "false"
          }
        , { "brick": "jollno6o4uloupgitupgjbfxgunhmm5hx3hdhvl7kbmw47dj4dpq-glibc-runtime-support"
          , "alias": "glibc_support"
          , "transitive": "false"
          }
        , { "brick": "doyhpmodramzk3rtng3a7it2nzmwko6uxm67xkypeyjeph5jv3za-gcc-glibc"
          , "alias": "gcc_glibc"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "ld_linux_name"
          , "value": "ld-linux-x86-64.so.2"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "echo \"=== Assembling Rubble ELF runtime ===\"\n"
              , "mkdir -p \"$out/lib\"\n"
              , "\n"
              , "# Copy only the runtime surface, including the C++ runtime used by Node.\n"
              , "# Preserve relative SONAME links without carrying compiler-library paths.\n"
              , "copy_runtime_library() {\n"
              , "  local soname=\"$1\" target\n"
              , "  while [ -L \"$gcc_glibc/lib/$soname\" ]; do\n"
              , "    cp -a \"$gcc_glibc/lib/$soname\" \"$out/lib/\"\n"
              , "    target=$(readlink \"$gcc_glibc/lib/$soname\")\n"
              , "    case \"$target\" in\n"
              , "      ''|*/*)\n"
              , "        echo \"Expected a relative runtime library filename: $soname -> $target\" >&2\n"
              , "        exit 1\n"
              , "        ;;\n"
              , "    esac\n"
              , "    soname=\"$target\"\n"
              , "  done\n"
              , "  cp -a \"$gcc_glibc/lib/$soname\" \"$out/lib/\"\n"
              , "}\n"
              , "\n"
              , "for soname in \"$ld_linux_name\" libc.so.6 libm.so.6 libdl.so.2 \\\n"
              , "  libpthread.so.0 librt.so.1 libresolv.so.2 libutil.so.1 \\\n"
              , "  libgcc_s.so.1 libstdc++.so.6 libz.so.1 librubble-glibc-paths.so \\\n"
              , "  libnss_compat.so.2 libnss_dns.so.2 libnss_files.so.2 libnss_hesiod.so.2; do\n"
              , "  copy_runtime_library \"$soname\"\n"
              , "done\n"
              , "if [ -f \"$gcc_glibc/lib/libmvec.so.1\" ]; then\n"
              , "  copy_runtime_library libmvec.so.1\n"
              , "fi\n"
              , "for service in compat dns files hesiod; do\n"
              , "  cp -a \"$gcc_glibc/lib/${service}.2\" \"$out/lib/\"\n"
              , "done\n"
              , "cp -a \"$gcc_glibc/lib/gconv\" \"$out/lib/\"\n"
              , "\n"
              , "runtime_search_path() {\n"
              , "  case \"$1\" in\n"
              , "    \"$out/lib/gconv/\"*) printf '%s' \"\\$ORIGIN:$out/lib\" ;;\n"
              , "    *) printf '%s' \"$out/lib\" ;;\n"
              , "  esac\n"
              , "}\n"
              , "\n"
              , "while IFS= read -r -d '' elf_file; do\n"
              , "  [ \"$(basename \"$elf_file\")\" != \"$ld_linux_name\" ] || continue\n"
              , "  if \"$patchelf\" --print-interpreter \"$elf_file\" >/dev/null 2>&1; then\n"
              , "    \"$patchelf\" --no-sort --set-interpreter \"$out/lib/$ld_linux_name\" \"$elf_file\"\n"
              , "  fi\n"
              , "  \"$patchelf\" --no-sort --set-rpath \"$(runtime_search_path \"$elf_file\")\" \"$elf_file\"\n"
              , "done < <(find \"$out/lib\" -type f -name '*.so*' -print0)\n"
              , "\n"
              , "echo \"=== Verifying Rubble ELF runtime closure ===\"\n"
              , "while IFS= read -r -d '' elf_file; do\n"
              , "  if ! needed_entries=\"$(\"$patchelf\" --print-needed \"$elf_file\")\"; then\n"
              , "    echo \"Expected an ELF runtime object: $elf_file\" >&2\n"
              , "    exit 1\n"
              , "  fi\n"
              , "\n"
              , "  if [[ -n \"$needed_entries\" ]]; then\n"
              , "    while IFS= read -r needed; do\n"
              , "      # libc locates its path initializer relative to itself after copying.\n"
              , "      resolved_needed=\"$needed\"\n"
              , "      case \"$needed\" in\n"
              , "        '$ORIGIN/librubble-glibc-paths.so') resolved_needed=librubble-glibc-paths.so ;;\n"
              , "        */*) echo \"Unexpected runtime dependency path: $needed\" >&2; exit 1 ;;\n"
              , "      esac\n"
              , "      if [[ ! -e \"$out/lib/$resolved_needed\" && ! -e \"$(dirname \"$elf_file\")/$resolved_needed\" ]]; then\n"
              , "        echo \"Missing runtime dependency for $elf_file: $needed\" >&2\n"
              , "        exit 1\n"
              , "      fi\n"
              , "      echo \"Resolved runtime dependency: $(basename \"$elf_file\") -> $needed\"\n"
              , "    done <<< \"$needed_entries\"\n"
              , "  else\n"
              , "    echo \"No runtime dependencies: $(basename \"$elf_file\")\"\n"
              , "  fi\n"
              , "\n"
              , "  if ! runtime_path=\"$(\"$patchelf\" --print-rpath \"$elf_file\")\"; then\n"
              , "    echo \"Failed to inspect the runtime search path: $elf_file\" >&2\n"
              , "    exit 1\n"
              , "  fi\n"
              , "  if [[ -n \"$runtime_path\" && \"$runtime_path\" != \"$(runtime_search_path \"$elf_file\")\" ]]; then\n"
              , "    echo \"Unexpected runtime search path for $elf_file: $runtime_path\" >&2\n"
              , "    exit 1\n"
              , "  elif [[ -n \"$runtime_path\" ]]; then\n"
              , "    echo \"Verified runtime search path: $(basename \"$elf_file\") -> $runtime_path\"\n"
              , "  else\n"
              , "    echo \"No runtime search path: $(basename \"$elf_file\")\"\n"
              , "  fi\n"
              , "done < <(find \"$out/lib\" -type f -name '*.so*' -print0)\n"
              , "\n"
              , "# Audit the copied runtime through the same implementation as its provider.\n"
              , "source \"$glibc_support/audit.bash\"\n"
              , "declare -A glibc_runtime_tools=()\n"
              , "for tool in env mkdir realpath sha256sum uname; do\n"
              , "  glibc_runtime_tools[$tool]=\"$bootstrap/bin/$tool\"\n"
              , "done\n"
              , "glibc_runtime_tool() { local tool=$1; shift; \"${glibc_runtime_tools[$tool]}\" \"$@\"; }\n"
              , "gnu_triple=$(\"$gcc_glibc/bin/gcc\" -dumpmachine)\n"
              , "glibc_runtime_audit \"$glibc_support\" \\\n"
              , "  --target \"$out\" --allow-output \"$out\" \\\n"
              , "  --loader \"$out/lib/$ld_linux_name\" --library-dir \"$out/lib\" \\\n"
              , "  --nss-module \"$out/lib/libnss_hesiod.so.2\" \\\n"
              , "  --nss-module \"$out/lib/libnss_dns.so.2\" \\\n"
              , "  --cc \"$gcc_glibc/bin/gcc\" --compiler-path \"$gcc_glibc/bin\" \\\n"
              , "  --cc-arg \"-B$gcc_glibc/lib/gcc/$gnu_triple/14\" \\\n"
              , "  --cc-arg -nostdinc --cc-arg -isystem --cc-arg \"$gcc_glibc/lib/gcc/$gnu_triple/14/include\" \\\n"
              , "  --cc-arg -isystem --cc-arg \"$gcc_glibc/include\" \\\n"
              , "  --cc-arg \"-L$gcc_glibc/lib\" --cc-arg \"-L$gcc_glibc/lib/gcc/$gnu_triple/14\" \\\n"
              , "  --patchelf \"$patchelf\" --output-dir \"$TMP/glibc-runtime-audit\"\n"
              , "\n"
              , "echo \"=== Rubble ELF runtime ready ===\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "5oiwqkogaw73q6vr6awd73gcirefkhnxligtcbjp2yxvgcao42bq-nodejs-runtime":
      { "id": "5oiwqkogaw73q6vr6awd73gcirefkhnxligtcbjp2yxvgcao42bq-nodejs-runtime"
      , "name": "nodejs-runtime"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "ztbwuqmg77pfi6tzkoy4asfmpiy22x6lugzprlhhhvjldam36n4q-rubble-script-shebang"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$script\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "teieaxxyjdoyw4gqby5r4ywgrstjp3t6ui4dxasa6j7ba34arziq-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "w7gterx6tkmti6wv733mqag4engf5xzrpvyrazpfjb7u7cvs7hla-node-v22.22.3-linux-x64.tar.xz"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "bxchorbehgapcopsqwo7w5zwjgenujywlkkytlnad3dvy5hpqc5q-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "ghchiozjtl2ibn4fj6cqsjqwccmgb4bjneutfqoawhgozjexoboq-python3"
          , "alias": "python3"
          , "transitive": "true"
          }
        , { "brick": "46lfnhiwl7xwedh2m5nqmsiz53zc3vcpqiox4v4mctm56nzwlz6a-bootstrap-env"
          , "alias": "bootstrap"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$out/setup-env.sh\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "st7kemdq4iesmpfx4kbo4q2b3rtuoelmqtgfzzrpzs7hukebga5q-rubble-elf-runtime"
          , "alias": "runtime"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "ld_linux_name"
          , "value": "ld-linux-x86-64.so.2"
          }
        , { "name": "node_arch"
          , "value": "x64"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p \"$out\"\n"
              , "tar -xJf \"$src\" --strip-components=1 -C \"$out\"\n"
              , "# Preserve program-header order: sorting this upstream ARM64 ELF breaks startup.\n"
              , "\"$patchelf\" --no-sort --set-interpreter \"$runtime/lib/$ld_linux_name\" \\\n"
              , "  --force-rpath --set-rpath \"$runtime/lib\" \"$out/bin/node\"\n"
              , "\n"
              , "rubble_script_shebang_register \"$out/bin/node\" node\n"
              , "rubble_script_shebang_register \"$python3/bin/python3\" python python3\n"
              , "rubble_script_shebang_register \"$bash/bin/bash\" sh bash\n"
              , "set -o pipefail\n"
              , "rubble_script_shebang_find --all --print0 \"$out\" |\n"
              , "  while IFS= read -r -d '' installed_file; do\n"
              , "    case \"$installed_file\" in\n"
              , "      *.ps1)\n"
              , "        chmod -x \"$installed_file\"\n"
              , "        continue\n"
              , "        ;;\n"
              , "    esac\n"
              , "    rubble_script_shebang_rewrite_all --strict \"$installed_file\"\n"
              , "  done\n"
              , "\n"
              , "test \"$(\"$out/bin/node\" --version)\" = v22.22.3\n"
              , "test \"$(\"$out/bin/npm\" --version)\" = 10.9.8\n"
              , "test \"$(\"$out/bin/npx\" --version)\" = 10.9.8\n"
              , "test \"$(\"$out/bin/corepack\" --version)\" = 0.34.6\n"
              , "test \"$(\"$out/bin/node\" -p process.platform)\" = linux\n"
              , "test \"$(\"$out/bin/node\" -p process.arch)\" = \"$node_arch\"\n"
              , "test -s \"$out/include/node/node.h\"\n"
              , "test -s \"$out/include/node/config.gypi\"\n"
              , "test \"$(\"$patchelf\" --print-interpreter \"$out/bin/node\")\" = \"$runtime/lib/$ld_linux_name\"\n"
              , "test \"$(\"$patchelf\" --print-rpath \"$out/bin/node\")\" = \"$runtime/lib\"\n"
              , "needed_entries=$(\"$patchelf\" --print-needed \"$out/bin/node\")\n"
              , "while IFS= read -r needed; do\n"
              , "  test -f \"$runtime/lib/$needed\"\n"
              , "done <<< \"$needed_entries\"\n"
              , "\n"
              , "# process.execPath must remain directly executable, including in child processes.\n"
              , "\"$out/bin/node\" - \"$out/bin/node\" <<'JS'\n"
              , "const assert = require('node:assert/strict');\n"
              , "const { realpathSync } = require('node:fs');\n"
              , "const { execFileSync } = require('node:child_process');\n"
              , "assert.equal(realpathSync(process.execPath), realpathSync(process.argv[2]));\n"
              , "assert.equal(execFileSync(process.execPath, ['--version'], { encoding: 'utf8', env: {} }).trim(), 'v22.22.3');\n"
              , "JS"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "snkx5dkrni2ql2hkmw3e6fba2aligzxwuoqnqk7i7jpg42slabeq-nodejs":
      { "id": "snkx5dkrni2ql2hkmw3e6fba2aligzxwuoqnqk7i7jpg42slabeq-nodejs"
      , "name": "nodejs"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "bxchorbehgapcopsqwo7w5zwjgenujywlkkytlnad3dvy5hpqc5q-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "ghchiozjtl2ibn4fj6cqsjqwccmgb4bjneutfqoawhgozjexoboq-python3"
          , "alias": "python3"
          , "transitive": "true"
          }
        , { "brick": "46lfnhiwl7xwedh2m5nqmsiz53zc3vcpqiox4v4mctm56nzwlz6a-bootstrap-env"
          , "alias": "bootstrap"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$out/setup-env.sh\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "5oiwqkogaw73q6vr6awd73gcirefkhnxligtcbjp2yxvgcao42bq-nodejs-runtime"
          , "alias": "nodejs_runtime"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "env" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "write_heredoc_file() {\n"
              , "  local target=\"$1\"\n"
              , "  local content\n"
              , "  IFS= read -r -d '' content || true\n"
              , "  builtin printf '%s' \"$content\" > \"$target\"\n"
              , "}\n"
              , "\n"
              , "node_runtime_tree=\"$nodejs_runtime\"\n"
              , "python_bin=\"$python3/bin/python3\"\n"
              , "test -x \"$python_bin\"\n"
              , "mkdir -p \"$out/bin\"\n"
              , "for tool in node npm npx corepack; do\n"
              , "  test -x \"$node_runtime_tree/bin/$tool\"\n"
              , "  ln -s \"$node_runtime_tree/bin/$tool\" \"$out/bin/$tool\"\n"
              , "done\n"
              , "\n"
              , "while IFS= builtin read -r __rubble_output_line; do\n"
              , "  builtin printf '%s\\n' \"$__rubble_output_line\"\n"
              , "done > \"$env\" <<EOF\n"
              , "export PATH=\"$out/bin:\\${PATH}\"\n"
              , "export NODE=\"$out/bin/node\"\n"
              , "export NPM=\"$out/bin/npm\"\n"
              , "export NPX=\"$out/bin/npx\"\n"
              , "export COREPACK=\"$out/bin/corepack\"\n"
              , "export PYTHON=\"$python_bin\"\n"
              , "export PYTHON3=\"$python_bin\"\n"
              , "export NODEJS_RUNTIME_PREFIX=\"$node_runtime_tree\"\n"
              , "export npm_config_audit=false\n"
              , "export npm_config_fund=false\n"
              , "export npm_config_update_notifier=false\n"
              , "export npm_config_progress=false\n"
              , "export npm_config_python=\"$python_bin\"\n"
              , "export npm_config_script_shell=\"$bash/bin/bash\"\n"
              , "declare -p PATH NODE NPM NPX COREPACK PYTHON PYTHON3 NODEJS_RUNTIME_PREFIX\n"
              , "declare -p npm_config_audit npm_config_fund npm_config_update_notifier npm_config_progress npm_config_python npm_config_script_shell\n"
              , "\"\\$NODE\" --version\n"
              , "\"\\$NPM\" --version\n"
              , "\"\\$NPX\" --version\n"
              , "\"\\$COREPACK\" --version\n"
              , "EOF\n"
              , "builtin unset __rubble_output_line\n"
              , "\n"
              , "echo \"=== Verifying npm script shell ===\"\n"
              , "probe_dir=\"$PWD/npm-script-probe\"\n"
              , "rm -rf \"$probe_dir\"\n"
              , "mkdir -p \"$probe_dir\"\n"
              , "write_heredoc_file \"$probe_dir/package.json\" <<'EOF'\n"
              , "{\"scripts\":{\"probe\":\"[[ -n \\\"$BASH_VERSION\\\" ]] && printf ok > probe.txt\"}}\n"
              , "EOF\n"
              , "(\n"
              , "  cd \"$probe_dir\"\n"
              , "  unset BASH_XTRACEFD\n"
              , "  npm_config_audit=false \\\n"
              , "  npm_config_fund=false \\\n"
              , "  npm_config_update_notifier=false \\\n"
              , "  npm_config_progress=false \\\n"
              , "  npm_config_script_shell=\"$bash/bin/bash\" \\\n"
              , "    \"$out/bin/npm\" run --silent probe\n"
              , "  IFS= read -r probe_result < probe.txt || true\n"
              , "  if [ \"$probe_result\" != \"ok\" ]; then\n"
              , "    echo \"Expected npm script shell probe to write ok, got $probe_result\" >&2\n"
              , "    exit 1\n"
              , "  fi\n"
              , ")\n"
              , "\n"
              , "echo \"=== Verifying npm node-gyp Python contract ===\"\n"
              , "python_executable=$(\"$python_bin\" -c 'import sys; print(sys.executable)')\n"
              , "case \"$python_executable\" in\n"
              , "  \"$python3/bin/\"*) ;;\n"
              , "  *) echo \"Python resolved outside its declared output: $python_executable\" >&2; exit 1 ;;\n"
              , "esac\n"
              , "node_gyp_probe_dir=\"$PWD/node-gyp-probe\"\n"
              , "rm -rf \"$node_gyp_probe_dir\"\n"
              , "mkdir -p \"$node_gyp_probe_dir/home\" \"$node_gyp_probe_dir/project\"\n"
              , "write_heredoc_file \"$node_gyp_probe_dir/project/binding.gyp\" <<'EOF'\n"
              , "{\"targets\":[{\"target_name\":\"empty\",\"sources\":[]}]}\n"
              , "EOF\n"
              , "(\n"
              , "  cd \"$node_gyp_probe_dir/project\"\n"
              , "  unset BASH_XTRACEFD\n"
              , "  env -i \\\n"
              , "    HOME=\"$node_gyp_probe_dir/home\" \\\n"
              , "    PATH=\"$out/bin\" \\\n"
              , "    PYTHON=\"$python_bin\" \\\n"
              , "    PYTHON3=\"$python_bin\" \\\n"
              , "    npm_config_python=\"$python_bin\" \\\n"
              , "    npm_config_audit=false \\\n"
              , "    npm_config_fund=false \\\n"
              , "    npm_config_update_notifier=false \\\n"
              , "    npm_config_progress=false \\\n"
              , "    \"$out/bin/node\" \"$node_runtime_tree/lib/node_modules/npm/node_modules/node-gyp/bin/node-gyp.js\" configure --nodedir=\"$node_runtime_tree\" \\\n"
              , "      >node-gyp.out 2>node-gyp.err\n"
              , "  found_python=false\n"
              , "  while IFS= read -r node_gyp_line || [ -n \"$node_gyp_line\" ]; do\n"
              , "    case \"$node_gyp_line\" in\n"
              , "      *\"find Python using Python version \"*\" found at \\\"$python_executable\\\"\"*)\n"
              , "        found_python=true\n"
              , "        ;;\n"
              , "    esac\n"
              , "  done < node-gyp.err\n"
              , "  if [ \"$found_python\" != true ]; then\n"
              , "    echo \"Expected node-gyp to use declared Python $python_bin\" >&2\n"
              , "    while IFS= read -r node_gyp_line || [ -n \"$node_gyp_line\" ]; do\n"
              , "      printf '%s\\n' \"$node_gyp_line\" >&2\n"
              , "    done < node-gyp.err\n"
              , "    exit 1\n"
              , "  fi\n"
              , ")"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "u2wisswub2qmsj2srgnwwrxlqrnn62s6ejh4ugyltwugyg3pfawq-rubble-web-node-modules":
      { "id": "u2wisswub2qmsj2srgnwwrxlqrnn62s6ejh4ugyltwugyg3pfawq-rubble-web-node-modules"
      , "name": "rubble-web-node-modules"
      , "platform": "x86_64-linux"
      , "opaque": true
      , "inputs": [
          { "brick": "oryvpwa2ctnjptul44ck6l3nzemkchspnw5qr45tjuz3w44z5cqa-RubbleR.git.partial"
          , "alias": "src"
          , "transitive": "false"
          , "hooks": {
              "post-checkout": [
                { "install-to": [
                    { "output": "dir"
                    , "dir": "./" }
                  ]
                }
              , { "shell": {
                    "value": [
                      "( source \"${script}\" \"${dir}\" )"
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "snkx5dkrni2ql2hkmw3e6fba2aligzxwuoqnqk7i7jpg42slabeq-nodejs"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$env\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "RUBBLE_SRC_LOCAL_PATHS all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "export HOME=\"$PWD/home\"\n"
              , "export npm_config_cache=\"$PWD/npm-cache\"\n"
              , "export npm_config_audit=false\n"
              , "export npm_config_fund=false\n"
              , "export npm_config_update_notifier=false\n"
              , "export npm_config_progress=false\n"
              , "export npm_config_ignore_scripts=true\n"
              , "mkdir -p \"$HOME\" \"$npm_config_cache\"\n"
              , "\n"
              , "cd rubble-web/ui\n"
              , "expected_package_manager=$(\"$NODE\" -p 'require(\"./package.json\").packageManager || \"\"')\n"
              , "case \"$expected_package_manager\" in\n"
              , "  npm@*)\n"
              , "    expected_npm_version=\"${expected_package_manager#npm@}\"\n"
              , "    ;;\n"
              , "  *)\n"
              , "    echo \"Expected packageManager to declare npm@<version>, got: ${expected_package_manager:-<empty>}\" >&2\n"
              , "    exit 1\n"
              , "    ;;\n"
              , "esac\n"
              , "actual_npm_version=$(\"$NPM\" --version)\n"
              , "if [[ \"$actual_npm_version\" != \"$expected_npm_version\" ]]; then\n"
              , "  echo \"npm version mismatch: packageManager=$expected_npm_version actual=$actual_npm_version\" >&2\n"
              , "  exit 1\n"
              , "fi\n"
              , "\n"
              , "\"$NPM\" ci --include=dev --ignore-scripts --no-audit --no-fund --cache \"$npm_config_cache\"\n"
              , "\n"
              , "test -x node_modules/.bin/tsc\n"
              , "test -x node_modules/.bin/vite\n"
              , "\n"
              , "mkdir -p \"$out\"\n"
              , "cp -a node_modules/. \"$out/\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "aj2kicz2nqpzxgetdsoi7jgqcnbnis5wnhjvbi75pojayk6ijsiq-llvm-tools-1.94.0":
      { "id": "aj2kicz2nqpzxgetdsoi7jgqcnbnis5wnhjvbi75pojayk6ijsiq-llvm-tools-1.94.0"
      , "name": "llvm-tools-1.94.0"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "teieaxxyjdoyw4gqby5r4ywgrstjp3t6ui4dxasa6j7ba34arziq-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "hsyi55wlvnlzocc3t5nac44lqr62jzqndxhhgwdvwju3vshv6zla-llvm-tools-1.94.0-x86_64-unknown-linux-gnu.tar.xz"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "doyhpmodramzk3rtng3a7it2nzmwko6uxm67xkypeyjeph5jv3za-gcc-glibc"
          , "alias": "gcc_glibc"
          , "transitive": "true"
          }
        , { "brick": "qaoants4nlzfxkjtirk4cu46xcdrqruorswdaacf6znn3io6tl6q-rustc-1.94.0"
          , "alias": "rustc"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "target_triple=\"${src[name]#*${name}-}\"\n"
              , "target_triple=\"${target_triple%%.*}\"\n"
              , "tar --strip-components=1 -Jxvf \"$src\"\n"
              , "mkdir -pv \"$out\"\n"
              , "mv -v ./llvm-tools-preview/lib/rustlib/${target_triple}/bin \"$out\"\n"
              , "\n"
              , "# On Linux, patchelf ELF binaries to use store's glibc dynamic linker\n"
              , "if [ -n \"${gcc_glibc:-}\" ]; then\n"
              , "  ld_linux=$(echo \"$gcc_glibc\"/lib/ld-linux-*.so.* | awk '{print $1}')\n"
              , "  lib_path=\"$gcc_glibc/lib\"\n"
              , "  # llvm-tools binaries link against libLLVM.so from rustc\n"
              , "  [ -n \"${rustc:-}\" ] && lib_path=\"$lib_path:$rustc/lib\"\n"
              , "  for f in \"$out\"/bin/*; do\n"
              , "    [ -f \"$f\" ] && [ ! -L \"$f\" ] || continue\n"
              , "    \"$gcc_glibc/bin/readelf\" -l \"$f\" 2>/dev/null | grep -q \"INTERP\" || continue\n"
              , "    \"$patchelf\" --set-interpreter \"$ld_linux\" --set-rpath \"$lib_path\" \"$f\"\n"
              , "  done\n"
              , "fi"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "aigf2aggz7iw6qwoesebbnog7ri6p7lnos2slaojyvax4gentzia-linux-native-toolchain":
      { "id": "aigf2aggz7iw6qwoesebbnog7ri6p7lnos2slaojyvax4gentzia-linux-native-toolchain"
      , "name": "linux-native-toolchain"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "x63s7v4qom7r4x7j6vg6y7p2sofdrxxj3dgw7fqdqftwwhjpixaq-perl"
          , "alias": "perl"
          , "transitive": "true"
          }
        , { "brick": "doyhpmodramzk3rtng3a7it2nzmwko6uxm67xkypeyjeph5jv3za-gcc-glibc"
          , "alias": "gcc"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "gcc_version"
          , "value": "14"
          }
        , { "name": "gnu_triple"
          , "value": "x86_64-linux-gnu"
          }
        , { "name": "ld_linux_name"
          , "value": "ld-linux-x86-64.so.2"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "while IFS= builtin read -r __rubble_output_line; do\n"
              , "  builtin printf '%s\\n' \"$__rubble_output_line\"\n"
              , "done > \"$out\" << EOF\n"
              , "# Linux Native Toolchain Environment (glibc GCC)\n"
              , "\n"
              , "# Add GCC and perl to PATH\n"
              , "export PATH=\"$perl/bin:$gcc/bin:\\${PATH}\"\n"
              , "\n"
              , "# Set PERL5LIB for OpenSSL build\n"
              , "export PERL5LIB=\"$perl/share/perl5/core_perl:$perl/lib/perl5/core_perl\\${PERL5LIB:+:}\\${PERL5LIB:-}\"\n"
              , "\n"
              , "# Set compiler environment variables\n"
              , "export CC=\"$gcc/bin/gcc\"\n"
              , "export CXX=\"$gcc/bin/g++\"\n"
              , "export AR=\"$gcc/bin/ar\"\n"
              , "export RANLIB=\"$gcc/bin/ranlib\"\n"
              , "export NM=\"$gcc/bin/nm\"\n"
              , "export LD=\"$gcc/bin/ld\"\n"
              , "\n"
              , "# Set include paths for glibc headers and GCC internal headers\n"
              , "export C_INCLUDE_PATH=\"$gcc/include:$gcc/lib/gcc/${gnu_triple}/${gcc_version}/include\"\n"
              , "export CPLUS_INCLUDE_PATH=\"$gcc/include/c++/${gcc_version}:$gcc/include/c++/${gcc_version}/${gnu_triple}:$gcc/include:$gcc/lib/gcc/${gnu_triple}/${gcc_version}/include\"\n"
              , "\n"
              , "# Prevent pkg-config from finding host system packages (hermetic build)\n"
              , "export PKG_CONFIG_LIBDIR=\"\"\n"
              , "\n"
              , "# Set linker and compiler flags\n"
              , "export LDFLAGS=\"-L$gcc/lib -L$gcc/lib/gcc/${gnu_triple}/${gcc_version} -Wl,--dynamic-linker=$gcc/lib/${ld_linux_name} -Wl,-rpath=$gcc/lib\"\n"
              , "export CFLAGS=\"-I$gcc/include -B$gcc/lib/gcc/${gnu_triple}/${gcc_version}\"\n"
              , "export CXXFLAGS=\"-I$gcc/include/c++/${gcc_version} -I$gcc/include -B$gcc/lib/gcc/${gnu_triple}/${gcc_version}\"\n"
              , "\n"
              , "# For Rust: set linker flags so compiled binaries use our bundled glibc\n"
              , "export RUSTFLAGS=\"\\${RUSTFLAGS:+\\${RUSTFLAGS} }-C link-arg=-L$gcc/lib -C link-arg=-L$gcc/lib/gcc/${gnu_triple}/${gcc_version} -C link-arg=-Wl,--dynamic-linker=$gcc/lib/${ld_linux_name} -C link-arg=-Wl,-rpath=$gcc/lib\"\n"
              , "\n"
              , "# Debug output\n"
              , "echo \"Linux Native Toolchain configured (glibc GCC):\"\n"
              , "echo \"  GCC: $gcc\"\n"
              , "echo \"  CC:   \\$CC\"\n"
              , "echo \"  PATH includes: $gcc/bin\"\n"
              , "\n"
              , "# Verify tools are available\n"
              , "type -a gcc cc\n"
              , "gcc --version\n"
              , "EOF\n"
              , "builtin unset __rubble_output_line"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "va2hj35yknh7msv2ucyztilm6l5ddtxbmw3itdjxycqbtf3fqota-cargo-1.94.0":
      { "id": "va2hj35yknh7msv2ucyztilm6l5ddtxbmw3itdjxycqbtf3fqota-cargo-1.94.0"
      , "name": "cargo-1.94.0"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "teieaxxyjdoyw4gqby5r4ywgrstjp3t6ui4dxasa6j7ba34arziq-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "qxtwnblp3d674vhhwxi33gd4hka5nzyis4krgtapmfnkjs7572yq-cargo-1.94.0-x86_64-unknown-linux-gnu.tar.xz"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "doyhpmodramzk3rtng3a7it2nzmwko6uxm67xkypeyjeph5jv3za-gcc-glibc"
          , "alias": "gcc_glibc"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar --strip-components=1 -Jxvf \"$src\"\n"
              , "mkdir -pv \"$out\"\n"
              , "mv cargo/bin \"$out\"\n"
              , "\n"
              , "# On Linux, patchelf ELF binaries to use store's glibc dynamic linker\n"
              , "if [ -n \"${gcc_glibc:-}\" ]; then\n"
              , "  ld_linux=$(echo \"$gcc_glibc\"/lib/ld-linux-*.so.* | awk '{print $1}')\n"
              , "  for f in \"$out\"/bin/*; do\n"
              , "    [ -f \"$f\" ] && [ ! -L \"$f\" ] || continue\n"
              , "    \"$gcc_glibc/bin/readelf\" -l \"$f\" 2>/dev/null | grep -q \"INTERP\" || continue\n"
              , "    \"$patchelf\" --set-interpreter \"$ld_linux\" --set-rpath \"$gcc_glibc/lib\" \"$f\"\n"
              , "  done\n"
              , "fi"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "dwbkud6kriwdtuoq6uwp2ceh5ifuxaalouu2zkq25d5cpcozppma-rust-web-wasm-toolchain":
      { "id": "dwbkud6kriwdtuoq6uwp2ceh5ifuxaalouu2zkq25d5cpcozppma-rust-web-wasm-toolchain"
      , "name": "rust-web-wasm-toolchain"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "zujuie37eo76vyfvxqs2lv5qwcndgjrdeatxuclyaviywufxfiea-rust-std-1.94.0-wasm32-unknown-unknown"
          , "alias": "rust_std_wasm"
          , "transitive": "false"
          }
        , { "brick": "ztbwuqmg77pfi6tzkoy4asfmpiy22x6lugzprlhhhvjldam36n4q-rubble-script-shebang"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$script\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "bxchorbehgapcopsqwo7w5zwjgenujywlkkytlnad3dvy5hpqc5q-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        , { "brick": "qaoants4nlzfxkjtirk4cu46xcdrqruorswdaacf6znn3io6tl6q-rustc-1.94.0"
          , "alias": "rustc"
          , "transitive": "true"
          }
        , { "brick": "aj2kicz2nqpzxgetdsoi7jgqcnbnis5wnhjvbi75pojayk6ijsiq-llvm-tools-1.94.0"
          , "alias": "rust_llvm_tools"
          , "transitive": "true"
          }
        , { "brick": "aigf2aggz7iw6qwoesebbnog7ri6p7lnos2slaojyvax4gentzia-linux-native-toolchain"
          , "transitive": "true"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$out\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "va2hj35yknh7msv2ucyztilm6l5ddtxbmw3itdjxycqbtf3fqota-cargo-1.94.0"
          , "alias": "cargo"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "host_triple"
          , "value": "x86_64-unknown-linux-gnu"
          }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "env" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "write_heredoc_file() {\n"
              , "  local target=\"$1\"\n"
              , "  local content\n"
              , "  IFS= read -r -d '' content || true\n"
              , "  builtin printf '%s' \"$content\" > \"$target\"\n"
              , "}\n"
              , "\n"
              , "rm -rf \"$out\"\n"
              , "mkdir -p \"$out\"\n"
              , "\n"
              , "cp -a \"$rustc/bin\" \"$out/\"\n"
              , "cp -a \"$rustc/lib\" \"$out/\"\n"
              , "cp -a \"$rustc/libexec\" \"$out/\"\n"
              , "mkdir -p \"$out/lib/rustlib/wasm32-unknown-unknown\"\n"
              , "cp -a \"$rust_std_wasm/lib/rustlib/wasm32-unknown-unknown/lib\" \"$out/lib/rustlib/wasm32-unknown-unknown/\"\n"
              , "\n"
              , "is_windows_host=false\n"
              , "if [[ \"$host_triple\" == *windows* ]]; then\n"
              , "  is_windows_host=true\n"
              , "fi\n"
              , "if $is_windows_host; then\n"
              , "  mkdir -p \"$out/lib/rustlib/${host_triple}/lib/self-contained\"\n"
              , "  cp -a \"$rust_mingw_lib/rustlib/${host_triple}/lib/self-contained/.\" \"$out/lib/rustlib/${host_triple}/lib/self-contained/\"\n"
              , "  windows_library_path=\"$(realpath \"$rust_mingw_lib/rustlib/${host_triple}/lib/self-contained\")\"\n"
              , "else\n"
              , "  windows_library_path=\"\"\n"
              , "fi\n"
              , "\n"
              , "real_rustc=\"$out/bin/rustc-real\"\n"
              , "if $is_windows_host; then\n"
              , "  real_rustc=\"$out/bin/rustc.exe\"\n"
              , "else\n"
              , "  mv \"$out/bin/rustc\" \"$real_rustc\"\n"
              , "fi\n"
              , "\n"
              , "if $is_windows_host; then\n"
              , "  if [[ -z \"${RUBBLE_WEB_WRAPPER_BASH:-}\" ]]; then\n"
              , "    echo \"RUBBLE_WEB_WRAPPER_BASH must point to the store Bash for Windows web builds\"\n"
              , "    exit 1\n"
              , "  fi\n"
              , "  rustc_wrapper_bash=\"$RUBBLE_WEB_WRAPPER_BASH\"\n"
              , "  pathext_env='export PATHEXT=\".COM;.EXE;.BAT;.CMD\"'\n"
              , "  library_path_env=\"export LIBRARY_PATH=\\\"$windows_library_path\\${LIBRARY_PATH:+:}\\${LIBRARY_PATH:-}\\\"\"\n"
              , "else\n"
              , "  rustc_wrapper_bash=\"$bash/bin/bash\"\n"
              , "  pathext_env=\"\"\n"
              , "  library_path_env='export LIBRARY_PATH=\"${LIBRARY_PATH:-}\"'\n"
              , "fi\n"
              , "\n"
              , "if ! $is_windows_host; then\n"
              , "  rubble_script_shebang_register \"$rustc_wrapper_bash\" sh bash\n"
              , "  shebang_scripts=()\n"
              , "  for script in \"$out/bin/rust-gdb\" \"$out/bin/rust-gdbgui\" \"$out/bin/rust-lldb\"; do\n"
              , "    [ -f \"$script\" ] || continue\n"
              , "    shebang_scripts+=(\"$script\")\n"
              , "  done\n"
              , "  if ((${#shebang_scripts[@]} > 0)); then\n"
              , "    rubble_script_shebang_rewrite_all --strict \"${shebang_scripts[@]}\"\n"
              , "  fi\n"
              , "fi\n"
              , "\n"
              , "host_rustflags=\"${RUSTFLAGS:-}\"\n"
              , "host_rustflags=\"${host_rustflags:+${host_rustflags} }--cap-lints warn\"\n"
              , "wasm_rustflags=\"--cap-lints warn\"\n"
              , "global_rustflags=\"\"\n"
              , "if $is_windows_host; then\n"
              , "  global_rustflags=\"$wasm_rustflags\"\n"
              , "fi\n"
              , "host_triple_env=\"$(printf '%s' \"$host_triple\" | tr '[:lower:]-' '[:upper:]_')\"\n"
              , "cargo_target_rustflags_env=\"\"\n"
              , "cargo_target_rustflags_declare=\"\"\n"
              , "if $is_windows_host; then\n"
              , "  cargo_target_rustflags_env=\"export CARGO_TARGET_${host_triple_env}_RUSTFLAGS=\\\"$host_rustflags\\\"\n"
              , "export CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUSTFLAGS=\\\"$wasm_rustflags\\\"\"\n"
              , "  cargo_target_rustflags_declare=\"CARGO_TARGET_${host_triple_env}_RUSTFLAGS CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUSTFLAGS\"\n"
              , "fi\n"
              , "\n"
              , "rustc_env_path=\"$out/bin/rustc\"\n"
              , "rustdoc_env_path=\"$out/bin/rustdoc\"\n"
              , "if ! $is_windows_host; then\n"
              , "  write_heredoc_file \"$out/bin/rustc\" <<EOF\n"
              , "#!$rustc_wrapper_bash\n"
              , "set -euo pipefail\n"
              , "\n"
              , "real_rustc=\"$real_rustc\"\n"
              , "sysroot=\"$out\"\n"
              , "\n"
              , "export LD_LIBRARY_PATH=\"\\$sysroot/lib\\${LD_LIBRARY_PATH:+:}\\${LD_LIBRARY_PATH:-}\"\n"
              , "\n"
              , "if [[ \"\\${1:-}\" == \"--print\" && \"\\${2:-}\" == \"sysroot\" ]]; then\n"
              , "  printf '%s\\n' \"\\$sysroot\"\n"
              , "  exit 0\n"
              , "fi\n"
              , "\n"
              , "case \"\\${1:-}\" in\n"
              , "  -V|--version|-vV)\n"
              , "    exec \"\\$real_rustc\" \"\\$@\"\n"
              , "    ;;\n"
              , "esac\n"
              , "\n"
              , "is_wasm=false\n"
              , "is_compile=false\n"
              , "next_is_target=false\n"
              , "for arg in \"\\$@\"; do\n"
              , "  if [[ \"\\$next_is_target\" == \"true\" ]]; then\n"
              , "    if [[ \"\\$arg\" == \"wasm32-unknown-unknown\" ]]; then\n"
              , "      is_wasm=true\n"
              , "    fi\n"
              , "    next_is_target=false\n"
              , "    continue\n"
              , "  fi\n"
              , "\n"
              , "  case \"\\$arg\" in\n"
              , "    --target)\n"
              , "      next_is_target=true\n"
              , "      ;;\n"
              , "    --target=wasm32-unknown-unknown)\n"
              , "      is_wasm=true\n"
              , "      ;;\n"
              , "    --crate-name|*.rs)\n"
              , "      is_compile=true\n"
              , "      ;;\n"
              , "  esac\n"
              , "done\n"
              , "\n"
              , "extra_args=(--sysroot \"\\$sysroot\")\n"
              , "if [[ \"\\$is_compile\" == \"true\" ]]; then\n"
              , "  if [[ \"\\$is_wasm\" == \"true\" ]]; then\n"
              , "    read -r -a rustflags <<< \"\\${RUBBLE_WEB_WASM_RUSTFLAGS:-}\"\n"
              , "  else\n"
              , "    read -r -a rustflags <<< \"\\${RUBBLE_WEB_HOST_RUSTFLAGS:-}\"\n"
              , "  fi\n"
              , "  extra_args+=(\"\\${rustflags[@]}\")\n"
              , "fi\n"
              , "\n"
              , "exec \"\\$real_rustc\" \"\\$@\" \"\\${extra_args[@]}\"\n"
              , "EOF\n"
              , "  chmod +x \"$out/bin/rustc\"\n"
              , "fi\n"
              , "\n"
              , "if $is_windows_host; then\n"
              , "  rustc_env_path=\"$(realpath \"$out/bin/rustc.exe\")\"\n"
              , "  rustdoc_env_path=\"$(realpath \"$out/bin/rustdoc.exe\")\"\n"
              , "fi\n"
              , "windows_tool_path_prefix=\"\"\n"
              , "if $is_windows_host; then\n"
              , "  IFS=':' read -r -a current_path_entries <<< \"$PATH\"\n"
              , "  for path_entry in \"${current_path_entries[@]}\"; do\n"
              , "    case \"$path_entry\" in\n"
              , "      */out-*-gcc/bin|*/rustlib/x86_64-pc-windows-gnu/bin/self-contained)\n"
              , "        windows_tool_path_prefix=\"${windows_tool_path_prefix}${path_entry}:\"\n"
              , "        ;;\n"
              , "    esac\n"
              , "  done\n"
              , "fi\n"
              , "\n"
              , "while IFS= builtin read -r __rubble_output_line; do\n"
              , "  builtin printf '%s\\n' \"$__rubble_output_line\"\n"
              , "done > \"$env\" <<EOF\n"
              , "export PATH=\"$out/bin:$cargo/bin:$rust_llvm_tools/bin:$windows_tool_path_prefix\\${PATH}\"\n"
              , "export LD_LIBRARY_PATH=\"$out/lib\\${LD_LIBRARY_PATH:+:}\\${LD_LIBRARY_PATH:-}\"\n"
              , "$library_path_env\n"
              , "export RUSTC=\"$rustc_env_path\"\n"
              , "export RUSTDOC=\"$rustdoc_env_path\"\n"
              , "export RUSTFLAGS=\"$global_rustflags\"\n"
              , "$cargo_target_rustflags_env\n"
              , "export RUBBLE_WEB_HOST_RUSTFLAGS=\"$host_rustflags\"\n"
              , "export RUBBLE_WEB_WASM_RUSTFLAGS=\"$wasm_rustflags\"\n"
              , "export SDKROOT=\"${SDKROOT:-}\"\n"
              , "export CC=\"${CC:-}\"\n"
              , "export CXX=\"${CXX:-}\"\n"
              , "$pathext_env\n"
              , "export AR=\"${AR:-}\"\n"
              , "export RANLIB=\"${RANLIB:-}\"\n"
              , "export NM=\"${NM:-}\"\n"
              , "export LD=\"${LD:-}\"\n"
              , "export LDFLAGS=\"${LDFLAGS:-}\"\n"
              , "export CFLAGS=\"${CFLAGS:-}\"\n"
              , "export CXXFLAGS=\"${CXXFLAGS:-}\"\n"
              , "export C_INCLUDE_PATH=\"${C_INCLUDE_PATH:-}\"\n"
              , "export CPLUS_INCLUDE_PATH=\"${CPLUS_INCLUDE_PATH:-}\"\n"
              , "export PKG_CONFIG_LIBDIR=\"${PKG_CONFIG_LIBDIR:-}\"\n"
              , "export PERL5LIB=\"${PERL5LIB:-}\"\n"
              , "declare -p PATH LD_LIBRARY_PATH LIBRARY_PATH RUSTC RUSTDOC RUSTFLAGS $cargo_target_rustflags_declare RUBBLE_WEB_HOST_RUSTFLAGS RUBBLE_WEB_WASM_RUSTFLAGS\n"
              , "if [[ -n \"${PATHEXT:-}\" ]]; then\n"
              , "  declare -p PATHEXT\n"
              , "fi\n"
              , "cargo --version\n"
              , "rustc -vV\n"
              , "EOF\n"
              , "builtin unset __rubble_output_line\n"
              , "\n"
              , "export PATH=\"$out/bin:$cargo/bin:$rust_llvm_tools/bin:${PATH}\"\n"
              , "export LD_LIBRARY_PATH=\"$out/lib${LD_LIBRARY_PATH:+:}${LD_LIBRARY_PATH:-}\"\n"
              , "if [[ -n \"$windows_library_path\" ]]; then\n"
              , "  export LIBRARY_PATH=\"$windows_library_path${LIBRARY_PATH:+:}${LIBRARY_PATH:-}\"\n"
              , "fi\n"
              , "export RUSTC=\"$rustc_env_path\"\n"
              , "export RUSTFLAGS=\"$global_rustflags\"\n"
              , "if $is_windows_host; then\n"
              , "  export PATHEXT=\".COM;.EXE;.BAT;.CMD\"\n"
              , "  export \"CARGO_TARGET_${host_triple_env}_RUSTFLAGS=$host_rustflags\"\n"
              , "  export CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUSTFLAGS=\"$wasm_rustflags\"\n"
              , "fi\n"
              , "export RUBBLE_WEB_HOST_RUSTFLAGS=\"$host_rustflags\"\n"
              , "export RUBBLE_WEB_WASM_RUSTFLAGS=\"$wasm_rustflags\"\n"
              , "\n"
              , "\"$cargo/bin/cargo\" --version\n"
              , "\"$rustc_env_path\" -vV\n"
              , "sysroot=\"$(\"$rustc_env_path\" --print sysroot)\"\n"
              , "expected_sysroot=\"$out\"\n"
              , "if $is_windows_host; then\n"
              , "  sysroot=\"${sysroot//\\\\//}\"\n"
              , "  expected_sysroot=\"$(realpath \"$out\")\"\n"
              , "fi\n"
              , "test \"$sysroot\" = \"$expected_sysroot\"\n"
              , "test -d \"$sysroot/lib/rustlib/${host_triple}/lib\"\n"
              , "test -d \"$sysroot/lib/rustlib/wasm32-unknown-unknown/lib\"\n"
              , "target_libdir=\"$(\"$rustc_env_path\" --print target-libdir --target wasm32-unknown-unknown)\"\n"
              , "if $is_windows_host; then\n"
              , "  target_libdir=\"${target_libdir//\\\\//}\"\n"
              , "fi\n"
              , "test -d \"$target_libdir\"\n"
              , "\n"
              , "printf 'fn main() { println!(\"host probe\"); }\\n' > host-probe.rs\n"
              , "host_probe=\"./host-probe\"\n"
              , "if $is_windows_host; then\n"
              , "  host_probe=\"./host-probe.exe\"\n"
              , "fi\n"
              , "if $is_windows_host; then\n"
              , "  read -r -a host_probe_flags <<< \"$host_rustflags\"\n"
              , "  \"$rustc_env_path\" host-probe.rs -o \"$host_probe\" \"${host_probe_flags[@]}\"\n"
              , "else\n"
              , "  \"$out/bin/rustc\" host-probe.rs -o \"$host_probe\"\n"
              , "fi\n"
              , "\"$host_probe\"\n"
              , "dynamic_linker=\"$(printf '%s\\n' \"${LDFLAGS:-}\" | sed -n 's/.*--dynamic-linker=\\([^ ]*\\).*/\\1/p')\"\n"
              , "if [[ -n \"$dynamic_linker\" ]]; then\n"
              , "  readelf -l host-probe | grep -F \"$dynamic_linker\"\n"
              , "fi\n"
              , "\n"
              , "printf '#[no_mangle]\\npub extern \"C\" fn probe() -> i32 { 7 }\\n' > wasm-probe.rs\n"
              , "if $is_windows_host; then\n"
              , "  read -r -a wasm_probe_flags <<< \"$wasm_rustflags\"\n"
              , "  \"$rustc_env_path\" --target wasm32-unknown-unknown --crate-type cdylib wasm-probe.rs -o wasm-probe.wasm \"${wasm_probe_flags[@]}\"\n"
              , "else\n"
              , "  \"$out/bin/rustc\" --target wasm32-unknown-unknown --crate-type cdylib wasm-probe.rs -o wasm-probe.wasm\n"
              , "fi\n"
              , "test -s wasm-probe.wasm"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "5w5ft5y3hkcueupk46bozqrdd7fwxp52ook5odjixgomzioqvuia-rust-toolchain":
      { "id": "5w5ft5y3hkcueupk46bozqrdd7fwxp52ook5odjixgomzioqvuia-rust-toolchain"
      , "name": "rust-toolchain"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "inputs": [
          { "brick": "c5mx6r24inu4xhdgcdtdjpfflxamue4idrmbz4koxqv6frtuwjwq-rust-std-1.94.0"
          , "transitive": "false"
          }
