  , "yz2gkzppzklqwxcexejnusirhckaj5q3znbfvnvabxdkbrjrduaq-binaryen-117":
      { "id": "yz2gkzppzklqwxcexejnusirhckaj5q3znbfvnvabxdkbrjrduaq-binaryen-117"
      , "name": "binaryen-117"
      , "platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "fxdlr54bss5xchltnftplbazx75gkxrblhjswghx525wntx4z47q-binaryen-version_117-x86_64-linux.tar.gz"
          , "alias": "src"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "tar -xzf \"$src\"\n"
              , "test -x binaryen-version_117/bin/wasm-opt\n"
              , "\n"
              , "mkdir -p \"$out/bin\"\n"
              , "cp binaryen-version_117/bin/wasm-opt \"$out/bin/wasm-opt\"\n"
              , "chmod +x \"$out/bin/wasm-opt\"\n"
              , "\n"
              , "\"$out/bin/wasm-opt\" --version"
              ]
            , "format": "text"
            }
          }
        ]
