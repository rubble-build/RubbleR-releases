              , "\n"
              , "cp etc/ssl/certs/ca-certificates.crt \"$out\"\n"
              , "\n"
              , "echo \"\"\n"
              , "echo \"=== CA certificates ===\"\n"
              , "wc -l < \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "gnh47phed75uwi3vbxi5scokhxo64p5gcafwkkjx6oowdevwnhga-c-ares-1.34.8-r0.apk":
