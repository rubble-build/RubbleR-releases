        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "rubble_canonical_script > \"$out\" <<EOF\n"
              , "export PATH=\"$PATH\"\n"
              , "export RUSTFLAGS=\"${RUSTFLAGS:-}\"\n"
              , "export SDKROOT=\"${SDKROOT:-}\"\n"
              , "export CC=\"${CC:-}\"\n"
              , "export CXX=\"${CXX:-}\"\n"
              , "export AR=\"${AR:-}\"\n"
              , "export RANLIB=\"${RANLIB:-}\"\n"
              , "export NM=\"${NM:-}\"\n"
              , "export LD=\"${LD:-}\"\n"
              , "export LDFLAGS=\"${LDFLAGS:-}\"\n"
              , "export CFLAGS=\"${CFLAGS:-}\"\n"
              , "export CXXFLAGS=\"${CXXFLAGS:-}\"\n"
              , "export C_INCLUDE_PATH=\"${C_INCLUDE_PATH:-}\"\n"
              , "export CPLUS_INCLUDE_PATH=\"${CPLUS_INCLUDE_PATH:-}\"\n"
              , "# Prevent pkg-config from finding host system packages (hermetic build)\n"
              , "export PKG_CONFIG_LIBDIR=\"${PKG_CONFIG_LIBDIR:-}\"\n"
              , "# PERL5LIB is needed for OpenSSL build (perl modules location)\n"
              , "export PERL5LIB=\"${PERL5LIB:-}\"\n"
              , "declare -p PATH RUSTFLAGS\n"
              , "\n"
              , "type -a cargo rustc\n"
              , "cargo --version\n"
              , "rustc -vV\n"
              , "EOF"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "shtksgz5dfwxl3a2qy5gazbufvz5d3jrp3yghyt6kfoysejsxr7q-bun-1.4.2":
      { "id": "shtksgz5dfwxl3a2qy5gazbufvz5d3jrp3yghyt6kfoysejsxr7q-bun-1.4.2"
      , "name": "bun-1.4.2"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "teieaxxyjdoyw4gqby5r4ywgrstjp3t6ui4dxasa6j7ba34arziq-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "geq2hsuhuzr6soywtb5evjghfoflwtikb5fax6dw5rm4y5p4b6pa-bun-linux-x64.zip"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "46lfnhiwl7xwedh2m5nqmsiz53zc3vcpqiox4v4mctm56nzwlz6a-bootstrap-env"
          , "alias": "bootstrap"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$out/setup-env.sh\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "st7kemdq4iesmpfx4kbo4q2b3rtuoelmqtgfzzrpzs7hukebga5q-rubble-elf-runtime"
          , "alias": "elf_runtime"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "archive_dir"
          , "value": "bun-linux-x64"
          }
        , { "name": "binary_name"
          , "value": "bun"
          }
        , { "name": "loader_name"
          , "value": "ld-linux-x86-64.so.2"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p unpacked \"$out/bin\"\n"
              , "unzip -q \"$src\" -d unpacked\n"
              , "cp \"unpacked/$archive_dir/$binary_name\" \"$out/bin/$binary_name\"\n"
              , "chmod 755 \"$out/bin/$binary_name\"\n"
              , "binary=\"$out/bin/$binary_name\"\n"
              , "loader=\"$elf_runtime/lib/$loader_name\"\n"
              , "test -x \"$loader\"\n"
              , "\"$patchelf\" --no-sort --set-interpreter \"$loader\" --force-rpath --set-rpath \"$elf_runtime/lib\" \"$binary\"\n"
              , "\n"
              , "# Patchelf 0.18.0 can move .gnu.version_d without updating DT_VERDEF.\n"
              , "# Repair that pointer from the ELF metadata after relocation.\n"
              , "# Reproducer: https://github.com/can1357/oh-my-pi/issues/9881\n"
              , "\"$bootstrap/bin/perl\" - \"$binary\" <<'PERL'\n"
              , "use strict;\n"
              , "use warnings;\n"
              , "open my $elf, '+<', $ARGV[0] or die \"open Bun ELF: $!\\n\";\n"
              , "binmode $elf;\n"
              , "sub read_at {\n"
              , "    my ($offset, $length) = @_;\n"
              , "    seek($elf, $offset, 0) or die \"seek Bun ELF: $!\\n\";\n"
              , "    my $buffer;\n"
              , "    read($elf, $buffer, $length) == $length or die \"short Bun ELF read\\n\";\n"
              , "    return $buffer;\n"
              , "}\n"
              , "my $header = read_at(0, 64);\n"
              , "substr($header, 0, 6) eq \"\\x7fELF\\x02\\x01\" or die \"expected ELF64 little endian\\n\";\n"
              , "my $section_offset = unpack('Q<', substr($header, 40, 8));\n"
              , "my ($section_size, $section_count) = unpack('S<S<', substr($header, 58, 4));\n"
              , "$section_size == 64 && $section_count > 0 or die \"unsupported Bun ELF sections\\n\";\n"
              , "my ($version_address, $dynamic_offset, $dynamic_size);\n"
              , "for my $index (0 .. $section_count - 1) {\n"
              , "    my $section = read_at($section_offset + $index * $section_size, $section_size);\n"
              , "    my ($type, $address, $offset, $size) = unpack('x4 L< x8 Q<Q<Q<', $section);\n"
              , "    if ($type == 0x6ffffffd) {\n"
              , "        !defined $version_address && $size > 0 or die \"ambiguous Bun version definitions\\n\";\n"
              , "        $version_address = $address;\n"
              , "    }\n"
              , "    if ($type == 6) {\n"
              , "        !defined $dynamic_offset or die \"ambiguous Bun dynamic table\\n\";\n"
              , "        ($dynamic_offset, $dynamic_size) = ($offset, $size);\n"
              , "    }\n"
              , "}\n"
              , "defined $dynamic_offset && $dynamic_size % 16 == 0 or die \"missing Bun dynamic table\\n\";\n"
              , "my ($version_slot, $previous_value, $terminated);\n"
              , "for (my $offset = $dynamic_offset; $offset < $dynamic_offset + $dynamic_size; $offset += 16) {\n"
              , "    my ($tag, $value) = unpack('Q<Q<', read_at($offset, 16));\n"
              , "    if ($tag == 0) { $terminated = 1; last; }\n"
              , "    next unless $tag == 0x6ffffffc;\n"
              , "    !defined $version_slot or die \"ambiguous Bun DT_VERDEF\\n\";\n"
              , "    ($version_slot, $previous_value) = ($offset + 8, $value);\n"
              , "}\n"
              , "$terminated or die \"unterminated Bun dynamic table\\n\";\n"
              , "exit 0 if !defined $version_address && !defined $version_slot;\n"
              , "defined $version_address && defined $version_slot or die \"incomplete Bun version metadata\\n\";\n"
              , "if ($previous_value != $version_address) {\n"
              , "    seek($elf, $version_slot, 0) or die \"seek Bun DT_VERDEF: $!\\n\";\n"
              , "    print {$elf} pack('Q<', $version_address) or die \"write Bun DT_VERDEF: $!\\n\";\n"
              , "    printf \"Bun DT_VERDEF: 0x%x -> 0x%x\\n\", $previous_value, $version_address;\n"
              , "}\n"
              , "close $elf or die \"close Bun ELF: $!\\n\";\n"
              , "PERL\n"
              , "\n"
              , "[[ \"$(\"$patchelf\" --print-interpreter \"$binary\")\" == \"$loader\" ]]\n"
              , "[[ \"$(\"$patchelf\" --print-rpath \"$binary\")\" == \"$elf_runtime/lib\" ]]\n"
              , "dynamic_tags=\"$(\"$bootstrap/bin/readelf\" -d \"$binary\")\"\n"
              , "[[ \"$dynamic_tags\" == *\"(RPATH)\"* && \"$dynamic_tags\" != *\"(RUNPATH)\"* ]]\n"
              , "\"$bootstrap/bin/readelf\" --version-info \"$binary\" > /dev/null\n"
              , "needed_entries=\"$(\"$patchelf\" --print-needed \"$binary\")\"\n"
              , "while IFS= read -r needed; do\n"
              , "  if [[ ! -f \"$elf_runtime/lib/$needed\" ]]; then\n"
              , "    echo \"Missing Bun runtime dependency: $needed\" >&2\n"
              , "    exit 1\n"
              , "  fi\n"
              , "done <<< \"$needed_entries\"\n"
              , "\n"
              , "actual_version=$(\"$binary\" --version)\n"
              , "[[ \"$actual_version\" == \"1.4.2\" ]]\n"
              , "env -i \"$binary\" -e '\n"
              , "  const fs = require(\"node:fs\");\n"
              , "  const {execFileSync} = require(\"node:child_process\");\n"
              , "  if (fs.realpathSync(process.execPath) !== fs.realpathSync(process.argv.at(-1))) {\n"
              , "    throw new Error(\"Bun process.execPath does not identify its executable\");\n"
              , "  }\n"
              , "  if (execFileSync(process.execPath, [\"--version\"], {env: {}}).toString().trim() !== \"1.4.2\") {\n"
              , "    throw new Error(\"Bun self-spawn failed\");\n"
              , "  }\n"
              , "' \"$binary\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "zlqkh4hv6jitrpj2uumu62lrfbvr6hozsu4j6wjoo75glrnl4f6a-RubbleR.git.partial":
      { "id": "zlqkh4hv6jitrpj2uumu62lrfbvr6hozsu4j6wjoo75glrnl4f6a-RubbleR.git.partial"
      , "name": "RubbleR.git.partial"
      , "src": {
          "repo": "https://github.com/chaifeng/RubbleR.git"
        , "commit": "85f86cf23402b123519ec5fbc374688f9ca1f8cb"
        , "paths": [
            "./Cargo.lock"
          , "./Cargo.toml"
          , "./rubble_derive/Cargo.toml"
          , "./rust-toolchain.toml"
          ]
        }
      , "inputs": [
          { "brick": "jzib76o6jwvszofr4g7p5ceo7li2szw2zm25pt6bwpu4plo7wdwq-rubble-src-checkout"
          , "alias": "rubble_src_checkout"
          , "transitive": "false"
          }
        , { "brick": "xpsu7cfnztrrwbvvhovnnlzvjzp3f6qf6funj7ehcobaqgpnx6ha-rubble-canonical-script"
          , "alias": "rubble_canonical_script"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "RUBBLE_SRC_FETCH_MODE RUBBLE_SRC_LOCAL_PATHS all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "__rubble_skip_src_split__"
          , "value": "true"
          }
        ]
      , "outputs": [
          { "name": "dir" }
        , { "name": "archive__impure__" }
        , { "name": "script" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -v \"$dir\"\n"
              , "echo \"${brick[src::commit]}\" > \"${dir}/.rubble-deferred\"\n"
              , "\n"
              , "mkdir -v \"$archive\"\n"
              , "echo \"${brick[src::commit]}\" > \"${archive}/.rubble-deferred\"\n"
              , "\n"
              , "source \"${rubble_canonical_script[script]}\"\n"
              , "\n"
              , "rubble_canonical_script << __EOF_SCRIPT_207__ | tee \"$script\"\n"
              , "set -x\n"
              , "\n"
              , "declare -p brick &>/dev/null || declare -A brick\n"
              , "repo=\"\\${brick_src_repo:-\\${brick[src::origin]:-${brick[src::origin]}}}\"\n"
              , "commit=\"\\${brick_src_commit:-\\${brick[src::commit]:-${brick[src::commit]}}}\"\n"
              , "paths=\"${brick[src::paths]}\"\n"
              , "gitRepoCredential=\"\"\n"
              , "src_archive=\"$archive\"\n"
              , "inner_path=\"\"\n"
              , "deferred_marker=\".rubble-deferred\"\n"
              , "\n"
              , "if [[ -z \"\\${repo:-}\" || -z \"\\${commit:-}\" ]]; then\n"
              , "    echo \"Error: Missing repo or commit information\" >&2\n"
              , "    exit 1\n"
              , "fi\n"
              , "\n"
              , "source \"${rubble_src_checkout}\" \"\\${1:-\\${dir}}\"\n"
              , "__EOF_SCRIPT_207__"
              ]
            , "format": "text"
            }
          }
        ]
      }
