{ "id": "niz3u7s37ltlvvoqqlcs4r7bbhp2prlm34bzeccnlxg3krzcahda-rubble"
, "name": "rubble"
, "platform": "x86_64-linux"
, "build_platform": "x86_64-linux"
, "rubble_home": "/var/lib/rubble"
, "opaque": true
, "inputs": [
    { "brick": "teieaxxyjdoyw4gqby5r4ywgrstjp3t6ui4dxasa6j7ba34arziq-patchelf"
    , "alias": "rubble_patchelf"
    , "transitive": "false"
    }
  , { "brick": "46lfnhiwl7xwedh2m5nqmsiz53zc3vcpqiox4v4mctm56nzwlz6a-bootstrap-env"
    , "alias": "bootstrap"
    , "transitive": "true"
    , "hooks": {
        "pre-checkout": [
          { "shell": {
              "value": [
                "source \"$out/setup-env.sh\""
              ]
            , "format": "text"
            }
          }
        ]
      }
    }
  , { "brick": "jollno6o4uloupgitupgjbfxgunhmm5hx3hdhvl7kbmw47dj4dpq-glibc-runtime-support"
    , "alias": "glibc_support"
    , "transitive": "true"
    }
  , { "brick": "st7kemdq4iesmpfx4kbo4q2b3rtuoelmqtgfzzrpzs7hukebga5q-rubble-elf-runtime"
    , "alias": "rubble_elf_runtime"
    , "transitive": "true"
    }
  , { "brick": "5w5ft5y3hkcueupk46bozqrdd7fwxp52ook5odjixgomzioqvuia-rust-toolchain"
    , "transitive": "false"
    , "after": [
        "bootstrap"
      ]
    , "hooks": {
        "pre-build": [
          { "shell": {
              "value": [
                "source \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
    }
  , { "brick": "shtksgz5dfwxl3a2qy5gazbufvz5d3jrp3yghyt6kfoysejsxr7q-bun-1.4.2"
    , "alias": "bun"
    , "transitive": "true"
    }
  , { "brick": "5nrap7vermuhdkqtamy653bdcnwr6ehk5a6anm7j63reercotpxq-rubble-deps-cache"
    , "alias": "deps_cache"
    , "transitive": "false"
    }
  , { "brick": "regoxzdjco6l24wacxv6igyyaqk7nfks2okct3g7rcat33gzh7ba-rubble-web-assets"
    , "alias": "web_assets"
    , "transitive": "false"
    }
  , { "brick": "34l3qhyt32cnsp3szqfcgmezrrqek6sxp6c3jr7uwnve67swunqq-RubbleR.git"
    , "alias": "src"
    , "transitive": "false"
    , "hooks": {
        "post-checkout": [
          { "install-to": [
              { "output": "dir"
              , "dir": "./" }
            ]
          }
        , { "shell": {
              "value": [
                "( source \"${script}\" \"${dir}\" )"
              ]
            , "format": "text"
            }
          }
        ]
      }
    }
  ]
, "env": [
    { "name": "BUILD_TYPE"
    , "value": "release" }
  , { "name": "IMPURE_ENV"
    , "value": "RUBBLE_SRC_LOCAL_PATHS RUST_LOG all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  , { "name": "docs" }
  , { "name": "lib" }
  , { "name": "scripts" }
  , { "name": "web" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "if [[ -n \"${deps_cache:-}\" ]]; then\n"
        , "  rm -rf vendor .cargo target\n"
        , "  cp -a \"${deps_cache}/vendor\" vendor\n"
        , "  cp -a \"${deps_cache}/.cargo\" .cargo\n"
        , "  cp -a \"${deps_cache}/target\" target\n"
        , "  cp -a \"${deps_cache}/Cargo.lock\" Cargo.lock\n"
        , "fi\n"
        , "\n"
        , "sed -i \"s/00000000000000000000000rubble00000000000000000000000/${brick[id]}/\" Cargo.toml Cargo.lock src/main.rs\n"
        , "export RUBBLE_RUNTIME_HOME=\"${RUBBLE_HOME}\"\n"
        , "if [[ -n \"${MSYS2_ROOT:-}\" ]]; then\n"
        , "  export RUBBLE_RUNTIME_PATH_ENV=\"$(cygpath -aw \"$MSYS2_ROOT/usr/bin\");$(cygpath -aw \"${bootstrap}/bin\");$(cygpath -aw \"${bun}/bin\")\"\n"
        , "else\n"
        , "  export RUBBLE_RUNTIME_PATH_ENV=\"${bootstrap}/bin:${bun}/bin\"\n"
        , "fi\n"
        , "\n"
        , "export RUBBLE_RUNTIME_REQUIRED_BRICKS=\"\"\n"
        , "project_dir=\"$PWD\"\n"
        , "RUBBLE_MANUAL_CATALOG=\"$(\n"
        , "  \"${bootstrap}/bin/bash\" \\\n"
        , "    \"$project_dir/scripts/prepare-rubble-docs-output.sh\" \\\n"
        , "    --catalog \\\n"
        , "    \"$project_dir\"\n"
        , ")\"\n"
        , "export RUBBLE_MANUAL_CATALOG\n"
        , "[[ -d \"$project_dir/target\" ]] || mkdir -v \"$project_dir/target\"\n"
        , "export CARGO_HOME=\"$project_dir/target/cargo_home\"\n"
        , "export OPENSSL_CONFIG_DIR=\"/rubble/openssl/ssl\"\n"
        , "# Keep RUSTFLAGS stable across deps_cache and final builds; build-path remaps\n"
        , "# break Cargo fingerprint reuse.\n"
        , "export RUSTFLAGS=\"${RUSTFLAGS:-} --cap-lints warn\"\n"
        , "launcher_suffix=\"\"\n"
        , "if [[ -n \"${MSYS2_ROOT:-}\" ]]; then\n"
        , "  launcher_suffix=\".exe\"\n"
        , "fi\n"
        , "isolated_cargo=\"$project_dir/target/rubble-isolated-bin/cargo${launcher_suffix}\"\n"
        , "if [[ ! -x \"$isolated_cargo\" ]]; then\n"
        , "  echo \"isolated Cargo launcher is missing: $isolated_cargo\"\n"
        , "  exit 1\n"
        , "fi\n"
        , "if [[ -n \"${web_assets:-}\" ]]; then\n"
        , "  rm -rf rubble-web/embed\n"
        , "  mkdir -p rubble-web/embed\n"
        , "  cp -a \"${web_assets}/.\" rubble-web/embed/\n"
        , "fi\n"
        , "\n"
        , "cargo_messages=\"$project_dir/cargo-build-messages.jsonl\"\n"
        , "cargo_log=\"$project_dir/cargo-build.log\"\n"
        , "cargo_artifact_selection=\"$project_dir/cargo-build-artifacts.bin\"\n"
        , "cargo_cache_stats_file=\"$project_dir/cargo-build-stats.txt\"\n"
        , "\"${bootstrap}/bin/bash\" \\\n"
        , "  \"$project_dir/scripts/build-rubble-cargo-artifacts.sh\" \\\n"
        , "  \"$isolated_cargo\" \\\n"
        , "  \"${bootstrap}/bin/perl\" \\\n"
        , "  \"$project_dir/scripts/read-cargo-build-messages.pl\" \\\n"
        , "  \"$project_dir/Cargo.toml\" \\\n"
        , "  \"$BUILD_TYPE\" \\\n"
        , "  \"$cargo_messages\" \\\n"
        , "  \"$cargo_log\" \\\n"
        , "  \"$cargo_artifact_selection\" \\\n"
        , "  \"$cargo_cache_stats_file\"\n"
        , "\n"
        , "mapfile -d '' -t cargo_artifacts < \"$cargo_artifact_selection\"\n"
        , "if ((${#cargo_artifacts[@]} != 3)); then\n"
        , "  echo \"Expected three Cargo-reported Rubble artifacts, found ${#cargo_artifacts[@]}\" >&2\n"
        , "  exit 1\n"
        , "fi\n"
        , "cargo_rubble_artifact=\"$(unixpath \"${cargo_artifacts[0]}\")\"\n"
        , "cargo_web_artifact=\"$(unixpath \"${cargo_artifacts[1]}\")\"\n"
        , "cargo_rlib_artifact=\"$(unixpath \"${cargo_artifacts[2]}\")\"\n"
        , "for cargo_artifact in \"$cargo_rubble_artifact\" \"$cargo_web_artifact\" \"$cargo_rlib_artifact\"; do\n"
        , "  if [[ ! -f \"$cargo_artifact\" ]]; then\n"
        , "    echo \"Cargo-reported artifact is not a file: $cargo_artifact\" >&2\n"
        , "    exit 1\n"
        , "  fi\n"
        , "done\n"
        , "\n"
        , "# Report cache statistics\n"
        , "mapfile -t cargo_cache_stats < \"$cargo_cache_stats_file\"\n"
        , "if ((${#cargo_cache_stats[@]} != 2)) || \\\n"
        , "  [[ ! \"${cargo_cache_stats[0]}\" =~ ^[0-9]+$ ]] || \\\n"
        , "  [[ ! \"${cargo_cache_stats[1]}\" =~ ^[0-9]+$ ]]; then\n"
        , "  echo \"Invalid Cargo cache statistics\" >&2\n"
        , "  exit 1\n"
        , "fi\n"
        , "fresh_count=\"${cargo_cache_stats[0]}\"\n"
        , "compile_count=\"${cargo_cache_stats[1]}\"\n"
        , "echo \"=== Cache Statistics ===\"\n"
        , "echo \"Fresh (cache hit): $fresh_count\"\n"
        , "echo \"Compiling (cache miss): $compile_count\"\n"
        , "if [[ $((fresh_count + compile_count)) -gt 0 ]]; then\n"
        , "  hit_rate=$((fresh_count * 100 / (fresh_count + compile_count)))\n"
        , "  echo \"Cache hit rate: ${hit_rate}%\"\n"
        , "fi\n"
        , "\n"
        , "# List crates that missed cache (recompiled)\n"
        , "if [[ \"$compile_count\" -gt 0 ]]; then\n"
        , "  echo \"\"\n"
        , "  echo \"=== Cache Miss Details ===\"\n"
        , "  grep \"^\\s*Compiling\" \"$cargo_log\" | sed 's/^\\s*Compiling //' | sort | while read -r crate_info; do\n"
        , "    crate_name=$(echo \"$crate_info\" | awk '{print $1}')\n"
        , "    crate_version=$(echo \"$crate_info\" | sed 's/.*v\\([0-9][^ ]*\\).*/\\1/')\n"
        , "    crate_path=$(echo \"$crate_info\" | grep -o '(.*)' || true)\n"
        , "    # Check if crate has build.rs\n"
        , "    if [[ -n \"$crate_path\" ]]; then\n"
        , "      clean_path=$(echo \"$crate_path\" | tr -d '()')\n"
        , "      if [[ -f \"$clean_path/build.rs\" ]]; then\n"
        , "        echo \"  $crate_name v$crate_version [has build.rs]\"\n"
        , "      else\n"
        , "        echo \"  $crate_name v$crate_version\"\n"
        , "      fi\n"
        , "    else\n"
        , "      echo \"  $crate_name v$crate_version\"\n"
        , "    fi\n"
        , "  done\n"
        , "\n"
        , "  # Summary by category\n"
        , "  echo \"\"\n"
        , "  echo \"=== Cache Miss Summary ===\"\n"
        , "  with_build_rs=0\n"
        , "  while read -r line; do\n"
        , "    path=$(echo \"$line\" | grep -o '([^)]*)' | tr -d '()') || true\n"
        , "    if [[ -n \"$path\" && -f \"$path/build.rs\" ]]; then\n"
        , "      with_build_rs=$((with_build_rs + 1))\n"
        , "    fi\n"
        , "  done < <(grep \"^\\s*Compiling\" \"$cargo_log\" || true)\n"
        , "  without_build_rs=$((compile_count - with_build_rs))\n"
        , "  echo \"  With build.rs: $with_build_rs (expected - OUT_DIR differs)\"\n"
        , "  echo \"  Without build.rs: $without_build_rs (unexpected - investigate)\"\n"
        , "fi\n"
        , "rm -f \"$cargo_log\" \"$cargo_messages\" \"$cargo_artifact_selection\" \"$cargo_cache_stats_file\"\n"
        , "\n"
        , "cp -v \"$cargo_rubble_artifact\" $out\n"
        , "cp -v \"$cargo_web_artifact\" $web\n"
        , "\n"
        , "mkdir -vp \"$scripts\"\n"
        , "cp -av -- \\\n"
        , "  scripts/audit-glibc-runtime.sh \\\n"
        , "  scripts/audit-rubble-output-paths.sh \\\n"
        , "  scripts/rubble-inventory-bundle-import.sh \\\n"
        , "  scripts/rubble-inventory-bundle.sh \\\n"
        , "  \"$scripts/\"\n"
        , "\n"
        , "\"${bootstrap}/bin/bash\" \\\n"
        , "  scripts/prepare-rubble-scripts-output.sh \\\n"
        , "  \"$scripts\" \\\n"
        , "  \"${bootstrap}/bin/bash\" \\\n"
        , "  \"$out\" \\\n"
        , "  \"${glibc_support:-}\"\n"
        , "\n"
        , "\"${bootstrap}/bin/bash\" \\\n"
        , "  scripts/prepare-rubble-docs-output.sh \\\n"
        , "  \"$docs\" \\\n"
        , "  \"${bootstrap}/bin/zstd\" \\\n"
        , "  \"$project_dir\"\n"
        , "\n"
        , "if [[ -n \"${rubble_elf_runtime:-}\" ]]; then\n"
        , "  managed_readelf=\"$bootstrap/bin/readelf\"\n"
        , "  if [[ ! -x \"$managed_readelf\" ]]; then\n"
        , "    echo \"Declared ELF inspection tool is not executable: $managed_readelf\" >&2\n"
        , "    exit 1\n"
        , "  fi\n"
        , "  managed_strip=\"$bootstrap/bin/strip\"\n"
        , "  if [[ ! -x \"$managed_strip\" ]]; then\n"
        , "    echo \"Declared ELF strip tool is not executable: $managed_strip\" >&2\n"
        , "    exit 1\n"
        , "  fi\n"
        , "\n"
        , "  shopt -s nullglob\n"
        , "  runtime_loaders=(\"$rubble_elf_runtime\"/lib/ld-linux-*.so.*)\n"
        , "  shopt -u nullglob\n"
        , "  if ((${#runtime_loaders[@]} != 1)); then\n"
        , "    echo \"Expected one Rubble ELF runtime loader, found ${#runtime_loaders[@]}\" >&2\n"
        , "    exit 1\n"
        , "  fi\n"
        , "  runtime_loader=\"${runtime_loaders[0]}\"\n"
        , "\n"
        , "  echo \"=== Routing Rubble executables to the ELF runtime ===\"\n"
        , "  for rubble_binary in \"$out\" \"$web\"; do\n"
        , "    # --force-rpath pins DT_RPATH instead of the default DT_RUNPATH so the\n"
        , "    # runtime library search path outranks LD_LIBRARY_PATH; a polluted\n"
        , "    # ambient LD_LIBRARY_PATH carrying a foreign glibc must not override\n"
        , "    # the declared runtime loader/libc pair.\n"
        , "    \"$rubble_patchelf\" \\\n"
        , "      --set-interpreter \"$runtime_loader\" \\\n"
        , "      --force-rpath \\\n"
        , "      --set-rpath \"$rubble_elf_runtime/lib\" \\\n"
        , "      \"$rubble_binary\"\n"
        , "\n"
        , "    if ! \"$managed_strip\" --strip-all \"$rubble_binary\"; then\n"
        , "      echo \"Failed to strip ELF symbols: $rubble_binary\" >&2\n"
        , "      exit 1\n"
        , "    fi\n"
        , "\n"
        , "    if ! interpreter=\"$(\"$rubble_patchelf\" --print-interpreter \"$rubble_binary\")\"; then\n"
        , "      echo \"Failed to inspect the ELF interpreter: $rubble_binary\" >&2\n"
        , "      exit 1\n"
        , "    fi\n"
        , "    if [[ \"$interpreter\" != \"$runtime_loader\" ]]; then\n"
        , "      echo \"Unexpected ELF interpreter for $rubble_binary: $interpreter\" >&2\n"
        , "      exit 1\n"
        , "    fi\n"
        , "\n"
        , "    if ! runtime_path=\"$(\"$rubble_patchelf\" --print-rpath \"$rubble_binary\")\"; then\n"
        , "      echo \"Failed to inspect the ELF runtime search path: $rubble_binary\" >&2\n"
        , "      exit 1\n"
        , "    fi\n"
        , "    if [[ \"$runtime_path\" != \"$rubble_elf_runtime/lib\" ]]; then\n"
        , "      echo \"Unexpected ELF runtime search path for $rubble_binary: $runtime_path\" >&2\n"
        , "      exit 1\n"
        , "    fi\n"
        , "\n"
        , "    if ! dynamic_tags=\"$(\"$managed_readelf\" -d \"$rubble_binary\")\"; then\n"
        , "      echo \"Failed to inspect ELF dynamic tags: $rubble_binary\" >&2\n"
        , "      exit 1\n"
        , "    fi\n"
        , "    if [[ \"$dynamic_tags\" != *\"(RPATH)\"* ]]; then\n"
        , "      echo \"Missing DT_RPATH for $rubble_binary\" >&2\n"
        , "      exit 1\n"
        , "    fi\n"
        , "    if [[ \"$dynamic_tags\" == *\"(RUNPATH)\"* ]]; then\n"
        , "      echo \"Unexpected DT_RUNPATH for $rubble_binary\" >&2\n"
        , "      exit 1\n"
        , "    fi\n"
        , "    echo \"Verified ELF dynamic tag: $(basename \"$rubble_binary\") -> DT_RPATH\"\n"
        , "\n"
        , "    if ! needed_entries=\"$(\"$rubble_patchelf\" --print-needed \"$rubble_binary\")\"; then\n"
        , "      echo \"Failed to inspect ELF runtime dependencies: $rubble_binary\" >&2\n"
        , "      exit 1\n"
        , "    fi\n"
        , "    while IFS= read -r needed; do\n"
        , "      if [[ ! -e \"$rubble_elf_runtime/lib/$needed\" ]]; then\n"
        , "        echo \"Missing ELF runtime dependency for $rubble_binary: $needed\" >&2\n"
        , "        exit 1\n"
        , "      fi\n"
        , "      echo \"Resolved ELF runtime dependency: $(basename \"$rubble_binary\") -> $needed\"\n"
        , "    done <<< \"$needed_entries\"\n"
        , "\n"
        , "    if ! section_headers=\"$(\"$managed_readelf\" -W -S \"$rubble_binary\")\"; then\n"
        , "      echo \"Failed to inspect ELF sections: $rubble_binary\" >&2\n"
        , "      exit 1\n"
        , "    fi\n"
        , "    for stripped_section in .symtab .strtab; do\n"
        , "      if [[ \"$section_headers\" == *\" $stripped_section \"* ]]; then\n"
        , "        echo \"Unexpected unstripped ELF section for $rubble_binary: $stripped_section\" >&2\n"
        , "        exit 1\n"
        , "      fi\n"
        , "    done\n"
        , "    for dynamic_section in .dynsym .dynstr; do\n"
        , "      if [[ \"$section_headers\" != *\" $dynamic_section \"* ]]; then\n"
        , "        echo \"Missing dynamic ELF section for $rubble_binary: $dynamic_section\" >&2\n"
        , "        exit 1\n"
        , "      fi\n"
        , "    done\n"
        , "    echo \"Verified stripped ELF symbols: $(basename \"$rubble_binary\")\"\n"
        , "    echo \"Verified ELF runtime routing: $rubble_binary\"\n"
        , "  done\n"
        , "else\n"
        , "  echo \"Skipping ELF runtime routing on this platform\"\n"
        , "fi\n"
        , "\n"
        , "if [[ \"${brick[platform]}\" == *-linux ]]; then\n"
        , "  \"$out\" --quiet info --check-tools\n"
        , "fi\n"
        , "\n"
        , "if [[ \"${brick[platform]}\" == *-linux ]]; then\n"
        , "  \"$web\" --help >/dev/null\n"
        , "fi\n"
        , "\n"
        , "mkdir -vp $lib\n"
        , "cp -v \"$cargo_rlib_artifact\" $lib\n"
        , "cp -v Cargo.toml Cargo.lock $lib"
        ]
      , "format": "text"
      }
    }
  ]
, "inventory": {
    "hl6djaj44qkp6rily6m7uf6lsksicuvyiukbsphwqzo7zhddpzna-zstd-libs-1.5.6-r2.apk":
      { "id": "hl6djaj44qkp6rily6m7uf6lsksicuvyiukbsphwqzo7zhddpzna-zstd-libs-1.5.6-r2.apk"
      , "name": "zstd-libs-1.5.6-r2.apk"
      , "src": {
