          }
        , { "brick": "c35i4mn5dmhidddyvzilwvmqnvugfaai2kfuxdqlq2pknwvaciuq-libgomp-14.2.0-r4.apk"
          , "alias": "libgomp_apk"
          , "transitive": "false"
          }
        , { "brick": "ygiy7hr5xdujt354tflhamaynd7pulonibb4exgkrqfb6eyq3ova-libgcc-14.2.0-r4.apk"
          , "alias": "libgcc_apk"
          , "transitive": "false"
          }
        , { "brick": "7qwj66t7ongdyxwj3ixwfuso2w4z75ztu277i425f66q6z76xvka-libatomic-14.2.0-r4.apk"
          , "alias": "libatomic_apk"
          , "transitive": "false"
          }
        , { "brick": "zkiff2cic77r6rxw3quhxg6gu4rznq4omwpz5tui7zwbvlqj6mbq-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "czbs6vraoytel3bfaxgi2lpunsggqjavasxwzqbkr6hwtyzzdbxa-jansson-2.14-r4.apk"
          , "alias": "jansson_apk"
          , "transitive": "false"
          }
        , { "brick": "hqjsomgsdf5yekubrqawdyfsvgwq3qx3uesyfpggo4ogd5ohak4q-isl26-0.26-r1.apk"
          , "alias": "isl_apk"
          , "transitive": "false"
          }
        , { "brick": "poyqkgpnrlor4i3embihirbnvv2lkaoat3pg55lbgvgmj2l4rlfa-gmp-6.3.0-r2.apk"
          , "alias": "gmp_apk"
          , "transitive": "false"
          }
        , { "brick": "jnmg45vg4ddydtuugrzlidkaux7kjxduijdqlfs3fgcoewkrrnfa-gcc-14.2.0-r4.apk"
          , "alias": "gcc_apk"
          , "transitive": "false"
          }
        , { "brick": "w2nvclvz4n67yxhsuoio5kwv6aihl4fwjeeqdbjgqpmnauv7sfxa-g__-14.2.0-r4.apk"
          , "alias": "gpp_apk"
          , "transitive": "false"
          }
        , { "brick": "zfy67agwxmyoiii7ufxqtoila6o65ig2u3aqqjo72h2snsjskhja-binutils-2.43.1-r3.apk"
          , "alias": "binutils_apk"
          , "transitive": "false"
          }
        , { "brick": "bxchorbehgapcopsqwo7w5zwjgenujywlkkytlnad3dvy5hpqc5q-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "gcc_triple"
          , "value": "x86_64-alpine-linux-musl"
          }
        , { "name": "gcc_version"
          , "value": "14.2.0"
          }
        , { "name": "musl_interpreter"
          , "value": "ld-musl-x86_64.so.1"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p \"$out/bin\" \"$out/lib\" \"$out/include\" \"$out/libexec\" extract\n"
              , "\n"
              , "echo \"=== Extracting packages ===\"\n"
              , "for apk in \"$gcc_apk\" \"$gpp_apk\" \"$binutils_apk\" \"$musl_dev_apk\" \\\n"
              , "           \"$linux_headers_apk\" \"$libstdcpp_dev_apk\" \"$libgcc_apk\" \\\n"
              , "           \"$libstdcpp_apk\" \"$libgomp_apk\" \"$libatomic_apk\" \"$gmp_apk\" \\\n"
              , "           \"$mpfr_apk\" \"$mpc_apk\" \"$isl_apk\" \"$zlib_apk\" \"$jansson_apk\" \\\n"
              , "           \"$zstd_libs_apk\"; do\n"
              , "  tar -xzf \"$apk\" -C extract 2>/dev/null || true\n"
              , "done\n"
              , "\n"
              , "# Create musl libc symlink pointing to the runtime interpreter\n"
              , "ln -sf \"$ld_musl\" \"$out/lib/$musl_interpreter\"\n"
              , "ln -sf \"$musl_interpreter\" \"$out/lib/libc.${musl_interpreter#ld-}\"\n"
              , "\n"
              , "# Copy all shared libraries\n"
              , "echo \"Copying shared libraries...\"\n"
              , "find extract -name \"*.so*\" -type f -exec cp -a {} \"$out/lib/\" \\; 2>/dev/null || true\n"
              , "find extract -name \"*.so*\" -type l -exec cp -a {} \"$out/lib/\" \\; 2>/dev/null || true\n"
              , "\n"
              , "# Copy static libraries and object files from musl-dev\n"
              , "echo \"Copying musl-dev files...\"\n"
              , "find extract/usr/lib -name \"*.a\" -exec cp -a {} \"$out/lib/\" \\; 2>/dev/null || true\n"
              , "find extract/usr/lib -name \"*.o\" -exec cp -a {} \"$out/lib/\" \\; 2>/dev/null || true\n"
              , "\n"
              , "# Copy GCC-specific libraries (crt*.o files, static libs)\n"
              , "echo \"Copying GCC libraries...\"\n"
              , "if [ -d \"extract/usr/lib/gcc\" ]; then\n"
              , "  cp -a extract/usr/lib/gcc \"$out/lib/gcc\"\n"
              , "fi\n"
              , "if [ -d \"extract/usr/lib/bfd-plugins\" ]; then\n"
              , "  cp -a extract/usr/lib/bfd-plugins \"$out/lib/\"\n"
              , "fi\n"
              , "\n"
              , "# Copy binaries\n"
              , "echo \"Copying binaries...\"\n"
              , "for f in extract/usr/bin/*; do\n"
              , "  if [ -f \"$f\" ] && [ ! -L \"$f\" ]; then\n"
              , "    cp \"$f\" \"$out/bin/\"\n"
              , "  elif [ -L \"$f\" ]; then\n"
              , "    cp -a \"$f\" \"$out/bin/\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# Copy GCC libexec (cc1, cc1plus, collect2, etc.)\n"
              , "echo \"Copying GCC libexec...\"\n"
              , "if [ -d \"extract/usr/libexec/gcc\" ]; then\n"
              , "  cp -a extract/usr/libexec/gcc \"$out/libexec/gcc\"\n"
              , "fi\n"
              , "\n"
              , "# Copy headers\n"
              , "echo \"Copying headers...\"\n"
              , "if [ -d \"extract/usr/include\" ]; then\n"
              , "  cp -a extract/usr/include/* \"$out/include/\" 2>/dev/null || true\n"
              , "fi\n"
              , "\n"
              , "# Patch binutils ELF binaries (PIE binaries — patchelf works reliably)\n"
              , "echo \"\"\n"
              , "echo \"=== Patching ELF binaries ===\"\n"
              , "for f in \"$out/bin/as\" \"$out/bin/ld\" \"$out/bin/ld.bfd\" \"$out/bin/ar\" \\\n"
              , "         \"$out/bin/nm\" \"$out/bin/ranlib\" \"$out/bin/objcopy\" \"$out/bin/objdump\" \\\n"
              , "         \"$out/bin/readelf\" \"$out/bin/strip\" \"$out/bin/strings\" \"$out/bin/size\" \\\n"
              , "         \"$out/bin/addr2line\" \"$out/bin/c++filt\" \"$out/bin/dwp\" \"$out/bin/elfedit\" \\\n"
              , "         \"$out/bin/gprof\"; do\n"
              , "  if [ -f \"$f\" ] && [ ! -L \"$f\" ]; then\n"
              , "    \"$patchelf\" --set-interpreter \"$ld_musl\" --set-rpath \"$out/lib\" \"$f\" 2>/dev/null || true\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# GCC/G++/CPP and libexec internals (cc1, cc1plus, collect2, lto-wrapper, etc.)\n"
              , "# crash when patchelf'd on aarch64 (EXEC binaries with long interpreter paths).\n"
              , "# Use ld-musl wrappers that invoke the store-internal dynamic linker directly.\n"
              , "GCC_LIBEXEC=\"$out/libexec/gcc/${gcc_triple}/${gcc_version}\"\n"
              , "\n"
              , "# Rename real GCC/G++ binaries\n"
              , "for cmd in gcc g++ cpp; do\n"
              , "  if [ -f \"$out/bin/$cmd\" ] && [ ! -L \"$out/bin/$cmd\" ]; then\n"
              , "    mv \"$out/bin/$cmd\" \"$out/bin/${cmd}.real\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# Create wrapper scripts using ld-musl interpreter\n"
              , "for cmd in gcc g++ cpp cc c89 c99 c++; do\n"
              , "  real_cmd=\"$cmd\"\n"
              , "  case \"$cmd\" in\n"
              , "    cc|c89|c99) real_cmd=\"gcc\" ;;\n"
              , "    c++) real_cmd=\"g++\" ;;\n"
              , "  esac\n"
              , "  rm -f \"$out/bin/$cmd\"\n"
              , "  printf '%s\\n' \"#!$bash/bin/bash\" > \"$out/bin/$cmd\"\n"
              , "  printf '%s\\n' \"exec \\\"$ld_musl\\\" --library-path \\\"$out/lib\\\" \\\"$out/bin/${real_cmd}.real\\\" \\\"\\$@\\\"\" >> \"$out/bin/$cmd\"\n"
              , "  chmod +x \"$out/bin/$cmd\"\n"
              , "done\n"
              , "\n"
              , "# Wrap libexec binaries (cc1, cc1plus, collect2, lto-wrapper, etc.)\n"
              , "find \"$GCC_LIBEXEC\" -maxdepth 1 -type f | while read -r f; do\n"
              , "  case \"$(basename \"$f\")\" in\n"
              , "    *.so|*.so.*) continue ;;\n"
              , "  esac\n"
              , "  if \"$patchelf\" --print-interpreter \"$f\" >/dev/null 2>&1; then\n"
              , "    mv \"$f\" \"${f}.real\"\n"
              , "    printf '%s\\n' \"#!$bash/bin/bash\" > \"$f\"\n"
              , "    printf '%s\\n' \"exec \\\"$ld_musl\\\" --library-path \\\"$out/lib\\\" \\\"${f}.real\\\" \\\"\\$@\\\"\" >> \"$f\"\n"
              , "    chmod +x \"$f\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# Also wrap gcc-ar, gcc-nm, gcc-ranlib, gcov, gcov-dump, gcov-tool, lto-dump\n"
              , "for cmd in gcc-ar gcc-nm gcc-ranlib gcov gcov-dump gcov-tool lto-dump; do\n"
              , "  if [ -f \"$out/bin/$cmd\" ] && [ ! -L \"$out/bin/$cmd\" ]; then\n"
              , "    mv \"$out/bin/$cmd\" \"$out/bin/${cmd}.real\"\n"
              , "    printf '%s\\n' \"#!$bash/bin/bash\" > \"$out/bin/$cmd\"\n"
              , "    printf '%s\\n' \"exec \\\"$ld_musl\\\" --library-path \\\"$out/lib\\\" \\\"$out/bin/${cmd}.real\\\" \\\"\\$@\\\"\" >> \"$out/bin/$cmd\"\n"
              , "    chmod +x \"$out/bin/$cmd\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# Update cross-compiler symlinks to point to wrapper scripts\n"
              , "for f in \"$out/bin/${gcc_triple}-\"*; do\n"
              , "  if [ -L \"$f\" ]; then\n"
              , "    target=$(readlink \"$f\")\n"
              , "    case \"$target\" in\n"
              , "      gcc|g++|cpp)\n"
              , "        rm \"$f\"\n"
              , "        ln -s \"$target\" \"$f\"\n"
              , "        ;;\n"
              , "    esac\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# Patch shared libraries to fix RPATH (exclude dynamic linker symlink)\n"
              , "find \"$out\" -name \"*.so*\" -type f ! -name \"ld-musl-*\" ! -name \"libc.musl-*\" | while read -r f; do\n"
              , "  if \"$out/bin/readelf\" -h \"$f\" >/dev/null 2>&1; then\n"
              , "    chmod u+w \"$f\" 2>/dev/null || true\n"
              , "    \"$patchelf\" --set-rpath \"$out/lib\" \"$f\" 2>/dev/null || \\\n"
              , "      echo \"  WARN: patchelf rpath failed on $(basename \"$f\")\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "rubble_script_shebang_register \"$bash/bin/bash\" sh bash\n"
              , "if [ -d \"$GCC_LIBEXEC/install-tools\" ]; then\n"
              , "  rubble_script_shebang_rewrite_all --strict --all \"$GCC_LIBEXEC/install-tools\"\n"
              , "fi\n"
              , "\n"
              , "# Do not patch Alpine GCC compiler executables themselves: cc1 can crash\n"
              , "# after PT_INTERP growth. Wrap every kernel-invokable musl ELF instead and\n"
              , "# keep the real payload non-executable so it cannot fall back to /lib.\n"
              , "find \"$out/bin\" \"$GCC_LIBEXEC\" -type f | while read -r f; do\n"
              , "  case \"$(basename \"$f\")\" in\n"
              , "    *.so|*.so.*) continue ;;\n"
              , "  esac\n"
              , "  if ! \"$patchelf\" --print-interpreter \"$f\" >/dev/null 2>&1; then\n"
              , "    continue\n"
              , "  fi\n"
              , "  case \"$f\" in\n"
              , "    *.real)\n"
              , "      chmod a-x \"$f\"\n"
              , "      ;;\n"
              , "    *)\n"
              , "      real=\"${f}.real\"\n"
              , "      mv \"$f\" \"$real\"\n"
              , "      printf '%s\\n' \"#!$bash/bin/bash\" > \"$f\"\n"
              , "      printf '%s\\n' \"exec \\\"$ld_musl\\\" --library-path \\\"$out/lib\\\" \\\"$real\\\" \\\"\\$@\\\"\" >> \"$f\"\n"
              , "      chmod +x \"$f\"\n"
              , "      chmod a-x \"$real\"\n"
              , "      ;;\n"
              , "  esac\n"
              , "done\n"
              , "\n"
              , "# Verify\n"
              , "echo \"\"\n"
              , "echo \"=== Verifying GCC toolchain ===\"\n"
              , "\"$out/bin/gcc\" --version | head -1 || true\n"
              , "\"$out/bin/g++\" --version | head -1 || true\n"
              , "\"$out/bin/ld\" --version | head -1 || true\n"
              , "\"$out/bin/ar\" --version | head -1 || true\n"
              , "\"$out/bin/as\" --version | head -1 || true\n"
              , "echo \"\"\n"
              , "echo \"Tool count: $(ls -1 \"$out/bin\" | wc -l)\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "btu4wdeflhf6iv4rk4awpoj4h3ke6bdsgsdmdj6icerqhprab2zq-bison":
      { "id": "btu4wdeflhf6iv4rk4awpoj4h3ke6bdsgsdmdj6icerqhprab2zq-bison"
      , "name": "bison"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "ztbwuqmg77pfi6tzkoy4asfmpiy22x6lugzprlhhhvjldam36n4q-rubble-script-shebang"
          , "transitive": "false"
          , "hooks": {
              "pre-build": [
                { "shell": {
                    "value": [
                      "source \"$script\""
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        , { "brick": "teieaxxyjdoyw4gqby5r4ywgrstjp3t6ui4dxasa6j7ba34arziq-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "zkiff2cic77r6rxw3quhxg6gu4rznq4omwpz5tui7zwbvlqj6mbq-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "cca6hpdxtvtjn3hkbljrizdlu2cpldgeodds67hxlcf2nhclfc5a-m4"
          , "alias": "m4"
          , "transitive": "true"
          }
        , { "brick": "bfahmy7gljzjxfst33xvrlfpvye7tavkkpozmme4kosoy3huftmq-bison-3.8.2-r1.apk"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "bxchorbehgapcopsqwo7w5zwjgenujywlkkytlnad3dvy5hpqc5q-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "echo \"Extracting bison package...\"\n"
              , "tar -xzf \"$src\" 2>/dev/null || true\n"
              , "\n"
              , "mkdir -p \"$out/bin\" \"$out/share\"\n"
              , "\n"
              , "# Copy bison binaries\n"
              , "cp usr/bin/bison \"$out/bin/bison\"\n"
              , "cp usr/bin/yacc \"$out/bin/yacc\"\n"
              , "chmod +x \"$out/bin/bison\" \"$out/bin/yacc\"\n"
              , "rubble_script_shebang_register \"$bash/bin/bash\" sh bash\n"
              , "rubble_script_shebang_rewrite_all --strict \"$out/bin/yacc\"\n"
              , "\n"
              , "# Copy bison data files (skeletons, m4sugar)\n"
              , "cp -a usr/share/bison \"$out/share/bison\"\n"
              , "\n"
              , "# Patch ELF binaries to use musl interpreter from runtime home\n"
              , "\"$patchelf\" --set-interpreter \"$ld_musl\" \"$out/bin/bison\"\n"
              , "\n"
              , "# Verify\n"
              , "echo \"\"\n"
              , "echo \"=== Verifying GNU Bison installation ===\"\n"
              , "BISON_PKGDATADIR=\"$out/share/bison\" M4=\"$m4\" \"$out/bin/bison\" --version | { head -1; cat > /dev/null; }"
              ]
            , "format": "text"
            }
          }
        ]
      }
