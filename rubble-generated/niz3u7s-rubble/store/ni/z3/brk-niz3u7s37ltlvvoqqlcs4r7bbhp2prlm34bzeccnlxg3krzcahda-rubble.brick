              , "chmod +x \"$out\"\n"
              , "\n"
              , "# Patch ELF binary to use musl interpreter from runtime home\n"
              , "\"$patchelf\" --set-interpreter \"$ld_musl\" \"$out\"\n"
              , "\n"
              , "# bin directory with symlinks for PATH integration\n"
              , "mkdir -p \"$bin\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/gzip\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/gunzip\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/zcat\"\n"
              , "\n"
              , "# Verify\n"
              , "echo \"\"\n"
              , "echo \"=== Verifying GNU gzip installation ===\"\n"
              , "\"$out\" --version | head -1 || true"
              ]
            , "format": "text"
            }
          }
        ]
