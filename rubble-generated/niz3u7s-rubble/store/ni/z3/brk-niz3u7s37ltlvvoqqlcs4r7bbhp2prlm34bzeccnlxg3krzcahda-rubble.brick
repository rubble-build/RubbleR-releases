  , "jollno6o4uloupgitupgjbfxgunhmm5hx3hdhvl7kbmw47dj4dpq-glibc-runtime-support":
      { "id": "jollno6o4uloupgitupgjbfxgunhmm5hx3hdhvl7kbmw47dj4dpq-glibc-runtime-support"
      , "name": "glibc-runtime-support"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "opaque": true
      , "inputs": [
          { "brick": "ppdghkityovkxogtghygvs2mls7qza646xifdh4qt3pdr7enpi2a-coreutils"
          , "alias": "coreutils"
          , "transitive": "false"
          }
        , { "brick": "4ravoggd7ip3ozxtjw2pppx3c2btu4xx7jhfrevaupwjdbyyrqmq-RubbleR.git.partial"
          , "alias": "src"
          , "transitive": "false"
          , "hooks": {
              "post-checkout": [
                { "install-to": [
                    { "output": "dir"
                    , "dir": "./" }
                  ]
                }
              , { "shell": {
                    "value": [
                      "( source \"${script}\" \"${dir}\" )"
                    ]
                  , "format": "text"
                  }
                }
              ]
            }
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "RUBBLE_SRC_LOCAL_PATHS all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "\"$coreutils/bin/mkdir\" -p \"$out\"\n"
              , "for file in initialize.c build-initializer.bash probe.c external-nss.c \\\n"
              , "  external-gconv.c passwd-namespace.c audit.bash README.md; do\n"
              , "  \"$coreutils/bin/cp\" \"scripts/glibc-runtime-support/$file\" \"$out/$file\"\n"
              , "done"
              ]
            , "format": "text"
            }
          }
        ]
      }
