          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "vta6yl5kfo7l43xvgauwa32n5mdi7kx7vjxjymz4odjpnhxy2gfa-gzip-1.13-r1.apk"
          , "alias": "src"
