  , "26tn2yq4ryvlust5j46r2gfdg7ew7zg7gpth4bowtw5vxvj5xeiq-findutils":
      { "id": "26tn2yq4ryvlust5j46r2gfdg7ew7zg7gpth4bowtw5vxvj5xeiq-findutils"
      , "name": "findutils"
      , "platform": "x86_64-linux"
      , "build_platform": "x86_64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "teieaxxyjdoyw4gqby5r4ywgrstjp3t6ui4dxasa6j7ba34arziq-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "zkiff2cic77r6rxw3quhxg6gu4rznq4omwpz5tui7zwbvlqj6mbq-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "4gvhwzfvxu2ugj4sf2jr5aq4u6pjy5jrywhkzxyimdv437sk6eba-findutils-4.10.0-r0.apk"
          , "alias": "src"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "echo \"Extracting findutils package...\"\n"
              , "tar -xzf \"$src\" 2>/dev/null || true\n"
              , "\n"
              , "mkdir -p \"$out/bin\"\n"
              , "\n"
              , "# Copy and patch find and xargs binaries\n"
              , "for cmd in find xargs; do\n"
              , "  if [ -f \"usr/bin/$cmd\" ]; then\n"
              , "    cp \"usr/bin/$cmd\" \"$out/bin/$cmd\"\n"
              , "    chmod +x \"$out/bin/$cmd\"\n"
              , "    \"$patchelf\" --set-interpreter \"$ld_musl\" \"$out/bin/$cmd\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# Verify\n"
              , "echo \"\"\n"
              , "echo \"=== Verifying GNU findutils installation ===\"\n"
              , "\"$out/bin/find\" --version | head -1 || true\n"
              , "\"$out/bin/xargs\" --version | head -1 || true"
              ]
            , "format": "text"
            }
          }
        ]
      }
