{ "id": "sro23mxtsmdqo6q6qnqjxue3aqpsmh44eskp6ftagjfnkxrfewuq-bison"
, "name": "bison"
, "platform": "x86_64-linux"
, "rubble_home": "/var/lib/rubble"
, "inputs": [
    { "brick": "gpd75vrjncv57fv3fzdfuoagqwgyqjwuizvdth2pdg7hv2q4lv5a-rubble-script-shebang"
    , "transitive": "false"
    , "hooks": {
        "pre-build": [
          { "shell": {
              "value": [
                "source \"$script\""
              ]
            , "format": "text"
            }
          }
        ]
      }
    }
  , { "brick": "cmdaozrcvaymmdfw3jodg7rrc4qwmaqyx6q3jj6u6nsie32hvdxq-publish-output-directory"
    , "transitive": "false"
    , "hooks": {
        "pre-build": [
          { "shell": {
              "value": [
                "source \"$script\""
              ]
            , "format": "text"
            }
          }
        ]
      }
    }
  , { "brick": "hdqxqr4vfc2rgc3rj5ywrpaykxqly77eix55tldf7wd7nqimpqfa-patchelf"
    , "alias": "patchelf"
    , "transitive": "false"
    }
  , { "brick": "z3xhjdr5it75lq5iwals4toaklhutksbdphbucgwhtgqhxz32k6q-ld-musl.so"
    , "alias": "ld_musl"
    , "transitive": "true"
    }
  , { "brick": "bfahmy7gljzjxfst33xvrlfpvye7tavkkpozmme4kosoy3huftmq-bison-3.8.2-r1.apk"
    , "alias": "src"
    , "transitive": "false"
    }
  , { "brick": "n7qbevbly56oq5vdzjm2bzhl77wjewdp4k5gmoimlbiv62nbv7pa-bash"
    , "alias": "bash"
    , "transitive": "true"
    }
  , { "brick": "6prv4ap5h2cndbif6hlymbvxvg3p2g3qtpdl7vdmyiwyxxp65kfq-m4"
    , "alias": "m4"
    , "transitive": "true"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  , { "name": "bin" }
  , { "name": "share" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "tar -xzf \"$src\" 2>/dev/null || true\n"
        , "\n"
        , "mkdir -p \"$out/bin\" \"$out/share\"\n"
        , "\n"
        , "# Copy bison binaries\n"
        , "cp usr/bin/bison \"$out/bin/bison\"\n"
        , "cp usr/bin/yacc \"$out/bin/yacc\"\n"
        , "chmod +x \"$out/bin/bison\" \"$out/bin/yacc\"\n"
        , "rubble_script_shebang_register \"${bash[bin]}/bash\" sh bash\n"
        , "rubble_script_shebang_rewrite_all --strict \"$out/bin/yacc\"\n"
        , "\n"
        , "# Copy bison data files (skeletons, m4sugar)\n"
        , "cp -a usr/share/bison \"$out/share/bison\"\n"
        , "\n"
        , "# Patch ELF binaries to use musl interpreter from runtime home\n"
        , "\"$patchelf\" --set-interpreter \"$ld_musl\" \"$out/bin/bison\"\n"
        , "\n"
        , "printf '%%%%\\ninput: ;\\n%%%%\\n' > \"$TMP/probe.y\"\n"
        , "BISON_PKGDATADIR=\"$out/share/bison\" M4=\"$m4\" \"$out/bin/bison\" --output=\"$TMP/probe.c\" \"$TMP/probe.y\"\n"
        , "rm -f \"$TMP/probe.y\" \"$TMP/probe.c\""
        ]
      , "format": "text"
      }
    }
  , { "shell": {
        "value": [
          "publish_output_directory \"$out/bin\" \"$bin\"\n"
        , "publish_output_directory \"$out/share\" \"$share\""
        ]
      , "format": "text"
      }
    }
  ]
