  , "5egteflbtlhbpl5lxsf77tssx5r2xozci62fdy42ah5ennedwyeq-musl-install-tools":
      { "id": "5egteflbtlhbpl5lxsf77tssx5r2xozci62fdy42ah5ennedwyeq-musl-install-tools"
      , "name": "musl-install-tools"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "n7qbevbly56oq5vdzjm2bzhl77wjewdp4k5gmoimlbiv62nbv7pa-bash"
          , "alias": "bash"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "install" }
        , { "name": "link_commands" }
        ]
      , "builder": [
          { "write": {
          "output": "install"
        , "mode": "0755"
        , "template": "#!{interpreter}\n{body}"
