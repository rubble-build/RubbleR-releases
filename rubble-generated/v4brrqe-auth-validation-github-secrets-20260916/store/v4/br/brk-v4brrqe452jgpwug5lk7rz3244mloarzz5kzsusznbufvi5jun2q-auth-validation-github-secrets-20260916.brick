{ "id": "v4brrqe452jgpwug5lk7rz3244mloarzz5kzsusznbufvi5jun2q-auth-validation-github-secrets-20260916"
, "name": "auth-validation-github-secrets-20260916"
, "build_platform": "x86_64-linux"
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "mkdir -p \"$out\"\n"
        , "printf \"%s\\n\" shared-authentication-ok > \"$out/result.txt\""
        ]
      , "format": "text"
      }
    }
  ]
}
