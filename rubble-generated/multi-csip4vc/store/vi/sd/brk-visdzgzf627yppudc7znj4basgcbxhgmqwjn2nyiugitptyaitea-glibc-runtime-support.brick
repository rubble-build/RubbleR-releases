{ "id": "visdzgzf627yppudc7znj4basgcbxhgmqwjn2nyiugitptyaitea-glibc-runtime-support"
, "name": "glibc-runtime-support"
, "build_platform": "aarch64-linux"
, "rubble_home": "/var/lib/rubble"
, "opaque": true
, "inputs": [
    { "brick": "qj7s4kfeu7lleafbwujkfsjkts575oc7v5agukewx2ic3y6b6mdq-coreutils"
    , "alias": "coreutils"
    , "transitive": "false"
    }
  , { "brick": "5eyssyrncrnzjquenwd7il5bulxkll55fhs3goh2ej6gqwwuphba-RubbleR.git.partial"
    , "alias": "src"
    , "transitive": "false"
    , "hooks": {
        "post-checkout": [
          { "install-to": [
              { "output": "dir"
              , "dir": "./" }
            ]
          }
        , { "shell": {
              "value": [
                "( source \"${script}\" \"${dir}\" )"
              ]
            , "format": "text"
            }
          }
        ]
      }
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "RUBBLE_SRC_LOCAL_PATHS all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "\"$coreutils/bin/mkdir\" -p \"$out\"\n"
        , "for file in initialize.c build-initializer.bash probe.c external-nss.c \\\n"
        , "  external-gconv.c passwd-namespace.c audit.bash README.md; do\n"
        , "  \"$coreutils/bin/cp\" \"scripts/glibc-runtime-support/$file\" \"$out/$file\"\n"
        , "done"
        ]
      , "format": "text"
      }
    }
  ]
