  , "nh577btyfes2xq2gotqnt6ur4vqq6qojz4kmf7xbewchtdzrmyzq-gnu-tar":
      { "id": "nh577btyfes2xq2gotqnt6ur4vqq6qojz4kmf7xbewchtdzrmyzq-gnu-tar"
      , "name": "gnu-tar"
      , "platform": "aarch64-linux"
      , "build_platform": "aarch64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "ptg4o4phfr2eutq2xrcoqi6zx2d2rk4nqoxdm73hvskgosibuh4a-tar-1.35-r2.apk"
          , "alias": "tar_apk"
          , "transitive": "false"
          }
        , { "brick": "cndex52rgwiybhxcbkpry2isc55dz3hrc5lblmzr3xyeilghixda-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "zwdawolcw4fqjnlmmwfrxjwrxcplq7t3jb73x5seskofbtj353na-libattr-2.5.2-r2.apk"
          , "alias": "libattr_apk"
          , "transitive": "false"
          }
        , { "brick": "65xn763kfhf7ye2ax5rr3hjotrij3qjagkddvfhqarwrt2a7mnha-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "7gwdsqgvkrl5q7ztjhu2z65wbjt2eywqrtwg7xc7jewdoolhnmea-acl-libs-2.3.2-r1.apk"
          , "alias": "acl_libs_apk"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        , { "name": "lib" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "echo \"Extracting packages...\"\n"
              , "mkdir -p tar-extract acl-extract attr-extract\n"
              , "tar -xzf \"$tar_apk\" -C tar-extract 2>/dev/null || true\n"
              , "tar -xzf \"$acl_libs_apk\" -C acl-extract 2>/dev/null || true\n"
              , "tar -xzf \"$libattr_apk\" -C attr-extract 2>/dev/null || true\n"
              , "\n"
              , "mkdir -p \"$lib\"\n"
              , "\n"
              , "# Copy shared libraries (libacl, libattr)\n"
              , "find acl-extract attr-extract -name \"*.so*\" -type f -exec cp -a {} \"$lib/\" \\; 2>/dev/null || true\n"
              , "find acl-extract attr-extract -name \"*.so*\" -type l -exec cp -a {} \"$lib/\" \\; 2>/dev/null || true\n"
              , "\n"
              , "# out is the tar binary itself\n"
              , "cp tar-extract/bin/tar \"$out\"\n"
              , "chmod +x \"$out\"\n"
              , "\n"
              , "# Patch ELF binary to use musl interpreter from runtime home\n"
              , "\"$patchelf\" --set-interpreter \"$ld_musl\" --set-rpath \"$lib\" \"$out\"\n"
              , "\n"
              , "# bin directory with symlinks for PATH integration\n"
              , "mkdir -p \"$bin\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/tar\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/gtar\"\n"
              , "\n"
              , "# Verify\n"
              , "echo \"\"\n"
              , "echo \"=== Verifying GNU tar installation ===\"\n"
              , "\"$out\" --version | head -1 || true"
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "qj7s4kfeu7lleafbwujkfsjkts575oc7v5agukewx2ic3y6b6mdq-coreutils":
      { "id": "qj7s4kfeu7lleafbwujkfsjkts575oc7v5agukewx2ic3y6b6mdq-coreutils"
      , "name": "coreutils"
      , "platform": "aarch64-linux"
      , "build_platform": "aarch64-linux"
      , "rubble_home": "/var/lib/rubble"
      , "inputs": [
          { "brick": "dxbm5xbf7vkb35noka43so2duja6uw3kitmmhxbybcer6op5bcla-utmps-libs-0.1.2.3-r2.apk"
          , "alias": "utmps_libs_apk"
          , "transitive": "false"
          }
        , { "brick": "ttxoxb3lfk7t3rzpgq4m42lsl7lmgzt2e5w5pdt6rxna3q6pulra-skalibs-libs-2.14.3.0-r0.apk"
          , "alias": "skalibs_libs_apk"
          , "transitive": "false"
          }
        , { "brick": "cndex52rgwiybhxcbkpry2isc55dz3hrc5lblmzr3xyeilghixda-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "zkj7262l7rctago4tw4edylztcehl6bcvsxrow4o4lpqurjcftdq-libcrypto3-3.3.7-r0.apk"
          , "alias": "libcrypto_apk"
          , "transitive": "false"
          }
        , { "brick": "zwdawolcw4fqjnlmmwfrxjwrxcplq7t3jb73x5seskofbtj353na-libattr-2.5.2-r2.apk"
          , "alias": "libattr_apk"
          , "transitive": "false"
          }
        , { "brick": "65xn763kfhf7ye2ax5rr3hjotrij3qjagkddvfhqarwrt2a7mnha-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        , { "brick": "5wsmysbedc7wbcb22csq254i5hrsdbwpdwuzyi5seacce7a4iaoa-coreutils-sha512sum-9.5-r2.apk"
          , "alias": "coreutils_sha512sum_apk"
          , "transitive": "false"
          }
        , { "brick": "k2sq3ksyc4xg4n3byfvtc2xp2by5lw3uus2pjw4ro7y4ad54uo4q-coreutils-fmt-9.5-r2.apk"
          , "alias": "coreutils_fmt_apk"
          , "transitive": "false"
          }
        , { "brick": "cnsuk57bulhj544m3skp3wwq4lsh5qegyneycg7bgfo2zzu5z7ua-coreutils-env-9.5-r2.apk"
          , "alias": "coreutils_env_apk"
          , "transitive": "false"
          }
        , { "brick": "esh7pawc46nsh5b2uuykm4qsjsoowbes5uu4nt2kcg6hocags6vq-coreutils-9.5-r2.apk"
          , "alias": "coreutils_apk"
          , "transitive": "false"
          }
        , { "brick": "7gwdsqgvkrl5q7ztjhu2z65wbjt2eywqrtwg7xc7jewdoolhnmea-acl-libs-2.3.2-r1.apk"
          , "alias": "acl_libs_apk"
          , "transitive": "false"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "mkdir -p \"$out/bin\" \"$out/lib\" extract\n"
              , "\n"
              , "echo \"Extracting packages...\"\n"
              , "for apk in \"$coreutils_apk\" \"$coreutils_env_apk\" \"$coreutils_fmt_apk\" \\\n"
              , "           \"$coreutils_sha512sum_apk\" \"$acl_libs_apk\" \"$libattr_apk\" \\\n"
              , "           \"$utmps_libs_apk\" \"$skalibs_libs_apk\" \"$libcrypto_apk\"; do\n"
              , "  tar -xzf \"$apk\" -C extract 2>/dev/null || true\n"
              , "done\n"
              , "\n"
              , "# Copy shared libraries (acl, attr, utmps, skalibs, libcrypto)\n"
              , "find extract -name \"*.so*\" -type f -exec cp -a {} \"$out/lib/\" \\; 2>/dev/null || true\n"
              , "find extract -name \"*.so*\" -type l -exec cp -a {} \"$out/lib/\" \\; 2>/dev/null || true\n"
              , "\n"
              , "# Copy the multicall binary\n"
              , "cp extract/usr/bin/coreutils \"$out/bin/coreutils\"\n"
              , "chmod +x \"$out/bin/coreutils\"\n"
              , "\n"
              , "# Copy sub-package binaries (env, fmt, sha512sum are separate ELF binaries)\n"
              , "for cmd in env fmt sha512sum; do\n"
              , "  if [ -f \"extract/usr/bin/$cmd\" ] && [ ! -L \"extract/usr/bin/$cmd\" ]; then\n"
              , "    cp \"extract/usr/bin/$cmd\" \"$out/bin/${cmd}\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# Patch ELF binaries to use musl interpreter from runtime home\n"
              , "for f in \"$out/bin/\"*; do\n"
              , "  if [ -f \"$f\" ] && [ ! -L \"$f\" ]; then\n"
              , "    if \"$patchelf\" --print-interpreter \"$f\" >/dev/null 2>&1; then\n"
              , "      \"$patchelf\" --set-interpreter \"$ld_musl\" --set-rpath \"$out/lib\" \"$f\"\n"
              , "    fi\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# Create symlinks for all coreutils commands pointing to the multicall binary\n"
              , "for cmd in \\\n"
              , "  base64 basename basenc b2sum base32 cat chcon chgrp chmod chown chroot \\\n"
              , "  cksum comm cp csplit cut date dd df dir dircolors dirname du echo \\\n"
              , "  expand expr factor false fold head hostid id install join kill link \\\n"
              , "  ln logname ls md5sum mkdir mkfifo mknod mktemp mv nice nl nohup \\\n"
              , "  nproc numfmt od paste pathchk pinky pr printenv printf ptx pwd \\\n"
              , "  readlink realpath rm rmdir runcon seq sha1sum sha224sum sha256sum \\\n"
              , "  sha384sum shred shuf sleep sort split stat stdbuf stty sum \\\n"
              , "  sync tac tail tee test timeout touch tr true truncate tsort tty \\\n"
              , "  uname unexpand uniq unlink uptime users vdir wc who whoami yes\n"
              , "do\n"
              , "  if [ ! -e \"$out/bin/$cmd\" ]; then\n"
              , "    ln -s coreutils \"$out/bin/$cmd\"\n"
              , "  fi\n"
              , "done\n"
              , "\n"
              , "# Verify\n"
              , "echo \"\"\n"
              , "echo \"=== Verifying coreutils installation ===\"\n"
              , "\"$out/bin/coreutils\" --version | head -1 || true\n"
              , "\"$out/bin/ls\" --version 2>&1 | head -1 || true\n"
              , "echo \"Total commands: $(ls -1 \"$out/bin\" | wc -l)\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  , "a7ud4y2emz4jysev4e5p275gywgintjlenar2fsfrjokko6cdclq-bootstrap-env":
