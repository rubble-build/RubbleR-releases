          { "brick": "cndex52rgwiybhxcbkpry2isc55dz3hrc5lblmzr3xyeilghixda-patchelf"
          , "alias": "patchelf"
          , "transitive": "false"
          }
        , { "brick": "hdhimhaqn7bul5k67m2gmw4ea6xibuprz2mgla5obsjibs7tfnoa-make-4.4.1-r2.apk"
          , "alias": "src"
          , "transitive": "false"
          }
        , { "brick": "65xn763kfhf7ye2ax5rr3hjotrij3qjagkddvfhqarwrt2a7mnha-ld-musl.so"
          , "alias": "ld_musl"
          , "transitive": "true"
          }
        ]
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "outputs": [
          { "name": "out" }
        , { "name": "bin" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "echo \"Extracting make package...\"\n"
              , "tar -xzf \"$src\" 2>/dev/null || true\n"
              , "\n"
              , "# out is the make binary itself\n"
              , "cp usr/bin/make \"$out\"\n"
              , "chmod +x \"$out\"\n"
              , "\n"
              , "# Patch ELF binary to use musl interpreter from runtime home\n"
              , "\"$patchelf\" --set-interpreter \"$ld_musl\" \"$out\"\n"
              , "\n"
              , "# bin directory with symlinks for PATH integration\n"
              , "mkdir -p \"$bin\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/make\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/gmake\"\n"
              , "\n"
              , "# Verify\n"
              , "echo \"\"\n"
              , "echo \"=== Verifying GNU Make installation ===\"\n"
              , "\"$out\" --version | head -1 || true"
              ]
            , "format": "text"
            }
          }
        ]
      }
