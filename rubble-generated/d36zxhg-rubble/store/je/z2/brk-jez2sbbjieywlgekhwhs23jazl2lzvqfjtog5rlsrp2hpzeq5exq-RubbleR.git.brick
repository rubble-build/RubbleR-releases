              , "\n"
              , "# bin directory with symlinks for PATH integration\n"
              , "mkdir -p \"$bin\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/grep\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/egrep\"\n"
              , "ln -s \"../$(basename \"$out\")\" \"$bin/fgrep\"\n"
              , "\n"
              , "# Verify\n"
              , "echo \"\"\n"
              , "echo \"=== Verifying GNU grep installation ===\"\n"
              , "\"$out\" --version 2>&1 | head -1 || true"
