{ "id": "vxwgaxdchz7bshf2frb2nciw5fvmchcygr76c7nstnwaithr3t2q-unzip"
, "name": "unzip"
, "platform": "aarch64-linux"
, "build_platform": "aarch64-linux"
, "rubble_home": "/var/lib/rubble"
, "inputs": [
    { "brick": "4uecjax2lpo5idputrmq6yayy6admss7pdzmgzf6pwomzimzj3qa-unzip-6.0-r15.apk"
    , "alias": "src"
    , "transitive": "false"
    }
  , { "brick": "cndex52rgwiybhxcbkpry2isc55dz3hrc5lblmzr3xyeilghixda-patchelf"
    , "alias": "patchelf"
    , "transitive": "false"
    }
  , { "brick": "65xn763kfhf7ye2ax5rr3hjotrij3qjagkddvfhqarwrt2a7mnha-ld-musl.so"
    , "alias": "ld_musl"
    , "transitive": "true"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  , { "name": "bin" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "tar -xzf \"$src\" 2>/dev/null || true\n"
        , "\n"
        , "# out is the unzip binary itself\n"
        , "cp usr/bin/unzip \"$out\"\n"
        , "chmod +x \"$out\"\n"
        , "\n"
        , "# Patch ELF binary to use musl interpreter from runtime home\n"
        , "\"$patchelf\" --set-interpreter \"$ld_musl\" \"$out\"\n"
        , "\n"
        , "# bin directory with symlink for PATH integration\n"
        , "mkdir -p \"$bin\"\n"
        , "ln -s \"../$(basename \"$out\")\" \"$bin/unzip\"\n"
        , "\n"
        , "# Verify\n"
        , "echo \"\"\n"
        , "echo \"=== Verifying unzip installation ===\"\n"
        , "\"$out\" -v 2>&1 | head -1 || true"
        ]
      , "format": "text"
      }
    }
  ]
, "inventory": {
    "4uecjax2lpo5idputrmq6yayy6admss7pdzmgzf6pwomzimzj3qa-unzip-6.0-r15.apk":
      { "id": "4uecjax2lpo5idputrmq6yayy6admss7pdzmgzf6pwomzimzj3qa-unzip-6.0-r15.apk"
      , "name": "unzip-6.0-r15.apk"
      , "src": {
          "url": "https://dl-cdn.alpinelinux.org/alpine/v3.21/main/aarch64/unzip-6.0-r15.apk"
        , "checksum": "sha256:b75c03bc8808172fd825d7f1e94daf4a40492d6d1838308db7e2f9e050da89e9"
        }
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "__rubble_skip_src_split__"
          , "value": "true"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "cp -ar \"$src\" \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
